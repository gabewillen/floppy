/// Core SCXML runtime contracts for independently deployed Wasm components.
///
/// Conventions shared by every interface in this package:
///
/// * Every string is UTF-8; every byte bound below counts UTF-8 bytes.
/// * Every fallible function returns a closed `component-error`. The error is
///   the only failure signal; a failed call never returns partial output.
/// * Callers own every argument; providers copy what they retain. No handle,
///   buffer, or string is shared across the boundary after a call returns.
/// * Unless a function documents a side effect on failure, a failed call
///   leaves provider state unchanged.
/// * Providers perform no ambient I/O. Clocks, randomness, networks, and
///   storage reach a component only through the imports its world names.
/// * Bounds marked "bundled provider" are enforced by the providers built from
///   this repository; other providers MAY choose tighter bounds and MUST
///   reject over-bound input with `payload-too-large` or `invalid-input`
///   rather than truncating it.
package stateforward:scxml@0.2.0;

/// Shared value types.
interface types {
  /// SCXML event classification (SCXML 1.0 section 5.10.1 `_event.type`).
  enum event-type {
    /// Raised by `<raise>` or the interpreter itself.
    internal,
    /// Delivered through an I/O processor or `send`.
    external,
    /// Generated by the platform, for example `error.execution`.
    platform,
  }

  /// Whether W3C baggage crosses the boundary it is attached to.
  enum baggage-policy {
    /// Baggage is removed before crossing the boundary.
    drop,
    /// Baggage crosses the boundary unchanged.
    propagate,
  }

  /// W3C Trace Context carrier. Providers validate every carrier and reject
  /// malformed ones with `invalid-input`; carriers never alter semantics.
  ///
  /// Propagation: the machine opens one telemetry span per effect batch,
  /// parented to the triggering event's carrier (else, during
  /// `start-invoked`, the invoking batch's carrier; else the host's
  /// context), and every event the batch raises, sends, autoforwards, or
  /// fails with (`error.execution`, `error.communication`) carries that span's
  /// `traceparent` and `tracestate` with the trigger's baggage under the
  /// trigger's `baggage-policy` (no baggage and `drop` without a trigger
  /// carrier). A processed event's batch span is therefore the child of the
  /// operation that sent it. Conditions are evaluated outside any batch, so
  /// the `error.execution` a failed condition raises carries the carrier of
  /// the batch the machine call last opened (else the evaluated event's
  /// carrier). When telemetry produces no span of its own, the trigger's
  /// carrier passes through unchanged.
  record trace-context {
    /// Canonical version-00 W3C `traceparent`: exactly 55 bytes.
    traceparent: string,
    /// W3C `tracestate`: at most 512 bytes and 32 list members.
    tracestate: option<string>,
    /// W3C baggage: at most 8192 bytes and 64 list members.
    baggage: option<string>,
    /// Whether `baggage` propagates to child events.
    baggage-policy: baggage-policy,
  }

  /// One SCXML event.
  ///
  /// Bounds (enforced by every bundled provider): `name`, `send-id`, and
  /// `invoke-id` valid SCXML names; `origin`,
  /// `origin-type`, `data`, and `raw` have no byte bound (SCXML sets none).
  /// JSON data MUST already be canonical.
  record event {
    /// Event name used for transition matching.
    name: string,
    /// Event classification.
    event-type: event-type,
    /// Identifier of the SCXML send operation that produced this event, when present.
    send-id: option<string>,
    /// Origin URI supplied by the delivering I/O processor.
    origin: option<string>,
    /// I/O processor type URI or alias that delivered the event.
    origin-type: option<string>,
    /// Invocation that produced the event, when applicable.
    invoke-id: option<string>,
    /// Event payload; `absent` means none.
    data: data-value,
    /// Raw I/O-processor message text the event was constructed from, when
    /// the delivering processor retains one (SCXML 6.2 `_event.raw`).
    raw: option<string>,
    /// Optional trace carrier; never changes event semantics.
    trace-context: option<trace-context>,
  }

  /// One named payload entry (`<param>` or `namelist` item) of a `<send>`,
  /// `<invoke>`, or `<donedata>`, in document order; duplicate names are
  /// kept (SCXML 6.2.4).
  ///
  /// Bounds (bundled providers): `name` non-empty;
  /// `value` within the `event` data bounds.
  record named-value {
    /// Entry name exactly as authored (a `namelist` entry's data-model key).
    name: string,
    /// Evaluated entry value.
    value: data-value,
  }

  /// Body of one SCXML Event I/O Processor message; the processor derives
  /// `_event.raw` from it (SCXML 5.10.1, C.1).
  variant send-message {
    /// No `<param>`, `namelist`, or `<content>`.
    empty,
    /// `<param>` and `namelist` entries in document order, duplicates kept.
    params(list<named-value>),
    /// A `<content>` payload; its value is the event's `data`.
    content,
  }

  /// One `<send>` request routed to an I/O processor.
  record send-request {
    /// Caller-owned send identifier. Required when `delay-ms` is non-zero,
    /// and whenever `event.send-id` is present. `event.send-id` MUST be
    /// absent or equal to it: the delivered event carries the id only when
    /// the author gave `id` or `idlocation` (SCXML C.1), while a delayed
    /// send without either still needs a generated one.
    send-id: option<string>,
    /// Event to deliver.
    event: event,
    /// Target URI; absence selects the processor default.
    target: option<string>,
    /// I/O processor type; absence selects the SCXML Event I/O Processor.
    processor-type: option<string>,
    /// Delay in whole milliseconds; 0 means immediate delivery.
    delay-ms: u64,
    /// Message body the processor renders `_event.raw` from.
    message: send-message,
  }
  /// One evaluated `<send>` addressed to an Event I/O Processor other than
  /// the SCXML one (SCXML 6.2), such as `BasicHTTP` (SCXML C.2) or a
  /// processor a package binds. The machine evaluates every expression; the
  /// processor never sees one, and the host routes the send by its
  /// `processor-type`.
  record processor-send {
    /// Evaluated `type`/`typeexpr`, exactly as written:
    /// a processor's type URI or one of its aliases. A type no processor
    /// answers is refused by the host with `invalid-input` (SCXML 6.2.5:
    /// `error.execution`).
    processor-type: string,
    /// The send's id (a valid SCXML name): the
    /// authored `id`, else the one the machine generated for this execution
    /// (SCXML 3.14, 6.2.4). It never enters the processor's message. The
    /// host keeps it with the request, so an `error.communication` it
    /// delivers after the `<send>` returned carries it as `send-id` (SCXML
    /// 5.10.1).
    send-id: string,
    /// Evaluated `event`/`eventexpr`.
    event-name: option<string>,
    /// Evaluated `target`/`targetexpr`.
    target: option<string>,
    /// `namelist` entries then `<param>` children, in document order, as
    /// data-model form values.
    params: list<named-value>,
    /// Evaluated `<content>`; mutually exclusive with `params`.
    content: option<data-value>,
    /// Delay in whole milliseconds.
    delay-ms: u64,
    /// Optional trace carrier; never changes semantics.
    trace-context: option<trace-context>,
  }


  /// Delivery class of one `<send>` target (SCXML 6.2, C.1). Decided only
  /// by the SCXML Event I/O Processor (`io-processor-api.classify-target`).
  variant send-target {
    /// `#_internal`: the sender's internal queue.
    internal,
    /// Absent, or the sender's own `#_scxml_sessionid`: the sender's
    /// external queue.
    local,
    /// `#_parent` or the parent's `#_scxml_sessionid`: the invoking session.
    parent,
    /// A live invocation of the sender (`#_invokeid`, or the invoked
    /// session's `#_scxml_sessionid`), by invoke id.
    invocation(string),
    /// Any other session of the sender's run (`#_scxml_sessionid` naming
    /// neither the sender, its parent, nor its invocations), by
    /// `_sessionid`: SCXML C.1 leaves the accessible sessions to the
    /// platform, and every session of the run is. The host delivers to it
    /// while it runs; one that does not run is `error.communication`.
    session(string),
    /// A well-formed session address no live session answers
    /// (`error.communication`).
    unreachable,
    /// Any other target form (`error.execution`).
    invalid,
  }

  /// Addressing facts about a sending session, reported by the host from
  /// its session table. These are facts only; the host never classifies a
  /// target.
  ///
  /// Bounds: `session-id` and `parent-session-id` valid SCXML names;
  /// `invocations` strictly sorted by invoke id.
  record sender {
    /// The sending session's `_sessionid`.
    session-id: string,
    /// The invoking parent's session id, for an invoked session.
    parent-session-id: option<string>,
    /// The sender's started, not cancelled invocations that still run.
    invocations: list<invocation-address>,
  }

  /// How a session addresses one invocation (SCXML C.1): by its invoke id
  /// (`#_invokeid`), or, for an invoked SCXML session, by its session id
  /// (`#_scxml_sessionid`).
  record invocation-address {
    /// The invoke id.
    invoke-id: string,
    /// The invoked session's `_sessionid`; none for an invoked service,
    /// which has no session.
    session-id: option<string>,
  }

  /// One event bound for a live invocation of the sender.
  record routed-event {
    /// Invoke id of the addressed invoked session.
    invoke-id: string,
    /// Event to deliver to that child.
    event: event,
  }

  /// How one `<data>` declaration is valued (SCXML 5.2-5.3).
  variant data-initializer {
    /// The `expr` value expression, evaluated with no current event.
    expression(string),
    /// A value the machine already materialized (inline content or an
    /// external `src` document).
    value(data-value),
  }

  /// Inline `<content>` or `<data>` children (SCXML 5.6, 6.2.6).
  variant inline-body {
    /// Text-only children, concatenated in document order.
    text(string),
    /// Children containing at least one element, as standalone,
    /// namespace-correct markup.
    markup(string),
  }

  /// Result of evaluating a `<foreach array>` expression (SCXML 4.6).
  variant foreach-result {
    /// Shallow snapshot of the collection's items in iteration order.
    items(list<data-value>),
    /// The value is not a legal collection (`error.execution`).
    illegal,
  }

  /// One `<invoke>` of an invoked service (SCXML 6.4): an `<invoke>` whose
  /// type is neither absent nor the SCXML processor type, every expression
  /// evaluated by the machine; the service never sees one.
  ///
  /// Bounds (bundled providers): `invoke-id` a valid SCXML name;
  /// `type-uri` at most 4096 bytes; `source` at most 16384
  /// bytes; `content` and every parameter value within the `event` data
  /// bounds; at most 32 `attributes` and `references`.
  record invoke-request {
    /// Interpreter-owned invocation identifier.
    invoke-id: string,
    /// The `<invoke>`'s `type` (or evaluated `typeexpr`), exactly as
    /// authored or evaluated (no case folding or trimming); the host routes
    /// by it byte for byte (SCXML 6.4.1: platform-specific values are
    /// allowed).
    type-uri: string,
    /// Evaluated `src`/`srcexpr` text exactly as authored or evaluated. It
    /// is data for the service: neither the machine nor the host loads it.
    source: option<string>,
    /// Evaluated `<content>` (its `expr`, or its inline children).
    content: option<data-value>,
    /// `<param>` and `namelist` entries in document order (SCXML 6.4.2).
    parameters: list<named-value>,
    /// The `<invoke>`'s attributes in the `env` namespace
    /// (`https://github.com/stateforward/scxml.rs/namespaces/env`), sorted
    /// by local name, each once: `env:<slot>="NAME"` as authored, and
    /// `env:<slot>expr` as `env:<slot>` with its expression's value. Each
    /// value is the name of the variable whose value the host binds to that
    /// slot; names, never values.
    attributes: list<extension-attribute>,
    /// The references the host bound, for the whole invocation, to the
    /// `attributes` whose variable it holds a value for, in slot order. The
    /// machine sends none; the host fills them before it calls `invoke`.
    references: list<slot-reference>,
    /// Carrier of the effect batch that ran `<invoke>`; never changes
    /// semantics.
    trace-context: option<trace-context>,
  }

  /// Portable data-model value.
  variant data-value {
    /// No value was supplied.
    absent,
    /// ECMAScript `undefined`.
    undefined,
    /// Data-model null.
    null,
    /// Boolean value.
    boolean(bool),
    /// Finite number; NaN and infinities are rejected with `invalid-input`.
    number(f64),
    /// String value.
    text(string),
    /// Canonical JSON array text.
    json-array(string),
    /// Canonical JSON object text with recursively sorted keys.
    json-object(string),
    /// XML payload preserved as UTF-8 source text.
    xml(string),
  }

  /// Where an `<assign>` places its value relative to each node its
  /// `location` selects (SCXML 1.0 section 5.4, and the XPath data model's
  /// `type` and `attr` in SCXML 1.0 CR 2014-03-13 §C.3.6).
  ///
  /// `replace-children` is SCXML's default and the only placement the
  /// ECMAScript and null data models define. It is also the placement of
  /// every assignment the machine materializes itself (`<foreach>` `item`
  /// and `index`) and of every `data-model-host.assign`. A provider fails a
  /// placement it does not define with `execution`, which the machine turns
  /// into `error.execution`, and changes no data.
  ///
  /// The assigned value (see `assign-source`) is converted exactly as
  /// `replace-children` converts it: an `xml` value is the node sequence
  /// of its fragment, and any other value is what the provider assigns for
  /// it by default. `delete` ignores the source (the machine passes
  /// `value(absent)`); `add-attribute` uses the value's string-value as the
  /// attribute value.
  variant assign-placement {
    /// Replace every child of the location node (the default).
    replace-children,
    /// Insert the value before the first child of the location node.
    first-child,
    /// Insert the value after the last child of the location node.
    last-child,
    /// Insert the value as the preceding sibling of the location node.
    previous-sibling,
    /// Insert the value as the following sibling of the location node.
    next-sibling,
    /// Replace the location node itself with the value.
    replace,
    /// Delete the location node.
    delete,
    /// Add, or replace, the attribute named by the exact `attr` text on the
    /// location node.
    add-attribute(string),
  }

  /// What an `<assign>` assigns (SCXML 1.0 section 5.4).
  variant assign-source {
    /// The `expr` value expression. The data model evaluates it and assigns
    /// the result inside one call, with `_event` bound to the call's event,
    /// so the location can hold any value the data model can represent,
    /// including values with no portable `data-value` form (for example
    /// ECMAScript functions, constructed objects, or a copy of `_event`).
    /// Bounded like an expression.
    expression(string),
    /// A value the machine already materialized for an existing location:
    /// inline `<assign>` children (a standalone, namespace-correct `xml`
    /// fragment that restates every namespace it uses when the children
    /// contain an element; `text` when they are text only), or `absent` for
    /// `delete`. The location must already denote a location of the data
    /// model; an undeclared one is an error and declares nothing.
    value(data-value),
    /// A `<foreach>` `item` or `index` value (SCXML 1.0 section 4.6), always
    /// with `replace-children`. `location` is then the attribute's variable
    /// name, not a location expression: the provider declares the variable
    /// when it is not declared yet and binds the value, and fails a name
    /// that is not a legal variable name with `invalid-input` or
    /// `execution`.
    foreach-value(data-value),
  }

  /// Exact expanded XML name. Namespace URIs are compared byte-for-byte.
  record qualified-name { namespace-uri: option<string>, local-name: string }
  /// One attribute of an extension-namespace element.
  record extension-attribute { name: qualified-name, value: string }
  /// Start tag of a nested extension-namespace element.
  record start-element { name: qualified-name, attributes: list<extension-attribute> }
  /// Flattened content of an extension-namespace element in document order;
  /// every `start-element` is balanced by a matching `end-element`.
  variant extension-content {
    text(string),
    start-element(start-element),
    end-element(qualified-name),
  }
  /// An opaque reference to one value the host holds for an invoked service
  /// (`invoke-request.references`): the component passes it back inside an
  /// `outbound-http` request, where the host substitutes the value. A
  /// reference is valid for its whole invocation; the value itself never
  /// enters the component.
  type value-reference = u32;
  /// One `env` slot of an invoked service's `<invoke>` and the reference the
  /// host bound to it: the `env:<slot>="NAME"` (or `env:<slot>expr`)
  /// attribute named a variable the embedder holds a value for. A slot that
  /// is not named, or whose variable has no value, is absent.
  record slot-reference { slot: string, reference: value-reference }
  /// One element of additional executable content, lowered by the compiler
  /// (SCXML 1.0 section 4.10: "any extensions to executable content MUST NOT
  /// be defined the 'scxml' namespace").
  record executable-content-extension {
    name: qualified-name,
    attributes: list<extension-attribute>,
    content: list<extension-content>,
  }

  /// Log severity.
  enum log-level { trace, debug, info, warn, error }

  /// Closed error schema version; unknown discriminants fail canonical ABI decoding.
  enum error-version { v1 }

  /// Closed failure classification shared by every runtime interface.
  enum error-code {
    /// An argument was malformed, violated a precondition, or failed
    /// validation. Inside executable content this is a recoverable SCXML
    /// execution error (`error.execution`).
    invalid-input,
    /// A caller-owned identifier is already live.
    duplicate-id,
    /// A caller-owned identifier is not live.
    unknown-id,
    /// A count bound (queue, registry, schedule) is full.
    capacity-exhausted,
    /// A byte bound was exceeded.
    payload-too-large,
    /// A payload named an unsupported schema version.
    unsupported-version,
    /// The call is illegal in the current lifecycle state, or a dependency
    /// broke its contract. Retrying the same call cannot succeed.
    protocol,
    /// SCXML execution failed (SCXML 5.10 `error.execution`).
    execution,
    /// A required capability or provider is not available.
    unavailable,
    /// The host platform failed.
    platform,
  }

  /// A closed runtime failure. Detail is optional, bounded to 160 UTF-8 bytes by
  /// producers, and contains only static safe text; input payloads and identifiers
  /// are never reflected into it.
  record component-error {
    version: error-version,
    code: error-code,
    detail: option<string>,
  }

  /// Whether an extension component executed one executable-content extension.
  variant extension-outcome {
    /// The element was handled.
    handled,
    /// The element is not handled by this component; the machine raises an
    /// SCXML execution error rather than ignoring it.
    not-handled,
  }

  /// Compile-time identity of one external script (SCXML 1.0 section 5.8
  /// `<script src>`), pinned by the compiler from a caller-supplied script
  /// package.
  record pinned-script {
    /// Media type the script package declared, for example
    /// `application/wasm` for a Wasm script component.
    media-type: string,
    /// SHA-256 of the exact script bytes: 64 lowercase hexadecimal characters.
    sha256: string,
    /// WIT world a Wasm script component implements
    /// (`stateforward:scxml/script@0.2.0`); absent for data-model-language
    /// text, whose bytes the compiler embeds in the Machine IR instead.
    wit-world: option<string>,
  }

  /// One external `<script src>` reference the machine hands to its host.
  ///
  /// Bounds (bundled providers): `uri` non-empty and at most 16384 bytes.
  /// A pinned reference is resolved only to bytes whose SHA-256 equals
  /// `pinned.sha256`; an unpinned reference is resolved by the host's
  /// runtime `script-loader` under the embedder's digest allowlist.
  record script-reference {
    /// The `src` URI exactly as authored; never rewritten or normalized.
    uri: string,
    /// Compile-time pin; absent for runtime resolution.
    pinned: option<pinned-script>,
  }
}

/// Data-model access offered to extension components and Wasm script
/// components by the host. The host forwards every call to the data-model
/// instance active for the calling session, so reads and assignments operate
/// on that data model's state; `_event` is bound to the event of the
/// executable content that invoked the caller.
interface data-model-host {
  use types.{data-value, component-error};
  /// Evaluates one expression in the active data model.
  /// Errors: `invalid-input` for a malformed expression, `execution` for an
  /// evaluation failure, `unavailable` when no data model is linked.
  evaluate: func(expression: string) -> result<data-value, component-error>;
  /// Assigns one value to one location with the default `replace-children`
  /// placement.
  /// Errors: as `evaluate`; a failed assignment changes no data.
  assign: func(location: string, value: data-value) -> result<_, component-error>;
}

/// Interpreter services offered to data models and extension components.
///
/// A data model receives only `log` and `in-state`; its `raise`, `send`,
/// and `cancel` answer `unavailable`. An extension component's calls act on the
/// session executing the element, and only during that `execute` call
/// (outside one, including in `initialize` and `shutdown`, they answer
/// `unavailable` and `in-state` answers false).
interface execution-host {
  use types.{event, send-request, log-level, component-error};
  /// Queues one internal event on the calling session. The host keeps the
  /// event's name, data, and carrier, stamps it `internal`, and hands it to
  /// the machine with the extension's outcome (`extension-execution.internal`).
  /// Errors: `invalid-input` for an invalid event; nothing is queued on
  /// failure. The host sets no bound on the events one `execute` call queues.
  raise: func(event: event) -> result<_, component-error>;
  /// Routes one SCXML Event I/O Processor send request (`processor-type`
  /// absent, `scxml`, or the processor's type URI) exactly as `<send>` routes
  /// it: the processor classifies the target; `#_internal` queues an internal
  /// event, the session's own address an external one (both handed back with
  /// the extension's outcome), and a parent, child, or delayed send is routed
  /// or scheduled by the host. Errors: `invalid-input` for a malformed request
  /// or target, or any other `processor-type` (an extension component sends
  /// through no other processor); `duplicate-id`, `capacity-exhausted`,
  /// `payload-too-large`, or `protocol` from the processor; `unavailable` for
  /// an unlinked processor or a target no live session answers (`<send>`'s
  /// `error.communication`); `platform` when the host failed, which fails the
  /// session.
  send: func(request: send-request) -> result<_, component-error>;
  /// Cancels a pending delayed send by caller-owned id; an absent id succeeds.
  /// Errors: `invalid-input` for a malformed id.
  cancel: func(send-id: string) -> result<_, component-error>;
  /// Records one log line; infallible and never alters semantics. Hosts
  /// never record the message text in telemetry.
  log: func(level: log-level, message: string);
  /// SCXML `In()` predicate over the configuration installed for the
  /// executable content being executed.
  in-state: func(state-id: string) -> bool;
  /// The session clock's current time in Unix epoch milliseconds: the
  /// run's start epoch plus the session's logical time, the clock its
  /// delayed sends are scheduled on (logical time 0 when the session starts;
  /// it follows the embedder's time in a live session). The ECMAScript data
  /// model reads it for `Date.now()` and `new Date()`. Infallible; a caller
  /// outside any session reads 0.
  now-ms: func() -> u64;
}

/// Capabilities a machine session uses to execute effects.
///
/// "Effect" is host vocabulary, not an SCXML term: an effect is one request
/// the machine makes of its host, in document order. Most effects carry out
/// executable content (SCXML 4: `<send>`, `<log>`, `<assign>`, `<script>`,
/// `<cancel>`, extension elements); others start, cancel, or forward to an
/// `<invoke>` (SCXML 6.4) or bind a state's `<data>` (SCXML 5.3).
///
/// The host owns the `machine-capabilities` resource and hands the machine an
/// owned handle at session construction; the session keeps it until the
/// session resource is dropped. Calls are synchronous and ordered: the machine
/// never calls a capability concurrently or re-entrantly. Effects applied
/// through these functions are committed by the host when the call returns;
/// the machine never asks the host to roll them back.
interface machine-capability-types {
  use types.{invoke-request, processor-send, data-value, assign-placement, assign-source, event, send-request, executable-content-extension, extension-outcome, component-error, trace-context, script-reference, named-value, send-target, data-initializer, inline-body, foreach-result};

  /// One entry of the machine's execution trace reported to the host.
  variant observation {
    /// One engine command (start, one event, resume) completed; reported
    /// before that command's effects run.
    command-completed,
    /// One `<raise>` was applied; carries the raised event name.
    raised(string),
    /// One queued event was dequeued and processed by transition selection
    /// (selected or ignored); carries its name. Reported after the processing
    /// command's `command-completed`, before that command's effects run.
    processed(string),
  }

  /// What executing one executable-content extension produced.
  record extension-execution {
    /// The extension component's own result (see
    /// `executable-content-extension-api.execute`).
    outcome: result<extension-outcome, component-error>,
    /// Internal events the extension component queued, in call order: every
    /// `execution-host.raise` and every `execution-host.send` to
    /// `#_internal`. The machine appends them to its internal queue.
    internal: list<event>,
    /// Self-addressed external events the extension component sent
    /// (`execution-host.send` with no target, `#_self`, or the session's own
    /// address), in call order. The machine appends them to its external queue.
    external: list<event>,
  }

  /// Session status.
  enum status {
    /// Constructed and not yet started.
    ready,
    /// Started and not in a top-level final state.
    running,
    /// A top-level final state was reached.
    finished,
    /// A terminal failure occurred; see `session.failure`.
    failed,
    /// `shutdown` was called.
    shut-down,
  }

  /// Recorded value of one history pseudostate (SCXML 3.10).
  record history-value {
    /// The history pseudostate's id.
    state: string,
    /// Recorded states in document order.
    value: list<string>,
  }
  /// The invoking parent of a session started by `start-invoked`.
  record invoked-by {
    /// `_sessionid` of the invoking parent session.
    parent-session-id: string,
    /// Invoke id the parent assigned to this session.
    invoke-id: string,
  }
  /// A started, not yet cancelled invocation (SCXML 6.4).
  record invocation-snapshot {
    /// Invoke id.
    invoke-id: string,
    /// Id of the invoking state.
    state: string,
    /// Index of the `<invoke>` among the state's invokes, document order.
    index: u32,
    /// Invoke type URI.
    type-uri: string,
    /// `autoforward`.
    autoforward: bool,
  }
  /// SCXML 3.5 transition `type`.
  enum transition-type {
    /// `external`.
    external,
    /// `internal`.
    internal,
  }
  /// A resolved `event:schema` as the Machine IR carries it.
  record event-schema-text {
    /// The schema as canonical JSON text.
    schema: string,
    /// SHA-256 of `schema`: 64 lowercase hexadecimal characters.
    sha256: string,
  }
  /// The `event` attribute vocabulary of one element
  /// (`https://github.com/stateforward/scxml.rs/namespaces/event`): metadata
  /// that never changes execution.
  variant event-schema {
    /// `event:schema`, resolved at compile time.
    schema(event-schema-text),
    /// `event:schemaexpr`: the authored expression, never evaluated here.
    schemaexpr(string),
  }
  /// A transition an event could trigger from the current configuration
  /// (the "Transitions" entry under "Session object (keys in this order)" in
  /// `docs/session-snapshot.md`). `cond` is authored text and is never
  /// evaluated; eventless transitions are not listed.
  record transition-snapshot {
    /// Source state id.
    source: string,
    /// Index among the source's transitions, document order.
    index: u32,
    /// Event descriptors (never empty).
    events: list<string>,
    /// Target state ids.
    targets: list<string>,
    /// Transition type.
    %type: transition-type,
    /// Authored condition text.
    cond: option<string>,
    /// SCXML 3.13 transition domain; none when targetless or `<scxml>`.
    domain: option<string>,
    /// This transition's exit set taken alone, exit order.
    exit: list<string>,
    /// This transition's entry set taken alone, entry order.
    entry: list<string>,
    /// The schema of the `_event.data` the transition handles, as the
    /// Machine IR carries it; none when the transition has no `event`
    /// vocabulary.
    event-schema: option<event-schema>,
  }
  /// Read-only image of one machine session (`docs/session-snapshot.md`,
  /// "Session object (keys in this order)"). It is introspection only:
  /// there is no restore. `machine-api.session.snapshot` takes it at a
  /// checkpoint; `machine-capabilities.execute-extension` carries the image
  /// at one executable-content extension (the executable-content image, see
  /// there).
  record machine-snapshot {
    /// Session status.
    status: status,
    /// `_name`: the document `name`; none when the document has none.
    name: option<string>,
    /// Active atomic/final states, document order.
    atomic: list<string>,
    /// Full active configuration, ancestors included, document order.
    configuration: list<string>,
    /// Internal queue (empty in a stable configuration).
    internal: list<event>,
    /// Recorded history values, document order of the history state.
    history: list<history-value>,
    /// Late-binding states already bound (SCXML 5.3), document order.
    bound-states: list<string>,
    /// Live invocations, in ascending invoke-id order.
    invocations: list<invocation-snapshot>,
    /// The invoking parent, for a session started by `start-invoked`.
    invoked-by: option<invoked-by>,
    /// Next generated send-id ordinal.
    send-counter: u64,
    /// Next generated invoke-id ordinal.
    invoke-counter: u64,
    /// Empty unless `options.transitions`; `exit`/`entry` empty unless
    /// `options.previews`.
    transitions: list<transition-snapshot>,
  }

  /// What the host did with one `<send>` it accepted.
  variant send-disposition {
    /// The event is for the sending session's own external queue: the
    /// machine enqueues it.
    enqueue-external(event),
    /// The host routed the event to another session.
    routed,
    /// The processor scheduled the event on the session's clock.
    scheduled,
    /// No live session answers the target: the machine raises
    /// `error.communication` with the send id (SCXML 6.2, C.1).
    undeliverable,
  }

  /// Kind of one document the machine asks the host to load.
  enum document-kind {
    /// An external `<data src>` document (SCXML 5.3).
    data,
    /// An `<invoke src>` child document (SCXML 6.4).
    invocation,
  }

  /// One document the host loaded: its text exactly as the resource holds
  /// it, and the media type its source indicated, when it indicated one
  /// (an HTTP `Content-Type`, a file-name extension the embedder maps, or
  /// the page's own label; SCXML B.2.1: "if an indication of the type of the
  /// content is available (e.g., via a Content-Type header), then the
  /// Processor SHOULD try to interpret the content according to that
  /// indication"). `media-type` is at most 256 bytes of visible ASCII; the
  /// machine ignores one that is not.
  record loaded-document {
    text: string,
    media-type: option<string>,
  }

  /// One invoked SCXML session the machine asks the host to start
  /// (SCXML 6.4).
  record invoked-session {
    /// Interpreter-owned invoke id (a valid SCXML name).
    /// The host names the invoked session itself: its `_sessionid` is unique
    /// among every session of the run and bounded at any nesting depth.
    invoke-id: string,
    /// Child Machine IR bytes produced by `compile-invocation` (untrusted;
    /// at most 16777216 bytes).
    machine-ir: list<u8>,
    /// The child document's `datamodel`, selecting the linked data model.
    data-model: option<string>,
    /// `<param>` and `namelist` entries passed to the child (SCXML 6.4.2).
    parameters: list<named-value>,
    /// Carrier of the effect batch that ran `<invoke>`. The host passes it
    /// on `invocation-context.trace-context`, so the child's start batch
    /// is that batch's child. Never changes semantics.
    trace-context: option<trace-context>,
  }

  /// What one `<invoke>` asks the host to start (SCXML 6.4): an SCXML
  /// session, or an invoked service.
  variant invocation {
    /// An invoked SCXML session (`type` absent or the SCXML processor type).
    session(invoked-session),
    /// An invoked service: any other `type`.
    service(invoke-request),
  }

  /// How the host carries out one `start-invocation` or
  /// `cancel-invocation` request.
  enum invocation-progress {
    /// The host carried the request out inside the call.
    completed,
    /// The host carries the request out after this call returns: the
    /// machine call that made it stops right after the `<invoke>` effect
    /// and returns a `call-result` with `suspended` set, nothing else having run
    /// after it; the host carries the request out and calls
    /// `session.invocation-completed` with the result this call would have
    /// returned, and the session goes on exactly as if it had.
    deferred,
  }

  /// Host-owned capability handle for one machine session.
  ///
  /// Data-model functions (`initialize-data-model` through
  /// `external-data`) are forwarded by the host one-to-one to the session's
  /// linked data-model instance (`data-model-api`), with identical
  /// semantics and errors; a session with no linked data model answers each
  /// fallible one with `unavailable` and each pure one with `none`.
  resource machine-capabilities {
    /// Updates the active configuration observed by data-model `In()`
    /// queries (`in-state`): removes every state in `exited` (the others
    /// keep their order), then appends every state in `entered`, in order;
    /// a state in both lists is removed and then re-appended. A session's
    /// configuration starts empty, and the machine sends only changes:
    /// every `exited` state is in the configuration, and no `entered` state
    /// is once `exited` is removed. Each effect and each deferred condition
    /// observes the configuration after the last update before it (SCXML
    /// 5.9.1): exit content no longer sees the states exited before it,
    /// entry content sees every state entered before it (W3C IRP test 409),
    /// and between effects the configuration is the full active
    /// configuration in document order. The machine calls this only when
    /// that observed configuration changes, so one microstep costs work
    /// linear in its effects plus the configuration size.
    /// Errors: any error fails the calling machine session.
    update-active-configuration: func(exited: list<string>, entered: list<string>) -> result<_, component-error>;
    /// Evaluates a transition or `<if>`/`<elseif>` condition. `invalid-input`
    /// and `execution` errors become SCXML `error.execution` and the
    /// condition is treated as false (SCXML 5.9); the call that selected or
    /// planned it succeeds. Every other error fails the session with that
    /// same code.
    evaluate-condition: func(expression: string, event: option<event>) -> result<bool, component-error>;
    /// Evaluates a value expression. `invalid-input` and `execution` errors
    /// become SCXML `error.execution`.
    evaluate-value: func(expression: string, event: option<event>) -> result<data-value, component-error>;
    /// Executes `<assign>`, or a `<foreach>` `item`/`index` assignment
    /// (`foreach-value` source, `replace-children`): assigns `source` to `location`
    /// with `placement`, with `_event` bound to `event` (unbound when
    /// `none`) while the location and any expression are evaluated.
    /// `invalid-input` and `execution` errors become SCXML
    /// `error.execution`; a failed assignment changes no data.
    assign: func(location: string, source: assign-source, placement: assign-placement, event: option<event>, context: option<trace-context>) -> result<_, component-error>;
    /// Executes one `<script>` body.
    execute: func(script: string, event: option<event>) -> result<_, component-error>;
    /// Fetches and prepares one external script at document load (SCXML 1.0
    /// section 5.8). The machine calls it during session construction, once
    /// per distinct `uri` in document order, for every `<script src>` whose
    /// content is not embedded in the Machine IR. The host resolves the URI
    /// to bytes and a media type (a pinned reference through the packaged
    /// `script-bundle` or its loader, an unpinned one through its runtime
    /// `script-loader`), authenticates them (pinned SHA-256, digest
    /// allowlist, size bound), and dispatches by media type:
    /// `application/wasm` must be a component implementing the `script`
    /// world; the active data model's own script language is kept as text;
    /// anything else is rejected.
    /// A second call for an already loaded `uri` with the same pin succeeds
    /// without reloading.
    /// Bounds (bundled hosts): no bound on the distinct URIs one session
    /// loads; each script at most 4194304 bytes when it is a Wasm component
    /// (every build: the bytes are authenticated before anything links
    /// them) and, in a wasm build only, 65536 bytes when it is data-model
    /// text; further capped by the host's script byte policy.
    /// Errors: any error rejects the document: the session starts `failed`
    /// with this cause:
    /// * `invalid-input`: an invalid URI; one URI loaded with two different
    ///   pins; a resolved media type that differs from the pin; a digest that
    ///   differs from the pin or, for an unpinned reference, is not in the
    ///   host allowlist; an unsupported media type; bytes that are not a
    ///   component implementing the `script` world; text in a different
    ///   language than the active data model or not UTF-8;
    /// * `payload-too-large`: the script exceeds its byte bound;
    /// * `unavailable`: no loader is linked for an unpinned or unbundled
    ///   reference, or the loader returned `unknown-id` or `unavailable`
    ///   (loader codes are translated, not forwarded);
    /// * `platform`: the loader returned `platform`.
    load-script: func(reference: script-reference) -> result<_, component-error>;
    /// Runs one external script previously accepted by `load-script`, with
    /// `_event` bound to `event`. A Wasm script component is instantiated
    /// fresh, linked to the active data model through `data-model-host`,
    /// and its `script-api.run` is called; data-model-language text runs
    /// through the data model's own `execute`. `invalid-input` and
    /// `execution` errors become SCXML `error.execution`; a reference that
    /// was not loaded fails with `protocol`.
    run-script: func(reference: script-reference, event: option<event>) -> result<_, component-error>;
    /// Delivers one internal event raised outside the machine's own queue.
    raise: func(event: event) -> result<_, component-error>;
    /// Executes `<cancel>`.
    cancel: func(send-id: string, context: option<trace-context>) -> result<_, component-error>;
    /// Executes one executable-content extension (SCXML 1.0 section 4.10)
    /// through the extension component the host bound to its exact namespace
    /// URI, with `_event` bound to `event` for the extension component's
    /// `data-model-host` calls.
    ///
    /// The outer error is the host's: `invalid-input` and `execution` raise
    /// SCXML `error.execution` and end that block, as any recoverable
    /// capability failure does; any other code, including `unavailable` when no
    /// extension component is bound to the element's exact namespace URI, fails
    /// the session (an unbound namespace fails closed, never degrading into
    /// core SCXML). Otherwise `extension-execution.outcome` is the extension
    /// component's answer: `not-handled` raises SCXML `error.execution` (it is
    /// never ignored), `invalid-input` and `execution` errors become
    /// `error.execution`, and any other error fails the session. The events the
    /// extension component queued are applied whatever its outcome, exactly
    /// like data-model assignments it already made.
    ///
    /// `snapshot` is present exactly when `extension-snapshot-request` answered
    /// true for the element's namespace URI. It is the machine's
    /// executable-content image, taken at this effect without evaluating
    /// anything (`docs/session-snapshot.md`, "Snapshots during executable
    /// content"): `atomic` and `configuration` are the configuration this
    /// effect observes (`update-active-configuration`, the one `In()` answers),
    /// `internal` the internal queue as the machine holds it, `transitions` the
    /// walk of "Transitions" from each innermost state of that configuration (a
    /// state none of whose children is in it) with `exit` and `entry` left
    /// empty, and the rest as `session.snapshot` reports it.
    execute-extension: func(element: executable-content-extension, event: option<event>, context: option<trace-context>, snapshot: option<machine-snapshot>) -> result<extension-execution, component-error>;
    /// Whether the extension component bound to `namespace-uri` reads the
    /// session snapshot (its component imports `session-snapshot-host`), so the
    /// machine passes its executable-content image with `execute-extension`;
    /// false when no extension component is bound to it. The machine asks
    /// before every extension and computes no image when the answer is false.
    /// Infallible and side-effect free.
    extension-snapshot-request: func(namespace-uri: string) -> bool;
    /// Loads the extension component of every executable-content extension
    /// namespace the document uses (SCXML 1.0 section 4.10). `namespace-uris`
    /// is the Machine IR's list of them: exact URIs, sorted, unique, and never
    /// empty. The machine calls it exactly once per session, root or invoked,
    /// before data binding and the first macrostep, and only when the
    /// document uses an extension namespace. The host answers from the
    /// namespaces it already binds, or loads a namespace through its
    /// embedder's resolver (a repository namespace, for example) and binds it
    /// for this session and every later one. Errors: any error, including
    /// `unavailable` when a namespace has no extension component to bind,
    /// fails the session start closed: no data is bound and no macrostep runs.
    load-extensions: func(namespace-uris: list<string>) -> result<_, component-error>;

    /// Admits one engine command against the run's shared command budget.
    /// The machine calls it before every engine command. Errors:
    /// `capacity-exhausted` when the budget is spent; any error fails the
    /// session with that cause.
    admit-command: func() -> result<_, component-error>;
    /// Reports one trace observation: after every engine command (before
    /// that command's effects) and after every applied `<raise>`.
    /// Infallible and never alters semantics.
    observe: func(observation: observation);

    /// The linked data model's stable name (`data-model-api.name`); none
    /// when no data model is linked.
    data-model-name: func() -> option<string>;
    /// `data-model-api.initialize` with the host's own system values
    /// (`_sessionid`, `_ioprocessors`) and the machine-supplied `_name`: the
    /// document's `name` attribute, none when the document has none (SCXML
    /// 5.10: "bind the variable _name at load time to the value of the 'name'
    /// attribute of the <scxml> element").
    /// The machine calls it once, from `start` or `start-invoked`, before binding data.
    initialize-data-model: func(declarations: list<string>, machine-name: option<string>) -> result<_, component-error>;
    /// `data-model-api.declare`.
    declare: func(id: string) -> result<_, component-error>;
    /// `data-model-api.initialize-data`.
    initialize-data: func(id: string, initializer: data-initializer) -> result<_, component-error>;
    /// `data-model-api.set-parameter`.
    set-parameter: func(name: string, value: data-value) -> result<bool, component-error>;
    /// `data-model-api.evaluate-location`.
    evaluate-location: func(location: string, event: option<event>) -> result<data-value, component-error>;
    /// `data-model-api.evaluate-text`.
    evaluate-text: func(expression: string, event: option<event>) -> result<option<string>, component-error>;
    /// `data-model-api.evaluate-log`.
    evaluate-log: func(expression: string, event: option<event>) -> result<string, component-error>;
    /// `data-model-api.evaluate-form-value`.
    evaluate-form-value: func(source: string, location: bool, event: option<event>) -> result<data-value, component-error>;
    /// `data-model-api.foreach-items`.
    foreach-items: func(expression: string, event: option<event>) -> result<foreach-result, component-error>;
    /// `data-model-api.release-foreach`. The machine calls it when one of
    /// its calls returns without suspending.
    release-foreach: func();
    /// `data-model-api.namelist-key`.
    namelist-key: func(location: string) -> option<string>;
    /// `data-model-api.event-payload`.
    event-payload: func(entries: list<named-value>) -> option<data-value>;
    /// `data-model-api.inline-content`.
    inline-content: func(content: inline-body) -> option<data-value>;
    /// `data-model-api.external-data`.
    external-data: func(text: string) -> option<data-value>;
    /// `data-model-api.event-data-field`.
    event-data-field: func(data: data-value, name: string) -> option<data-value>;
    /// `data-model-api.accepts-event-data`.
    accepts-event-data: func(data: data-value) -> bool;

    /// Loads one external document (`<data src>` text, or an `<invoke src>`
    /// child document) exactly as authored by `uri`, with the media type its
    /// source indicated.
    /// Errors: `unavailable` when the URI is not resolvable (the machine
    /// raises `error.execution`); `payload-too-large` over the host bound.
    load-document: func(kind: document-kind, uri: string) -> result<loaded-document, component-error>;
    /// Classifies one `<send>` target. The host forwards to the SCXML Event
    /// I/O Processor's `classify-target` with this session's sender facts;
    /// it never classifies itself.
    classify-target: func(target: option<string>) -> send-target;
    /// Routes one SCXML Event I/O Processor `<send>` through the processor
    /// (`io-processor-api.dispatch`) and executes its decision.
    /// Errors: `invalid-input` and `payload-too-large` become SCXML
    /// `error.execution`; every other error fails the session.
    send: func(request: send-request) -> result<send-disposition, component-error>;
    /// Sends one `<send>` whose type is not the SCXML Event I/O Processor's
    /// through the processor its `processor-type` names: at once when
    /// `delay-ms` is 0, else the host has the processor check it and
    /// schedules it through the SCXML Event I/O Processor's
    /// `schedule-processor` (disposition `scheduled`), and dispatches it when
    /// it falls due; a due send that cannot be dispatched raises
    /// `error.communication` with its send id through
    /// `session.communication-error` (SCXML 6.2, 6.2.4, C.2).
    /// Errors: `invalid-input` (a type no processor answers included) and
    /// `payload-too-large` become SCXML `error.execution`; every other error
    /// fails the session.
    send-processor: func(request: processor-send) -> result<send-disposition, component-error>;
    /// Executes `<log>` with the data model's rendered text
    /// (`evaluate-log`; empty when `<log>` has no `expr`).
    log: func(label: option<string>, text: string, context: option<trace-context>) -> result<_, component-error>;

    /// Compiles one child document to lowered Machine IR through the
    /// compiler component (schema policy off, runtime script resolution).
    /// The host never parses SCXML.
    /// Errors: `invalid-input` when the compiler rejects the document.
    compile-invocation: func(source-name: string, source: string) -> result<list<u8>, component-error>;
    /// Starts one invocation (SCXML 6.4), inside this call (`completed`) or
    /// after it returns (`deferred`; see `invocation-progress`).
    ///
    /// An invoked SCXML session (`session`): the host constructs the invoked
    /// machine session, links its data model and I/O processors, calls its
    /// `start-invoked`, and runs it to a stable configuration. An invoked
    /// session may invoke in turn, at any depth. An invoked session whose
    /// call stops at its command bound is ended as `cancel-invocation`
    /// ends it (nothing it sends reaches this session from then on, its
    /// `cancel` runs, and no `done.invoke` follows): a start that stopped
    /// there fails with `invalid-input`, and a later call becomes
    /// `communication-error` (`error.communication.<invoke-id>`).
    ///
    /// An invoked service (`service`): the host instantiates the service
    /// component bound to exactly `type-uri` in a store of its own and calls
    /// its `invoked-service-api.invoke`. Events the invoking session sends to
    /// `#_<invoke-id>` (and autoforwarded events) reach the service on the
    /// `events` stream; the events the service returns on its stream reach
    /// this session through `session.deliver-from-invocation` stamped with
    /// the invoke id; its future resolving `ok` becomes
    /// `done.invoke.<invoke-id>`, and resolving `err` or a trap becomes
    /// `communication-error` (`error.communication.<invoke-id>`).
    ///
    /// Errors (returned here, or passed to `invocation-completed`):
    /// `invalid-input` when the invoked session is rejected at load or at
    /// its start or its start stops at its command bound, the service's `invoke` returned an error or trapped, the
    /// service imports an interface the host does not link or a resource
    /// the run does not grant, or the host's invoke limits leave no room
    /// for it; `unavailable` when no service component is bound to the
    /// type (each raises `error.execution`); `duplicate-id` for a live
    /// invoke id.
    start-invocation: func(request: invocation) -> result<invocation-progress, component-error>;
    /// Cancels the invocation (SCXML 6.4), inside this call or after it
    /// returns as `start-invocation`. An invoked service: from now on
    /// nothing it returns reaches this session; the host cancels its
    /// `invoke` subtask and drops its store, and no `done.invoke` follows.
    /// An invoked session: from now on nothing it sends reaches this
    /// session; when unfinished its `cancel` runs (cancelling the sessions
    /// it invoked as its own exit reaches them), then the host drops it
    /// with its external event queue, its timers, and every session below
    /// it. Events it sent earlier stay on this session's external queue.
    /// An absent invoke id succeeds without effect.
    cancel-invocation: func(invoke-id: string) -> result<invocation-progress, component-error>;
    /// Queues one event on the external event queue of a live, unfinished
    /// invoked session, or on the `events` stream of a live invoked service
    /// (`<invoke autoforward>`); otherwise a no-op.
    forward-to-invocation: func(invoke-id: string, event: event) -> result<_, component-error>;
  }
}

/// Guest telemetry facade. Guests never embed an OTEL SDK; the host maps
/// these closed values onto its OpenTelemetry providers. Every enum is closed
/// and every value is a bounded label; payloads, identifiers, and expressions
/// never cross this interface.
interface telemetry {
  use types.{trace-context};
  /// Closed operation label.
  enum operation {
    initialize,
    evaluate-condition,
    evaluate-value,
    assign,
    execute,
    system-context,
    start,
    send,
    cancel,
    drain-due,
    type-uri,
    resume,
    shutdown,
    check-syntax,
    check-effects,
    start-invoked,
    deliver,
    exit,
    dispatch,
    route-due,
    encode,
    diff,
    communication-error,
    schedule-processor,
  }
  /// Closed outcome label: `rejected` for caller or input failures, `failed`
  /// for execution or platform failures.
  enum outcome { ok, rejected, failed }
  /// Closed span-event label.
  enum signal-event {
    type-uri-returned,
    send-accepted,
    send-rejected,
    cancel-completed,
    cancel-rejected,
    due-drained,
    input-accepted,
    input-rejected,
    transformation-completed,
    artifact-accepted,
    artifact-produced,
  }
  /// Closed numeric measurement kinds with stable units and host instrument mappings.
  enum measurement-kind { effects, input-bytes, snapshot-bytes, queue-depth, fuel }
  /// One numeric sample; `value` is a measurement, never a label.
  record measurement {
    kind: measurement-kind,
    value: u64,
  }
  /// Opens one guest span under `parent` and returns its host-owned id plus
  /// the child carrier. Id 0 with no carrier means telemetry is unavailable;
  /// guests MUST continue unchanged. Each id MUST be ended exactly once.
  start: func(operation: operation, parent: option<trace-context>) -> tuple<u64, option<trace-context>>;
  /// Closes a span opened by `start`; unknown ids are ignored.
  end: func(span: u64, outcome: outcome);
  /// Records an outcome and at most one typed numeric sample; values are never indexed labels.
  observe: func(operation: operation, outcome: outcome, measurement: option<measurement>, context: option<trace-context>);
  /// Records a closed event without emitting a metric sample.
  event: func(operation: operation, event: signal-event, context: option<trace-context>);
}

/// One SCXML data model (SCXML 1.0 section 5).
///
/// Lifecycle: `initialize` before any other call except `name`,
/// `check-syntax`, `check-effects`, and the pure functions (`namelist-key`, `event-payload`,
/// `inline-content`, `external-data`, `event-data-field`, `accepts-event-data`); calls before a successful
/// `initialize` fail with `unavailable`. A failed call changes no data.
/// Bundled-provider bounds: no text/JSON/XML value or location name has a
/// byte bound. The XPath provider gives
/// each expression evaluation 1000000 fuel units; running out of fuel, like any other evaluator limit, fails
/// that call with `execution` (SCXML `error.execution`) and changes no data.
interface data-model-api {
  use types.{data-value, assign-placement, assign-source, event, component-error, trace-context, named-value, data-initializer, inline-body, foreach-result};
  /// SCXML system variables (SCXML 1.0 section 5.10).
  record system-values {
    /// `_sessionid`; a valid SCXML name.
    session-id: string,
    /// `_name`: the document's `name` attribute; none when it has none, and
    /// the data model then binds `_name` to no value (ECMAScript
    /// `undefined`, an empty XPath `<_name/>`).
    machine-name: option<string>,
    /// `_ioprocessors`.
    io-processors: data-value,
  }
  /// Syntactic category of one fragment passed to `check-syntax`.
  enum syntax-kind {
    /// A boolean condition (`cond`).
    condition,
    /// A value expression (`expr`, `*expr`, `<foreach array>`).
    value,
    /// An assignable location (`location`, `idlocation`, a `namelist`
    /// item, `<foreach item/index>`).
    location,
    /// A `<script>` body.
    script,
  }
  /// One syntax problem. `start` and `end` are UTF-8 byte offsets into the
  /// checked source on character boundaries with `start <= end <= len`;
  /// `message` is at most 512 bytes and describes the problem without
  /// positions.
  record syntax-issue {
    start: u32,
    end: u32,
    message: string,
  }
  /// Returns the stable data-model name (`ecmascript`, `null`, `xpath`).
  name: func() -> string;
  /// Parse-only syntax check used by validators; it never evaluates the
  /// source, never reads or changes data-model state, and may be called
  /// before `initialize`. Returns an empty list when the fragment is
  /// syntactically valid, otherwise at most 4 issues.
  /// Errors: `payload-too-large` when the fragment exceeds the expression or
  /// script bound; `invalid-input` when the provider declines it (for
  /// example, nesting beyond its parser bound); `unavailable` when the
  /// provider does not check syntax (the bundled null provider, whose data
  /// model has no expression syntax).
  check-syntax: func(kind: syntax-kind, source: string) -> result<list<syntax-issue>, component-error>;
  /// What one fragment passed to `check-effects` is in its document.
  enum effect-role {
    /// A `cond` on `<transition>`, `<if>`, or `<elseif>` (checked: SCXML
    /// Appendix B, "This language MUST not have side effects").
    condition,
    /// A `<log expr>` (checked: SCXML 4.7.3, "The SCXML processor MUST
    /// ensure that <log> has no side-effects on document interpretation.").
    log,
    /// A static `<script>` body (its declarations and writes).
    script,
    /// A `<data expr>`; `name` is its `id`.
    data,
    /// Any other value expression (its writes).
    value,
    /// A location (its root variable is written).
    location,
  }
  /// One fragment of the document's source. `name` is present exactly for
  /// `data`.
  record effect-fragment {
    role: effect-role,
    name: option<string>,
    source: string,
  }
  /// Whether the document loads any `<script src>`, whose source a
  /// parse-only analysis cannot read.
  enum external-scripts {
    /// Every script is inline.
    absent,
    /// At least one script is loaded from `src`.
    present,
  }
  /// What a finding, or the effect it is caused by, does.
  enum effect-kind {
    /// Assigns a variable or property outside the checked expression.
    assignment,
    /// Increments or decrements one.
    update,
    /// Deletes one.
    deletion,
    /// Calls a built-in method that changes its receiver or an argument.
    mutating-call,
    /// Draws from a random sequence whose position then advances.
    random,
    /// Calls a document function; the cause says what its body does.
    function-call,
    /// Calls a function the analysis cannot see.
    unknown-call,
    /// Runs text as code.
    dynamic-code,
    /// Reads a value while the document defines a getter or conversion
    /// method that has an effect.
    implicit-call,
    /// Writes through a reference the analysis cannot trace.
    unknown-write,
    /// Uses a dynamic scope.
    dynamic-scope,
    /// Calls something a script the analysis cannot read may define.
    unseen-script,
    /// Exceeds the analysis bounds.
    too-complex,
    /// Assigns, updates, or deletes a system variable itself (SCXML 5.10);
    /// reported for any fragment.
    system-variable-write,
  }
  /// A byte range of one fragment: `fragment` indexes the request; `start
  /// <= end` are UTF-8 byte offsets on character boundaries of its source.
  record effect-span {
    fragment: u32,
    start: u32,
    end: u32,
  }
  /// Where a call's effect happens: in `function` (empty for an anonymous
  /// one) at `span`, touching or calling `subject`.
  record effect-cause {
    kind: effect-kind,
    span: effect-span,
    subject: string,
    function: string,
  }
  /// One effect of a checked fragment. `certain` is true when the syntax
  /// certainly has the effect when it runs and false when the analysis
  /// cannot decide. `subject` and `cause.subject`/`function` are at most
  /// 256 bytes. `operator` is the `=` of a condition that is exactly one
  /// plain assignment.
  record effect-finding {
    certain: bool,
    kind: effect-kind,
    span: effect-span,
    subject: string,
    cause: option<effect-cause>,
    operator: option<effect-span>,
  }
  /// Parse-only side-effect analysis used by validators: it reads every
  /// fragment of one document (`scripts` is `present` when the document
  /// has a `<script src>` it cannot read) and reports the effects
  /// of the `condition` and `log` fragments and every
  /// `system-variable-write` of any fragment, sorted, at most 4 per
  /// fragment. It never evaluates source, never reads or changes
  /// data-model state, and may be called before `initialize`. A fragment
  /// that does not parse is skipped.
  /// Bounds: at most 16384 fragments and 4194304 source bytes.
  /// Errors: `payload-too-large` over those bounds; `invalid-input` for a
  /// malformed request; `unavailable` when the provider does not analyze
  /// effects (the bundled null provider).
  check-effects: func(fragments: list<effect-fragment>, scripts: external-scripts) -> result<list<effect-finding>, component-error>;
  /// Declares every `<data>` id of the document (document order, unique)
  /// with the provider's placeholder value (ECMAScript `null`; `XPath` an
  /// empty node-set) and binds the system variables. The null provider
  /// accepts only an empty list. The `XPath` provider also binds the W3C
  /// `XPath` IRP template processor name
  /// `http://www.w3.org/TR/scxml/#SCXMLProcessor` in `_ioprocessors` to the
  /// `http://www.w3.org/TR/scxml/#SCXMLEventProcessor` entry.
  /// Bounds (bundled providers): each declaration a valid variable name.
  /// Errors: `invalid-input` for an invalid, reserved, or duplicate name, a
  /// non-empty list on the null provider, or malformed system values;
  /// `payload-too-large` for over-bound input. Failure preserves prior
  /// state.
  initialize: func(declarations: list<string>, context: system-values) -> result<_, component-error>;
  /// Declares one late-bound `<data>` variable (SCXML 5.3) with the
  /// placeholder value.
  /// Errors: `invalid-input` for an invalid or reserved name; `unavailable`
  /// on the null provider.
  declare: func(id: string) -> result<_, component-error>;
  /// Values one declared `<data>` variable (SCXML 5.2-5.3). An `expression`
  /// is evaluated with no current event and stored in the same call.
  /// Errors: `invalid-input` and `execution` are recoverable initializer
  /// failures (the machine then sets the variable to the data model's
  /// `undefined`/empty value, as for an empty `<data>` element (SCXML 5.3),
  /// and queues `error.execution`); `unavailable` on the null provider.
  initialize-data: func(id: string, initializer: data-initializer) -> result<_, component-error>;
  /// Sets one `<invoke>` parameter in an invoked child as the initial value
  /// of the top-level `<data>` it names (SCXML 6.4.3); the machine calls it
  /// in that declaration's place during data binding, only for a name that
  /// matches a top-level declaration, and never evaluates that
  /// declaration's own value. Returns false, and leaves the data model
  /// unchanged, when `name` is not declared by the child.
  /// Errors: as `initialize-data`.
  set-parameter: func(name: string, value: data-value) -> result<bool, component-error>;
  /// Reads one location (`<param location>`, a `namelist` entry); the
  /// location must exist.
  /// Errors: `invalid-input` for a malformed location, `execution` for an
  /// evaluation failure or a missing location.
  evaluate-location: func(location: string, event: option<event>) -> result<data-value, component-error>;
  /// Evaluates an attribute SCXML defines as a string (`eventexpr`,
  /// `targetexpr`, `typeexpr`, `delayexpr`, `sendidexpr`, `srcexpr`).
  /// ECMAScript returns `none` for a non-string value; `XPath` converts
  /// with `string()`.
  /// Errors: as `evaluate-value`.
  evaluate-text: func(expression: string, event: option<event>) -> result<option<string>, component-error>;
  /// Renders a `<log expr>` (SCXML 4.7) to its log text: ECMAScript's
  /// deterministic log rendering, `XPath` `string()`, or the null data
  /// model's literal text (empty for no value).
  /// Errors: as `evaluate-value`.
  evaluate-log: func(expression: string, event: option<event>) -> result<string, component-error>;
  /// Evaluates one `<param>` or `namelist` value of a send to an Event I/O
  /// Processor other than the SCXML one (SCXML 6.2, C.2): a `location`
  /// (when `location` is true) or a value expression. ECMAScript returns the
  /// portable value; `XPath` returns its string-value (a location must
  /// select nodes).
  /// Errors: as `evaluate-location`.
  evaluate-form-value: func(source: string, location: bool, event: option<event>) -> result<data-value, component-error>;
  /// Evaluates a `<foreach array>` expression to its item snapshot.
  /// Errors: as `evaluate-value`.
  foreach-items: func(expression: string, event: option<event>) -> result<foreach-result, component-error>;
  /// Every `<foreach>` in progress is over: the machine call that ran them
  /// returned, so each finished, or an error in its body ended it early
  /// (SCXML 4.6) and it never finishes. The data model forgets them, so no
  /// loop stays recorded for the rest of the session. Infallible; a data
  /// model that tracks no loop does nothing.
  release-foreach: func();
  /// The payload key of one `namelist` entry (the ECMAScript identifier, or
  /// the `XPath` `$name` variable name); `none` for an illegal entry
  /// (SCXML 6.2.4: `error.execution`). Pure: reads no state.
  namelist-key: func(location: string) -> option<string>;
  /// Builds `_event.data` from `<param>`/`namelist` entries (SCXML
  /// 6.2.4-6.2.5): an ECMAScript object, or `XPath` `<data id>` elements.
  /// `none` when a value cannot be carried (`error.execution`). Pure.
  event-payload: func(entries: list<named-value>) -> option<data-value>;
  /// Value of inline `<content>` or `<data>` children (SCXML 5.6, 6.2.6):
  /// markup is an XML value; ECMAScript reads normalized text as JSON when
  /// it parses, else as a string; `XPath` keeps text as a string. `none`
  /// when the data model has no value for it. Pure.
  inline-content: func(content: inline-body) -> option<data-value>;
  /// Value of an external `<data src>` document (SCXML 5.3) this data model
  /// decides itself (`XPath` markup as a node-set, else text; ECMAScript an
  /// XML document value); `none` leaves the caller's JSON-or-text rule.
  /// Pure.
  external-data: func(text: string) -> option<data-value>;
  /// The value an event's `data` carries under `name`: the entry a sender
  /// built from a `<param>` or `namelist` item of that name (an ECMAScript
  /// object member, or the content of an `XPath` `<data id="name">`
  /// element); `none` when the data carries no such value. SCXML 6.5.2:
  /// an empty `<finalize>` updates each `namelist` or `<param location>`
  /// location "with any return value that has a name that matches". Pure.
  event-data-field: func(data: data-value, name: string) -> option<data-value>;
  /// Whether this data model can represent `data` as `_event.data`. SCXML
  /// C.1: "If the receiving Processor cannot handle the data format
  /// contained in the message, the receiving Processor MUST place the error
  /// error.communication in internal queue of the session for which the
  /// message was intended and MUST ignore the message." Pure.
  accepts-event-data: func(data: data-value) -> bool;
  /// Evaluates a boolean condition with `_event` bound to `event`. `none`
  /// means SCXML defines no current event (for example `<onentry>` and
  /// `<data>` evaluated by `start`, before the first event): `_event` is then
  /// unbound (SCXML 1.0 section 5.10) and providers MUST NOT fabricate one.
  /// Errors: `invalid-input` for malformed or over-bound expressions,
  /// `execution` for an evaluation error.
  evaluate-condition: func(expression: string, event: option<event>) -> result<bool, component-error>;
  /// Evaluates a value expression with `_event` bound to `event` (unbound
  /// when `none`, as for `evaluate-condition`).
  evaluate-value: func(expression: string, event: option<event>) -> result<data-value, component-error>;
  /// Assigns `source` to `location` with `placement` (see `assign-source`
  /// and `assign-placement`), with `_event` bound to `event` (unbound when
  /// `none`, as for `evaluate-condition`) while the location and an
  /// `expression` source are evaluated; evaluation and assignment are one
  /// transaction. Only a `foreach-value` source declares its variable.
  /// Errors: `invalid-input` for a malformed or undeclared
  /// location or an over-bound expression, value, or name, `execution` for
  /// an evaluation failure or a placement the data model does not define
  /// (the bundled ECMAScript and null providers define only
  /// `replace-children`).
  assign: func(location: string, source: assign-source, placement: assign-placement, event: option<event>, context: option<trace-context>) -> result<_, component-error>;
  /// Executes one script with `_event` bound to `event` (unbound when
  /// `none`, as for `evaluate-condition`).
  execute: func(script: string, event: option<event>) -> result<_, component-error>;
  /// Returns the bound system variables.
  system-context: func() -> result<system-values, component-error>;
  /// A value with no `data-value` form (an ECMAScript function, `Date`,
  /// cyclic object, `NaN`, ...): its type and its string form.
  record variable-text {
    /// The value's type in the provider's language (ECMAScript: its
    /// `typeof`, such as `function` or `object`).
    kind: string,
    /// The value's string form (ECMAScript: a function's source text, a
    /// `Date`'s `toString`, `[object Tag]` for any other object, a
    /// primitive's `ToString`).
    text: string,
  }
  /// One declared variable's value. A variable whose rendered text is
  /// longer than 65536 bytes is `oversized` instead, in every provider.
  variant variable-value {
    /// A portable value.
    value(data-value),
    /// A value with no portable form, by its type and string form.
    text(variable-text),
    /// A variable whose rendered text (the `data-value` text, the XPath
    /// element markup, or the string form) is longer than 65536 bytes:
    /// that text's exact length in bytes. The text is not carried and never
    /// truncated.
    oversized(u64),
  }
  /// One user variable of a data-model snapshot.
  record variable {
    /// The variable name.
    name: string,
    /// Its value.
    value: variable-value,
  }
  /// Read-only image of the data model (`docs/session-snapshot.md`,
  /// "Session object (keys in this order)").
  record data-model-snapshot {
    /// SCXML 5.10 system variables.
    system: system-values,
    /// Every declared `<data>` id in document order (ECMAScript: late-bound
    /// ids declared afterwards follow; XPath: datamodel document order) with
    /// its current value; each carried text at most 65536 bytes (a longer one is `oversized`).
    variables: list<variable>,
  }
  /// Read-only dump of the data model for introspection. Evaluates
  /// nothing, calls no host capability, reports no telemetry observation,
  /// and changes no state; runs on its own per-call fuel. The null provider
  /// returns its system values and no variables.
  /// Errors: `unavailable` before `initialize`.
  snapshot: func() -> result<data-model-snapshot, component-error>;
}

/// SCXML Event I/O Processor (SCXML 1.0 appendix C.1).
///
/// Delayed sends are scheduled on the imported project clock, which owns
/// logical time. Delivery is at most once: `drain-due` removes due items from
/// the clock before decoding them, so a delivered or rejected item is never
/// returned again. The processor also holds a delayed `BasicHTTP` send
/// (SCXML C.2) on the same clock until its delay elapses (SCXML 6.2: "It
/// MUST dispatch the message only when the delay interval elapses."), so
/// one clock orders, cancels (SCXML 6.3), and discards (SCXML 6.2) every
/// delayed send of a session; the host dispatches a due `BasicHTTP` send
/// through the `BasicHTTP` processor.
interface io-processor-api {
  use types.{event, send-request, processor-send, component-error, trace-context, send-target, sender, routed-event};

  /// One delayed send held on the clock, by the Event I/O Processor that
  /// dispatches it when its delay elapses.
  variant delayed-send {
    /// A send of this processor, routed by `route-due`.
    scxml(send-request),
    /// A send of another Event I/O Processor, which the host dispatches
    /// through the processor its `processor-type` names.
    processor(processor-send),
  }

  /// What the host must do with one accepted immediate or delayed send.
  variant dispatch-decision {
    /// The request was scheduled on the clock under its send id.
    scheduled,
    /// Deliver the stamped event to the sender's own external queue.
    local(event),
    /// Deliver the stamped event to the sender's invoking parent.
    parent(event),
    /// Deliver the stamped event to one live invocation of the sender.
    invocation(routed-event),
    /// Deliver the stamped event to another session of the sender's run,
    /// by `_sessionid` (`send-target.session`).
    session(tuple<string, event>),
  }

  /// Where one due delayed send is delivered, decided at delivery time.
  variant due-route {
    /// The sender's own external queue.
    local(event),
    /// The sender's invoking parent.
    parent(event),
    /// One live invocation of the sender.
    invocation(routed-event),
    /// Another session of the sender's run, by `_sessionid`
    /// (`send-target.session`); the host refuses one that no longer runs as
    /// undeliverable.
    session(tuple<string, event>),
    /// Nobody answers the target any more (for example an invoked session
    /// that finished), so the message cannot be dispatched: the host calls
    /// the sender's `session.communication-error` with the failed send's id
    /// (SCXML 6.2, 6.2.4, C.1, 5.10.1). A sender that terminated has no due
    /// sends (6.2).
    undeliverable(option<string>),
  }

  /// Why one due item could not be delivered.
  enum due-rejection {
    /// The clock returned bytes that are not a canonical send request.
    invalid-payload,
    /// The decoded request's send id differs from the clock timer id.
    identity-mismatch,
  }

  /// One due item that could not be delivered, identified by its timer id.
  record rejected-due {
    /// Clock timer id, which equals the original send id.
    send-id: string,
    /// Closed rejection reason.
    reason: due-rejection,
  }

  /// Result of one `drain-due` call. Every item removed from the clock
  /// appears in exactly one list; both lists keep clock order (deadline,
  /// then schedule order).
  record due-batch {
    /// Valid sends to dispatch.
    delivered: list<delayed-send>,
    /// Items that were removed from the clock but could not be delivered.
    rejected: list<rejected-due>,
  }

  /// Returns `http://www.w3.org/TR/scxml/#SCXMLEventProcessor`.
  type-uri: func() -> string;
  /// Short aliases documents may use for this processor's type, in
  /// `_ioprocessors` order (bundled provider: `["scxml"]`). Pure.
  aliases: func() -> list<string>;
  /// This processor's location for session `session-id`
  /// (`#_scxml_<session-id>`, SCXML C.1), the `_ioprocessors` location and
  /// the `origin` stamped on sent events. Pure.
  session-location: func(session-id: string) -> string;
  /// Classifies one `<send>` target for `sender` (SCXML 6.2, C.1). Pure and
  /// total; emits no telemetry.
  classify-target: func(target: option<string>, sender: sender) -> send-target;
  /// Validates one request from `sender`, stamps the event's `origin`
  /// (`session-location`), `origin-type` (the type URI), and `raw` (from
  /// `message`), and either schedules it on the clock under its send id
  /// (`delay-ms` non-zero) or classifies its target and returns the
  /// delivery the host executes. The host never classifies itself.
  ///
  /// Preconditions: `processor-type` is absent, an alias, or the type URI;
  /// `event.send-id` is absent or equals `send-id`; a delayed request carries a send id.
  /// Errors: `protocol` for another processor type; `invalid-input` for
  /// malformed input, a missing delayed send id, a bad trace
  /// carrier, or an `internal` or `invalid` target (classified before the
  /// delay is applied);
  /// `payload-too-large` (including the raw message bound and a stamped
  /// event over the `event` bounds); `duplicate-id` for a
  /// live send id; `unavailable` for an `unreachable` target (the host answers the
  /// machine `undeliverable`). Nothing is scheduled on failure.
  dispatch: func(request: send-request, sender: sender) -> result<dispatch-decision, component-error>;
  /// Routes one delayed request returned by `drain-due` for `sender`, at
  /// delivery time: the target is classified again, so an invoked session
  /// that finished or was cancelled since scheduling yields
  /// `undeliverable`. Pure and total.
  route-due: func(request: send-request, sender: sender) -> due-route;
  /// Schedules one delayed send of another Event I/O Processor on the
  /// clock under its `send-id` for `delay-ms` (SCXML 6.2). The host first
  /// has that processor check it, so every failure the processor reports
  /// before it would send is reported at the `<send>`; the send is
  /// dispatched only when it falls due (`drain-due`).
  ///
  /// Preconditions: `delay-ms` > 0.
  /// Errors: `invalid-input` for a zero delay, a malformed field, or a bad
  /// trace carrier; `payload-too-large` for a field wider than the encoding;
  /// `duplicate-id` for a live send id. Nothing is scheduled on failure.
  schedule-processor: func(request: processor-send) -> result<_, component-error>;
  /// Cancels a pending delayed send (of either processor); an absent id
  /// succeeds without effect.
  /// Errors: `invalid-input` for a malformed (empty) id or a bad trace
  /// carrier.
  cancel: func(send-id: string, context: option<trace-context>) -> result<_, component-error>;
  /// Removes at most `max-items` due sends (of either processor) from the
  /// clock and decodes them per item. One undeliverable item never prevents
  /// delivery of the others.
  ///
  /// Preconditions: 1 <= `max-items` <= 1024.
  /// Errors: `protocol` for an out-of-range limit; the clock is unchanged.
  drain-due: func(max-items: u32) -> result<due-batch, component-error>;
  /// One pending delayed send (a cancelable).
  record pending-send {
    /// The send as scheduled.
    request: delayed-send,
    /// Absolute deadline on the virtual clock, in milliseconds.
    deadline-ms: u64,
  }
  /// Pending delayed sends in clock order (deadline, then schedule order),
  /// decoded from the imported clock's read-only `snapshot` (delayed-send
  /// wire v8). Read-only: removes, schedules, and cancels nothing, reports
  /// no telemetry observation, and changes no state.
  /// Errors: `protocol` when a clock timer does not decode as this
  /// processor's delayed send or its id differs from the send id (a broken
  /// invariant of the clock or the processor; the call takes no input).
  snapshot: func() -> result<list<pending-send>, component-error>;
}

/// One invoked service (SCXML 6.4): an external service an `<invoke>`
/// whose type is neither absent nor the SCXML processor type starts.
///
/// The host instantiates the component once per invocation, in a store of
/// its own, and calls `invoke` once as a subtask of the invoking session.
/// Bounds (bundled hosts): each event within the `types.event` bounds; at
/// most the host's per-input fuel between two inputs it delivers (the start,
/// an event, a due timer, or an HTTP response).
interface invoked-service-api {
  use types.{invoke-request, event, data-value, component-error};
  /// Runs the service for one invocation.
  ///
  /// `events` carries every event the invoking session sends to
  /// `#_<invoke-id>` (`<send target="#_invokeid">`) and every event it
  /// autoforwards (`<invoke autoforward="true">`), in order.
  ///
  /// `ok` returns the stream of the events the service returns to the
  /// invoking session, which receives each on its external queue stamped
  /// with the invoke id (the host sets `invoke-id`, sets `origin-type` to
  /// the invoke type, and sets the event type to `external`; the event runs
  /// the invocation's `<finalize>` first), and a future that resolves when
  /// the service is done: `ok` becomes `done.invoke.<invoke-id>` carrying
  /// its data, after every event returned before it; `err`, a trap
  /// (including fuel exhaustion), or an event outside the `types.event`
  /// bounds becomes the invocation's `communication-error` message
  /// (`error.communication.<invoke-id>`, and no `done.invoke`).
  ///
  /// When the invoking state exits first (or the invoking session ends),
  /// the host cancels the subtask and drops the store: nothing the service
  /// returns afterwards reaches the session and no `done.invoke` follows
  /// (SCXML 6.4).
  ///
  /// Errors: any error rejects the start (the invoking session raises
  /// `error.execution`).
  invoke: async func(request: invoke-request, events: stream<event>) -> result<tuple<stream<event>, future<result<option<data-value>, component-error>>>, component-error>;
}

/// One Event I/O Processor other than the SCXML one (SCXML 6.2): the
/// component a processor package binds to its type URI, which carries the
/// `<send>`s of that type to the outside world and turns what comes back
/// into external events.
///
/// The host instantiates the component once per session, in a store of
/// its own, on that session's first `<send>` of its type, and calls `open`
/// once as a subtask of the session. Then, for every `<send>` of its type,
/// the host calls `send` (or `check` when the send is delayed, and `send`
/// when it falls due) as another subtask, and waits until the instance has
/// nothing left to run before the session goes on. Every event the instance
/// returns on `open`'s stream joins the session's external queue (the host
/// sets the event type to `external` and `origin-type` to the processor's
/// type URI; the processor sets `origin`, SCXML 5.10.1). When the session
/// ends the host cancels every subtask and drops the store, which closes
/// the instance's connections.
///
/// Bounds (bundled hosts): each event within the `types.event` bounds; at
/// most the host's per-input fuel between two inputs it delivers (a send,
/// a due timer, an HTTP response, or a WebSocket message).
interface event-processor-api {
  use types.{processor-send, event, component-error, trace-context};
  /// What one instance is opened with.
  record processor-start {
    /// The processor's type URI, as its package binds it.
    type-uri: string,
    /// The `_sessionid` of the session the instance serves.
    session-id: string,
    /// Optional trace carrier; never changes semantics.
    trace-context: option<trace-context>,
  }
  /// Opens the instance for its session.
  ///
  /// `ok` returns the stream of the events the instance delivers to the
  /// session, and a future that resolves when the instance can send no
  /// more: from then on every `send` of its type raises
  /// `error.communication` in the session, and `some` error raises one
  /// `error.communication` without a send id when it resolves.
  /// Errors: any error, or a trap, rejects the first `<send>` (the session
  /// raises `error.communication` with its send id), and every later one.
  open: async func(start: processor-start) -> result<tuple<stream<event>, future<option<component-error>>>, component-error>;
  /// Checks one send exactly as `send` would before sending it, without
  /// sending it: the host checks a delayed `<send>` when it is evaluated
  /// (SCXML 6.2) and sends it when it falls due.
  /// Errors: as `send`'s validation errors.
  check: async func(request: processor-send) -> result<_, component-error>;
  /// Sends one `<send>` of the processor's type (`request.processor-type`
  /// is the type URI or one of its aliases; `delay-ms` is 0).
  ///
  /// A call that resolves before the instance is idle decides the `<send>`:
  /// `ok` accepts it; `invalid-input` and `payload-too-large` raise
  /// `error.execution`, and `unavailable` raises `error.communication`
  /// (SCXML 6.2, 5.10.1). A call still pending then accepts the `<send>`,
  /// and an error it resolves with later raises `error.communication` with
  /// its send id.
  send: async func(request: processor-send) -> result<_, component-error>;
}

/// Executable behavior for one extension namespace.
///
/// Lifecycle: `initialize` once, then any number of `execute` calls, then
/// `shutdown`. Calls after `shutdown` fail with `protocol`. A host instantiates
/// an extension component once per session (every invoked session gets
/// its own instance), calls `initialize` when the session is constructed and
/// `shutdown` when it ends for any reason, so extension component state never
/// outlives or crosses a session. An extension component's imported
/// `data-model-host` and `execution-host` act on the executing session.
///
/// An extension element is executable content: it runs synchronously inside
/// a microstep, so its component does no I/O (no network, no WASI) and
/// receives no `env` slot values or references. Work that waits on the
/// outside world belongs in an invoked service (SCXML 6.4).
interface executable-content-extension-api {
  use types.{executable-content-extension, extension-outcome, component-error, trace-context};
  /// Returns the exact namespace URI this extension component implements.
  namespace-uri: func() -> string;
  /// Prepares extension component state.
  initialize: func() -> result<_, component-error>;
  /// Executes one lowered executable-content extension whose namespace is
  /// `namespace-uri`. `not-handled` declines it (the machine raises SCXML
  /// `error.execution`).
  /// Errors: `invalid-input` for malformed elements or carriers, `execution`
  /// for a behavior failure (both raised as SCXML `error.execution`); any
  /// other code fails the session. A trap (including fuel exhaustion) is an
  /// `execution` failure and retires the instance: later `execute` calls in the
  /// session fail with `execution`.
  execute: func(element: executable-content-extension, context: option<trace-context>) -> result<extension-outcome, component-error>;
  /// Releases extension component state; idempotent.
  shutdown: func() -> result<_, component-error>;
}

/// Outbound HTTP a host may grant to invoked services (SCXML 6.4).
///
/// Deny by default: a host that grants nothing refuses every request with
/// `unavailable`. A granting host sends only to the targets its embedder
/// allowlists, follows no redirect (a redirect status is returned as the
/// response), and adds no ambient credentials, cookies, or proxy. `fetch`
/// and `send` are asynchronous: a call suspends only the calling task (the
/// invoking session and the service's other tasks go on). The granting host bounds
/// its connect and total time, and closes the connection of a request when
/// the invocation is cancelled. The URL, headers, and bodies are component
/// payload: hosts never put them into telemetry. The capability works only
/// while an invoked service's invocation runs (admitted to the origins its
/// service package declares); elsewhere every call fails with
/// `unavailable`.
interface outbound-http {
  use types.{component-error, value-reference};
  /// One part of a URL or header value: literal text, or a reference the
  /// host substitutes with the value it holds (`invoke-request.references`).
  variant text-part {
    literal(string),
    reference(value-reference),
  }
  /// One part of a request body: literal bytes, or a reference the host
  /// substitutes with the value's UTF-8 bytes.
  variant body-part {
    bytes(list<u8>),
    reference(value-reference),
  }
  /// One header field. Bounds: `name` 1..=256 bytes of RFC 9110 token
  /// characters, never `host`, `content-length`, `transfer-encoding`, or
  /// `connection` (ASCII case-insensitively); `value`, once substituted, at
  /// most 8192 bytes with no CR, LF, or NUL.
  record http-header {
    name: string,
    value: list<text-part>,
  }
  /// One request. Bounds: `method` is exactly `GET` or `POST`; `url`, once
  /// substituted, is an absolute `http` or `https` URL without userinfo, at
  /// most 16384 bytes; at most 64 headers; `body`, once substituted, at most
  /// 4194304 bytes (empty for `GET`); at most 64 parts in `url`, in each
  /// header value, and in `body`.
  ///
  /// The host substitutes every reference, then canonicalizes the URL and
  /// admits the request only to an origin or URL prefix the service's package
  /// declares, or to the origin a reference's value supplies entirely (the
  /// first part is a reference whose value is an absolute `http` or `https`
  /// URL without userinfo, and the next part, if any, starts the path,
  /// query, or fragment). A reference the call did not receive is
  /// `invalid-input`.
  record http-request {
    method: string,
    url: list<text-part>,
    headers: list<http-header>,
    body: list<body-part>,
  }
  /// One response: its final status (100..=599; a 3xx is returned, never
  /// followed) and its body, at most 16777216 bytes.
  record http-response {
    status: u16,
    body: list<u8>,
  }
  /// Performs one request.
  /// Errors: `invalid-input` for a request outside the bounds above or an
  /// unknown reference; `unavailable` when the host offers no outbound HTTP,
  /// the URL is not admitted, the transport failed (connect, TLS, timeout),
  /// or the call is made outside an invocation;
  /// `payload-too-large` when the response body exceeds its bound.
  fetch: async func(request: http-request) -> result<http-response, component-error>;
  /// Performs one request and streams its response, as `wasi:http`'s
  /// `client.send` does: `ok` once the final status (100..=599) has arrived,
  /// with the body as the host receives it and a future that resolves when
  /// the body has ended: `ok` after its last byte, `err` with `unavailable`
  /// when the transport failed or `payload-too-large` when the body passed
  /// its bound (16777216 bytes in all, as `fetch`'s). The body's parts reach
  /// the service as inputs of its invocation, in order, each at the session's
  /// logical time it arrived (a live session records each one), so a
  /// service can report progress while a long response is still arriving.
  /// The request is admitted and bounded exactly as `fetch`'s, it counts
  /// against the requests in flight until its body has ended, and the call's
  /// own errors are `fetch`'s. A body the service stops reading is still
  /// received, within its bound, until it ends or the invocation is
  /// cancelled.
  send: async func(request: http-request) -> result<tuple<u16, stream<u8>, future<result<_, component-error>>>, component-error>;
}

/// Outbound WebSocket connections (RFC 6455) a host may grant to Event I/O
/// Processor and invoked-service components.
///
/// Deny by default, as `outbound-http`: a host that grants nothing refuses
/// every connection with `unavailable`. A granting host connects only to the
/// `ws` and `wss` origins its embedder allowlists and the component's
/// package declares, follows no redirect, and adds no ambient credentials,
/// cookies, or proxy. A header or URL part may be an `env` reference, as in
/// `outbound-http`, so a service sends a credential it never sees. The host
/// owns the socket and TLS: the component only exchanges messages.
/// `connect` suspends only the calling task. The host bounds the time to
/// connect, and closes every connection of an instance when the instance
/// ends (its session ends, or its invocation is cancelled). The URL,
/// headers, and messages are component payload: hosts never put them into
/// telemetry. The capability works only while an Event I/O Processor
/// instance or an invocation runs; elsewhere every call fails with
/// `unavailable`.
interface outbound-websocket {
  use types.{component-error};
  use outbound-http.{text-part};
  /// One WebSocket message: a text frame (UTF-8) or a binary frame. Bound:
  /// at most 1048576 bytes.
  variant message {
    /// A text message.
    text(string),
    /// A binary message.
    binary(list<u8>),
  }
  /// One handshake header field. Bounds as `outbound-http.http-header`;
  /// never `host`, `connection`, `upgrade`, or a `sec-websocket-*` field.
  record websocket-header {
    name: string,
    value: list<text-part>,
  }
  /// One connection request. `url` begins with a literal `ws://` or
  /// `wss://`, or with a reference whose value is a `ws`, `wss`, `http`, or
  /// `https` URL, which supplies the origin as for a request (an `http`
  /// value names the `ws` URL of the same form). Bounds: `url`, once
  /// substituted, is an absolute URL without userinfo or fragment, at most
  /// 16384 bytes; at most 64 headers; at most 16 `protocols`, each an RFC
  /// 9110 token of at most 256 bytes.
  record websocket-request {
    url: list<text-part>,
    headers: list<websocket-header>,
    /// Subprotocols offered (`Sec-WebSocket-Protocol`), in preference order.
    protocols: list<string>,
  }
  /// How the peer closed the connection: its close code and reason (at
  /// most 123 bytes).
  record close-frame {
    code: u16,
    reason: string,
  }
  /// Opens one connection and exchanges messages over it.
  ///
  /// `outgoing` carries the messages to send, in order; when the component
  /// ends it, the host closes the connection with code 1000. `ok` once the
  /// opening handshake has completed: the subprotocol the server selected,
  /// the messages the peer sends, in order, and a future that resolves when
  /// the connection has closed: `ok(some(frame))` for the peer's close
  /// frame (its answer, after the component's own close), `ok(none)` when
  /// it closed without one, `err` with
  /// `unavailable` when the connection was lost or `payload-too-large`
  /// when a message passed its bound. Each message reaches the component as
  /// an input of its instance, at the session's logical time it arrived (a
  /// live session records each one).
  /// Errors: `invalid-input` for a request outside the bounds above;
  /// `unavailable` when the host offers no outbound WebSocket, the URL is
  /// not admitted, or the handshake failed (connect, TLS, status, timeout);
  /// `capacity-exhausted` past 16 connections of one instance.
  connect: async func(request: websocket-request, outgoing: stream<message>) -> result<tuple<option<string>, stream<message>, future<result<option<close-frame>, component-error>>>, component-error>;
}

/// Resolves repository packages for the CLI: an extension namespace URI or
/// an invoked-service type URI that names a package in a repository, at a
/// release (the `@<tag>` a document pinned, split off when it was parsed)
/// or at the repository's latest release.
///
/// A resolver never decides trust. It reports which release a URI resolves
/// to and fetches that release's files; the host verifies every byte it
/// returns (the manifest's exact URI and WIT identity, the schema against
/// the manifest's digest and its `targetNamespace`, the component against
/// the release's `SHA256SUMS`), and owns the content-addressed cache, the
/// pin of each URI to its first resolution, `--offline`, and resolving each
/// URI once per root session. A resolver reaches the network only through
/// its `wasi:http` import, which the host admits only to the origins it
/// grants, and receives no credential: a host that holds one adds it to the
/// requests it admits.
///
/// `configuration` is the host's, as name and value pairs; a resolver
/// refuses a missing, repeated, or unknown name with `invalid-input`. The
/// GitHub resolver reads `github-api-base`, `github-raw-base`, and
/// `github-download-base` (the CLI's `--github-*-base` flags, or GitHub's
/// own origins), each an absolute URL without userinfo, query, or fragment.
///
/// Both functions return `none` for a URI this resolver does not serve, as
/// an `ExtensionResolver` does; the host then treats it as an ordinary URI.
/// Errors carry a `detail` the host shows: `invalid-input` for a malformed
/// argument or configuration, `unavailable` for a request the host refused,
/// a transport failure, a non-success status, or a redirect beyond its
/// bound, and `payload-too-large` for a body over `limit`.
interface resolver-api {
  use types.{component-error};
  /// A release of a package's repository: its tag and the 40-character
  /// lowercase hexadecimal commit the tag names.
  record release {
    tag: string,
    commit: string,
  }
  /// One file of a release.
  variant artifact {
    /// The package manifest, at the release's commit.
    manifest,
    /// A file of the package at the release's commit, by its path relative
    /// to the manifest (the manifest's `schema-artifact`).
    schema(string),
    /// A release asset by name (the manifest's `extension-artifact` or
    /// `service-artifact`).
    component(string),
    /// The release's `SHA256SUMS` asset.
    sha256sums,
  }
  /// The release `uri` (a tagless package URI) resolves to: the release
  /// `tag` names, or, without one, the repository's latest release.
  resolve: async func(configuration: list<tuple<string, string>>, uri: string, tag: option<string>) -> result<option<release>, component-error>;
  /// The exact bytes of `artifact` of `uri` at `release`, at most `limit`
  /// bytes (at most 2147483647).
  fetch: async func(configuration: list<tuple<string, string>>, uri: string, release: release, artifact: artifact, limit: u64) -> result<option<list<u8>>, component-error>;
}

/// Read-only snapshot of the executing session, offered to extension components
/// (`docs/session-snapshot.md`, "Snapshots during executable content").
///
/// It is introspection only: nothing restores, resumes, or changes a session
/// from it, and SCXML documents never see it. An extension component that
/// imports this interface makes the machine compute its executable-content
/// image for every element of the extension component's namespace
/// (`machine-capabilities. extension-snapshot-request`); an extension component
/// that does not import it costs nothing. Like `execution-host`, it works only
/// during `execute`.
interface session-snapshot-host {
  use types.{component-error};
  /// A section of the document a call can omit (the
  /// `session-snapshot-api.section` sections an executable-content snapshot
  /// holds; `previews` and `invocations` are always omitted there).
  enum section {
    /// SCXML 5.10 system variables.
    system,
    /// User data-model variables.
    data-model,
    /// The Appendix D internal and external event queues.
    queues,
    /// Pending delayed sends.
    pending-sends,
    /// Transitions an event could trigger.
    transitions,
  }
  /// The canonical `scxml.session-snapshot/v2` document (compact JSON text) of
  /// the executing session as it stands at this call: one session object (no
  /// invoked sessions), `previews` and `invocations` excluded besides `exclude`,
  /// trace carriers stripped. The machine part is the executable-content image
  /// `execute-extension` carried; the data model, pending sends, and clock are
  /// read at this call, so they include what the extension component changed so
  /// far; `queues` also lists the events this `execute` call queued so far,
  /// after the session's own. Errors: `unavailable` outside `execute`
  /// (including `initialize` and `shutdown`) or when the executing host or
  /// machine supplied no executable-content image; `capacity-exhausted` for a
  /// call after the 64th of one `execute` call; `payload-too-large` for a
  /// document over a bound of the format (a string or integer bound); `execution`
  /// when a component's read-only `snapshot` export failed; `platform` when the
  /// host failed.
  ///
  /// `target`, when given, names another session of the executing session's
  /// run as a `<send>` target does (`#_parent`, `#_<invokeid>` of a live
  /// invoked session, or `#_scxml_<sessionid>` of any running session of the
  /// run), and the result is that session's canonical document at its last
  /// checkpoint (`options.point` `checkpoint`; every other session of the run
  /// is between machine calls while this one executes), with its external
  /// queue, `previews` and `invocations` excluded besides `exclude`, trace
  /// carriers stripped; a target naming the executing session is the
  /// executable-content image above. The read changes nothing in the target
  /// session. Errors besides the above: `unavailable` for a malformed target,
  /// one no running session of the run answers (including an invoked service,
  /// or a finished, `failed`, or `shut-down` session).
  snapshot: func(exclude: list<section>, target: option<string>) -> result<string, component-error>;
}

/// Supplier of one machine's immutable lowered Machine IR.
///
/// The generic machine component imports this interface and calls it once
/// per session construction. Two providers exist:
///
/// * runtime mode: the host implements it and returns IR bytes produced by
///   the compiler at run time (the only mode used by browser hosts);
/// * packaged mode: the compiler's packager emits a data-only component that
///   exports it with the IR bytes in one active data segment of a
///   non-growable memory, and composes it with the pinned generic machine,
///   so the packaged component no longer imports this interface (packaging
///   is for non-browser ahead-of-time hosts only).
interface ir-source {
  /// Returns the canonical Machine IR bytes (the compiler's `lowered-ir`
  /// artifact: UTF-8 JSON, deterministic portable data, not WebAssembly).
  ///
  /// The provider returns identical bytes on every call; it performs no I/O
  /// after construction and has no failure mode. The consuming machine
  /// treats the bytes as untrusted: it rejects more than 16777216 bytes with
  /// `payload-too-large`, a version other than the machine's Machine IR
  /// version with `unsupported-version`, malformed or structurally or
  /// semantically invalid IR with `invalid-input`, and valid IR that uses
  /// semantics outside the engine's supported slice with `unavailable`;
  /// each rejection yields a `failed` session (see `machine-api`).
  machine-ir: func() -> list<u8>;
}

/// Entry point of a Wasm script component (SCXML 1.0 section 5.8
/// `<script src="...wasm">`).
///
/// A script component implements the `script` world: it imports only
/// `types`, `telemetry`, and `data-model-host` (the host links the latter to
/// the session's active data model), and exports only this interface. It
/// owns no durable state: the host instantiates it fresh for every run, so
/// every effect it has goes through `data-model-host`.
interface script-api {
  use types.{event, component-error};
  /// Runs the script once with `_event` bound to `event` (absent before the
  /// first event, for example in root scripts).
  /// Errors: `invalid-input` or `execution` for a script failure, which the
  /// machine raises as SCXML `error.execution`; a failed run may already
  /// have applied data-model assignments, exactly like an inline script
  /// that fails part-way.
  run: func(event: option<event>) -> result<_, component-error>;
}

/// Runtime script resolution capability supplied to a host by its embedder
/// (for example a browser page or an agent runtime that authors SCXML
/// dynamically). This is the loader contract `load-script` uses for
/// unpinned references; the host authenticates everything it returns.
interface script-loader {
  use types.{component-error};
  /// Bytes and media type fetched for one `src` URI.
  record loaded-script {
    /// Media type of `bytes`, for example `application/wasm`.
    media-type: string,
    /// Exact fetched bytes (bundled Wasmtime host: at most 4194304 bytes).
    bytes: list<u8>,
  }
  /// Resolves one `src` URI exactly as authored.
  /// Errors: `unknown-id` when the URI is not available, `unavailable` when
  /// the embedder refuses it, `platform` for a fetch failure; each rejects
  /// the document at load. `load-script` reports `unknown-id` and
  /// `unavailable` as `unavailable`, and `platform` as `platform`.
  resolve: func(uri: string) -> result<loaded-script, component-error>;
}

/// Script components the packager bundled into a packaged machine for
/// ahead-of-time hosts. The packaged component exports this interface only
/// when its Machine IR pins at least one Wasm script component; hosts read
/// the bundle once and serve pinned references from it after checking each
/// entry's SHA-256 against the pin.
interface script-bundle {
  /// Every bundled script as `(uri, media-type, bytes)`, strictly sorted by
  /// `uri` (so URIs are unique). The provider returns identical data on
  /// every call and performs no I/O; the call itself cannot fail.
  /// Bounds: at most 64 entries; each `uri` a valid script URI of at most
  /// 16384 bytes; each entry within the `load-script` byte bounds.
  /// Consumers validate the bundle before use: the bundled Wasmtime host
  /// rejects the whole packaged machine (no session is created) when the
  /// bundle has more than 64 entries, an invalid URI, or URIs that are not
  /// strictly sorted; per-entry digest, media-type, and size checks happen
  /// at `load-script`.
  scripts: func() -> list<tuple<string, string, list<u8>>>;
}

/// One compiled SCXML machine: the generic engine plus immutable tables.
///
/// ## Session lifecycle and failure contract
///
/// ```text
/// ready --start|start-invoked--> running --(final state)--> finished
///   |                 |                          |
///   +--(failure)------+----> failed <------------+
///   any state --shutdown--> shut-down
/// ```
///
/// * Rejections leave the session unchanged: a `send` event that fails input
///   validation, `start` or `start-invoked` on a session that is not
///   `ready`, and `send`, `deliver-from-invocation`, `resume`, or `cancel`
///   on a session that is `ready` or `finished` fail with
///   `invalid-input` or `protocol`, `committed-effects` 0, and
///   `session-failed` false.
/// * Failures are terminal: an engine error after the lifecycle checks, a
///   capability failure while installing a configuration, a non-recoverable
///   effect failure, or an effect-protocol violation moves the session to
///   `failed`. The failing call returns the cause with `session-failed` true.
///   Effects already applied through `machine-capabilities` during that call
///   stay committed (the machine cannot roll back host effects);
///   `committed-effects` counts them so the host can reconcile.
/// * Recoverable execution errors are not failures: when an effect's
///   capability returns `invalid-input` or `execution`, the engine aborts
///   exactly that executable-content block (one `<onentry>`, `<onexit>`, or
///   transition body), queues `error.execution` (SCXML 3.4/5.7/5.10), and
///   keeps executing later blocks of the same engine command; the call succeeds and
///   `call-result.effect-count` counts the effects that ran.
/// * Every other effect capability error, including `unavailable` from a
///   capability the host does not provide, is a terminal failure.
/// * A session constructed with an invalid `session-id` (empty, not a valid
///   SCXML name) starts in `failed` with
///   `invalid-input`. Otherwise construction calls `ir-source.machine-ir`
///   once; IR that fails the bounds, version, structural, or semantic checks
///   documented on `ir-source` starts the session in `failed` with the
///   documented code. Valid IR then has the host load every external
///   `<script src>` through `machine-capabilities.load-script`; the first
///   load error starts the session in `failed` with that cause (SCXML 1.0
///   section 5.8: the document is rejected). `failure` reports why.
/// * On a `failed` session, `start`, `start-invoked`, `send`,
///   `deliver-from-invocation`, `resume`, `cancel`, and `snapshot` fail with
///   `protocol`; `configuration` is empty; `failure` returns the original
///   cause; `shutdown` succeeds.
/// * On a `shut-down` session every call except `status`, `failure`,
///   `configuration`, and `shutdown` fails with `protocol`; `configuration`
///   is empty and `shutdown` is idempotent.
interface machine-api {
  use types.{event, component-error, data-value, named-value, trace-context};
  use machine-capability-types.{machine-capabilities, status, history-value, invoked-by, invocation-snapshot, transition-type, transition-snapshot, machine-snapshot};

  /// Context of a session started as an invoked child (SCXML 6.4).
  record invocation-context {
    /// `_sessionid` of the invoking parent session.
    parent-session-id: string,
    /// Invoke id the parent assigned to this child.
    invoke-id: string,
    /// `<param>` and `namelist` entries. Each one whose name matches a
    /// top-level `<data>` of this session is that declaration's initial
    /// value, set through `machine-capabilities.set-parameter` in its place
    /// during data binding; the rest are not added (SCXML 6.4.3).
    parameters: list<named-value>,
    /// The invoking batch's carrier (`invoked-session.trace-context`):
    /// every effect batch of this `start-invoked` call without a trigger
    /// carrier is parented to it instead of the host's context. Validated
    /// like every carrier; never changes semantics.
    trace-context: option<trace-context>,
  }

  /// A child's completion, for `done.invoke.<invoke-id>` (SCXML 6.4, 6.5).
  record invocation-done {
    /// The child's `<donedata>` value, if any.
    data: option<data-value>,
    /// The child's `call-result.done-trace-context`: the carrier the
    /// `done.invoke` event carries. Never changes semantics.
    trace-context: option<trace-context>,
  }

  /// One message an invoking session receives from one of its
  /// invocations.
  variant invocation-message {
    /// An event the child sent to `#_parent`, or an event an invoked
    /// service returned.
    event(event),
    /// The child reached a top-level final state, or the invoked service's
    /// future resolved `ok`.
    done(invocation-done),
    /// The invoked service failed after it started (its future resolved
    /// `err`, it trapped, or it returned an invalid event): the session
    /// raises `error.communication` carrying the invoke id on its internal
    /// queue (SCXML 5.10.1), and receives no `done.invoke` for it.
    communication-error,
  }

  /// Failure of one `start`, `start-invoked`, `send`,
  /// `deliver-from-invocation`, `resume`, or `cancel` call.
  record session-failure {
    /// Closed cause.
    error: component-error,
    /// Effects applied through `machine-capabilities` during this call before
    /// it failed. They are committed and are not rolled back.
    committed-effects: u32,
    /// True exactly when the session status is `failed` after this call.
    session-failed: bool,
  }

  /// What `session.snapshot` computes beyond the configuration.
  record snapshot-options {
    /// List the triggerable transitions.
    transitions: bool,
    /// Fill each listed transition's `exit` and `entry`.
    previews: bool,
  }
  /// Result of one successful `start`, `start-invoked`, `send`,
  /// `deliver-from-invocation`, `resume`, `cancel`, `communication-error`,
  /// or `invocation-completed` call.
  record call-result {
    /// Status after the call.
    status: status,
    /// Active leaf states in document order after the call.
    active-configuration: list<string>,
    /// Effects applied through `machine-capabilities` by this call.
    effect-count: u32,
    /// True when the session is stable (no enabled eventless transition
    /// or internal event pending) or not `running`. False only when the call
    /// stopped at the engine's bound of 1024 engine commands per call; the
    /// session is consistent and `resume` continues it, and `send` is
    /// rejected with `protocol` until a `resume` reports a stable configuration.
    stable: bool,
    /// Present exactly when this call finished a session whose top-level
    /// final state has `<donedata>`: the evaluated payload (`undefined` when
    /// its evaluation failed). An invoking host puts it on
    /// `done.invoke.<id>` (SCXML 6.4); for a session nobody invoked the host
    /// returns it to the environment (SCXML 5.5).
    return-data: option<data-value>,
    /// Present when this call finished the session and its last effect
    /// batch has a carrier: that batch's carrier (see `trace-context`),
    /// which an invoking host passes on `invocation-done` so
    /// `done.invoke` names the operation that completed the child.
    done-trace-context: option<trace-context>,
    /// True when the call stopped right after a `start-invocation` or
    /// `cancel-invocation` the host answered `deferred`: `stable` is
    /// false, and only `invocation-completed` continues the session (every
    /// other command is rejected with `protocol`; `snapshot` with
    /// `not-stable`).
    suspended: bool,
  }

  /// One machine session. The session owns its engine and the
  /// `machine-capabilities` handle; dropping the resource releases both.
  resource session {
    /// Creates a session. Never fails; an invalid `session-id` or table
    /// load failure yields a `failed` session (see the interface docs).
    constructor(session-id: string, capabilities: machine-capabilities);
    /// Binds the document's data (early binding: every `<data>`; late
    /// binding: top-level `<data>`) through the data-model capabilities,
    /// then enters the initial configuration and runs to a stable configuration: every
    /// macrostep the start triggers completes inside this call, at most 1024
    /// engine commands (see `call-result.stable`). Precondition: status `ready`.
    start: func() -> result<call-result, session-failure>;
    /// `start` for a session invoked by another SCXML session (SCXML 6.4):
    /// data binding, where a parameter naming a top-level `<data>` is its
    /// initial value (`set-parameter`, SCXML 6.4.3), then the
    /// initial configuration. The session remembers `context` for
    /// `#_parent` routing and `return-data`. Precondition: status `ready`.
    start-invoked: func(context: invocation-context) -> result<call-result, session-failure>;
    /// Delivers one message from the invocation `invoke-id` and runs to
    /// a stable configuration: an `event` is stamped with `invoke-id`; `done(d)` becomes
    /// `done.invoke.<invoke-id>` carrying `d`. The engine runs that
    /// invocation's `<finalize>` first. `failed` instead places a platform
    /// `error.communication` carrying `invoke-id` on the internal queue and
    /// runs the macrostep that processes it (as `communication-error`; no
    /// `<finalize>` runs and no external event is dequeued). There is no liveness check: a
    /// message from an invocation already cancelled is still delivered
    /// (official case 236). A message whose data this session's data model
    /// cannot represent (`accepts-event-data`) is ignored and raises
    /// `error.communication` on the internal queue instead (SCXML C.1), as
    /// does such an SCXML Event I/O Processor message through `send`.
    /// Precondition: as `send`.
    deliver-from-invocation: func(invoke-id: string, message: invocation-message) -> result<call-result, session-failure>;
    /// Exits the interpreter (W3C `exitInterpreter`): runs `<onexit>` of the
    /// active configuration and cancels its invocations, without
    /// `done.invoke` delivery. Precondition: status `running`.
    cancel: func() -> result<call-result, session-failure>;
    /// Processes one external event and runs to a stable configuration under the same
    /// bound. Precondition: status `running` and the previous call reported
    /// `stable` (otherwise a `protocol` rejection). The event enters the
    /// external queue as an Event I/O Processor delivers it (`event-type`
    /// `external`, SCXML 5.10.1, 6.4). It has no `invoke-id`
    /// unless this session was started by `start-invoked`, whose parent's
    /// `autoforward` sends exact copies of its own external-queue events
    /// (SCXML 6.4.1). A session receives its children's messages only
    /// through `deliver-from-invocation`, and the platform's errors only
    /// through `communication-error`.
    /// Errors: `invalid-input` for an `internal` or `platform` event type or
    /// a forbidden `invoke-id` (so no caller can run an invocation's
    /// `<finalize>`, present its own event as a child's, or raise an error
    /// through the external queue), and
    /// `invalid-input` or `payload-too-large` for an event outside the
    /// `types.event` bounds (each a rejection).
    send: func(event: event) -> result<call-result, session-failure>;
    /// Whether this session's document admits `event` from another
    /// session or the host: its data satisfies the literal `event:schema`
    /// of every transition of the document whose event descriptor matches
    /// the event's name (SCXML 3.12.1; namespaces/event, "At run time"). A
    /// host asks the receiving session before it routes a `<send>` to
    /// `#_parent` or `#_<invokeid>` (a refusal is the sender's
    /// `error.execution`) and before it delivers its own input (a refusal
    /// rejects the input). False for an event outside the `types.event`
    /// bounds. Pure: evaluates no expression, calls no capability, charges
    /// no command, emits no telemetry, and changes nothing; it answers in
    /// every status, and a session whose document never loaded admits
    /// every valid event.
    accepts-event-data: func(event: event) -> bool;
    /// Raises the `error.communication` of this session's `<send>` whose id
    /// is `send-id` (its `_event.sendid`; none only for a send that has no
    /// id), for a failure the platform learns of after that `<send>`
    /// completed: a delayed send whose target no longer answers when it
    /// falls due (SCXML 6.2, C.1), or a `BasicHTTP` request that fails after
    /// it was accepted (C.2). SCXML 3.12.2: errors are placed "in the
    /// internal event queue"; 6.2.4: "If it is unable to dispatch the
    /// message, the Processor MUST place the error error.communication on
    /// the internal event queue." The platform event joins the internal
    /// queue and the session runs to a stable configuration under the `resume` bound:
    /// on a session waiting on its external queue (Appendix D
    /// `mainEventLoop`) that is the macrostep that drains the internal
    /// queue, and no external event is dequeued; on a session whose last
    /// call stopped at the command bound the event waits behind the
    /// internal events already queued. Precondition: status `running`
    /// (stable or not).
    /// Errors: `invalid-input` for an invalid `send-id`.
    communication-error: func(send-id: option<string>) -> result<call-result, session-failure>;
    /// Continues a session whose previous call stopped at the command bound,
    /// running to a stable configuration under the same bound; on a stable session it
    /// applies no effects. Precondition: status `running`.
    resume: func() -> result<call-result, session-failure>;
    /// Continues a session whose previous call returned `suspended`: the
    /// deferred `start-invocation` or `cancel-invocation` request's result
    /// settles as that call's own result would have (SCXML 6.4: an
    /// `invalid-input` or `execution` start failure raises
    /// `error.execution`; any other error fails the session), then the
    /// suspended call's work goes on under its command bound, and the
    /// returned call-result is what that call would have returned (its
    /// `effect-count` counts this call's effects only). Precondition: the
    /// previous call returned `suspended` (otherwise a `protocol`
    /// rejection).
    invocation-completed: func(outcome: result<_, component-error>) -> result<call-result, session-failure>;
    /// Active leaf states in document order; empty unless the session is
    /// `ready`, `running`, or `finished`.
    configuration: func() -> list<string>;
    /// Current status; infallible.
    status: func() -> status;
    /// The cause of a `failed` session; none in every other status.
    failure: func() -> option<component-error>;
    /// Read-only image of the session. Applies no effects, evaluates no
    /// condition, calls no capability, charges no command, reports no
    /// telemetry observation, and changes nothing; runs on its own per-call
    /// fuel.
    /// Errors: `protocol` for `failed`/`shut-down` sessions and, with detail
    /// `not-stable`, when the last call did not report `stable`.
    snapshot: func(options: snapshot-options) -> result<machine-snapshot, component-error>;
    /// Releases the engine and moves to `shut-down`; idempotent, never fails.
    shutdown: func() -> result<_, component-error>;
  }
}

/// Encoder and differ of the canonical read-only session snapshot
/// document `scxml.session-snapshot/v2` (`docs/session-snapshot.md`,
/// "Document"), for hosts that do not link the `scxml-snapshot` crate natively. Pure and
/// capability-free: it reads nothing but its arguments.
interface session-snapshot-api {
  use types.{event, data-value, component-error};
  use machine-api.{machine-snapshot};
  use data-model-api.{data-model-snapshot};
  use io-processor-api.{pending-send};
  /// A session section `snapshot-options.exclude` can omit.
  enum section {
    /// SCXML 5.10 system variables.
    system,
    /// User data-model variables.
    data-model,
    /// The Appendix D internal and external event queues.
    queues,
    /// Pending delayed sends.
    pending-sends,
    /// Transitions an event could trigger.
    transitions,
    /// Transition `exit`/`entry` previews.
    previews,
    /// Invoked sessions, at any depth.
    invocations,
  }
  /// Whether W3C trace carriers are kept.
  enum trace-context-policy {
    /// Carriers appear as held.
    preserve,
    /// Carriers are omitted.
    strip,
  }
  /// Where in a run a document was taken (`options.point`).
  enum snapshot-point {
    /// At a stable checkpoint: the internal queue is empty.
    checkpoint,
    /// While one executable-content extension executes, for the extension
    /// component that asked (`session-snapshot-host.snapshot`): one session,
    /// mid-macrostep; `invocations` and `previews` are always excluded.
    executable-content,
  }
  /// How a document is produced.
  record snapshot-options {
    /// Excluded sections.
    exclude: list<section>,
    /// Trace-carrier policy.
    trace-context: trace-context-policy,
    /// Where the document is taken: a host that runs extension components
    /// encodes an `executable-content` document for
    /// `session-snapshot-host.snapshot`.
    point: snapshot-point,
  }
  /// Role of one component in the provenance list.
  enum component-role {
    /// The logical clock.
    clock,
    /// The ECMAScript data model.
    data-model-ecmascript,
    /// The null data model.
    data-model-null,
    /// The XPath data model.
    data-model-xpath,
    /// The SCXML Event I/O Processor.
    io-processor-scxml,
    /// The generic machine.
    machine,
  }
  /// Release-artifact identity of one component.
  record component-identity {
    /// Component role.
    role: component-role,
    /// SHA-256 of the released artifact, 64 lowercase hex.
    sha256: string,
  }
  /// Everything a host gathered for one session at a checkpoint.
  record session-capture {
    /// Index of the parent in `capture.sessions`; none for the root (index 0).
    parent: option<u32>,
    /// `_sessionid`.
    session-id: string,
    /// SHA-256 of the IR bytes the session loaded.
    ir-sha256: string,
    /// Linked data model name, if any.
    data-model-name: option<string>,
    /// The machine's read-only image.
    machine: machine-snapshot,
    /// The data model's read-only image, unless not gathered.
    data-model: option<data-model-snapshot>,
    /// Pending delayed sends, clock order.
    pending-sends: list<pending-send>,
    /// The session's external event queue, oldest first: events sent to
    /// it, including those from the sessions it invoked (stamped with
    /// their `invoke-id`) and their `done.invoke.<id>`.
    external: list<event>,
    /// Whether an invoked session reached a top-level final state (false
    /// for the root).
    finished: bool,
  }
  /// One checkpoint's capture of a root session and every session it invoked.
  record capture {
    /// Component provenance.
    components: list<component-identity>,
    /// Shared virtual clock position, in milliseconds.
    now-ms: u64,
    /// Pre-order: the root first, each session after the session that
    /// invoked it, at any nested invoke depth.
    sessions: list<session-capture>,
  }
  /// Canonical `scxml.session-snapshot/v2` document bytes.
  /// Errors: `invalid-input`, detail `snapshot-<code>`.
  encode: func(capture: capture, options: snapshot-options) -> result<list<u8>, component-error>;
  /// Canonical `scxml.session-snapshot-diff/v2` bytes of two valid documents.
  /// Errors: `invalid-input`, detail `snapshot-<code>`.
  diff: func(before: list<u8>, after: list<u8>, include-trace-context: bool) -> result<list<u8>, component-error>;
}

/// The optional session snapshot codec component (encode and diff only).
world session-snapshot {
  import telemetry;
  export session-snapshot-api;
}
/// A data-model provider component.
world data-model {
  import telemetry;
  import execution-host;
  export data-model-api;
}
/// The SCXML Event I/O Processor component; delayed sends use the project clock.
world io-processor {
  import telemetry;
  import stateforward:scxml-clock/clock-api@0.2.0;
  export io-processor-api;
}
/// An invoked-service provider component (SCXML 6.4). Its
/// `wasi:clocks/monotonic-clock` runs on the session's logical clock, so a
/// service's timers fall due in order with the session's delayed sends.
world invoked-service {
  import wasi:clocks/monotonic-clock@0.3.0;
  import outbound-http;
  import outbound-websocket;
  import telemetry;
  export invoked-service-api;
}
/// An Event I/O Processor component (SCXML 6.1): the host binds it to an
/// exact `<send type>` URI and opens one instance per session on that
/// session's first send of the type. It reaches the network only through
/// the requests and connections the host admits to its package's origins.
world event-processor {
  import outbound-http;
  import outbound-websocket;
  import telemetry;
  export event-processor-api;
}
/// An extension component. It imports only what it uses, and no I/O (see
/// `executable-content-extension-api`); importing `session-snapshot-host`
/// makes the machine compute its executable-content image for each of the
/// extension component's elements.
world executable-content-extension {
  import telemetry;
  import data-model-host;
  import execution-host;
  import session-snapshot-host;
  export executable-content-extension-api;
}
/// The generic machine component: the engine plus IR loaded through
/// `ir-source` at session construction.
world machine {
  import telemetry;
  import ir-source;
  export machine-api;
}
/// A data-only Machine IR provider emitted by the packager; it has no imports.
world machine-ir-provider {
  export ir-source;
}
/// A Wasm script component referenced by `<script src>`; see `script-api`.
world script {
  import telemetry;
  import data-model-host;
  export script-api;
}
/// A data-only script bundle emitted by the packager; it has no imports.
world script-bundle-provider {
  export script-bundle;
}
/// A repository package resolver component (`resolver-api`). Its only
/// capability is outbound HTTP through `wasi:http/client`, which the host
/// admits only to the origins it grants.
world resolver {
  import wasi:http/client@0.3.0;
  export resolver-api;
}
/// The host side of the runtime: links providers and exports capabilities.
world scxml-host {
  import data-model-api;
  import io-processor-api;
  import invoked-service-api;
  import executable-content-extension-api;
  import machine-api;
  import script-api;
  import script-bundle;
  import script-loader;
  export ir-source;
  export data-model-host;
  export execution-host;
  export session-snapshot-host;
  export machine-capability-types;
  export telemetry;
}
