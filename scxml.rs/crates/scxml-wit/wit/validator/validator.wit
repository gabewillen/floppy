/// SCXML validator component: the primary authoring interface. Produces
/// bounded, deterministic `scxml.report/v3` diagnostics; never executes
/// extension components.
package stateforward:scxml-validator@0.2.0;

/// Guest telemetry facade; closed labels only, never payloads.
interface telemetry {
  /// W3C trace carrier. It only parents telemetry spans and never alters
  /// output; in requests, present fields count as request metadata.
  record trace-context { traceparent: option<string>, tracestate: option<string> }
  /// Closed module label.
  enum module { validator }
  /// Closed operation label.
  enum operation { validate }
  /// Closed span-event label.
  enum signal-event { input-rejected, artifact-produced }
  /// Closed failure-category label.
  enum error-category { invalid-input, validation, report }
  /// Opens one host-owned span under `parent` and returns its id plus the
  /// child carrier. Id 0 means telemetry is unavailable; the guest continues
  /// unchanged. Each id is ended exactly once.
  start: func(module: module, operation: operation, parent: option<trace-context>) -> tuple<u64, option<trace-context>>;
  /// Records one closed event on an open span; unknown ids are ignored.
  event: func(span: u64, event: signal-event);
  /// Closes a span, marking it failed with `error` when present.
  end: func(span: u64, error: option<error-category>);
}

/// Request, result, and error types.
interface types {
  use telemetry.{trace-context};
  /// Closed error schema version; unknown discriminants fail canonical ABI decoding.
  enum error-version { v1 }
  /// Bounded failure classification with no caller-controlled payload.
  enum error-code {
    /// The request violated a documented bound or uniqueness rule.
    invalid-request,
    /// The canonical report could not be encoded within its bounds.
    canonical-report-failed,
  }
  /// Closed, payload-free failure.
  record component-error { version: error-version, code: error-code }
  /// XSD validation policy: `strict` rejects unknown or unschematized
  /// extension namespaces, `lax` validates what has a schema, `off` skips XSD.
  enum schema-policy { strict, lax, off }
  /// One XSD bound to one exact namespace URI. When no resource binds the
  /// SCXML namespace `http://www.w3.org/2005/07/scxml`, the validator applies
  /// its bundled, unmodified official W3C SCXML 1.0 schema set.
  record schema-resource { namespace-uri: string, system-id: string, bytes: list<u8> }
  /// extension package manifest (exact URI, extension artifact,
  /// schema artifact and lowercase hex SHA-256, WIT world and version, and
  /// the optional package validator artifact and its lowercase hex SHA-256,
  /// present together or not at all).
  record extension-package {
    namespace-uri: string,
    package-version: string,
    extension-artifact: string,
    schema-artifact: string,
    schema-sha256: string,
    wit-world: string,
    wit-version: string,
    validator-artifact: option<string>,
    validator-sha256: option<string>,
  }
  /// Exact bytes of one JSON Schema file an `event:schema` attribute
  /// references (the `event` attribute vocabulary,
  /// `https://github.com/stateforward/scxml.rs/namespaces/event`). The
  /// caller reads each file relative to the document; nothing is fetched.
  record event-schema-resource {
    /// The reference's resource part exactly as authored: the attribute
    /// value before `#`, trimmed of XML white space (byte comparison).
    uri: string,
    /// The file's exact bytes.
    bytes: list<u8>,
  }
  /// Request bounds (checked before any parsing; violations fail with
  /// `invalid-request` and produce no report): `source` at most 16777216
  /// bytes; at most 64 `schemas` and 64 `packages`; each schema's `bytes` at
  /// most 4194304 bytes and all schemas at most 16777216 bytes together; every
  /// metadata string (`source-name`, schema `namespace-uri` and `system-id`,
  /// every present package field, and present trace-context fields) non-empty and at
  /// most 4096 bytes, and at most 1048576 metadata bytes together; the whole
  /// request at most 33554432 bytes. Schema namespace URIs and package
  /// namespace URIs must each be unique (exact byte comparison). `event-schemas` holds at most 64 resources and 16777216 bytes together
  /// (each resource's `bytes` at most 4194304 bytes, its `uri` non-empty and
  /// at most 16384 bytes, URIs unique by exact byte comparison); its bytes
  /// are bounded separately and do not count toward the whole-request bound.
  /// A reference with no resource is an `EVENT004` diagnostic in the report.
  record validation-request {
    source-name: string,
    source: string,
    policy: schema-policy,
    schemas: list<schema-resource>,
    packages: list<extension-package>,
    event-schemas: list<event-schema-resource>,
    trace-context: option<trace-context>,
  }
  /// Diagnostic severity (the canonical report's `severity`).
  enum severity { note, warning, error }
  /// Confidence in applying a fix's edits (the canonical report's
  /// `applicability`).
  enum applicability { machine-applicable, maybe-incorrect, has-placeholders }
  /// A half-open UTF-8 byte range of the document source (`start <= end`,
  /// both on character boundaries).
  record span { start: u32, end: u32 }
  /// One labeled source range.
  record label { span: span, message: option<string> }
  /// One replacement of a source range.
  record edit { span: span, replacement: string }
  /// One suggested repair: non-overlapping edits.
  record fix { message: string, applicability: applicability, edits: list<edit> }
  /// One diagnostic of a package validator, in the canonical report's
  /// terms. `code` is the package's own code (`[a-z][a-z0-9_]*`, at most 64
  /// bytes); the validator reports it as `<prefix>::<code>`.
  record diagnostic {
    code: string,
    severity: severity,
    message: string,
    primary: label,
    secondary: list<label>,
    help: option<string>,
    fixes: list<fix>,
  }
}

/// The parsed document a package validator reads: read-only data the
/// validator builds once per document. Every index is into `elements`.
interface document {
  use types.{span};
  /// An expanded XML name: the exact, tagless namespace URI (none for no
  /// namespace) and the local name.
  record qualified-name { namespace-uri: option<string>, local-name: string }
  /// One attribute as parsed: its value after XML attribute-value
  /// normalization, and the span of the whole attribute.
  record attribute { name: qualified-name, value: string, span: span }
  /// One element: the span of the whole element (start tag to end tag), its
  /// attributes in source order, and its child elements' and parent's
  /// indices.
  record element {
    name: qualified-name,
    span: span,
    attributes: list<attribute>,
    children: list<u32>,
    parent: option<u32>,
  }
  /// One SCXML `<transition>`, in document order (the n-th is the n-th
  /// `<transition>` element): its source state's `id` (empty when the state
  /// has none), its `event` attribute, and the literal text of its
  /// `event:schema` (none without one, and none for `event:schemaexpr`).
  record transition-info { state: string, event: option<string>, event-schema: option<string> }
  /// The whole document: every element in document order (the root is
  /// index 0), the `<data>` and state ids in document order, the
  /// transitions, and the root's `datamodel` attribute.
  record context {
    elements: list<element>,
    data-ids: list<string>,
    state-ids: list<string>,
    transitions: list<transition-info>,
    datamodel: option<string>,
  }
}

/// A package validator: an optional component an extension or service
/// package ships (manifest `validator-artifact` and `validator-sha256`) that
/// checks what the package's XSD cannot. The validator calls it once per
/// document, after the XSD and built-in checks, with the package's targets:
/// the elements in its namespace (an extension package) or the `<invoke>`
/// elements whose `type` is its service URI (a service package). Its
/// diagnostics are reported as `<prefix>::<code>`, where the prefix is the
/// document's prefix of the namespace (an extension package; the URI's last
/// path segment when it is the default namespace) or the service URI's last
/// path segment (a service package: a repository service's `<name>`). It
/// runs with no
/// imports, on a bounded fuel budget, and must be deterministic. The
/// validator fails closed with one `PKG002` error naming the package on a
/// trap (fuel exhaustion included), an `err`, a span outside the source or
/// off a character boundary, overlapping edits within one fix, or an edit
/// outside every target element.
interface package-validator-api {
  use types.{component-error, diagnostic};
  use document.{context};
  /// Checks `targets` (indices into `document.elements`, in document
  /// order, never empty) and returns at most 256 diagnostics.
  validate: func(document: context, targets: list<u32>) -> result<list<diagnostic>, component-error>;
}

/// Explicit parse-only expression syntax capability.
///
/// The validator asks `supported-data-model` once per request. `none` means no
/// checker is linked: only data-model-neutral rules run and no expression is
/// guessed at. Otherwise the validator sends each `cond`, value, location, and
/// `<script>` fragment of documents whose `datamodel` attribute equals the
/// returned name exactly (other recognized data models get the `LINT010`
/// note that their expressions were not checked). Composition: link an
/// adapter over one data-model component's
/// `stateforward:scxml/data-model-api.check-syntax` (the bundled ECMAScript
/// and XPath components implement it; the Wasmtime host's
/// `ComponentValidator` is that adapter, answering `none` for the null
/// data model, which has no expression syntax), or a host stub that returns
/// `none` to keep validation usable without a data model.
interface expression-syntax {
  /// Syntactic category of one fragment.
  enum syntax-kind { condition, value, location, script }
  /// One syntax problem. `start <= end` are UTF-8 byte offsets on character
  /// boundaries into the checked source; `message` is at most 512 bytes.
  record syntax-issue { start: u32, end: u32, message: string }
  /// Why a fragment was declined. A checker declines only what its data
  /// model also rejects at evaluation (`too-large`: over the byte bound;
  /// `too-complex`: over a parser nesting or size bound, never reported as
  /// a syntax issue), so validators report every decline as the `LIMIT003`
  /// error.
  enum declined { too-large, too-complex, unavailable }
  /// What one fragment passed to `check-effects` is in its document.
  enum effect-role { condition, log, script, data, value, location }
  /// One fragment; `name` is present exactly for `data` (its `id`).
  record effect-fragment { role: effect-role, name: option<string>, source: string }
  /// Whether the document loads any `<script src>`, whose source a
  /// parse-only analysis cannot read: `absent` (every script is inline) or
  /// `present`.
  enum external-scripts { absent, present }
  /// What a finding, or the effect it is caused by, does.
  enum effect-kind {
    assignment, update, deletion, mutating-call, random, function-call,
    unknown-call, dynamic-code, implicit-call, unknown-write, dynamic-scope,
    unseen-script, too-complex, system-variable-write,
  }
  /// A byte range of fragment `fragment` (`start <= end`, UTF-8 offsets on
  /// character boundaries).
  record effect-span { fragment: u32, start: u32, end: u32 }
  /// Where a call's effect happens.
  record effect-cause { kind: effect-kind, span: effect-span, subject: string, function: string }
  /// One effect of a `condition` or `log` fragment, or a
  /// `system-variable-write` of any fragment; `certain` false means
  /// undecidable. Strings are at most 256 bytes.
  record effect-finding {
    certain: bool,
    kind: effect-kind,
    span: effect-span,
    subject: string,
    cause: option<effect-cause>,
    operator: option<effect-span>,
  }
  /// Exact `datamodel` value this checker understands, or `none`.
  supported-data-model: func() -> option<string>;
  /// Parses one fragment without evaluating it. Returns an empty list when
  /// the fragment is valid, otherwise at most 4 issues.
  check-syntax: func(kind: syntax-kind, source: string) -> result<list<syntax-issue>, declined>;
  /// Analyzes the side effects of one document's `cond` and `<log expr>`
  /// fragments without evaluating anything (`data-model-api.check-effects`;
  /// a data model whose expressions have no side effects returns an empty
  /// list). At most 16384 fragments and 4194304 source bytes; at most 4
  /// findings per fragment, sorted.
  check-effects: func(fragments: list<effect-fragment>, scripts: external-scripts) -> result<list<effect-finding>, declined>;
}

/// Exported validator entry point.
interface validator-api {
  use types.{component-error, validation-request};
  /// Consumes the request and returns owned canonical `scxml.report/v3`
  /// bytes (kind `validator`). Invalid SCXML is not an error: it yields a
  /// report whose diagnostics describe it. Byte-deterministic for identical
  /// requests. Errors: `invalid-request` for a request outside the bounds on
  /// `validation-request`; `canonical-report-failed` when the report cannot be
  /// encoded. No partial output is returned on failure.
  validate: func(request: validation-request) -> result<list<u8>, component-error>;
}

/// The validator component.
world validator {
  import telemetry;
  import expression-syntax;
  /// The bound package validators, one call per package with targets: the
  /// host routes each call to the package bound to the targets' exact
  /// namespace URI (extension elements) or literal `<invoke type>`
  /// (`<invoke>` elements), and answers an empty list when that package
  /// ships no validator.
  import package-validator-api;
  export validator-api;
}

/// A package validator component: no imports.
world package-validator {
  export package-validator-api;
}
