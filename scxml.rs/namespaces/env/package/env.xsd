<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of the host's `env` attribute vocabulary (namespaces/env).

  The namespace has no elements: it is an attribute vocabulary only, never
  fetched, with no component and no release asset. An invoked service's
  <invoke> binds one of its service package's declared slots (the
  manifest's `env-slots`) with

    env:<slot>="NAME"        the variable whose value the host binds
    env:<slot>expr="EXPR"    an expression that evaluates to that name

  The attribute names are an open set (each package declares its own slots),
  which XSD cannot enumerate, so this schema declares no attributes. The
  validator checks each attribute against the service's manifest (ENV001:
  an undeclared slot, a slot bound twice, or a value that is not a variable
  name) and rejects the namespace anywhere else, executable-content
  extension elements and other SCXML elements included (ENV002). This file documents the vocabulary for readers and tools that
  resolve a namespace to a schema; the validator does not load it.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/scxml.rs/namespaces/env"
           elementFormDefault="qualified">
  <!--
    The value of an env:<slot> attribute: a variable name,
    [A-Za-z_][A-Za-z0-9_]*, at most 256 bytes. The value an
    env:<slot>expr attribute evaluates to must be one too.
  -->
  <xs:simpleType name="variable-name">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_]*"/>
      <xs:maxLength value="256"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- The value of an env:<slot>expr attribute: a value expression in the
       document's data model. -->
  <xs:simpleType name="value-expression">
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
</xs:schema>
