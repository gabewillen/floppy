<?xml version="1.0"?>
<!-- env-3: a slot bound twice is rejected. The document must be rejected; it never runs. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:example="https://stateforward.org/scxml/example" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <onentry>
    <example:fetch env:url="IRP_BASE_URL" path="/ok" env:token="IRP_KEY" env:tokenexpr="'IRP_KEY'"/>
  </onentry>
  <transition conf:targetpass=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
