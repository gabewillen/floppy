<?xml version="1.0"?>
<!-- env-6: each element sends the value of the variable it names, and an element that names none receives no slot. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:example="https://stateforward.org/scxml/example" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <onentry>
    <example:fetch env:url="IRP_BASE_URL" env:token="IRP_OTHER_KEY" path="/authorization/other-key"/>
  </onentry>
  <transition event="example.fetched" target="s1"/>
  <transition event="*" conf:targetfail=""/>
</state>
<state id="s1">
  <onentry>
    <example:fetch env:url="IRP_BASE_URL" env:token="IRP_KEY" path="/authorization/key"/>
  </onentry>
  <transition event="example.fetched" target="s2"/>
  <transition event="*" conf:targetfail=""/>
</state>
<state id="s2">
  <onentry>
    <example:fetch url="https://irp.invalid/v1" path="/ok"/>
  </onentry>
  <transition event="error.execution" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
