<?xml version="1.0" encoding="UTF-8"?><!-- env-6: each element sends the value of the variable it names. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OTHER_KEY" model="irp-echo-authorization" prompt="k" location="Var1"/>
  </onentry>
  <transition cond="Var1=='other-key'" target="s1"/>
  <transition target="fail"/>
</state>
<state id="s1">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-authorization" prompt="k" location="Var1"/>
  </onentry>
  <transition cond="Var1=='key'" target="s2"/>
  <transition target="fail"/>
</state>
<state id="s2">
  <onentry>
    <openai:generate model="irp-reply" prompt="k" location="Var1"/>
  </onentry>
  <transition event="error.execution" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>