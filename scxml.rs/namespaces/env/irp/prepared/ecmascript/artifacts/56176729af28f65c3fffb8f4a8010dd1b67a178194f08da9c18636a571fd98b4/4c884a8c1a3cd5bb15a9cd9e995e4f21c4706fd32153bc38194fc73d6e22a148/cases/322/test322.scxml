<?xml version="1.0" encoding="UTF-8"?><!-- env-3: a value that is not a variable name is rejected. The document must be rejected; it never runs. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="not a name" model="irp-reply" prompt="k" location="Var1"/>
  </onentry>
  <transition target="pass"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>