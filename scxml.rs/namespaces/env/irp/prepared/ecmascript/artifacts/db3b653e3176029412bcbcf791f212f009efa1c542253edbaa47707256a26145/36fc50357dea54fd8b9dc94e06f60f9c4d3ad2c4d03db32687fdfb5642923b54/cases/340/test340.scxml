<?xml version="1.0" encoding="UTF-8"?><!-- env-5: a url variable without a value leaves the slot absent: the example falls back to its url attribute, which no declared origin admits, so it raises error.execution and sends nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:example="https://stateforward.org/scxml/example" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <example:fetch env:url="IRP_UNSET" url="https://irp.invalid/v1" path="/ok"/>
  </onentry>
  <transition event="error.execution" target="s1"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <onentry>
    <example:fetch env:url="IRP_BASE_URL" path="/requests/0"/>
  </onentry>
  <transition event="example.fetched" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>