<?xml version="1.0"?>
<!-- The env namespace's implementation report plan: each assertion is a
     numbered statement of namespaces/env/README.md ("Statements") that a
     document decides; the statements about what a run does are proven by
     the invoked-service tests the README names. -->
<assertions baseuri="https://github.com/stateforward/scxml.rs/tree/main/namespaces/env/irp/sources">
  <assert id="env-1" specnum="1" specid="#env-1">
    <![CDATA[An invoke's slots are the ones its service package declares (env-slots): a slot bound twice (env:<slot> and env:<slot>expr), an env:<slot> value that is not a variable name, or an attribute that names no valid slot is rejected (ENV001); a slot the package does not declare is rejected when the validator is given the package.]]>
    <test id="320" conformance="mandatory" manual="false">
      <start uri="320/test320.txml"/>
      <reject code="ENV001"/>
    </test>
    <test id="321" conformance="mandatory" manual="false">
      <start uri="321/test321.txml"/>
      <reject code="ENV001"/>
    </test>
    <test id="322" conformance="mandatory" manual="false">
      <start uri="322/test322.txml"/>
      <reject code="ENV001"/>
    </test>
  </assert>
  <assert id="env-2" specnum="2" specid="#env-2">
    <![CDATA[Only an invoked service's invoke has slots: an element in the env namespace, or an env attribute on an element in no namespace, on an executable-content extension element, on the invoke of an SCXML session, or on any other SCXML element, is rejected (ENV002).]]>
    <test id="330" conformance="mandatory" manual="false">
      <start uri="330/test330.txml"/>
      <reject code="ENV002"/>
    </test>
    <test id="331" conformance="mandatory" manual="false">
      <start uri="331/test331.txml"/>
      <reject code="ENV002"/>
    </test>
    <test id="332" conformance="mandatory" manual="false">
      <start uri="332/test332.txml"/>
      <reject code="ENV002"/>
    </test>
    <test id="333" conformance="mandatory" manual="false">
      <start uri="333/test333.txml"/>
      <reject code="ENV002"/>
    </test>
    <test id="334" conformance="mandatory" manual="false">
      <start uri="334/test334.txml"/>
      <reject code="ENV002"/>
    </test>
  </assert>
</assertions>
