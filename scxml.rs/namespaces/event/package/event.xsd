<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of the host's `event` vocabulary (namespaces/event).

  The namespace is never fetched, with no component and no release asset.
  `<event:defer/>`, its one element, is executable content of a
  `<transition>` with an `event` attribute that holds the event the
  transition handles until the transition's state is exited or a state
  inside it that handles the event is entered (README.md, "Deferred
  events"). `<transition>`, `<send>`,
  `<raise>`, and `<donedata>` describe the event data they handle or create
  with

    event:schema="JSON-OR-REFERENCE"   a JSON Schema: inline JSON (first
                                       non-white-space character `{`, or
                                       exactly `true` or `false`), or a path
                                       relative to the document with an
                                       optional JSON Pointer fragment
    event:schemaexpr="EXPR"            an expression in the document's data
                                       model whose value is the schema

  at most one of the two per element. At run time a send or raise whose data
  its own literal schema, or for an event the session delivers to itself a
  literal schema of a transition handling it, rejects is not dispatched and
  raises error.execution (README.md, "At run time"). The W3C SCXML schema admits them
  (its `##other` attribute wildcards, processed laxly), and the validator
  checks them (EVENT001-EVENT008). This file documents the vocabulary for
  readers and tools that resolve a namespace to a schema; the validator does
  not load it.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/scxml.rs/namespaces/event"
           elementFormDefault="qualified">
  <!--
    `event:schema`: a JSON Schema (JSON Schema 2020-12 by default; 2019-09
    and draft-07 by `$schema`), inline or by reference. JSON, URI
    references, and JSON Pointers are not XSD datatypes, so the value is a
    string; the validator parses and checks it.
  -->
  <xs:attribute name="schema" type="xs:string"/>
  <!--
    `event:schemaexpr`: a value expression in the document's data model
    whose value is the schema.
  -->
  <xs:attribute name="schemaexpr" type="xs:string"/>
  <!--
    `<event:defer/>`: hold the event the enclosing transition handles. No
    attributes and no content; the validator checks where it is
    (EVENT001).
  -->
  <xs:element name="defer">
    <xs:complexType/>
  </xs:element>
</xs:schema>
