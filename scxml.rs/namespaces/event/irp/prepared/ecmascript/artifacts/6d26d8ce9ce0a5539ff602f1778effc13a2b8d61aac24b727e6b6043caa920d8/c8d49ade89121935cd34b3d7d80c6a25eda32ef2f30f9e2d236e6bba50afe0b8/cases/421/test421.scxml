<?xml version="1.0" encoding="UTF-8"?><!-- event-3: leading white space before { is allowed. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<state id="s0">
  <onentry>
    <raise event="a" event:schema="  {&#34;type&#34;: &#34;object&#34;}"/>
  </onentry>
  <transition event="a" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>