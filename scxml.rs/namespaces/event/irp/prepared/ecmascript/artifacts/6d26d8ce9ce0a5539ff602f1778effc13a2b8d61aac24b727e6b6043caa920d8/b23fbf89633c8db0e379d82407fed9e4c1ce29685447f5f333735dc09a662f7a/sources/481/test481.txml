<?xml version="1.0"?>
<!-- event-9: a schema does not change transition selection or add events. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event">
<state id="s0">
  <onentry>
    <raise event="a.b" event:schema='{"type": "object"}'/>
    <raise event="c" event:schema='{"type": "object"}'/>
  </onentry>
  <transition event="a" target="s1" event:schema='{"type": "object", "required": ["count"], "additionalProperties": false}'/>
  <transition event="*" conf:targetfail=""/>
</state>
<state id="s1">
  <transition event="c" conf:targetpass="" event:schema="false"/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
