<?xml version="1.0" encoding="UTF-8"?><!-- event-4: a reference resolves against the document's base URI, `..` segments included, so it may name a file outside the document's directory. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<state id="s0">
  <onentry>
    <raise event="a"/>
  </onentry>
  <transition event="a" target="pass"/>
  <transition event="order" target="fail" event:schema="../schemas/order.json#/$defs/Order"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>