<?xml version="1.0" encoding="UTF-8"?><!-- event-9: a send to another session whose data a transition of the receiving document handling it rejects is not routed, and error.execution ends the sender's block: the child's #_parent send and the parent's #_<invokeid> send. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<state id="s0" initial="s01">
  <onentry>
    <send event="timeout" delay="5s"/>
  </onentry>
  <invoke id="child">
    <content>
      <scxml initial="c0" version="1.0" datamodel="ecmascript">
        <state id="c0">
          <onentry>
            <send target="#_parent" event="up"/>
            <send target="#_parent" event="unreached"/>
          </onentry>
          <transition event="error.execution">
            <send target="#_parent" event="child.rejected"/>
          </transition>
          <transition event="down" event:schema="{&#34;type&#34;: &#34;object&#34;}">
            <send target="#_parent" event="child.got.down"/>
          </transition>
        </state>
      </scxml>
    </content>
  </invoke>
  <state id="s01">
    <transition event="up" target="fail" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
    <transition event="child.rejected" target="s02"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s02">
    <onentry>
      <send target="#_child" event="down"/>
      <raise event="skipped"/>
    </onentry>
    <transition event="error.execution" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>