<?xml version="1.0" encoding="UTF-8"?><!-- event-9: a schema does not change transition selection or add events. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="xpath">
<state id="s0">
  <onentry>
    <raise event="a.b" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
    <raise event="c" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
  </onentry>
  <transition event="a" target="s1" event:schema="{&#34;type&#34;: &#34;object&#34;, &#34;required&#34;: [&#34;count&#34;], &#34;additionalProperties&#34;: false}"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <transition event="c" target="pass" event:schema="false"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>