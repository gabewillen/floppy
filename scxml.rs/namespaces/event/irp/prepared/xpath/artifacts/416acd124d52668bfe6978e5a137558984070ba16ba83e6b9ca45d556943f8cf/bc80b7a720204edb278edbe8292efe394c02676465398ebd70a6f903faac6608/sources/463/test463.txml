<?xml version="1.0"?>
<!-- event-7: a pointer selecting a schema that relies on $anchor cannot be moved and is rejected. The document must be rejected; it never runs. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event">
<state id="s0">
  <onentry>
    <raise event="x" event:schema="schemas/anchored.json#/$defs/Anchored"/>
  </onentry>
  <transition conf:targetpass=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
