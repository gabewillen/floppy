<?xml version="1.0"?>
<!-- event-9: data a schema does not describe is delivered unchanged. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event">
<state id="s0">
  <onentry>
    <send event="a" event:schema='{"type": "object", "required": ["count"], "additionalProperties": false}'>
      <param conf:name="1" expr="1"/>
    </send>
  </onentry>
  <transition event="a" conf:eventvarVal="1=1" target="s1" event:schema='{"type": "object", "required": ["count"], "additionalProperties": false}'/>
  <transition event="*" conf:targetfail=""/>
</state>
<state id="s1">
  <onentry>
    <raise event="b" event:schema="false"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition event="b" conf:targetpass="" event:schema="false"/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
