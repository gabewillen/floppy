<?xml version="1.0" encoding="UTF-8"?><!-- event-3: the boolean schemas true and false are accepted. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="xpath">
<state id="s0">
  <onentry>
    <raise event="a" event:schema="true"/>
  </onentry>
  <transition event="a" target="pass" event:schema="true"/>
  <transition event="unused" target="fail" event:schema="false"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>