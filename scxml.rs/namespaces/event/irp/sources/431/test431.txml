<?xml version="1.0"?>
<!-- event-4: a JSON Pointer selects a value of the file. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event">
<state id="s0">
  <onentry>
    <raise event="a"/>
  </onentry>
  <transition event="a" conf:targetpass=""/>
  <transition event="item" conf:targetfail="" event:schema="schemas/order.json#/$defs/Item"/>
  <transition event="order" conf:targetfail="" event:schema="schemas/order.json#/$defs/Order"/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
