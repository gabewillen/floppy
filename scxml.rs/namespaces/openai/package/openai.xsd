<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of the `openai` extension namespace (namespaces/openai). It governs
  structure only; the extension component governs what the element does.

  openai:generate  model | modelexpr (one is required at run time;
                   modelexpr wins), prompt, promptexpr, and openai:prompt
                   children (at least one non-empty part at run time),
                   location (optional: without it the element is in
                   function-calling mode and the model must call one of
                   the send functions the active configuration accepts),
                   max-output-tokens, reasoning; the host's env slots
                   env:apikey (required at run time) and env:baseurl
                   (optional), or their expr forms, admitted by the
                   ##other wildcard and checked against the manifest

  `stream` and `retry` are not part of this package version and are
  rejected here rather than ignored.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0"
           elementFormDefault="qualified">
  <xs:element name="generate">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="prompt" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string"/>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="model" type="xs:string"/>
      <xs:attribute name="modelexpr" type="xs:string"/>
      <xs:attribute name="prompt" type="xs:string"/>
      <xs:attribute name="promptexpr" type="xs:string"/>
      <xs:attribute name="location" type="xs:string"/>
      <xs:attribute name="max-output-tokens" type="xs:positiveInteger"/>
      <xs:attribute name="reasoning" type="xs:string"/>
      <xs:anyAttribute namespace="##other" processContents="lax"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
