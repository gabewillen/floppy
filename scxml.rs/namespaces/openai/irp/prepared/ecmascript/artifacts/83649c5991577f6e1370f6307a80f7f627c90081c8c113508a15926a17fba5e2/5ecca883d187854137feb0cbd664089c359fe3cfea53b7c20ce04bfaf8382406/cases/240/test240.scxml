<?xml version="1.0" encoding="UTF-8"?><!-- openai-15: after a failure the block stops and the session keeps running. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-status-500" prompt="f" location="Var1"/>
    <raise event="after"/>
  </onentry>
  <transition event="error.execution" target="s1"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <onentry>
    <raise event="next"/>
  </onentry>
  <transition event="next" target="s2"/>
  <transition event="*" target="fail"/>
</state>
<state id="s2">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-reply" prompt="f" location="Var1"/>
  </onentry>
  <transition cond="Var1=='irp reply'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>