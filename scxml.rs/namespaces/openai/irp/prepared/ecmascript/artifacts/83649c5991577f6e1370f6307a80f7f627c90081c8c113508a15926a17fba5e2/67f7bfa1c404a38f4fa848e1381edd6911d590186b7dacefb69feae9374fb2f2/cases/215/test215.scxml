<?xml version="1.0" encoding="UTF-8"?><!-- openai-12: every call is sent, in order. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-call-all" prompt="c"/>
  </onentry>
  <transition event="first" target="s1"/>
  <transition event="second" target="fail"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <transition event="second" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>