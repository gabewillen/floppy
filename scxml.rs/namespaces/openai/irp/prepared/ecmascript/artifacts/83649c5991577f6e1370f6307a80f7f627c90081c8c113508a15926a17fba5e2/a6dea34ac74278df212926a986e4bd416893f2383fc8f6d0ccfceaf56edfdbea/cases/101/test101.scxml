<?xml version="1.0" encoding="UTF-8"?><!-- openai-1: the element runs where its block runs: in transition content. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <transition target="s1">
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-reply" prompt="Say hello." location="Var1"/>
  </transition>
</state>
<state id="s1">
  <transition cond="Var1=='irp reply'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>