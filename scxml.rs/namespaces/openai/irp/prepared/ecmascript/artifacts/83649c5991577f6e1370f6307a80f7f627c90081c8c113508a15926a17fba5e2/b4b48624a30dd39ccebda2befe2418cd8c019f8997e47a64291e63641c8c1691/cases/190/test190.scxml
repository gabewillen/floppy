<?xml version="1.0" encoding="UTF-8"?><!-- openai-10: tool names follow the descriptors in order. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-tools" prompt="t" location="Var1"/>
  </onentry>
  <transition cond="Var1=='send_answer_yes,send_answer_no,send_foo,send_bar,send_a-b,send_a_b_c'" target="pass"/>
  <transition target="fail"/>
  <transition event="answer.yes answer.no" target="x"/>
  <transition event="foo.* bar." target="x"/>
  <transition event="*" target="x"/>
  <transition event="answer.yes" target="x"/>
  <transition event="a-b" target="x"/>
  <transition event="a.b.c" target="x"/>
  <transition event="eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" target="x"/>
</state>
<state id="x"/>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>