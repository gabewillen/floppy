<?xml version="1.0"?>
<!-- openai-3: prompt, promptexpr, and the children, in that order, joined with line breaks (echoed with | for each line break). -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-prompt" prompt="first" promptexpr="'second'" conf:location="1"><openai:prompt>  third  </openai:prompt><openai:prompt>fourth</openai:prompt></openai:generate>
  </onentry>
  <transition conf:idQuoteVal="1=first|second|third|fourth" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
