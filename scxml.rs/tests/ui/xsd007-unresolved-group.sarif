{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<?ui-args --schema urn:example:custom=tests/ui/schemas/missing-group.xsd?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" xmlns:c=\"urn:example:custom\" initial=\"a\">\n  <final id=\"a\"><onentry><c:mark/></onentry></final>\n</scxml>\n"},"location":{"uri":"tests/ui/xsd007-unresolved-group.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/xsd007-unresolved-group.scxml"},"region":{"endColumn":7,"endLine":2,"startColumn":2,"startLine":2}}}],"message":{"markdown":"XSD model-group reference does not name a group defined in the supplied schema set\n\n**Note:** the preflight must expand every `xs:group ref` to bound work; undefined or circular groups cannot be expanded soundly\n\n**Help:** define the referenced group in the supplied schema set and remove circular group references\n\n**Spec:** XML Schema 1.0 Part 1 §3.7 Model Group Definitions","text":"XSD model-group reference does not name a group defined in the supplied schema set"},"properties":{"byteSpan":{"end":81,"start":76},"category":"schema"},"ruleId":"XSD007"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"the preflight must expand every `xs:group ref` to bound work; undefined or circular groups cannot be expanded soundly"},"help":{"text":"How to fix: define the referenced group in the supplied schema set and remove circular group references.\n\nSpecification: XML Schema 1.0 Part 1 §3.7 Model Group Definitions\n\nRun `scxml-cli --explain XSD007` for examples."},"helpUri":"https://www.w3.org/TR/xmlschema-1/#cModel_Group_Definitions","id":"XSD007","name":"XSD007","properties":{"category":"schema"},"shortDescription":{"text":"a schema model-group reference cannot be budgeted"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}