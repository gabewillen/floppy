{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <state id=\"a\">\n    <onentry>\n      <send event=\"tick\" target=\"#_internal\" delay=\"1s\"/>\n    </onentry>\n    <transition event=\"tick\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml070-delayed-internal-send.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml070-delayed-internal-send.scx"},"replacements":[{"deletedRegion":{"byteLength":11,"byteOffset":172,"endColumn":56,"endLine":4,"startColumn":45,"startLine":4},"insertedContent":{"text":""}}]}],"description":{"text":"remove `delay`"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml070-delayed-internal-send.scx"},"region":{"endColumn":56,"endLine":4,"startColumn":46,"startLine":4}}}],"message":{"markdown":"a `<send>` to `#_internal` cannot use `delay`\n\n**Note:** an event sent to `#_internal` joins the internal event queue at once; SCXML forbids a delay on it, and the processor raises `error.execution` instead of delivering the event\n\n**Help:** remove `delay` to raise the event now, or drop the `target` to deliver it after the delay on the session's own external queue\n\n**Spec:** SCXML 1.0 §6.2 <send>","text":"a `<send>` to `#_internal` cannot use `delay`"},"properties":{"byteSpan":{"end":183,"start":173},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"the send targets the internal event queue"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml070-delayed-internal-send.scx"},"region":{"endColumn":45,"endLine":4,"startColumn":26,"startLine":4}}}],"ruleId":"SCXML070"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"SCXML 1.0 §6.2 says `delay` and `delayexpr` must not occur when the `target` is the internal event queue: an internal event joins the queue at once, so a delayed internal send is non-conformant, and the processor raises `error.execution` for it instead of delivering the event"},"help":{"text":"How to fix: remove the delay to raise the event now, or drop `target` to deliver the event after the delay on the session's own external queue.\n\nSpecification: SCXML 1.0 §6.2 <send>\n\nRun `scx --explain SCXML070` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#send","id":"SCXML070","name":"SCXML070","properties":{"category":"semantic"},"shortDescription":{"text":"a `<send>` to `#_internal` has a delay"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}