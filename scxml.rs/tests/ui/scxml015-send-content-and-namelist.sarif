{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <state id=\"a\">\n    <onentry>\n      <send event=\"ping\" namelist=\"x\">\n        <content>payload</content>\n      </send>\n    </onentry>\n    <transition event=\"ping\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml015-send-content-and-namelist.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml015-send-content-and-namelist.scx"},"region":{"endColumn":38,"endLine":4,"startColumn":26,"startLine":4}}}],"message":{"markdown":"send with `content` cannot also use `namelist`\n\n**Note:** `<content>` supplies the complete payload; `namelist` and `<param>` build a key/value payload, so the two forms cannot be combined\n\n**Help:** use `content` or `namelist`, not both\n\n**Spec:** SCXML 1.0 §6.2 <send>","text":"send with `content` cannot also use `namelist`"},"properties":{"byteSpan":{"end":165,"start":153},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"content declared here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml015-send-content-and-namelist.scx"},"region":{"endColumn":17,"endLine":5,"startColumn":10,"startLine":5}}}],"ruleId":"SCXML015"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"`<content>` supplies the complete payload; `namelist` and `<param>` build a key/value payload, so the two forms cannot be combined"},"help":{"text":"How to fix: use `<content>`, or `namelist`/`<param>`, not both.\n\nSpecification: SCXML 1.0 §6.2 <send>\n\nRun `scx --explain SCXML015` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#send","id":"SCXML015","name":"SCXML015","properties":{"category":"semantic"},"shortDescription":{"text":"a `<send>` combines `<content>` with `namelist` or `<param>`"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}