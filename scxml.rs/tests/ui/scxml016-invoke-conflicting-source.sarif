{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <state id=\"a\">\n    <invoke src=\"child.scxml\" srcexpr=\"'child.scxml'\"/>\n    <transition event=\"done.invoke\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml016-invoke-conflicting-source.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-conflicting-source.scx"},"replacements":[{"deletedRegion":{"byteLength":24,"byteOffset":143,"endColumn":54,"endLine":3,"startColumn":30,"startLine":3},"insertedContent":{"text":""}}]}],"description":{"text":"keep `src` and remove `srcexpr`"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-conflicting-source.scx"},"region":{"endColumn":30,"endLine":3,"startColumn":13,"startLine":3}}}],"message":{"markdown":"invoke source cannot use both `src` and `srcexpr`\n\n**Note:** `src`/`srcexpr`, `type`/`typeexpr`, `id`/`idlocation`, and an external source versus inline `<content>` are each mutually exclusive ways to say what to invoke and how to identify it\n\n**Help:** keep exactly one of `src` or `srcexpr`\n\n**Spec:** SCXML 1.0 §6.4 <invoke>","text":"invoke source cannot use both `src` and `srcexpr`"},"properties":{"byteSpan":{"end":143,"start":126},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"conflicting attribute"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-conflicting-source.scx"},"region":{"endColumn":54,"endLine":3,"startColumn":31,"startLine":3}}}],"ruleId":"SCXML016"}],"tool":{"driver":{"inform