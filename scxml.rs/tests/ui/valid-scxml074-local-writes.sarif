{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <datamodel><data id=\"items\" expr=\"[3, 1, 2]\"/></datamodel>\n  <script>function sortedFirst(list) { var copy = list.slice(); copy.sort(); return copy[0]; }</script>\n  <state id=\"a\">\n    <onentry><log label=\"first\" expr=\"sortedFirst(items)\"/></onentry>\n    <transition event=\"go\" cond=\"sortedFirst(items) === 1 &amp;&amp; In('a')\" target=\"f\"/>\n  </state>\n  <final id=\"f\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/valid-scxml074-local-writes.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":0,"warnings":0},"producer":{"kind":"validator"}},"results":[],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}