{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<?ui-args --schema urn:example:custom=tests/fixtures/extension-example.xsd?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\"\n       xmlns:c=\"urn:example:custom\"\n       initial=\"a\">\n  <state id=\"a\">\n    <onentry><c:mark value=\"not-an-integer\"/></onentry>\n    <transition event=\"go\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/xsd-custom-datatype.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/xsd-custom-datatype.scxml"},"region":{"endColumn":43,"endLine":6,"startColumn":29,"startLine":6}}}],"message":{"markdown":"invalid value `not-an-integer` for attribute `value` on `<c:mark>`\n\n**Note:** the schema registered for `urn:example:custom` rejects this under XML Schema constraint `cvc-datatype-valid`\n\n**Help:** use a value in the datatype's lexical form\n\n**Spec:** XML Schema 1.0 Part 2 §4.1.4 Datatype Valid (`cvc-datatype-valid`)","text":"invalid value `not-an-integer` for attribute `value` on `<c:mark>`"},"properties":{"byteSpan":{"end":253,"start":239},"category":"schema"},"ruleId":"XSD-cvc-datatype-valid"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"SCXML attributes such as `delay` (a CSS2 duration) have restricted lexical forms checked by the schema"},"help":{"text":"How to fix: use a value in the datatype's lexical form.\n\nSpecification: XML Schema 1.0 Part 2 §4.1.4 Datatype Valid\n\nRun `scxml-cli --explain XSD-cvc-datatype-valid` for examples."},"helpUri":"https://www.w3.org/TR/xmlschema-2/#cvc-datatype-valid","id":"XSD-cvc-datatype-valid","name":"XSD-cvc-datatype-valid","properties":{"category":"schema"},"shortDescription":{"text":"a value is not in the lexical space of its datatype"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}