af-children.scx"},"region":{"endColumn":22,"endLine":7,"startColumn":16,"startLine":7}}}],"message":{"markdown":"element `<x:note>` in an unbound namespace has no effect\n\n**Note:** SCXML 1.0 allows attributes and elements from other namespaces on and in its elements (the W3C schema's `##other` wildcards), and the processor executes none of them: only a package that binds the namespace (its schema and validator) reads them, and no extension package or registered schema binds this one\n\n**Help:** bind the namespace's package (`--extension-package MANIFEST.json`) or register its schema (`--schema URI=PATH`), or remove the element if it is a leftover","text":"element `<x:note>` in an unbound namespace has no effect"},"properties":{"byteSpan":{"end":376,"start":370},"category":"lint"},"relatedLocations":[{"id":1,"message":{"text":"not executable content: `<script>` runs no custom action"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/lint022-foreign-leaf-children.scx"},"region":{"endColumn":14,"endLine":7,"startColumn":8,"startLine":7}}}],"ruleId":"LINT022"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"SCXML 1.0 and its W3C schema allow attributes from other namespaces on SCXML elements and elements from other namespaces in their content models (the `##other` wildcards), and the processor executes none of them: an element in another namespace runs only as a custom action in executable content, and every other piece of foreign markup is metadata that only the package binding its namespace (its schema and package validator) reads. No extension package or registered schema binds this namespace, so nothing reads the markup; it is often a leftover or a misspelled namespace. `xml:*` (`xml:base` governs the `src` URIs in its scope; `xml:lang` and `xml:space` carry no SCXML behavior) and `xsi:*` attributes are accepted silently"},"help":{"text":"How to fix: bind the namespace's package (`--extension-package MANIFEST.json`) or register its schema (`--schema URI=PATH`), or remove the markup.\n\nRun `scx --explain LINT022` for examples."},"id":"LINT022","name":"LINT022","properties":{"category":"lint"},"shortDescription":{"text":"an attribute or element in an unbound namespace has no effect"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}