nfiguration":{"level":"error"},"fullDescription":{"text":"SCXML is an XML vocabulary; until the document parses, no schema or semantic rule can run"},"help":{"text":"How to fix: fix the XML syntax at the marked position: remove Markdown code fences or prose outside the single root element, keep `<?xml …?>` at the very start, escape `<` as `&lt;` and `&` as `&amp;` in attribute values and text (or use `<![CDATA[ … ]]>` in `<script>`), close or rename mismatched tags, quote attribute values, specify each attribute once, and never write `--` inside a comment.\n\nSpecification: XML 1.0 (Fifth Edition) §2.1 Well-Formed XML Documents\n\nRun `scxml-cli --explain XML001` for examples."},"helpUri":"https://www.w3.org/TR/xml/#sec-well-formed","id":"XML001","name":"XML001","properties":{"category":"syntax"},"shortDescription":{"text":"the document is not well-formed XML"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}