{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"  \n\n<?xml version=\"1.0\"?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"a\">\n  <state id=\"a\"><transition event=\"go\" target=\"f\"/></state><final id=\"f\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/xml001-late-xml-declaration.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/xml001-late-xml-declaration.scx"},"replacements":[{"deletedRegion":{"byteLength":4,"byteOffset":0,"endColumn":1,"endLine":3,"startColumn":1,"startLine":1},"insertedContent":{"text":""}}]}],"description":{"text":"remove the whitespace before the XML declaration"},"properties":{"applicability":"machine-applicable"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/xml001-late-xml-declaration.scx"},"region":{"endColumn":22,"endLine":3,"startColumn":1,"startLine":3}}}],"message":{"markdown":"XML declaration is not at the start of the document\n\n**Note:** the XML declaration must precede everything, even whitespace; elsewhere the name `xml` is reserved and `<?xml` is not well formed\n\n**Help:** remove the blank lines and spaces before `<?xml`\n\n**Spec:** XML 1.0 (Fifth Edition) §2.8 Prolog and Document Type Declaration","text":"XML declaration is not at the start of the document"},"properties":{"byteSpan":{"end":25,"start":4},"category":"syntax"},"ruleId":"XML001"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"SCXML is an XML vocabulary; until the document parses, no schema or semantic rule can run"},"help":{"text":"How to fix: fix the XML syntax at the marked position: remove Markdown code fences or prose outside the single root element, keep `<?xml …?>` at the very start, escape `<` as `&lt;` and `&` as `&amp;` in attribute values and text (or use `<![CDATA[ … ]]>` in `<script>`), close or rename mismatched tags, quote attribute values, specify each attribute once, and never write `--` inside a comment.\n\nSpecification: XML 1.0 (Fifth Edition) §2.1 Well-Formed XML Documents\n\nRun `scx --explain XML001` for examples."},"helpUri":"https://www.w3.org/TR/xml/#sec-well-formed","id":"XML001","name":"XML001","properties":{"category":"syntax"},"shortDescription":{"text":"the document is not well-formed XML"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}