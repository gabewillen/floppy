<?ui-args --extension-package components/scxml-extension-example/package/example.extension.json?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:example="https://stateforward.org/scxml/example"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       version="1.0" datamodel="ecmascript" initial="s0">
  <datamodel>
    <data id="outcome"/>
  </datamodel>
  <state id="s0">
    <onentry>
      <example:fetch url="https://api.example/v1/items" location="outcome" env:tokn="API_TOKEN"/>
    </onentry>
    <transition event="example.fetched" target="done"/>
  </state>
  <final id="done"/>
</scxml>
