{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\" 1.0 \" datamodel=\" ecmascript \" initial=\" idle \">\n  <datamodel>\n    <data id=\" count \" expr=\"0\"/>\n  </datamodel>\n  <state id=\" idle \">\n    <onentry>\n      <send event=\" tick \" id=\" timer \" delay=\"1s\"/>\n      <cancel sendid=\" timer \"/>\n    </onentry>\n    <transition event=\" go  stop \" cond=\"In('idle') &amp;&amp; count === 0\" target=\" done \" type=\" internal \"/>\n  </state>\n  <final id=\" done \"/>\n</scxml>\n"},"location":{"uri":"tests/ui/valid-padded-schema-values.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":0,"warnings":0},"producer":{"kind":"validator"}},"results":[],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}