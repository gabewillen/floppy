ests/ui/scxml038-xpath-mixed-habits.scx"},"region":{"endColumn":40,"endLine":11,"startColumn":39,"startLine":11}}}],"message":{"markdown":"xpath syntax error in `cond`: `%` is not an XPath operator\n\n**Note:** a condition that cannot be parsed raises `error.execution` and evaluates as false, so this condition can never hold\n\n**Help:** XPath spells the remainder operator `mod`\n\n**Spec:** SCXML 1.0 §5.9 Expressions\n\n**Spec:** SCXML CR 2014 §C.3 The XPath Data Model","text":"xpath syntax error in `cond`: `%` is not an XPath operator"},"properties":{"byteSpan":{"end":526,"start":525},"category":"lint"},"relatedLocations":[{"id":1,"message":{"text":"while parsing this `cond`"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml038-xpath-mixed-habits.scx"},"region":{"endColumn":64,"endLine":11,"startColumn":35,"startLine":11}}}],"ruleId":"SCXML038"},{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml038-xpath-mixed-habits.scx"},"replacements":[{"deletedRegion":{"byteLength":10,"byteOffset":533,"endColumn":57,"endLine":11,"startColumn":47,"startLine":11},"insertedContent":{"text":"and"}}]}],"description":{"text":"use `and`"},"properties":{"applicability":"machine-applicable"}}],"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml038-xpath-mixed-habits.scx"},"region":{"endColumn":57,"endLine":11,"startColumn":47,"startLine":11}}}],"message":{"markdown":"xpath syntax error in `cond`: `&&` is not an XPath operator\n\n**Note:** a condition that cannot be parsed raises `error.execution` and evaluates as false, so this condition can never hold\n\n**Help:** XPath spells logical and as `and`\n\n**Spec:** SCXML 1.0 §5.9 Expressions\n\n**Spec:** SCXML CR 2014 §C.3 The XPath Data Model","text":"xpath syntax error in `cond`: `&&` is not an XPath operator"},"properties":{"byteSpan":{"end":543,"start":533},"category":"lint"},"relatedLocations":[{"id":1,"message":{"text":"while parsing this `cond`"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml038-xpath-mixed-habits.scx"},"region":{"endColumn":64,"endLine":11,"startColumn":35,"startLine":11}}}],"ruleId":"SCXML038"},{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml038-xpath-mixed-habits.scx"},"replacements":[{"deletedRegion":{"byteLength":1,"byteOffset":544,"endColumn":59,"endLine":11,"startColumn":58,"startLine":11},"insertedContent":{"text":"not("}},{"deletedRegion":{"byteLength":0,"byteOffset":550,"endColumn":64,"endLine":11,"startColumn":64,"startLine":11},"insertedContent":{"text":")"}}]}],"description":{"text":"negate with `not()`"},"properties":{"applicability":"maybe-incorrect"}}],"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml038-xpath-mixed-habits.scx"},"region":{"endColumn":59,"endLine":11,"startColumn":58,"startLine":11}}}],"message":{"markdown":"xpath syntax error in `cond`: `!` is not an XPath operator\n\n**Note:** a condition that cannot be parsed raises `error.execution` and evaluates as false, so this condition can never hold\n\n**Help:** negate with the `not()` function, for example `not($done)`; `!=` is the only XPath operator with `!`\n\n**Spec:** SCXML 1.0 §5.9 Expressions\n\n**Spec:** SCXML CR 2014 §C.3 The XPath Data Model","text":"xpath syntax error in `cond`: `!` is not an XPath operator"},"properties":{"byteSpan":{"end":545,"start":544},"category":"lint"},"relatedLocations":[{"id":1,"message":{"text":"while parsing this `cond`"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml038-xpath-mixed-habits.scx"},"region":{"endColumn":64,"endLine":11,"startColumn":35,"startLine":11}}}],"ruleId":"SCXML038"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"SCXML 1.0 §5.9.4: \"The SCXML Processor MAY reject documents containing syntactically ill-formed expressions at document load time, or it MAY wait and place 'error.execution' in the internal event queue at runtime when the expressions are evaluated.\" This toolchain takes the second option, so the document compiles and the expression raises `error.execution` whenever it is evaluated (a condition is then false and the rest of an executable-content block is skipped); this check runs only when the host supplies the data model's parse-only syntax capability (the native CLI links the ECMAScript and XPath checkers). Each finding names the offending source text and, where a repair is certain to parse, offers it: ECMAScript habits in XPath (`==` to `=`, `&&` to `and`, `||` to `or`, `!x` to `not(x)`, `length()` to `string-length()`), a stray `=` in ECMAScript (`x === = 3`), word operators, quoting, and more. The XPath data model has no script language, so a non-empty `<script>` is reported too"},"help":{"text":"How to fix: apply the suggested repair, or fix the syntax at the marked position following the finding's help; for XPath, use XPath 1.0 operators and functions (`=`, `and`, `or`, `not()`, `string-length()`, `count()`).\n\nSpecification: SCXML 1.0 §B.2 The ECMAScript Data Model\n\nRun `scx --explain SCXML038` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#ecma-profile","id":"SCXML038","name":"SCXML038","properties":{"category":"semantic"},"shortDescription":{"text":"an expression or script does not parse in the selected data model"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}