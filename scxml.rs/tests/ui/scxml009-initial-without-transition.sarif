{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"p\">\n  <state id=\"p\">\n    <initial/>\n    <state id=\"c\">\n      <transition event=\"go\" target=\"d\"/>\n    </state>\n    <final id=\"d\"/>\n  </state>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml009-initial-without-transition.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml009-initial-without-transition.scxml"},"region":{"endColumn":13,"endLine":3,"startColumn":6,"startLine":3}}}],"message":{"markdown":"initial must contain exactly one transition\n\n**Note:** `<initial>` describes one default entry; its single transition names the default child states\n\n**Help:** add exactly one target-only transition inside `initial`\n\n**Spec:** SCXML 1.0 §3.6 <initial>","text":"initial must contain exactly one transition"},"properties":{"byteSpan":{"end":103,"start":96},"category":"semantic"},"ruleId":"SCXML009"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"`<initial>` describes one default entry; its single transition names the default child states"},"help":{"text":"How to fix: put exactly one target-only `<transition>` inside `<initial>`.\n\nSpecification: SCXML 1.0 §3.6 <initial>\n\nRun `scxml-cli --explain SCXML009` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#initial","id":"SCXML009","name":"SCXML009","properties":{"category":"semantic"},"shortDescription":{"text":"an `<initial>` does not contain exactly one `<transition>`"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}