{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"p\">\n  <state id=\"p\" initial=\"c\">\n    <initial>\n      <transition target=\"c\"/>\n    </initial>\n    <state id=\"c\">\n      <transition event=\"go\" target=\"d\"/>\n    </state>\n    <final id=\"d\"/>\n  </state>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml011-duplicate-initial-forms.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml011-duplicate-initial-forms.scxml"},"region":{"endColumn":28,"endLine":2,"startColumn":17,"startLine":2}}}],"message":{"markdown":"state cannot use both the `initial` attribute and an `initial` child\n\n**Note:** a compound state has exactly one default entry description; two forms conflict\n\n**Help:** keep exactly one form of initial configuration\n\n**Spec:** SCXML 1.0 §3.3 <state>","text":"state cannot use both the `initial` attribute and an `initial` child"},"properties":{"byteSpan":{"end":101,"start":90},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"conflicting initial child"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml011-duplicate-initial-forms.scxml"},"region":{"endColumn":13,"endLine":3,"startColumn":6,"startLine":3}}}],"ruleId":"SCXML011"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"a compound state has exactly one default entry description; two forms conflict"},"help":{"text":"How to fix: keep either the `initial` attribute or the `<initial>` child.\n\nSpecification: SCXML 1.0 §3.3 <state>\n\nRun `scxml-cli --explain SCXML011` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#state","id":"SCXML011","name":"SCXML011","properties":{"category":"semantic"},"shortDescription":{"text":"a state uses both an `initial` attribute and an `<initial>` child"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}