artifactLocation":{"uri":"tests/ui/multi-diagnostic-ordering.scx"},"region":{"endColumn":19,"endLine":9,"startColumn":14,"startLine":9}}}],"message":{"markdown":"duplicate identifier `ready`\n\n**Note:** transition targets, `initial` references, and history defaults resolve by ID; duplicates make every reference ambiguous\n\n**Help:** choose a unique identifier and update every reference to it\n\n**Spec:** SCXML 1.0 §3.14 IDs","text":"duplicate identifier `ready`"},"properties":{"byteSpan":{"end":279,"start":274},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"first declared here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/multi-diagnostic-ordering.scx"},"region":{"endColumn":19,"endLine":4,"startColumn":14,"startLine":4}}}],"ruleId":"SCXML002"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"SCXML 1.0 and its W3C schema allow attributes from other namespaces on SCXML elements and elements from other namespaces in their content models (the `##other` wildcards), and the processor executes none of them: an element in another namespace runs only as a custom action in executable content, and every other piece of foreign markup is metadata that only the package binding its namespace (its schema and package validator) reads. No extension package or registered schema binds this namespace, so nothing reads the markup; it is often a leftover or a misspelled namespace. `xml:*` (`xml:base` governs the `src` URIs in its scope; `xml:lang` and `xml:space` carry no SCXML behavior) and `xsi:*` attributes are accepted silently"},"help":{"text":"How to fix: bind the namespace's package (`--extension-package MANIFEST.json`) or register its schema (`--schema URI=PATH`), or remove the markup.\n\nRun `scx --explain LINT022` for examples."},"id":"LINT022","name":"LINT022","properties":{"category":"lint"},"shortDescription":{"text":"an attribute or element in an unbound namespace has no effect"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"transition targets, `initial` references, and history defaults resolve by ID; duplicates make every reference ambiguous"},"help":{"text":"How to fix: rename one declaration to a unique identifier and update every reference to it.\n\nSpecification: SCXML 1.0 §3.14 IDs\n\nRun `scx --explain SCXML002` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#IDs","id":"SCXML002","name":"SCXML002","properties":{"category":"semantic"},"shortDescription":{"text":"an identifier is declared more than once"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"a transition's `target` must be one or more IDs of states in the same SCXML document; an unresolved target makes the document non-conformant"},"help":{"text":"How to fix: correct the identifier or declare the missing state.\n\nSpecification: SCXML 1.0 §3.5 <transition>\n\nRun `scx --explain SCXML005` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#transition","id":"SCXML005","name":"SCXML005","properties":{"category":"semantic"},"shortDescription":{"text":"a transition target does not name a state in this document"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"the `initial` attribute of `<scxml>` or `<state>` selects the states entered first; an unknown ID, or an empty list, leaves the initial configuration undefined"},"help":{"text":"How to fix: correct the identifier or declare the missing state; omit an empty `initial` to enter the first child state.\n\nSpecification: SCXML 1.0 §3.2 <scxml>\n\nRun `scx --explain SCXML006` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#scxml","id":"SCXML006","name":"SCXML006","properties":{"category":"semantic"},"shortDescription":{"text":"an `initial` attribute names a state that does not exist"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"`event` is a whitespace-separated list of descriptors (`a`, `a.b`, `a.*`, `*`); commas and other punctuation never match"},"help":{"text":"How to fix: separate descriptors with spaces and use only name characters, `.`, and the `*` wildcard.\n\nSpecification: SCXML 1.0 §3.12.1 Event Descriptors\n\nRun `scx --explain SCXML013` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#EventDescriptors","id":"SCXML013","name":"SCXML013","properties":{"category":"semantic"},"shortDescription":{"text":"a transition `event` is not a valid event-descriptor list"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"each SCXML element has a fixed content model; for example executable content belongs only in `<onentry>`, `<onexit>`, and `<transition>`"},"help":{"text":"How to fix: move the element to a parent that accepts it, or add the missing children.\n\nSpecification: XML Schema 1.0 Part 1 §3.4.4 Element Locally Valid (Complex Type)\n\nRun `scx --explain XSD-cvc-complex-type.2.4` for examples."},"helpUri":"https://www.w3.org/TR/xmlschema-1/#cvc-complex-type","id":"XSD-cvc-complex-type.2.4","name":"XSD-cvc-complex-type.2.4","properties":{"category":"schema"},"shortDescription":{"text":"a child element is not allowed at this position, or required children are missing"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"the schema requires this attribute; for example `<scxml>` must declare `version=\"1.0\"` and `<if>` must declare `cond`"},"help":{"text":"How to fix: add the required attribute.\n\nSpecification: XML Schema 1.0 Part 1 §3.4.4 Element Locally Valid (Complex Type)\n\nRun `scx --explain XSD-cvc-complex-type.4` for examples."},"helpUri":"https://www.w3.org/TR/xmlschema-1/#cvc-complex-type","id":"XSD-cvc-complex-type.4","name":"XSD-cvc-complex-type.4","properties":{"category":"schema"},"shortDescription":{"text":"a required attribute is missing"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}