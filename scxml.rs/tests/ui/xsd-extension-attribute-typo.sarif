{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<?ui-args --schema urn:example:action=tests/ui/schemas/action.xsd?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" xmlns:x=\"urn:example:action\" version=\"1.0\" initial=\"a\">\n  <state id=\"a\">\n    <onentry>\n      <x:notify chanel=\"ops\" message=\"started\"/>\n    </onentry>\n    <transition event=\"go\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/xsd-extension-attribute-typo.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/xsd-extension-attribute-typo.scx"},"replacements":[{"deletedRegion":{"byteLength":6,"byteOffset":218,"endColumn":23,"endLine":5,"startColumn":17,"startLine":5},"insertedContent":{"text":"channel"}}]}],"description":{"text":"`<x:notify>` has an attribute with a similar name: `channel`"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/xsd-extension-attribute-typo.scx"},"region":{"endColumn":23,"endLine":5,"startColumn":17,"startLine":5}}}],"message":{"markdown":"attribute `chanel` is not allowed on `<x:notify>`\n\n**Note:** the schema registered for `urn:example:action` rejects this under XML Schema constraint `cvc-complex-type.3.2.2`: Attribute 'chanel' is not allowed for this element\n\n**Help:** did you mean `channel`?\n\n**Spec:** XML Schema 1.0 Part 1 §3.4.4 Element Locally Valid (Complex Type) (`cvc-complex-type.3.2.2`)","text":"attribute `chanel` is not allowed on `<x:notify>`"},"properties":{"byteSpan":{"end":224,"start":218},"category":"schema"},"ruleId":"XSD-cvc-complex-type.3.2.2"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"def