{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"p\">\n  <state id=\"p\" initial=\"c\">\n    <history id=\"h\"/>\n    <state id=\"c\">\n      <transition event=\"go\" target=\"d\"/>\n    </state>\n    <final id=\"d\"/>\n  </state>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml019-history-without-transition.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml019-history-without-transition.scxml"},"region":{"endColumn":13,"endLine":3,"startColumn":6,"startLine":3}}}],"message":{"markdown":"history must contain exactly one transition\n\n**Note:** the history transition defines the default configuration used before the parent state was ever exited\n\n**Help:** add exactly one target-only transition inside `history`\n\n**Spec:** SCXML 1.0 §3.10 <history>","text":"history must contain exactly one transition"},"properties":{"byteSpan":{"end":115,"start":108},"category":"semantic"},"ruleId":"SCXML019"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"the history transition defines the default configuration used before the parent state was ever exited"},"help":{"text":"How to fix: put exactly one target-only `<transition>` inside `<history>`.\n\nSpecification: SCXML 1.0 §3.10 <history>\n\nRun `scxml-cli --explain SCXML019` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#history","id":"SCXML019","name":"SCXML019","properties":{"category":"semantic"},"shortDescription":{"text":"a `<history>` does not contain exactly one `<transition>`"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}