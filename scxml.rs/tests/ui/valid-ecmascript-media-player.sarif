{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<?xml version=\"1.0\"?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"boot\" name=\"player\">\n  <datamodel>\n    <data id=\"volume\" expr=\"50\"/>\n    <data id=\"playlist\" expr=\"[]\"/>\n    <data id=\"cursor\" expr=\"0\"/>\n    <data id=\"cfg\" src=\"data:application/json,%7B%22autoplay%22%3Atrue%7D\"/>\n    <data id=\"stats\">{ \"plays\": 0, \"errors\": [] }</data>\n  </datamodel>\n  <script><![CDATA[\n    function clamp(v, lo, hi) { return Math.min(hi, Math.max(lo, v)); }\n    var seen = new Set();\n  ]]></script>\n  <state id=\"boot\">\n    <invoke id=\"loader\" type=\"http://www.w3.org/TR/scxml/\" autoforward=\"false\">\n      <param name=\"n\" expr=\"3\"/>\n      <content>\n        <scxml version=\"1.0\" datamodel=\"ecmascript\" initial=\"load\">\n          <datamodel><data id=\"n\"/></datamodel>\n          <state id=\"load\">\n            <onentry><send target=\"#_parent\" event=\"loaded\"><param name=\"items\" expr=\"Array.from({length: n}, (_, i) =&gt; 'track' + i)\"/></send></onentry>\n            <transition target=\"end\"/>\n          </state>\n          <final id=\"end\"/>\n        </scxml>\n      </content>\n      <finalize><assign location=\"playlist\" expr=\"_event.data.items\"/></finalize>\n    </invoke>\n    <transition event=\"loaded\" target=\"active\"/>\n    <transition event=\"error.*\" target=\"broken\"/>\n  </state>\n  <parallel id=\"active\">\n    <state id=\"transport\" initial=\"stopped\">\n      <state id=\"stopped\">\n        <transition event=\"play\" cond=\"playlist.length &gt; 0 &amp;&amp; cursor &lt; playlist.length\" target=\"playing\"/>\n      </state>\n      <state id=\"playing\">\n        <onentry><script>stats.plays++; seen.add(playlist[cursor]);</script></onentry>\n        <transition event=\"pause\" target=\"paused\"/>\n        <transition event=\"stop\" target=\"stopped\"/>\n        <transition event=\"track.end\" cond=\"cursor + 1 &lt; playlist.length\" target=\"playing\">\n          <assign location=\"cursor\" expr=\"cursor + 1\"/>\n        </transition>\n        <transition event=\"track.end\" target=\"stopped\"><assign location=\"cursor\" expr=\"0\"/></transition>\n      </state>\n      <state id=\"paused\">\n        <transition event=\"play\" target=\"playing\"/>\n        <transition event=\"stop\" target=\"stopped\"/>\n      </state>\n    </state>\n    <state id=\"audio\" initial=\"normal\">\n      <state id=\"normal\">\n        <transition event=\"volume.set\" type=\"internal\">\n          <assign location=\"volume\" expr=\"clamp(Number(_event.data), 0, 100)\"/>\n          <if cond=\"volume === 0\"><raise event=\"mute\"/></if>\n        </transition>\n        <transition event=\"mute\" target=\"muted\"/>\n      </state>\n      <state id=\"muted\">\n        <transition event=\"unmute volume.set\" target=\"normal\"/>\n      </state>\n    </state>\n    <transition event=\"shutdown\" target=\"off\"/>\n  </parallel>\n  <state id=\"broken\">\n    <onentry><log label=\"error\" expr=\"JSON.stringify(_event)\"/></onentry>\n    <transition event=\"reset\" target=\"boot\"/>\n  </state>\n  <final id=\"off\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/valid-ecmascript-media-player.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":0,"warnings":0},"producer":{"kind":"validator"}},"results":[],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}