{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <state id=\"a\">\n    <onentry>\n      <script src=\"lib.wasm\">input = 1;</script>\n    </onentry>\n    <transition event=\"go\" target=\"done\"/>\n  </state>\n  <final id=\"done\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml050-script-src-and-content.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml050-script-src-and-content.scx"},"replacements":[{"deletedRegion":{"byteLength":15,"byteOffset":141,"endColumn":29,"endLine":4,"startColumn":14,"startLine":4},"insertedContent":{"text":""}}]}],"description":{"text":"remove the `src` attribute and keep the inline script"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml050-script-src-and-content.scx"},"region":{"endColumn":29,"endLine":4,"startColumn":15,"startLine":4}}}],"message":{"markdown":"`<script>` cannot have both a `src` attribute and inline content\n\n**Note:** SCXML 1.0 §5.8: `<script>` takes either a `src` URI or inline script content, never both\n\n**Help:** keep the external `src` and delete the inline content, or delete `src` and keep the inline script\n\n**Spec:** SCXML 1.0 §5.8 <script>","text":"`<script>` cannot have both a `src` attribute and inline content"},"properties":{"byteSpan":{"end":156,"start":142},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"inline content here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml050-script-src-and-content.scx"},"region":{"endColumn":40,"endLine":4,"startColumn":30,"startLine":4}}}],"ruleId":"SCXML050"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"SCXML 1.0 §5.8 gives `<script>` either a `src` URI or inline script content, never both; an implementation cannot know which one the author meant to run"},"help":{"text":"How to fix: keep the external `src` and delete the inline content, or delete `src` and keep the inline script.\n\nSpecification: SCXML 1.0 §5.8 <script>\n\nRun `scx --explain SCXML050` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#script","id":"SCXML050","name":"SCXML050","properties":{"category":"semantic"},"shortDescription":{"text":"a `<script>` has both `src` and inline content"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}