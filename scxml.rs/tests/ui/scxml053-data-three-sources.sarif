{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s\">\n  <datamodel>\n    <data id=\"x\" expr=\"1\" src=\"file:x.json\">\n      <value/>\n    </data>\n  </datamodel>\n  <state id=\"s\">\n    <transition event=\"go\" target=\"done\"/>\n  </state>\n  <final id=\"done\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml053-data-three-sources.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml053-data-three-sources.scx"},"replacements":[{"deletedRegion":{"byteLength":9,"byteOffset":127,"endColumn":26,"endLine":3,"startColumn":17,"startLine":3},"insertedContent":{"text":""}},{"deletedRegion":{"byteLength":18,"byteOffset":136,"endColumn":44,"endLine":3,"startColumn":26,"startLine":3},"insertedContent":{"text":""}}]}],"description":{"text":"remove `expr` and `src`"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml053-data-three-sources.scx"},"region":{"endColumn":44,"endLine":3,"startColumn":27,"startLine":3}}}],"message":{"markdown":"`<data>` declares more than one value source: `expr`, `src`, and the child content\n\n**Note:** `<data>` gets its initial value from exactly one of `src` (a URI), `expr` (an expression), or inline child content; with several the value is ambiguous\n\n**Help:** keep one value source and remove the other 2: for example, remove `expr` and `src`\n\n**Spec:** SCXML 1.0 §5.3 <data>","text":"`<data>` declares more than one value source: `expr`, `src`, and the child content"},"properties":{"byteSpan":{"end":154,"start":137},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"`expr` is declared here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml053-data-three-sources.scx"},"region":{"endColumn":26,"endLine":3,"startColumn":18,"startLine":3}}},{"id":2,"message":{"text":"the child content is declared here too"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml053-data-three-sources.scx"},"region":{"endColumn":15,"endLine":4,"startColumn":7,"startLine":4}}}],"ruleId":"SCXML053"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"`<data>` takes its value from exactly one of `src`, `expr`, or child content (SCXML 1.0 §5.3), `<content>` is either computed by `expr` or given as child content (§5.6), and `<assign>` takes its value from `expr` or child content (§5.4); with several sources the value is ambiguous"},"help":{"text":"How to fix: keep one value source and remove the others.\n\nSpecification: SCXML 1.0 §5.3 <data>\n\nRun `scx --explain SCXML053` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#data","id":"SCXML053","name":"SCXML053","properties":{"category":"semantic"},"shortDescription":{"text":"a `<data>`, `<content>`, or `<assign>` has more than one value source"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}