{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"p\">\n  <state id=\"p\" initial=\"c\">\n    <history id=\"h\">\n      <transition target=\"g\"/>\n    </history>\n    <state id=\"c\" initial=\"g\">\n      <state id=\"g\">\n        <transition event=\"go\" target=\"d\"/>\n      </state>\n    </state>\n    <final id=\"d\"/>\n  </state>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml021-shallow-history-deep-target.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml021-shallow-history-deep-target.scxml"},"region":{"endColumn":28,"endLine":4,"startColumn":27,"startLine":4}}}],"message":{"markdown":"shallow history target `g` is not an immediate child\n\n**Note:** shallow history records only the parent's immediate children, so its default must be one of them; deep history records descendants, so its default must lie inside the history's parent\n\n**Help:** target an immediate child of the history parent, or use `type=\"deep\"` for a deeper descendant\n\n**Spec:** SCXML 1.0 §3.10 <history>","text":"shallow history target `g` is not an immediate child"},"properties":{"byteSpan":{"end":151,"start":150},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"target declared here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml021-shallow-history-deep-target.scxml"},"region":{"endColumn":19,"endLine":7,"startColumn":18,"startLine":7}}}],"ruleId":"SCXML021"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"shallow history records only the parent's immediate children, so its default must be one of them; deep history records descendants, so its default must lie inside the history's parent"},"help":{"text":"How to fix: for shallow history target an immediate child of the history's parent (or declare `type=\"deep\"`); for deep history target a descendant of the parent.\n\nSpecification: SCXML 1.0 §3.10 <history>\n\nRun `scxml-cli --explain SCXML021` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#history","id":"SCXML021","name":"SCXML021","properties":{"category":"semantic"},"shortDescription":{"text":"a history default targets a state outside what the history can restore"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}