{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"p\">\n  <parallel id=\"p\">\n    <state id=\"download\" initial=\"fetching\">\n      <state id=\"fetching\"><transition event=\"fetched\" target=\"saved\"/></state>\n      <state id=\"saved\"/>\n    </state>\n    <state id=\"spinner\"/>\n  </parallel>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml024-parallel-region-stuck.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":2,"warnings":2},"producer":{"kind":"validator"}},"results":[{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml024-parallel-region-stuck.scxml"},"region":{"endColumn":13,"endLine":5,"startColumn":8,"startLine":5}}}],"message":{"markdown":"state `saved` has no outgoing transition and may never exit\n\n**Note:** neither this state nor any enclosing `<state>` or `<parallel>` has a transition or `<invoke>`, and no transition in an enclosing `<parallel>` can leave that `<parallel>`, so once entered the machine can never leave it\n\n**Help:** add an outgoing transition, make this a `final` state, or document an intentional externally terminated wait\n\n**Spec:** SCXML 1.0 §3.3 <state>","text":"state `saved` has no outgoing transition and may never exit"},"properties":{"byteSpan":{"end":231,"start":226},"category":"lint"},"ruleId":"SCXML024"},{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml024-parallel-region-stuck.scxml"},"region":{"endColumn":11,"endLine":7,"startColumn":6,"startLine":7}}}],"message":{"markdown":"state `spinner` has no outgoing transition and may never exit\n\n**Note:** neither this state nor any enclosing `<state>` or `<parallel>` has a transition or `<invoke>`, and no transition in an enclosing `<parallel>` can leave that `<parallel>`, so once entered the machine can never leave it\n\n**Help:** add an outgoing transition, make this a `final` state, or document an intentional externally terminated wait\n\n**Spec:** SCXML 1.0 §3.3 <state>","text":"state `spinner` has no outgoing transition and may never exit"},"properties":{"byteSpan":{"end":268,"start":263},"category":"lint"},"ruleId":"SCXML024"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"a state with no transitions and no `<invoke>`, inside no `<state>` or `<parallel>` that has one and no `<parallel>` with a transition that can leave it, can never be left; the machine stalls there unless that is intentional"},"help":{"text":"How to fix: add an outgoing transition, make it a `<final>` state, or document the intentional wait.\n\nSpecification: SCXML 1.0 §3.3 <state>\n\nRun `scxml-cli --explain SCXML024` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#state","id":"SCXML024","name":"SCXML024","properties":{"category":"lint"},"shortDescription":{"text":"a non-final atomic state has no exit"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}