{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"a\">\n  <!-- bad -- comment -->\n  <state id=\"a\"><transition event=\"go\" target=\"f\"/></state><final id=\"f\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/xml001-comment-double-hyphen.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/xml001-comment-double-hyphen.scxml"},"replacements":[{"deletedRegion":{"byteLength":16,"byteOffset":80,"endColumn":23,"endLine":2,"startColumn":7,"startLine":2},"insertedContent":{"text":" bad - comment "}}]}],"description":{"text":"collapse repeated hyphens in the comment"},"properties":{"applicability":"machine-applicable"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/xml001-comment-double-hyphen.scxml"},"region":{"endColumn":14,"endLine":2,"startColumn":12,"startLine":2}}}],"message":{"markdown":"`--` inside a comment\n\n**Note:** XML reserves `--` inside comments (for SGML compatibility), so a comment cannot contain it or end with `--->`\n\n**Help:** use a single `-` inside comments, and leave a space before the closing `-->`\n\n**Spec:** XML 1.0 (Fifth Edition) §2.5 Comments","text":"`--` inside a comment"},"properties":{"byteSpan":{"end":87,"start":85},"category":"syntax"},"ruleId":"XML001"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"SCXML is an XML vocabulary; until the document parses, no schema or semantic rule can run"},"help":{"text":"How to fix: fix the XML syntax at the marked position: remove Markdown code fences or prose outside the single root element, keep `<?xml …?>` at the very start, escape `<` as `&lt;` and `&` as `&amp;` in attribute values and text (or use `<![CDATA[ … ]]>` in `<script>`), close or rename mismatched tags, quote attribute values, specify each attribute once, and never write `--` inside a comment.\n\nSpecification: XML 1.0 (Fifth Edition) §2.1 Well-Formed XML Documents\n\nRun `scxml-cli --explain XML001` for examples."},"helpUri":"https://www.w3.org/TR/xml/#sec-well-formed","id":"XML001","name":"XML001","properties":{"category":"syntax"},"shortDescription":{"text":"the document is not well-formed XML"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}