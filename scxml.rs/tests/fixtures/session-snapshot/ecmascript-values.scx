<?xml version="1.0" encoding="UTF-8"?>
<!-- ECMAScript values without a portable form, shown by their typeof and
     string form: "twice" holds a function (its source text), "when" a Date
     (its toString), and after "go" "box" holds an instance of the script
     constructor "Box" ([object Object]); the script global "Box" is not a
     <data> id and is not listed. Checkpoints: 0 after start ("box" is still
     null), 1 after "go" ("box" holds the instance), 2 at the only drain
     iteration, 3 at the end. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="ecmascript-values" initial="s">
  <datamodel>
    <data id="count" expr="0"/>
    <data id="box" expr="null"/>
    <data id="twice" expr="function (n) { return n * 2; }"/>
    <data id="when" expr="new Date(0)"/>
  </datamodel>
  <script>function Box(value) { this.value = value; }</script>
  <state id="s">
    <transition event="go" target="t">
      <assign location="box" expr="new Box(twice(2))"/>
      <assign location="count" expr="twice(count + 1)"/>
    </transition>
  </state>
  <state id="t">
    <transition event="reset" target="s"/>
  </state>
</scxml>
