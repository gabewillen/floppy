{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.conversation.failed",
  "description": "Failure signal produced when a conversation phase cannot complete.",
  "properties": {
    "stage": {
      "description": "Conversation phase that failed.",
      "enum": [
        "memory",
        "turn_detector",
        "voice_routing"
      ],
      "title": "Stage",
      "type": "string"
    },
    "message": {
      "description": "Human-readable failure message.",
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "stage",
    "message"
  ],
  "type": "object"
}
