{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.perceived",
  "description": "Everything that reached the bot while it was busy and was taken together by this turn, in the order it arrived. Each percept keeps its own source and participants; what matters among them is yours to decide.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "percepts"
  ],
  "properties": {
    "percepts": {
      "description": "The stimuli this turn took, in the order they arrived; between two and eight of them. Order is arrival only, never importance.",
      "title": "Percepts",
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "description": "One stimulus that reached the bot while it was busy, exactly as it arrived: the device input or the ability's product event, the source it arrived from, and who took part in it.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stimulus",
          "source"
        ],
        "properties": {
          "stimulus": {
            "additionalProperties": false,
            "description": "The stimulus unchanged, as the body took it: a device's bot.input as its envelope (its source null: it reaches the body from outside its session), or the stimulus an ability's bot.ability.cognition.input handed the body. The original passes the live stimulus object; floppy passes it as data [floppy field].",
            "properties": {
              "event": {
                "minLength": 1,
                "type": "string"
              },
              "data": {},
              "id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "target": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "event",
              "data"
            ],
            "type": "object"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Envelope source the stimulus arrived from: the nerve it came in on. Identity only; the body stamps it when the stimulus reaches it so attention can tell which device it concerns. Null for a bot.input, which reaches the body from outside its session [floppy field].",
            "examples": [
              "session.floppy.listening",
              null
            ],
            "title": "Source"
          },
          "participants": {
            "default": [],
            "description": "Who took part in this stimulus, as its producer stamped them, copied unchanged. Empty when the producer knows no one.",
            "examples": [
              [
                {
                  "ref": "person-42",
                  "role": "source"
                }
              ]
            ],
            "items": {
              "additionalProperties": false,
              "description": "Someone who took part in a stimulus: an opaque, producer-stable identity reference and the role it played (source: who produced it; target: who it was addressed to).",
              "examples": [
                {
                  "ref": "+15555550100",
                  "role": "source"
                },
                {
                  "ref": "person-42",
                  "role": "target"
                },
                {
                  "own": true,
                  "ref": "voice:3f2a9c",
                  "role": "source"
                }
              ],
              "properties": {
                "ref": {
                  "description": "Opaque, producer-stable identity such as a phone number, an app person id, or a chat handle. Never a display name chosen by the bot.",
                  "examples": [
                    "+15555550100",
                    "person-42",
                    "caller"
                  ],
                  "maxLength": 200,
                  "minLength": 1,
                  "title": "Ref",
                  "type": "string"
                },
                "role": {
                  "description": "source: who produced the stimulus (speaker, sender). target: who it was addressed to.",
                  "enum": [
                    "source",
                    "target"
                  ],
                  "examples": [
                    "source",
                    "target"
                  ],
                  "title": "Role",
                  "type": "string"
                },
                "own": {
                  "default": false,
                  "description": "True when the producer knows this participant is the bot itself, for example the bot's own voice heard back or the voice it spoke with. Stamped only by that producer; never inferred.",
                  "examples": [
                    false,
                    true
                  ],
                  "title": "Own",
                  "type": "boolean"
                },
                "resembles": {
                  "default": [],
                  "description": "For an identity its producer made just now (nobody it knew): the known identities it resembles, best first, at most 3. Stamped only by that producer; never a link.",
                  "examples": [
                    [
                      {
                        "ref": "voice:7b1e04",
                        "similarity": 0.42
                      }
                    ]
                  ],
                  "items": {
                    "additionalProperties": false,
                    "description": "A known identity this new one resembles: its ref and how similar the two are (-1..1). Perception data only: it links nothing, and it is never a print.",
                    "examples": [
                      {
                        "ref": "voice:7b1e04",
                        "similarity": 0.42
                      }
                    ],
                    "properties": {
                      "ref": {
                        "description": "The ref of the known identity, as its producer stamps it.",
                        "examples": [
                          "voice:7b1e04"
                        ],
                        "maxLength": 200,
                        "minLength": 1,
                        "title": "Ref",
                        "type": "string"
                      },
                      "similarity": {
                        "description": "How similar the two are, -1..1; higher is more alike.",
                        "examples": [
                          0.42
                        ],
                        "maximum": 1.0,
                        "minimum": -1.0,
                        "title": "Similarity",
                        "type": "number"
                      }
                    },
                    "required": [
                      "ref",
                      "similarity"
                    ],
                    "type": "object"
                  },
                  "maxItems": 3,
                  "title": "Resembles",
                  "type": "array"
                }
              },
              "required": [
                "ref",
                "role"
              ],
              "title": "Participant",
              "type": "object"
            },
            "maxItems": 32,
            "title": "Participants",
            "type": "array"
          }
        }
      }
    }
  },
  "examples": [
    {
      "percepts": [
        {
          "stimulus": {
            "event": "bot.input",
            "data": {
              "target_device": "phone",
              "priority": 0,
              "observation": {
                "event": "device.phone.ringing",
                "data": {
                  "call_id": "call-123"
                }
              }
            },
            "source": null
          },
          "source": null,
          "participants": []
        },
        {
          "stimulus": {
            "event": "bot.input",
            "data": {
              "priority": 5,
              "observation": {
                "event": "computer.text.entered",
                "data": {
                  "text": "Are you there?"
                }
              },
              "participants": [
                {
                  "ref": "person-42",
                  "role": "source"
                }
              ]
            },
            "source": null
          },
          "source": null,
          "participants": [
            {
              "ref": "person-42",
              "role": "source"
            }
          ]
        }
      ]
    }
  ]
}
