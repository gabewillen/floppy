<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" version="1.0" datamodel="ecmascript" initial="traffic"><state id="traffic" initial="green"><state id="green"><onentry><send event="light.green" target="#_parent"/><send event="walk.off" target="#_parent"/></onentry><transition event="pedestrian.button" event:schema='{"type":"object"}' target="yellow"/></state><state id="yellow"><onentry><send event="light.yellow" target="#_parent"/><send event="timer.yellow_done" delay="3s" id="yellowTimer"/></onentry><onexit><cancel sendid="yellowTimer"/></onexit><transition event="timer.yellow_done" target="walk"/></state><state id="walk"><onentry><send event="light.red" target="#_parent"/><send event="walk.on" target="#_parent"/><send event="timer.walk_done" delay="5s" id="walkTimer"/></onentry><onexit><cancel sendid="walkTimer"/></onexit><transition event="timer.walk_done" target="clear"/></state><state id="clear"><onentry><send event="walk.off" target="#_parent"/><send event="timer.clear_done" delay="1s" id="clearTimer"/></onentry><onexit><cancel sendid="clearTimer"/></onexit><transition event="timer.clear_done" target="green"/></state></state></scxml>