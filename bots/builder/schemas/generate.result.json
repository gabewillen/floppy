{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generate.result",
  "description": "The reply of the generate service: its content and every tool call, each with its id, name and JSON-object arguments, and what the request cost: its bytes and, when counted, its tokens.",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "request_bytes": {
      "description": "The UTF-8 bytes of the request body as the service sent it, without its streaming members (stream, stream_options).",
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "description": "The tokens the backend said it counted, when its reply carried usage (a stream's on its last chunk). A count it left out is absent.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "content",
    "tool_calls",
    "request_bytes"
  ],
  "additionalProperties": false
}
