{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generate.result",
  "description": "The reply of the generate service as the original text generator returns it: its content and every tool call, each with its id, name and JSON-object arguments.",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "args"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "content",
    "tool_calls"
  ],
  "additionalProperties": false
}
