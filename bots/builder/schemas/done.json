{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "done",
  "description": "The donedata of the final state done of the builder bot: an SCXML machine that validates and passes its own simulation, as its three documents and the path of the one invoked.",
  "type": "object",
  "properties": {
    "scxml": {"type": "string", "minLength": 1},
    "schemas": {"type": "object"},
    "script": {"type": "string"},
    "path": {"type": "string", "minLength": 1},
    "tests": {"type": "array", "items": {"type": "object"}},
    "report": {
      "type": "object",
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "failures": {"type": "integer", "minimum": 0},
        "fixes_applied": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "plan": {"type": "object"},
        "decisions": {"type": "array", "items": {"type": "string"}},
        "history": {"type": "array", "items": {"type": "object"}},
        "simulation": {"type": "array", "items": {"type": "object"}}
      },
      "required": ["attempts", "failures", "fixes_applied", "warnings", "plan", "decisions", "history", "simulation"],
      "additionalProperties": false
    }
  },
  "required": ["scxml", "schemas", "script", "path", "tests", "report"],
  "additionalProperties": false
}
