{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "builder.request",
  "description": "Ask the builder bot to build one SCXML machine from a natural-language specification.",
  "type": "object",
  "properties": {
    "spec": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 8},
    "model": {"type": "string", "minLength": 1},
    "generate_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "generate_ceiling_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "min_every_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "turn_after_bound_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "apply": {
      "type": "object",
      "description": "The live turn a turn behavior is run on before it is built (the reference verify_apply's input): the turn, the behavior input as autonomy builds it, and the sessions that turn's output names [floppy field].",
      "properties": {
        "turn": {"type": "integer", "minimum": 1},
        "input": {"type": "object"},
        "targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 32}
      },
      "required": ["turn", "input", "targets"],
      "additionalProperties": false
    },
    "template": {"const": "turn", "description": "Build a turn behavior from the turn template: the model writes only its script (decision D132) [floppy field]."}
  },
  "required": ["spec"],
  "dependentRequired": {"template": ["name", "apply"]},
  "additionalProperties": false
}
