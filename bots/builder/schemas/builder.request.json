{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "builder.request",
  "description": "Ask the builder bot to build one SCXML machine from a natural-language specification.",
  "type": "object",
  "properties": {
    "spec": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 8},
    "model": {"type": "string", "minLength": 1},
    "generate_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}
  },
  "required": ["spec"],
  "additionalProperties": false
}
