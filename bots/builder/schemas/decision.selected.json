{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision.selected",
  "description": "The decision service's selection: the chosen event with its grounded data, already checked against the event's schema, and its probability as its confidence (decisions D150, D243). The builder sends it to itself.",
  "type": "object",
  "properties": {
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "event",
          "data",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "selections"
  ],
  "additionalProperties": false
}
