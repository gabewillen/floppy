{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "failed",
  "description": "The donedata of the final state failed of the builder bot: why it could not build a machine that validates and passes its simulation.",
  "type": "object",
  "properties": {
    "reason": {"enum": ["invalid-request", "no-progress", "attempts-exhausted", "abandoned"]},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"enum": ["request", "generate", "draft", "validate", "simulate", "timeout"]},
          "code": {"type": "string"},
          "message": {"type": "string"}
        },
        "required": ["kind", "code", "message"],
        "additionalProperties": false
      }
    },
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "required": ["reason", "diagnostics", "history"],
  "additionalProperties": false
}
