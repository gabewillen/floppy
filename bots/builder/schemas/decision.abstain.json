{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision.abstain",
  "description": "The decision service took no event: nothing was offered, or the backend chose a pass criterion, whose tier is hand_to (decisions D150, D243).",
  "type": "object",
  "properties": {
    "reason": {
      "enum": [
        "no-candidates",
        "declined"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hand_to": {
      "enum": [
        "intuition",
        "reasoning"
      ]
    }
  },
  "required": [
    "reason"
  ],
  "additionalProperties": false
}
