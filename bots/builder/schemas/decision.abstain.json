{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision.abstain",
  "description": "The decision service took no event: nothing was offered, or the backend chose the pass criterion.",
  "type": "object",
  "properties": {
    "reason": {
      "enum": [
        "no-candidates",
        "declined"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "reason"
  ],
  "additionalProperties": false
}
