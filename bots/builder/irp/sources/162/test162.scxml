<?xml version="1.0" encoding="UTF-8"?>
<!-- builder-7: a design generation that outlasts generate_ceiling_ms is a timeout design-timeout diagnostic. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="builder" type="scxml" src="../../../builder.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="builder.request" target="#_builder"><content expr='{"spec": "a pinger: answer a ping with pong and finish", "generate_ceiling_ms": 1, "max_attempts": 1}'/></send>
    </onentry>
    <transition event="done.invoke.builder" cond='_event.data.reason === "attempts-exhausted" &amp;&amp; Array.isArray(_event.data.history) &amp;&amp; _event.data.diagnostics.some(function (d) { return d.kind === "timeout" &amp;&amp; d.code === "design-timeout"; })' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
