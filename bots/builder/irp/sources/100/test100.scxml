<?xml version="1.0" encoding="UTF-8"?>
<!-- builder-1: a request refused by its schema raises error.execution at the sender; the builder keeps waiting and answers a whitespace spec invalid-request. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="builder" type="scxml" src="../../../builder.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="builder.request" target="#_builder"><content expr='{"spec": "x", "colour": "blue"}'/></send>
    </onentry>
    <transition event="error.execution" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="builder.request" target="#_builder"><content expr='{"spec": "   "}'/></send>
    </onentry>
    <transition event="done.invoke.builder" cond='_event.data.reason === "invalid-request" &amp;&amp; Array.isArray(_event.data.history) &amp;&amp; _event.data.diagnostics.some(function (d) { return d.kind === "request" &amp;&amp; d.code === "invalid-request"; }) &amp;&amp; _event.data.history.length === 0 &amp;&amp; _event.data.scxml === undefined' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
