<?xml version="1.0" encoding="UTF-8"?>
<!-- builder-8: with the lifetime bounds, an hourly routine passes its forced first tick and is built. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="builder" type="scxml" src="../../../builder.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="builder.request" target="#_builder"><content expr='{"spec": "a pinger: answer a ping with pong and finish", "min_every_ms": 60000, "turn_after_bound_ms": 1000}'/></send>
    </onentry>
    <transition event="done.invoke.builder" cond="_event.data.scxml.indexOf('bot.behavior.tick') &gt;= 0 &amp;&amp; _event.data.report.simulation.length === 2 &amp;&amp; _event.data.report.simulation[1].name === 'first tick' &amp;&amp; _event.data.report.simulation[1].passed === true" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
