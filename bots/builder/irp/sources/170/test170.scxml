<?xml version="1.0" encoding="UTF-8"?>
<!-- builder-8: with the lifetime bounds, a routine scheduled every 30 s is a lifetime E0009 diagnostic. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="builder" type="scxml" src="../../../builder.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="builder.request" target="#_builder"><content expr='{"spec": "a pinger: answer a ping with pong and finish", "max_attempts": 1, "min_every_ms": 60000, "turn_after_bound_ms": 1000}'/></send>
    </onentry>
    <transition event="done.invoke.builder" cond='_event.data.reason === "attempts-exhausted" &amp;&amp; Array.isArray(_event.data.history) &amp;&amp; _event.data.diagnostics.some(function (d) { return d.kind === "lifetime" &amp;&amp; d.code === "E0009"; })' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
