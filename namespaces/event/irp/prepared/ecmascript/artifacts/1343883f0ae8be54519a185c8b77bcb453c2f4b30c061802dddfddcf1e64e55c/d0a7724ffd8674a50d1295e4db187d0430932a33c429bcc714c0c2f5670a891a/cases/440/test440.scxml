<?xml version="1.0" encoding="UTF-8"?><!-- event-5: 2020-12, 2019-09, and draft-07 schemas are accepted, with or without the trailing #. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<state id="s0">
  <onentry>
    <raise event="a" event:schema="{&#34;$schema&#34;: &#34;https://json-schema.org/draft/2020-12/schema#&#34;, &#34;type&#34;: &#34;object&#34;}"/>
    <raise event="b" event:schema="{&#34;$schema&#34;: &#34;https://json-schema.org/draft/2019-09/schema&#34;, &#34;type&#34;: &#34;object&#34;}"/>
    <raise event="c" event:schema="{&#34;$schema&#34;: &#34;http://json-schema.org/draft-07/schema#&#34;, &#34;type&#34;: &#34;object&#34;}"/>
    <raise event="d" event:schema="{&#34;$schema&#34;: &#34;http://json-schema.org/draft-07/schema&#34;, &#34;type&#34;: &#34;object&#34;}"/>
  </onentry>
  <transition event="a" target="s1"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <transition event="b" target="s2"/>
  <transition event="*" target="fail"/>
</state>
<state id="s2">
  <transition event="c" target="s3"/>
  <transition event="*" target="fail"/>
</state>
<state id="s3">
  <transition event="d" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>