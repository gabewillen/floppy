<?xml version="1.0" encoding="UTF-8"?><!-- event-9: a raise whose event a transition's schema rejects is not raised, and error.execution ends its block. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="xpath">
<state id="s0">
  <onentry>
    <raise event="b" event:schema="{&#34;type&#34;: &#34;null&#34;}"/>
    <raise event="c"/>
  </onentry>
  <transition event="b" target="fail" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
  <transition event="error.execution" target="s1"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <onentry>
    <raise event="d"/>
  </onentry>
  <transition event="c" target="fail"/>
  <transition event="d" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>