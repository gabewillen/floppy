<?xml version="1.0" encoding="UTF-8"?><!-- event-1: an event schema is allowed on each of transition, send, raise, and donedata. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="xpath">
<state id="s0" initial="s01">
  <onentry>
    <raise event="raised" event:schema="{&#34;type&#34;: &#34;null&#34;}"/>
  </onentry>
  <transition event="raised" target="s1" event:schema="{&#34;type&#34;: &#34;null&#34;}"/>
  <transition event="*" target="fail"/>
  <state id="s01"/>
</state>
<state id="s1">
  <onentry>
    <send event="sent" event:schema="{&#34;type&#34;: &#34;null&#34;}"/>
  </onentry>
  <transition event="sent" target="s2" event:schema="{&#34;type&#34;: &#34;null&#34;}"/>
  <transition event="*" target="fail"/>
</state>
<state id="s2" initial="s21">
  <state id="s21">
    <transition target="s2final"/>
  </state>
  <final id="s2final">
    <donedata event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
  </final>
  <transition event="done.state.s2" target="pass" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>