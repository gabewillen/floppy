<?xml version="1.0"?>
<!-- behavior-1: a verify_tick with content raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior">
<datamodel>
  <data id="a" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:verify_tick location="a" ticks="[]">x</behavior:verify_tick>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="a === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
