<?xml version="1.0" encoding="UTF-8"?><!-- behavior-2: each behavior row is an instance with its examples parsed, its counters numbers and its triggers. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="i" expr="null"/>
  <data id="b" expr="({rows: [{columns: ['name', 'source', 'examples', 'used_count', 'failed_count'], values: ['A', '&lt;scxml/&gt;', '[&#34;x&#34;]', '2', '']}, {columns: ['name', 'source', 'examples', 'used_count', 'failed_count'], values: ['B', '', '[]', '0', '0']}]})"/>
  <data id="t" expr="({rows: [{columns: ['behavior_name', 'trigger'], values: ['A', 'bot.input']}, {columns: ['behavior_name', 'trigger'], values: ['C', 'x']}, {columns: ['behavior_name', 'trigger'], values: ['A', 'environment.sound']}]})"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:instances_from_behavior_results location="i" behaviors="b" triggers="t"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="i.length === 2 &amp;&amp; i[0].examples[0] === 'x' &amp;&amp; i[0].used_count === 2 &amp;&amp; i[0].failed_count === 0 &amp;&amp; JSON.stringify(i[0].triggers) === '[&#34;bot.input&#34;,&#34;environment.sound&#34;]' &amp;&amp; i[1].triggers.length === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>