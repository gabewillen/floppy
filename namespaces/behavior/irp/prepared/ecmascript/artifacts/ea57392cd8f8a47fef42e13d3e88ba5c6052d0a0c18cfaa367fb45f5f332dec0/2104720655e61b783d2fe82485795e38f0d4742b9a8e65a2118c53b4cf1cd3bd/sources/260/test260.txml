<?xml version="1.0"?>
<!-- behavior-7: the turn behavior template is written with its script reference naming the script. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior">
<datamodel>
  <data id="a" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:turn_program location="a" script="'Greet_On-Knock.js'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="typeof a === 'string' &amp;&amp; a.indexOf('&lt;script src=&quot;Greet_On-Knock.js&quot;/&gt;') > 0 &amp;&amp; a.indexOf('turn.js&quot;') &lt; 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
