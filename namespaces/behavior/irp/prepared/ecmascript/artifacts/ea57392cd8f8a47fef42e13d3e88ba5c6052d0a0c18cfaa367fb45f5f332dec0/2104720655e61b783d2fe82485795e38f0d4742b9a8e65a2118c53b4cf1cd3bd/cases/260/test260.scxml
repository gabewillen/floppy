<?xml version="1.0" encoding="UTF-8"?><!-- behavior-7: the turn behavior template is written with its script reference naming the script. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="a" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:turn_program location="a" script="'Greet_On-Knock.js'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="typeof a === 'string' &amp;&amp; a.indexOf('&lt;script src=&#34;Greet_On-Knock.js&#34;/&gt;') &gt; 0 &amp;&amp; a.indexOf('turn.js&#34;') &lt; 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>