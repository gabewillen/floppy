<?xml version="1.0" encoding="UTF-8"?><!-- behavior-6: a run that handles nothing is the original's message. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="a" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:verify_apply location="a" done="({turn: 1, handled: false, selected: []})" turn="1" input="({})" targets="['communication']"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="a.length === 1 &amp;&amp; a[0] === 'behavior output must select at least one event for the observed pattern.'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>