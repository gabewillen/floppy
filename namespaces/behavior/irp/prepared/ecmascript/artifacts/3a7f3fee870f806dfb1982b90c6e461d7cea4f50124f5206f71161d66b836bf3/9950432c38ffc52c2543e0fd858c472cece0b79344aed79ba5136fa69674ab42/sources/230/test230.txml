<?xml version="1.0"?>
<!-- behavior-4: a schedule below min_every is an E0009 of a persistent routine, with its schedule. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior">
<datamodel>
  <data id="e" expr="null"/>
  <data id="l" expr="null"/>
  <data id="c" expr="null"/>
  <data id="doc" expr="'&lt;scxml xmlns=&quot;http://www.w3.org/2005/07/scxml&quot;&gt;&lt;state id=&quot;w&quot;&gt;&lt;onentry&gt;&lt;send event=&quot;t.every&quot; delay=&quot;30s&quot;/&gt;&lt;/onentry&gt;&lt;transition event=&quot;t.every&quot;&gt;&lt;send event=&quot;bot.behavior.tick&quot; target=&quot;#_parent&quot;/&gt;&lt;/transition&gt;&lt;/state&gt;&lt;/scxml&gt;'"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:lifetime_errors location="e" scxml="doc" min_every="60000" turn_after_bound="1000" lifetimelocation="l" scheduleslocation="c"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="l === 'persistent' &amp;&amp; JSON.stringify(c) === '[&quot;t.every&quot;]' &amp;&amp; e.length === 1 &amp;&amp; e[0].code === 'E0009' &amp;&amp; e[0].kind === 'lifetime' &amp;&amp; e[0].message.indexOf('every (the t.every delay of 30s) is shorter than the 60-second minimum routine interval.') === 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
