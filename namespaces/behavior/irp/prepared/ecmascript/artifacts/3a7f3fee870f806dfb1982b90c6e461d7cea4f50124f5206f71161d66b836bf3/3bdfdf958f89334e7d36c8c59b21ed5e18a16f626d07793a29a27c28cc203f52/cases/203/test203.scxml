<?xml version="1.0" encoding="UTF-8"?><!-- behavior-1: an element the namespace does not have raises error.execution. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="d" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:next_after location="d" at="({})" now="0"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="d === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>