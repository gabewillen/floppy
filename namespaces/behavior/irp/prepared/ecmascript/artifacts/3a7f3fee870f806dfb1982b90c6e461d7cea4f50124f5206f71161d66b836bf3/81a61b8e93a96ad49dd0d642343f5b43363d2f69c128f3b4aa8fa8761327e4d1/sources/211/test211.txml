<?xml version="1.0"?>
<!-- behavior-2: no rows are no instances. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior">
<datamodel>
  <data id="i" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:instances_from_behavior_results location="i" behaviors="({rows: []})" triggers="({rows: []})"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="Array.isArray(i) &amp;&amp; i.length === 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
