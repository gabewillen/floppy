<?xml version="1.0" encoding="UTF-8"?><!-- behavior-5: no tick, or one without its fields, is one message. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="a" expr="null"/>
  <data id="b" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:verify_tick location="a" ticks="[]"/>
    <behavior:verify_tick location="b" ticks="[{name: 'M', trigger: 'hourly', scheduled_at: 'a', fired_at: 'b', output: []}]"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="a[0] === 'persistent routine did not emit a tick for its first schedule.' &amp;&amp; b[0] === 'persistent routine tick must carry name, trigger (every or at), scheduled_at and fired_at.'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>