<?xml version="1.0" encoding="UTF-8"?><!-- behavior-6: a run on an input it must not answer passes unanswered, is told what it answered, a script that threw is told which call threw, and one that did not load that it did not load. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="a" expr="null"/>
  <data id="b" expr="null"/>
  <data id="c" expr="null"/>
  <data id="d" expr="null"/>
  <data id="input" expr="({text: 'pong'})"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:verify_apply location="a" done="({turn: 2, handled: false, selected: [], error: null})" turn="2" input="input" targets="['conversation']" handled="false"/>
    <behavior:verify_apply location="b" done="({turn: 2, handled: true, selected: [{event: 'e', target: 'conversation'}], error: null})" turn="2" input="input" targets="['conversation']" handled="false"/>
    <behavior:verify_apply location="c" done="({turn: 2, handled: false, selected: [], error: 'selections'})" turn="2" input="input" targets="['conversation']"/>
    <behavior:verify_apply location="d" done="({turn: 2, handled: false, selected: [], error: 'script'})" turn="2" input="input" targets="['conversation']"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="a.length === 0 &amp;&amp; b.length === 1 &amp;&amp; b[0] === 'the behavior must not answer this input (handled false, selected []), it answered handled true with 1 selection(s).' &amp;&amp; c.length === 1 &amp;&amp; c[0] === 'the script\'s selections() threw on this input: it must return a value for every input.' &amp;&amp; d.length === 1 &amp;&amp; d[0] === 'the script did not load: it must parse, and its top level must run without throwing.'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>