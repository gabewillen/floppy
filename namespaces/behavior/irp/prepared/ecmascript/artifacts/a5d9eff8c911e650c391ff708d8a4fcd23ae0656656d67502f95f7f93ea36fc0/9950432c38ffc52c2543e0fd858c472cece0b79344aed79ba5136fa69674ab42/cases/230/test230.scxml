<?xml version="1.0" encoding="UTF-8"?><!-- behavior-4: a schedule below min_every is an E0009 of a persistent routine, with its schedule. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="e" expr="null"/>
  <data id="l" expr="null"/>
  <data id="c" expr="null"/>
  <data id="doc" expr="'&lt;scxml xmlns=&#34;http://www.w3.org/2005/07/scxml&#34;&gt;&lt;state id=&#34;w&#34;&gt;&lt;onentry&gt;&lt;send event=&#34;t.every&#34; delay=&#34;30s&#34;/&gt;&lt;/onentry&gt;&lt;transition event=&#34;t.every&#34;&gt;&lt;send event=&#34;bot.behavior.tick&#34; target=&#34;#_parent&#34;/&gt;&lt;/transition&gt;&lt;/state&gt;&lt;/scxml&gt;'"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:lifetime_errors location="e" scxml="doc" min_every="60000" turn_after_bound="1000" lifetimelocation="l" scheduleslocation="c"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="l === 'persistent' &amp;&amp; JSON.stringify(c) === '[&#34;t.every&#34;]' &amp;&amp; e.length === 1 &amp;&amp; e[0].code === 'E0009' &amp;&amp; e[0].kind === 'lifetime' &amp;&amp; e[0].message.indexOf('every (the t.every delay of 30s) is shorter than the 60-second minimum routine interval.') === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>