<?xml version="1.0"?>
<!-- behavior-2: a result without rows raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior">
<datamodel>
  <data id="i" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:instances_from_behavior_results location="i" behaviors="({rowcount: 0})" triggers="({rows: []})"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="i === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
