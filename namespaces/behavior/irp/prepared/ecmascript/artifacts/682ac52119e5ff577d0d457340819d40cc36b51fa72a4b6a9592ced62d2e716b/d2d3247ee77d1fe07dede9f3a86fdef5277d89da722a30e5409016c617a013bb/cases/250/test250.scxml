<?xml version="1.0" encoding="UTF-8"?><!-- behavior-6: a run on the live turn whose donedata selects on its input, to one of its targets, has no messages. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="a" expr="null"/>
  <data id="done" expr="({turn: 3, handled: true, selected: [{event: 'bot.ability.communication.respond', target: 'communication', data: {text: 'hi', label: 'knock'}}]})"/>
  <data id="input" expr="({label: 'knock', focus_candidates: ['door']})"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:verify_apply location="a" done="done" turn="3" input="input" targets="['communication']" error="null"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="Array.isArray(a) &amp;&amp; a.length === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>