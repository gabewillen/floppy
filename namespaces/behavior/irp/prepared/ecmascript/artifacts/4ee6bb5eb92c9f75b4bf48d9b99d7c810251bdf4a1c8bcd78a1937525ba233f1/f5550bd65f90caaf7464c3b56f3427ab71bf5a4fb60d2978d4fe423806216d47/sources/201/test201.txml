<?xml version="1.0"?>
<!-- behavior-1: a replace_behavior_clauses with an undeclared attribute raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior">
<datamodel>
  <data id="s" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:replace_behavior_clauses location="s" instance="({name: 'A', source: ''})" status="'DRAFT'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="s === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
