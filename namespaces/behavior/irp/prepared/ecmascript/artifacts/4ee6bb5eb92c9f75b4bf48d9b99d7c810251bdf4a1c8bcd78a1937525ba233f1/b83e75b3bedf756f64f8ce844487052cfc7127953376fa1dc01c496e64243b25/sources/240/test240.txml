<?xml version="1.0"?>
<!-- behavior-5: a tick with its fields whose output reads them has no messages. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior">
<datamodel>
  <data id="a" expr="null"/>
  <data id="ticks" expr="[{name: 'M', trigger: 'every', scheduled_at: 'a', fired_at: 'b', output: [{event: 'bot.speaking.say', data: {text: 'hi', name: 'M'}}]}]"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:verify_tick location="a" ticks="ticks"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="Array.isArray(a) &amp;&amp; a.length === 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
