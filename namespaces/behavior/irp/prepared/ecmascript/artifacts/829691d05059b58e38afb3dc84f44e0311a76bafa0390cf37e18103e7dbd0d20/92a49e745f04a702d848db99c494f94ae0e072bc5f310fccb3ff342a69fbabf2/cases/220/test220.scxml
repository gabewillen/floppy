<?xml version="1.0" encoding="UTF-8"?><!-- behavior-3: the statements delete the triggers and the row, then insert the row and each distinct trigger. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:behavior="https://github.com/stateforward/floppy/namespaces/behavior" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="s" expr="null"/>
  <data id="b" expr="({name: 'A', source: '&lt;scxml/&gt;', description: 'd', examples: ['x'], lifetime: 'persistent', status: 'ACTIVE', used_count: 2, last_used_at: 't', failed_count: 0, last_failed_at: '', triggers: ['bot.input', 'x', 'bot.input']})"/>
</datamodel>
<state id="s0">
  <onentry>
    <behavior:replace_behavior_clauses location="s" instance="b"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="s.length === 5 &amp;&amp; s[0].sql.indexOf('DELETE FROM bot_behavior_trigger') === 0 &amp;&amp; s[1].sql.indexOf('DELETE FROM bot_behavior ') === 0 &amp;&amp; JSON.stringify(s[2].parameters) === '[&#34;A&#34;,&#34;&lt;scxml/&gt;&#34;,&#34;d&#34;,&#34;[\\&#34;x\\&#34;]&#34;,&#34;persistent&#34;,&#34;ACTIVE&#34;,&#34;2&#34;,&#34;t&#34;,&#34;0&#34;,&#34;&#34;]' &amp;&amp; JSON.stringify(s[4].parameters) === '[&#34;A&#34;,&#34;x&#34;]'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>