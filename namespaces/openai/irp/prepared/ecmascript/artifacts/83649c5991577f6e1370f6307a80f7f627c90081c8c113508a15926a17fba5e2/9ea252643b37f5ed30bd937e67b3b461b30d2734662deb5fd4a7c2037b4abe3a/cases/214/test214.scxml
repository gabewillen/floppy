<?xml version="1.0" encoding="UTF-8"?><!-- openai-12: target #_internal places the event on the internal queue. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<state id="s0">
  <onentry>
    <send event="external"/>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-call-first-internal" prompt="c"/>
  </onentry>
  <transition event="internal" target="s1"/>
  <transition event="external" target="fail"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <transition event="external" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>