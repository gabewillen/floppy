<?xml version="1.0" encoding="UTF-8"?><!-- openai-12: the first delayed call of a session has the send id openai.send.0, which cancel takes. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="xpath">
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-call-first-delay" prompt="c"/>
    <cancel sendid="openai.send.0"/>
    <send event="tick" delay="100ms"/>
  </onentry>
  <transition event="answer" target="fail"/>
  <transition event="tick" target="pass"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>