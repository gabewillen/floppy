<?xml version="1.0" encoding="UTF-8"?><!-- openai-9: a nested state is shown as the active atomic state. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="xpath">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0" initial="s01">
  <state id="s01">
    <onentry>
      <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-system" prompt="s" location="$Var1"/>
    </onentry>
    <transition cond="$Var1='s01'" target="pass"/>
    <transition target="fail"/>
  </state>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>