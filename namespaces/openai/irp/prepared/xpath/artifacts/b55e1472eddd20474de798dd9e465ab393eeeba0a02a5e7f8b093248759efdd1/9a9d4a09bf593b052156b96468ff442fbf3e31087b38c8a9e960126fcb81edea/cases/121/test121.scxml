<?xml version="1.0" encoding="UTF-8"?><!-- openai-3: empty parts are dropped. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="xpath">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-prompt" promptexpr="''" location="$Var1"><openai:prompt>   </openai:prompt><openai:prompt>only</openai:prompt></openai:generate>
  </onentry>
  <transition cond="$Var1='only'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>