<?xml version="1.0"?>
<!-- openai-12: a delayed call is dispatched when its delay elapses. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-call-first-delay" prompt="c"/>
    <send event="tick" delay="10ms"/>
  </onentry>
  <transition event="answer" conf:targetfail=""/>
  <transition event="tick" target="s1"/>
</state>
<state id="s1">
  <transition event="answer" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
