<?xml version="1.0"?>
<!-- openai-15: after a failure the block stops and the session keeps running. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-status-500" prompt="f" conf:location="1"/>
    <raise event="after"/>
  </onentry>
  <transition event="error.execution" target="s1"/>
  <transition event="*" conf:targetfail=""/>
</state>
<state id="s1">
  <onentry>
    <raise event="next"/>
  </onentry>
  <transition event="next" target="s2"/>
  <transition event="*" conf:targetfail=""/>
</state>
<state id="s2">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-reply" prompt="f" conf:location="1"/>
  </onentry>
  <transition conf:idQuoteVal="1=irp reply" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
