<?xml version="1.0"?>
<!-- openai-3: empty parts are dropped. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-prompt" promptexpr="''" conf:location="1"><openai:prompt>   </openai:prompt><openai:prompt>only</openai:prompt></openai:generate>
  </onentry>
  <transition conf:idQuoteVal="1=only" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
