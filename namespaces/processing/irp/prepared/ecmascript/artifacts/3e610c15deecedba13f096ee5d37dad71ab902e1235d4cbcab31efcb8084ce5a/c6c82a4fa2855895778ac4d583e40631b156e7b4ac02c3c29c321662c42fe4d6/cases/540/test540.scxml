<?xml version="1.0" encoding="UTF-8"?><!-- processing-5: the selection confidence is the least of the selections' confidences, each normalized to a whole 0-100 number, rounded half to even. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:processing="https://github.com/stateforward/floppy/namespaces/processing" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="selections" expr="[{&#34;event&#34;: &#34;a&#34;, &#34;confidence&#34;: 0.91}, {&#34;event&#34;: &#34;b&#34;, &#34;confidence&#34;: 0.425}, {&#34;event&#34;: &#34;c&#34;}]"/>
  <data id="confidence" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <processing:selection_confidence location="confidence" selections="selections"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="confidence === 42" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>