<?xml version="1.0" encoding="UTF-8"?><!-- processing-4: max puts maxItems on the events array; without it the array is unbounded. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:processing="https://github.com/stateforward/floppy/namespaces/processing" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="[{&#34;event&#34;: &#34;tool.go&#34;, &#34;schema&#34;: {&#34;type&#34;: &#34;object&#34;}, &#34;target&#34;: &#34;a&#34;}]"/>
  <data id="bounded" expr="null"/>
  <data id="unbounded" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <processing:send location="bounded" choices="choices" max="1"/>
    <processing:send location="unbounded" choices="choices"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="bounded.properties.events.maxItems === 1 &amp;&amp; !('maxItems' in unbounded.properties.events)" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>