<?xml version="1.0"?>
<!-- processing-5: the selection confidence is the least of the selections' confidences, each normalized to a whole 0-100 number, rounded half to even. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:processing="https://github.com/stateforward/floppy/namespaces/processing">
<datamodel>
  <data id="selections" expr='[{"event": "a", "confidence": 0.91}, {"event": "b", "confidence": 0.425}, {"event": "c"}]'/>
  <data id="confidence" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <processing:selection_confidence location="confidence" selections="selections"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="confidence === 42" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
