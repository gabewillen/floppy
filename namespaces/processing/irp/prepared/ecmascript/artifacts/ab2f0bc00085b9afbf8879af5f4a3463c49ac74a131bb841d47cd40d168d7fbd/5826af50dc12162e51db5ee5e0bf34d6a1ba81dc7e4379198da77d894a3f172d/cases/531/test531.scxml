<?xml version="1.0" encoding="UTF-8"?><!-- processing-4: data is required when its schema requires a field, a non-object schema is wrapped as value, a single target is a fixed enum, and the first branch's example is the events' example. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:processing="https://github.com/stateforward/floppy/namespaces/processing" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="[{&#34;event&#34;: &#34;tool.say&#34;, &#34;target&#34;: &#34;a&#34;, &#34;schema&#34;: {&#34;type&#34;: &#34;object&#34;, &#34;properties&#34;: {&#34;text&#34;: {&#34;type&#34;: &#34;string&#34;}}, &#34;required&#34;: [&#34;text&#34;], &#34;examples&#34;: [{&#34;text&#34;: &#34;hi&#34;}]}}, {&#34;event&#34;: &#34;bot.count&#34;, &#34;schema&#34;: {&#34;type&#34;: &#34;integer&#34;}}]"/>
  <data id="schema" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <processing:send location="schema" choices="choices"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="schema.properties.events.items.anyOf[0].required.join(',') === 'event,data,target' &amp;&amp; schema.properties.events.items.anyOf[0].properties.target.enum.join(',') === 'a' &amp;&amp; schema.properties.events.examples.length === 2 &amp;&amp; schema.properties.events.examples[1].data.text === 'hi' &amp;&amp; schema.properties.events.examples[1].target === 'a' &amp;&amp; schema.properties.events.items.anyOf[1].properties.data.required.join(',') === 'value' &amp;&amp; schema.properties.events.items.anyOf[1].properties.data.properties.value.type === 'integer' &amp;&amp; schema.properties.events.items.anyOf[1].required.join(',') === 'event,data'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>