<?xml version="1.0"?>
<!-- processing-4: data is required when its schema requires a field, a non-object schema is wrapped as value, a single target is a fixed enum, and the first branch's example is the events' example. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:processing="https://github.com/stateforward/floppy/namespaces/processing">
<datamodel>
  <data id="choices" expr='[{"event": "tool.say", "target": "a", "schema": {"type": "object", "properties": {"text": {"type": "string"}}, "required": ["text"], "examples": [{"text": "hi"}]}}, {"event": "bot.count", "schema": {"type": "integer"}}]'/>
  <data id="schema" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <processing:send location="schema" choices="choices"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="schema.properties.events.items.anyOf[0].required.join(',') === 'event,data,target' &amp;&amp; schema.properties.events.items.anyOf[0].properties.target.enum.join(',') === 'a' &amp;&amp; schema.properties.events.examples.length === 2 &amp;&amp; schema.properties.events.examples[1].data.text === 'hi' &amp;&amp; schema.properties.events.examples[1].target === 'a' &amp;&amp; schema.properties.events.items.anyOf[1].properties.data.required.join(',') === 'value' &amp;&amp; schema.properties.events.items.anyOf[1].properties.data.properties.value.type === 'integer' &amp;&amp; schema.properties.events.items.anyOf[1].required.join(',') === 'event,data'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
