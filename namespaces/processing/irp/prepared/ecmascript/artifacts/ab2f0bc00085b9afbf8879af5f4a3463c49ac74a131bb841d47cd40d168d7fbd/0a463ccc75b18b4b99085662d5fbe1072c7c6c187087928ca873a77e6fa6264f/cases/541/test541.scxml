<?xml version="1.0" encoding="UTF-8"?><!-- processing-5: with no selection carrying a confidence the confidence is null. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:processing="https://github.com/stateforward/floppy/namespaces/processing" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="confidence" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <processing:selection_confidence location="confidence" selections="[{event: 'a'}]"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="confidence === null" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>