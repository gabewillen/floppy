<?xml version="1.0"?>
<!-- processing-6: a model_facing_schema location that does not hold choices raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:processing="https://github.com/stateforward/floppy/namespaces/processing">
<datamodel>
  <data id="choices" expr="'untouched'"/>
  <data id="over" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <processing:model_facing_schema location="choices" overlocation="over"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="choices === 'untouched' &amp;&amp; over === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
