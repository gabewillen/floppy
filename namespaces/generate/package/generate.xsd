<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of nemobot's `generate` extension namespace (namespaces/generate).
  It governs structure only; the extension component governs what the element
  does. Bind it with the prefix `gen` by convention.

  gen:generate  location (required); model | modelexpr (exactly one at run
                time); expr | one gen:content child (exactly one at run
                time); system | systemexpr (at most one); schemaexpr | one
                gen:schema child (at most one), with schemaname and strict;
                the host's env slots env:apikey (required at run time) and
                env:baseurl (optional), or their expr forms, admitted by the
                ##other wildcard and checked against the manifest
  gen:content   the prompt as text; no elements
  gen:schema    a JSON Schema as text; no elements
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:gen="https://github.com/stateforward/nemobot/namespaces/generate@v0.1.0"
           targetNamespace="https://github.com/stateforward/nemobot/namespaces/generate@v0.1.0"
           elementFormDefault="qualified">
  <xs:element name="generate">
    <xs:complexType>
      <xs:all>
        <xs:element ref="gen:content" minOccurs="0"/>
        <xs:element ref="gen:schema" minOccurs="0"/>
      </xs:all>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="model" type="xs:string"/>
      <xs:attribute name="modelexpr" type="xs:string"/>
      <xs:attribute name="expr" type="xs:string"/>
      <xs:attribute name="system" type="xs:string"/>
      <xs:attribute name="systemexpr" type="xs:string"/>
      <xs:attribute name="schemaexpr" type="xs:string"/>
      <xs:attribute name="schemaname">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[A-Za-z0-9_\-]{1,64}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="strict">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="true"/>
            <xs:enumeration value="false"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:anyAttribute namespace="##other" processContents="lax"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="content">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="schema">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string"/>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
