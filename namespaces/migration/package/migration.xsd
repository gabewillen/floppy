<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of floppy's `migration` extension namespace
  (namespaces/migration). It governs structure only; the extension
  component governs what the element does. Bind it with the prefix
  `migration` by convention.

  migration:plan  location (required): receives the plan {from, to, steps}.
                  revisions, current (required), target (optional, default
                  head): expressions of Alembic's revisions
                  [{revision, down_revision, upgrade, downgrade}], the
                  current revision (or null), and the target (head, base,
                  a revision, +N or -N).
                  It takes no other attribute and no content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/floppy/namespaces/migration"
           elementFormDefault="qualified">
  <xs:element name="plan">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="revisions" type="xs:string" use="required"/>
      <xs:attribute name="current" type="xs:string" use="required"/>
      <xs:attribute name="target" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
