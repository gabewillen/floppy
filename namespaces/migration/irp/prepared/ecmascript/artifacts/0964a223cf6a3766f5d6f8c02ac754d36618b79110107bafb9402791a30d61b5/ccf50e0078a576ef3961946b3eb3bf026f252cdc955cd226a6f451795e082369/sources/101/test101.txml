<?xml version="1.0"?>
<!-- migration-1: a plan with an attribute the schema does not declare raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:migration="https://github.com/stateforward/floppy/namespaces/migration">
<datamodel>
  <data id="revisions" expr="[]"/>
  <data id="l" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <migration:plan location="l" revisions="revisions" current="null" engine="sqlite"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="l === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
