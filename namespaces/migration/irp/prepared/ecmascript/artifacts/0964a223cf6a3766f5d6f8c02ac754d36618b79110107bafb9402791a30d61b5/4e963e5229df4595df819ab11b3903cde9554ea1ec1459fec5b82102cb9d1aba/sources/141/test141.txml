<?xml version="1.0"?>
<!-- migration-5: a down_revision the history does not hold raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:migration="https://github.com/stateforward/floppy/namespaces/migration">
<datamodel>
  <data id="revisions" expr='[{"revision": "a", "down_revision": null, "upgrade": [], "downgrade": []}, {"revision": "b", "down_revision": "z", "upgrade": [], "downgrade": []}]'/>
  <data id="plan" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <migration:plan location="plan" revisions="revisions" current="null"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="plan === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
