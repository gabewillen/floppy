<?xml version="1.0" encoding="UTF-8"?><!-- migration-3: downgrading to base plans every applied revision, newest first, with its downgrade statements, and to is null. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:migration="https://github.com/stateforward/floppy/namespaces/migration" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="revisions" expr="[{&#34;revision&#34;: &#34;a&#34;, &#34;down_revision&#34;: null, &#34;upgrade&#34;: [{&#34;sql&#34;: &#34;up a&#34;}], &#34;downgrade&#34;: [{&#34;sql&#34;: &#34;down a&#34;}]}, {&#34;revision&#34;: &#34;b&#34;, &#34;down_revision&#34;: &#34;a&#34;, &#34;upgrade&#34;: [{&#34;sql&#34;: &#34;up b&#34;}], &#34;downgrade&#34;: [{&#34;sql&#34;: &#34;down b&#34;}]}, {&#34;revision&#34;: &#34;c&#34;, &#34;down_revision&#34;: &#34;b&#34;, &#34;upgrade&#34;: [{&#34;sql&#34;: &#34;up c&#34;}], &#34;downgrade&#34;: [{&#34;sql&#34;: &#34;down c&#34;}]}]"/>
  <data id="plan" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <migration:plan location="plan" revisions="revisions" current="'c'" target="'base'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="plan.from === 'c' &amp;&amp; plan.to === null &amp;&amp; plan.steps.map(function (s) { return s.revision + ':' + s.direction + ':' + s.statements[0].sql; }).join(',') === 'c:downgrade:down c,b:downgrade:down b,a:downgrade:down a'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>