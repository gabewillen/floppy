<?xml version="1.0" encoding="UTF-8"?><!-- migration-1: a plan with an empty attribute raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:migration="https://github.com/stateforward/floppy/namespaces/migration" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="revisions" expr="[]"/>
  <data id="l" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <migration:plan location="l" revisions="revisions" current="null" target=""/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="l === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>