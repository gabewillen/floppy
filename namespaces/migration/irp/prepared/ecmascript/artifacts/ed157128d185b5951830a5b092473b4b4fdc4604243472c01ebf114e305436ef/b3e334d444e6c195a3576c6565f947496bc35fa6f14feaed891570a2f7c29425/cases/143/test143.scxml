<?xml version="1.0" encoding="UTF-8"?><!-- migration-5: revisions that are not an array raise error.execution and assign nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:migration="https://github.com/stateforward/floppy/namespaces/migration" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="revisions" expr="{&#34;revision&#34;: &#34;a&#34;}"/>
  <data id="plan" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <migration:plan location="plan" revisions="revisions" current="null"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="plan === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>