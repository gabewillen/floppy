<?xml version="1.0"?>
<!-- conversation-3: the relationship context reference groups the identities, is the same in either direction, and is assigned to keylocation. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="inbound" expr='{"source_ids": ["user"], "target_ids": ["bot"], "content_type": "text/plain"}'/>
  <data id="outbound" expr='{"source_ids": ["bot"], "target_ids": ["user"], "content_type": "text/plain"}'/>
  <data id="i" expr="null"/>
  <data id="o" expr="null"/>
  <data id="ki" expr="null"/>
  <data id="ko" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="i" keylocation="ki" direction="inbound" event="'e'" message="inbound" sequence="0"/>
    <conversation:commit location="o" keylocation="ko" direction="outbound" event="'e'" message="outbound" sequence="1"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="ki === ko &amp;&amp; ki === '{&quot;identity_groups&quot;:[[&quot;bot&quot;],[&quot;user&quot;]]}'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
