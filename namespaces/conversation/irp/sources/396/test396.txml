<?xml version="1.0"?>
<!-- conversation-11: a weight that is not a whole number raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="f" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:fold_voices location="f" centroid="'i8:fwA='" weight="-1" voices="[]"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="f === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
