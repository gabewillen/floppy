<?xml version="1.0"?>
<!-- conversation-5: a negative sequence raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="msg" expr='{"source_ids": ["user"], "target_ids": ["bot"], "content": "hello", "content_type": "text/plain", "extra": 1}'/>
  <data id="m" expr="'untouched'"/>
  <data id="k" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="m" keylocation="k" direction="inbound" event="'e'" message="msg" sequence="-1"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="m === 'untouched' &amp;&amp; k === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
