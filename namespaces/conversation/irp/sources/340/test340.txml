<?xml version="1.0"?>
<!-- conversation-5: a name is its own track, an embedding track- and its unit vector, and no source no track. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="a" expr="null"/>
  <data id="b" expr="null"/>
  <data id="c" expr="'unset'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:new_track_ref location="a" source="'alice'"/>
    <conversation:new_track_ref location="b" source="[3, 4]"/>
    <conversation:new_track_ref location="c" source="null"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="a === 'alice' &amp;&amp; b === 'track-[0.6,0.8]' &amp;&amp; c === null" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
