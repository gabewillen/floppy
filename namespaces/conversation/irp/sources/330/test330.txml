<?xml version="1.0"?>
<!-- conversation-4: a provenance's string id, source, target, session_ref and its turn_ref are taken; a non-string one is null. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="msg" expr='{"source_ids": ["user"], "target_ids": ["bot"], "content": "hello", "content_type": "text/plain", "extra": 1}'/>
  <data id="p" expr='{"id": "ev1", "source": "listening", "target": 7, "session_ref": "s1", "turn_ref": {"turn": 2}}'/>
  <data id="m" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="m" direction="inbound" event="'e'" message="msg" sequence="0" provenance="p"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="m.provenance.id === 'ev1' &amp;&amp; m.provenance.source === 'listening' &amp;&amp; m.provenance.target === null &amp;&amp; m.provenance.session_ref === 's1' &amp;&amp; m.provenance.turn_ref.turn === 2" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
