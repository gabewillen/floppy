<?xml version="1.0"?>
<!-- conversation-4: a participant is added once and dropped on a failed turn. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="rs" expr="[({session_ref: 'relationship-a', context_ref: 'a', source_ids: ['alice'], target_ids: ['bot'], participants: [], sequences: []})]"/>
  <data id="once" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:participant_for_source location="rs[0]" source="'alice'"/>
    <conversation:participant_for_source location="rs[0]" source="'alice'"/>
    <assign location="once" expr="rs[0].participants.length"/>
    <conversation:fail_turn location="rs[0]" source="'alice'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="once === 1 &amp;&amp; rs[0].participants.length === 0 &amp;&amp; rs[0].session_ref === 'relationship-a'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
