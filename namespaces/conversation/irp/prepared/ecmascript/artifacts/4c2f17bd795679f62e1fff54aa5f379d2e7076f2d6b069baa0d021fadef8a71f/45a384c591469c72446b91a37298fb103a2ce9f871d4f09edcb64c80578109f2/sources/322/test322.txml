<?xml version="1.0"?>
<!-- conversation-3: targetless input shares the first ambient relationship. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="rs" expr="[({session_ref: 'relationship-a', context_ref: 'a', source_ids: ['alice'], target_ids: ['bot'], participants: []}), ({session_ref: 'relationship-b', context_ref: 'b', source_ids: ['bob'], target_ids: [], participants: []})]"/>
  <data id="i" expr="null"/>
  <data id="input" expr="({source_ids: ['carol'], target_ids: []})"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:relationship_for_input location="rs" indexlocation="i" input="input"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="i === 1 &amp;&amp; rs.length === 2" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
