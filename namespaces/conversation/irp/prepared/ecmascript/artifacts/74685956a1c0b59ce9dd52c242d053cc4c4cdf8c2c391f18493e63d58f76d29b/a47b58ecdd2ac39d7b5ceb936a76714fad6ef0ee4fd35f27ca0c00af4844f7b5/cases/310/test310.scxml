<?xml version="1.0" encoding="UTF-8"?><!-- conversation-2: an inbound message drops audio content and other members, and takes its relationship's reference. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="l" expr="null"/>
  <data id="msg" expr="({source_ids: ['alice'], target_ids: [], content: 'AAAA', content_type: 'Audio/PCM', extra: 1})"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:message_for_turn location="l" direction="inbound" event="'bot.ability.conversation.input'" message="msg" sequence="2"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="l.sequence === 2 &amp;&amp; l.direction === 'inbound' &amp;&amp; l.content === null &amp;&amp; l.extra === undefined &amp;&amp; l.provenance.event === 'bot.ability.conversation.input' &amp;&amp; l.provenance.session_ref === 'relationship-{&#34;identity_groups&#34;:[[],[&#34;alice&#34;]]}'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>