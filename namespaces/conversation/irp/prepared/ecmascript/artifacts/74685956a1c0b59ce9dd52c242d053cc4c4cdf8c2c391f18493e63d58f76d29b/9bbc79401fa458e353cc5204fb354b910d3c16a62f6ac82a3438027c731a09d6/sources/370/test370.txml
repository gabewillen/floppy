<?xml version="1.0"?>
<!-- conversation-8: relationships that are not an array raise error.execution and assign nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="rs" expr="'untouched'"/>
  <data id="i" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:relationship_for_input location="rs" indexlocation="i" input="({source_ids: [], target_ids: []})"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="rs === 'untouched' &amp;&amp; i === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
