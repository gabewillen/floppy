<?xml version="1.0" encoding="UTF-8"?><!-- conversation-4: a participant is added once and dropped on a failed turn. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="rs" expr="[({session_ref: 'relationship-a', context_ref: 'a', source_ids: ['alice'], target_ids: ['bot'], participants: [], sequences: []})]"/>
  <data id="once" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:participant_for_source location="rs[0]" source="'alice'"/>
    <conversation:participant_for_source location="rs[0]" source="'alice'"/>
    <assign location="once" expr="rs[0].participants.length"/>
    <conversation:fail_turn location="rs[0]" source="'alice'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="once === 1 &amp;&amp; rs[0].participants.length === 0 &amp;&amp; rs[0].session_ref === 'relationship-a'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>