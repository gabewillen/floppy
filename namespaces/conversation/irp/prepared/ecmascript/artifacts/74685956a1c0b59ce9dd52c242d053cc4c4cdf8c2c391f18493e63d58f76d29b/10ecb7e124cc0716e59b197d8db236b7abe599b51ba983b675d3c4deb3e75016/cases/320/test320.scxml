<?xml version="1.0" encoding="UTF-8"?><!-- conversation-3: the first input begins a relationship with its context reference. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="rs" expr="[]"/>
  <data id="i" expr="null"/>
  <data id="input" expr="({source_ids: ['zed', 'alice'], target_ids: ['bot']})"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:relationship_for_input location="rs" indexlocation="i" input="input"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="i === 0 &amp;&amp; rs.length === 1 &amp;&amp; rs[0].context_ref === '{&#34;identity_groups&#34;:[[&#34;alice&#34;,&#34;zed&#34;],[&#34;bot&#34;]]}' &amp;&amp; rs[0].session_ref === 'relationship-' + rs[0].context_ref &amp;&amp; rs[0].source_ids.join() === 'alice,zed' &amp;&amp; rs[0].participants.length === 0 &amp;&amp; rs[0].sequences.length === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>