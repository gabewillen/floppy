<?xml version="1.0" encoding="UTF-8"?><!-- conversation-9: carried participants that are not {ref, role} raise error.execution and assign nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="'untouched'"/>
  <data id="i" expr="({source_ids: ['ann'], target_ids: []})"/>
  <data id="e" expr="({data: {participants: [{ref: 'ann', role: 'speaker'}]}})"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:turn_participants location="p" input="i" parent="e"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="p === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>