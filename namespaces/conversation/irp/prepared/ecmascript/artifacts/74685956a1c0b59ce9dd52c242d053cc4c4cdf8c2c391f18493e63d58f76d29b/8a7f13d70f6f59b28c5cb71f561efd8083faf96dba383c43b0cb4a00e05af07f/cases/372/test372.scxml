<?xml version="1.0" encoding="UTF-8"?><!-- conversation-8: no turns raise error.execution and assign nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="m" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:complete_turn location="m" event="'e'" input="({source_ids: [], target_ids: [], content_type: 'text/plain'})" turns="[]" session_ref="'r'" sequence="0"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="m === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>