<?xml version="1.0" encoding="UTF-8"?><!-- conversation-1: the removed commit element raises error.execution. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="l" expr="'untouched'"/>
  <data id="msg" expr="({source_ids: ['alice'], target_ids: [], content: 'AAAA', content_type: 'Audio/PCM', extra: 1})"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="l" direction="inbound" event="'e'" message="msg" sequence="0"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="l === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>