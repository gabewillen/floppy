<?xml version="1.0"?>
<!-- conversation-3: the first input begins a relationship with its context reference. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="rs" expr="[]"/>
  <data id="i" expr="null"/>
  <data id="input" expr="({source_ids: ['zed', 'alice'], target_ids: ['bot']})"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:relationship_for_input location="rs" indexlocation="i" input="input"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="i === 0 &amp;&amp; rs.length === 1 &amp;&amp; rs[0].context_ref === '{&quot;identity_groups&quot;:[[&quot;alice&quot;,&quot;zed&quot;],[&quot;bot&quot;]]}' &amp;&amp; rs[0].session_ref === 'relationship-' + rs[0].context_ref &amp;&amp; rs[0].source_ids.join() === 'alice,zed' &amp;&amp; rs[0].participants.length === 0 &amp;&amp; rs[0].sequences.length === 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
