<?xml version="1.0" encoding="UTF-8"?><!-- conversation-1: an on_end with content raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="l" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:on_end location="l" turn="null" participant_ref="'a'" conversation_ref="'c'" turn_ref="'t'" source_participant_ref="'a'">x</conversation:on_end>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="l === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>