<?xml version="1.0" encoding="UTF-8"?><!-- conversation-7: audio keeps its chunks and the first rate and channels. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="t" expr="null"/>
  <data id="closed" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:ingest_content location="t" content="({kind: 'audio', content: 'a.pcm', sample_rate_hz: 16000})"/>
    <conversation:ingest_content location="t" content="({kind: 'audio', content: 'b.pcm', sample_rate_hz: 8000, channels: 2})"/>
    <conversation:on_end location="closed" turn="t" participant_ref="'alice'" conversation_ref="'c'" turn_ref="'t1'" source_participant_ref="'alice'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="closed.turn.audio.join() === 'a.pcm,b.pcm' &amp;&amp; closed.turn.content_type === 'audio/pcm' &amp;&amp; closed.turn.sample_rate_hz === 16000 &amp;&amp; closed.turn.channels === 2" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>