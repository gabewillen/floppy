<?xml version="1.0"?>
<!-- conversation-10: two people within the margin of a voice leave it no one's, and a damaged voice row is skipped. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="p" expr="null"/>
  <data id="input" expr="({source_ids: [[1, 0]], target_ids: []})"/>
  <data id="voices" expr="[['person-1', '[1,0]'], ['person-2', '[0.96,0.28]'], ['person-3', 'damaged'], 7]"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:people_for_input location="p" input="input" voices="voices" count="3"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="p.input.source_ids.join() === 'person-4' &amp;&amp; p.people.join() === 'person-4' &amp;&amp; p.voices.length === 1" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
