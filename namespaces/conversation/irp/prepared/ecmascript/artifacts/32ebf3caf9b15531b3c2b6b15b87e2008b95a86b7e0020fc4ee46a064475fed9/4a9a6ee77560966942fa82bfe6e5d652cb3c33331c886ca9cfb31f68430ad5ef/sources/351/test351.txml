<?xml version="1.0"?>
<!-- conversation-6: without text, audio has no content and other content is kept. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="a" expr="null"/>
  <data id="c" expr="null"/>
  <data id="turns" expr="[{turn_ref: 't1', text: ''}]"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:complete_turn location="a" event="'e'" input="({source_ids: ['a'], target_ids: [], content: 'media/a.pcm', content_type: 'audio/pcm'})" turns="turns" session_ref="'r'"/>
    <conversation:complete_turn location="c" event="'e'" input="({source_ids: ['a'], target_ids: [], content: {k: 1}, content_type: 'application/json'})" turns="turns" session_ref="'r'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="a.content === null &amp;&amp; a.content_type === 'audio/pcm' &amp;&amp; c.content.k === 1" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
