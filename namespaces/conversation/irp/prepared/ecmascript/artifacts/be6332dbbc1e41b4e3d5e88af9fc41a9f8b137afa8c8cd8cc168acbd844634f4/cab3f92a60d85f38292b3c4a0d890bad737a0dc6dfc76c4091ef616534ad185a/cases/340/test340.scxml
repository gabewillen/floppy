<?xml version="1.0" encoding="UTF-8"?><!-- conversation-5: a name is its own track, an embedding track- and its unit vector, and no source no track. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="a" expr="null"/>
  <data id="b" expr="null"/>
  <data id="c" expr="'unset'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:new_track_ref location="a" source="'alice'"/>
    <conversation:new_track_ref location="b" source="[3, 4]"/>
    <conversation:new_track_ref location="c" source="null"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="a === 'alice' &amp;&amp; b === 'track-[0.6,0.8]' &amp;&amp; c === null" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>