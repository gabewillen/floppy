<?xml version="1.0" encoding="UTF-8"?><!-- conversation-4: the detector references are ordered by relationship and then identity. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="refs" expr="null"/>
  <data id="rs" expr="[({session_ref: 'relationship-b', participants: ['bob', [3, 4], 'alice']}), ({session_ref: 'relationship-a', participants: ['zed']})]"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:detector_refs location="refs" relationships="rs"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="JSON.stringify(refs) === '[[&#34;relationship-a&#34;,&#34;zed&#34;],[&#34;relationship-b&#34;,&#34;alice&#34;],[&#34;relationship-b&#34;,&#34;bob&#34;],[&#34;relationship-b&#34;,[3,4]]]'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>