<?xml version="1.0"?>
<!-- conversation-8: a source that is not an identity raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="r" expr="({session_ref: 'relationship-a', context_ref: 'a', source_ids: ['alice'], target_ids: ['bot'], participants: [], sequences: []})"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:participant_for_source location="r" source="({id: 1})"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="r.participants.length === 0" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
