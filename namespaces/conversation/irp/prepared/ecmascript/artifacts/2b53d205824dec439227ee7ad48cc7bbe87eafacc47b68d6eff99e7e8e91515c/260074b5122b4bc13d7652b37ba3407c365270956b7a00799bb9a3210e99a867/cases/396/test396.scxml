<?xml version="1.0" encoding="UTF-8"?><!-- conversation-11: a weight that is not a whole number raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="f" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:fold_voices location="f" centroid="'i8:fwA='" weight="-1" voices="[]"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="f === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>