<?xml version="1.0" encoding="UTF-8"?><!-- conversation-11: merged_context_refs writes each relationship context reference that names the merged person with the reference its groups make once the person is the other. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="r" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:merged_context_refs location="r" refs="['{&#34;identity_groups&#34;:[[],[&#34;person-10&#34;,&#34;person-2&#34;]]}', '{&#34;identity_groups&#34;:[[],[&#34;person-3&#34;]]}', 'damaged']" from="'person-2'" into="'person-10'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="r.length === 1 &amp;&amp; r[0][1] === '{&#34;identity_groups&#34;:[[],[&#34;person-10&#34;]]}'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>