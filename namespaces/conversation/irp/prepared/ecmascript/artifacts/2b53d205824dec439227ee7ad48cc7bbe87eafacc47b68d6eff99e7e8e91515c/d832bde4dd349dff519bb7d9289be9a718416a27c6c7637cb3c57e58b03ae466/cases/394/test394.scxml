<?xml version="1.0" encoding="UTF-8"?><!-- conversation-11: people_to_merge takes the most alike pair at 0.85 or more, the newer into the older, with their weighted representative; with none alike enough it writes null. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="m" expr="null"/>
  <data id="none" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:people_to_merge location="m" people="[['person-1', 'i8:fwA=', 3], ['person-2', 'i8:AH8=', 1], ['person-3', 'i8:fwY=', 1]]"/>
    <conversation:people_to_merge location="none" people="[['person-1', 'i8:fwA=', 1], ['person-2', 'i8:AH8=', 1]]"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="m.into === 'person-1' &amp;&amp; m.from === 'person-3' &amp;&amp; m.weight === 4 &amp;&amp; m.centroid === 'i8:fwE=' &amp;&amp; none === null" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>