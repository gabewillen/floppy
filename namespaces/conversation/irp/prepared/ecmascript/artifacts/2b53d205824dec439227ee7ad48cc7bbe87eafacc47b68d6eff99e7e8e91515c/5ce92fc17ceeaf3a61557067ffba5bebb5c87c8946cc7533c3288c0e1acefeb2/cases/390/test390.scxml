<?xml version="1.0" encoding="UTF-8"?><!-- conversation-10: a voice memory holds is its person, a voice no one has a new person numbered on after the sequence, and a new person's first voice is its representative, and every voice heard is to be stored. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="input" expr="({source_ids: [[0.3, 0.95], 'alice', [0.96, -0.28]], target_ids: ['floppy'], content: 'hi'})"/>
  <data id="voices" expr="[['person-1', 'i8:JHo=']]"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:people_for_input location="p" input="input" voices="voices" after="1"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="p.input.content === 'hi' &amp;&amp; p.input.source_ids.join() === 'person-1,alice,person-2' &amp;&amp; p.input.target_ids.join() === 'floppy' &amp;&amp; p.people.join() === 'person-2' &amp;&amp; JSON.stringify(p.representatives) === '[[&#34;person-2&#34;,&#34;i8:etw=&#34;]]' &amp;&amp; JSON.stringify(p.voices) === '[[&#34;person-1&#34;,&#34;[0.3,0.95]&#34;],[&#34;person-2&#34;,&#34;[0.96,-0.28]&#34;]]'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>