<?xml version="1.0"?>
<!-- conversation-8: a stimulus that is not an object or null raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="t" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:ingest_content location="t" content="'hi'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="t === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
