<?xml version="1.0"?>
<!-- conversation-3: without a provenance, an inbound message's session_ref is its relationship reference and an outbound one's is null. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="inbound" expr='{"source_ids": ["user"], "target_ids": ["bot"], "content_type": "text/plain"}'/>
  <data id="i" expr="null"/>
  <data id="o" expr="null"/>
  <data id="k" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="i" keylocation="k" direction="inbound" event="'e'" message="inbound" sequence="0"/>
    <conversation:commit location="o" direction="outbound" event="'e'" message="inbound" sequence="1"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="i.provenance.session_ref === 'relationship-' + k &amp;&amp; o.provenance.session_ref === null &amp;&amp; i.provenance.id === null &amp;&amp; i.provenance.turn_ref === null" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
