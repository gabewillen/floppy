<?xml version="1.0" encoding="UTF-8"?><!-- conversation-2: inbound audio content is null; outbound content is kept as given. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="msg" expr="{&#34;source_ids&#34;: [&#34;user&#34;], &#34;target_ids&#34;: [&#34;bot&#34;], &#34;content&#34;: &#34;media/said.wav&#34;, &#34;content_type&#34;: &#34;Audio/WAV&#34;}"/>
  <data id="i" expr="null"/>
  <data id="o" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="i" direction="inbound" event="'e'" message="msg" sequence="0"/>
    <conversation:commit location="o" direction="outbound" event="'e'" message="msg" sequence="1"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="i.content === null &amp;&amp; o.content === 'media/said.wav'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>