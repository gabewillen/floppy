<?xml version="1.0"?>
<!-- conversation-2: inbound audio content is null; outbound content is kept as given. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation">
<datamodel>
  <data id="msg" expr='{"source_ids": ["user"], "target_ids": ["bot"], "content": "media/said.wav", "content_type": "Audio/WAV"}'/>
  <data id="i" expr="null"/>
  <data id="o" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="i" direction="inbound" event="'e'" message="msg" sequence="0"/>
    <conversation:commit location="o" direction="outbound" event="'e'" message="msg" sequence="1"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="i.content === null &amp;&amp; o.content === 'media/said.wav'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
