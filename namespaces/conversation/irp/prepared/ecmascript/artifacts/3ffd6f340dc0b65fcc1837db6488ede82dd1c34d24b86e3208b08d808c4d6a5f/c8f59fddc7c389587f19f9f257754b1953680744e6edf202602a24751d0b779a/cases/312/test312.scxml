<?xml version="1.0" encoding="UTF-8"?><!-- conversation-2: a message without content commits null content. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="msg" expr="{&#34;source_ids&#34;: [&#34;user&#34;], &#34;target_ids&#34;: [&#34;bot&#34;], &#34;content_type&#34;: &#34;text/plain&#34;}"/>
  <data id="m" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <conversation:commit location="m" direction="inbound" event="'e'" message="msg" sequence="0"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="('content' in m) &amp;&amp; m.content === null" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>