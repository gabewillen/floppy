<?xml version="1.0"?>
<!-- env-6: each element sends the value of the variable it names. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OTHER_KEY" model="irp-echo-authorization" prompt="k" conf:location="1"/>
  </onentry>
  <transition conf:idQuoteVal="1=other-key" target="s1"/>
  <transition conf:targetfail=""/>
</state>
<state id="s1">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-authorization" prompt="k" conf:location="1"/>
  </onentry>
  <transition conf:idQuoteVal="1=key" target="s2"/>
  <transition conf:targetfail=""/>
</state>
<state id="s2">
  <onentry>
    <openai:generate model="irp-reply" prompt="k" conf:location="1"/>
  </onentry>
  <transition event="error.execution" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
