<?xml version="1.0"?>
<!-- env-7: a base URL value that supplies no origin is refused before it is sent. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:example="https://stateforward.org/scxml/example" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env">
<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <onentry>
    <example:fetch env:url="IRP_NO_ORIGIN_BASE_URL" path="/ok"/>
  </onentry>
  <transition event="error.execution" target="s1"/>
  <transition event="*" conf:targetfail=""/>
</state>
<state id="s1">
  <onentry>
    <example:fetch env:url="IRP_BASE_URL" path="/requests/0"/>
  </onentry>
  <transition event="example.fetched" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
