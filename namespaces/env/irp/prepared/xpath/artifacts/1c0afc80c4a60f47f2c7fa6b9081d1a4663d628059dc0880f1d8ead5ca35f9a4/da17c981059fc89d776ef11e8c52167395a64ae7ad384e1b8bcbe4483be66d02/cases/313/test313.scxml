<?xml version="1.0" encoding="UTF-8"?><!-- env-2: a string that is not a variable name raises error.execution (the slot is not left absent). --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="xpath">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" env:baseurlexpr="'not a name'" model="irp-reply" prompt="u" location="$Var1"/>
  </onentry>
  <transition event="error.execution" target="s1"/>
  <transition event="*" target="fail"/>
</state>
<state id="s1">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" model="irp-echo-requests" prompt="count" location="$Var1"/>
  </onentry>
  <transition cond="$Var1='0'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>