<?xml version="1.0" encoding="UTF-8"?><!-- env-2: env:baseurlexpr binds the variable its value names. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env" xmlns:openai="https://github.com/stateforward/scxml.rs/namespaces/openai@v0.2.0" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="Var1"/>
</datamodel>
<state id="s0">
  <onentry>
    <openai:generate env:apikey="IRP_OPENAI_KEY" env:baseurlexpr="'IRP_BASE_URL'" model="irp-echo-url" prompt="u" location="Var1"/>
  </onentry>
  <transition cond="Var1=='https://openai.irp.invalid/v1/responses'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>