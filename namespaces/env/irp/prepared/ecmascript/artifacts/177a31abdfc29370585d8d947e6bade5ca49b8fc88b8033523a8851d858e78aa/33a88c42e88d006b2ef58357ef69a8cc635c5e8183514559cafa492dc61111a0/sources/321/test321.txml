<datamodel>
  <data conf:id="1"/>
</datamodel>
<state id="s0">
  <invoke typeexpr="'https://stateforward.org/scxml/services/echo'" env:endpoint="not a name"/>
  <transition conf:targetpass=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
