<?xml version="1.0" encoding="UTF-8"?><!-- identity-3: ids that are not an array of identities raise error.execution and assign nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:identity="https://github.com/stateforward/floppy/namespaces/identity" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="s" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <identity:sorted_identities location="s" ids="[{a: 1}]"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="s === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>