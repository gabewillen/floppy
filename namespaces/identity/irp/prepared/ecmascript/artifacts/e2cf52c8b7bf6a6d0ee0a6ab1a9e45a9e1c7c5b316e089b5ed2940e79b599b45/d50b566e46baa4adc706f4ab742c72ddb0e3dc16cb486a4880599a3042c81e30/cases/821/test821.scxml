<?xml version="1.0" encoding="UTF-8"?><!-- identity-3: embeddings sort by their Python JSON text, so 1e-05 sorts after 0.5. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:identity="https://github.com/stateforward/floppy/namespaces/identity" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="ids" expr="[[0.5], [0.00001], [10]]"/>
  <data id="s" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <identity:sorted_identities location="s" ids="ids"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="JSON.stringify(s) === '[[0.5],[10],[0.00001]]'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>