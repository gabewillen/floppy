<?xml version="1.0"?>
<!-- identity-1: a hears_name without a text raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:identity="https://github.com/stateforward/floppy/namespaces/identity">
<datamodel>
  <data id="heard" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <identity:hears_name location="heard" name="'Al'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="heard === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
