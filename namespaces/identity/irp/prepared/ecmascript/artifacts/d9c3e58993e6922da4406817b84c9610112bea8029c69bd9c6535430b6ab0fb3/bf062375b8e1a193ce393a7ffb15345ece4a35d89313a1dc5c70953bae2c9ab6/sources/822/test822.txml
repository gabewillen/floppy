<?xml version="1.0"?>
<!-- identity-3: ids that are not an array of identities raise error.execution and assign nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:identity="https://github.com/stateforward/floppy/namespaces/identity">
<datamodel>
  <data id="s" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <identity:sorted_identities location="s" ids="[{a: 1}]"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="s === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
