<?xml version="1.0" encoding="UTF-8"?><!-- identity-1: a hears_name without a text raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:identity="https://github.com/stateforward/floppy/namespaces/identity" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="heard" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <identity:hears_name location="heard" name="'Al'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="heard === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>