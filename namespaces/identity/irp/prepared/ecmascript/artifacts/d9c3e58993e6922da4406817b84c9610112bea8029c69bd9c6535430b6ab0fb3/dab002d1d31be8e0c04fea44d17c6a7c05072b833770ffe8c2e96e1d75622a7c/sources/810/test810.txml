<?xml version="1.0"?>
<!-- identity-2: a name is heard as a whole run of the text's case-folded letter-and-digit tokens. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:identity="https://github.com/stateforward/floppy/namespaces/identity">
<datamodel>
  <data id="heard" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <identity:hears_name location="heard" name="'Floppy Bot'" text="'hey, FLOPPY  bot!'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="heard === true" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
