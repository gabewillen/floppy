<?xml version="1.0"?>
<!-- intuition-4: an escalated confidence that is a boolean raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:intuition="https://github.com/stateforward/floppy/namespaces/intuition">
<datamodel>
  <data id="e" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <intuition:escalate location="e" confidence="true" tuner="null"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="e === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
