<?xml version="1.0"?>
<!-- intuition-1: an observe without a confidence raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:intuition="https://github.com/stateforward/floppy/namespaces/intuition">
<datamodel>
  <data id="t" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <intuition:observe location="t"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="t === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
