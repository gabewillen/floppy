<?xml version="1.0" encoding="UTF-8"?><!-- intuition-4: an observed confidence that is a string raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:intuition="https://github.com/stateforward/floppy/namespaces/intuition" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="t" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <intuition:observe location="t" confidence="'high'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="t === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>