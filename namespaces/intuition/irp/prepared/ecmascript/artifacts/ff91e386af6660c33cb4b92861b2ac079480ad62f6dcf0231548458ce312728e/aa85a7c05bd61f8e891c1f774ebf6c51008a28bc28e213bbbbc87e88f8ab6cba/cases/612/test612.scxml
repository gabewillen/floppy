<?xml version="1.0" encoding="UTF-8"?><!-- intuition-2: a later observation moves the mean and variance by the EMA. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:intuition="https://github.com/stateforward/floppy/namespaces/intuition" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="t" expr="{&#34;mean&#34;: 70, &#34;var&#34;: 100, &#34;n&#34;: 8}"/>
</datamodel>
<state id="s0">
  <onentry>
    <intuition:observe location="t" confidence="34"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="Math.abs(t.mean - 67.12) &lt; 1e-9 &amp;&amp; Math.abs(t['var'] - 195.68) &lt; 1e-9 &amp;&amp; t.n === 9" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>