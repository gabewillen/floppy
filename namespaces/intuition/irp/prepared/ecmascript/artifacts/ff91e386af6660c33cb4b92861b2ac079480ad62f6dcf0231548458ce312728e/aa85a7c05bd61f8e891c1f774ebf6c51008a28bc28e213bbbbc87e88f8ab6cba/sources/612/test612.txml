<?xml version="1.0"?>
<!-- intuition-2: a later observation moves the mean and variance by the EMA. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:intuition="https://github.com/stateforward/floppy/namespaces/intuition">
<datamodel>
  <data id="t" expr='{"mean": 70, "var": 100, "n": 8}'/>
</datamodel>
<state id="s0">
  <onentry>
    <intuition:observe location="t" confidence="34"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="Math.abs(t.mean - 67.12) &lt; 1e-9 &amp;&amp; Math.abs(t['var'] - 195.68) &lt; 1e-9 &amp;&amp; t.n === 9" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
