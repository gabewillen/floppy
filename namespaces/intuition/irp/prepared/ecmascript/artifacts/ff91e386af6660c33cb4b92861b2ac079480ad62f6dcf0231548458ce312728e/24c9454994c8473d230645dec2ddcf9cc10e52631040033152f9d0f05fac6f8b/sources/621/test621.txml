<?xml version="1.0"?>
<!-- intuition-3: after the warmup the threshold is the mean less one deviation. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:intuition="https://github.com/stateforward/floppy/namespaces/intuition">
<datamodel>
  <data id="t" expr='{"mean": 80, "var": 100, "n": 8}'/>
  <data id="below" expr="null"/>
  <data id="at" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <intuition:escalate location="below" confidence="69" tuner="t"/>
    <intuition:escalate location="at" confidence="70" tuner="t"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="below === true &amp;&amp; at === false" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
