<?xml version="1.0" encoding="UTF-8"?><!-- intuition-3: after the warmup the threshold is the mean less one deviation. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:intuition="https://github.com/stateforward/floppy/namespaces/intuition" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="t" expr="{&#34;mean&#34;: 80, &#34;var&#34;: 100, &#34;n&#34;: 8}"/>
  <data id="below" expr="null"/>
  <data id="at" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <intuition:escalate location="below" confidence="69" tuner="t"/>
    <intuition:escalate location="at" confidence="70" tuner="t"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="below === true &amp;&amp; at === false" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>