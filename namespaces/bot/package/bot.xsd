<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of floppy's `bot` extension namespace (namespaces/bot). It
  governs structure only; the extension component governs what the element
  does. Bind it with the prefix `bot` by convention.

  bot:attention  location (required): receives the turn's focus candidates
                 (mosfet attention_bias_for_turn): the focus, then the
                 stimulus's device (a bot.input's target_device, else the
                 device its source reports from) when it is configured.
                 focuslocation (optional): receives the focus (the focused
                 device when it is configured, else null).
                 stimulus, devices, focus (required), sources (optional):
                 expressions of the stimulus envelope, the configured
                 devices, the focused device, and source id -> device.
  bot:verdict    location (required): receives the selections without the
                 bot.ability.cognition.ignore ones (mosfet
                 without_ignore_selections).
                 rejectionlocation (required): receives the message of the
                 first focus or clear selection the attention policy
                 refuses (mosfet attention_selection_error), else null.
                 selections, focus, candidates (required): expressions of
                 the turn's selections, its focus and its focus candidates.
  bot:stimulus   location (required): receives the stimulus envelope
                 {event, data, source, target?, id?}.
                 event, data, source (required), target, id (optional):
                 expressions; a null, undefined or empty source is null.
  bot:recognize  location (required): receives whether the text names the
                 bot (mosfet recognition.hears_name): the name's
                 case-folded letter-and-digit tokens as a whole run in the
                 text's.
                 name, text (required): expressions; each a string or null.
                 None takes another attribute or content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/floppy/namespaces/bot"
           elementFormDefault="qualified">
  <xs:element name="attention">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="focuslocation" type="xs:string" use="optional"/>
      <xs:attribute name="stimulus" type="xs:string" use="required"/>
      <xs:attribute name="devices" type="xs:string" use="required"/>
      <xs:attribute name="focus" type="xs:string" use="required"/>
      <xs:attribute name="sources" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="verdict">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="rejectionlocation" type="xs:string" use="required"/>
      <xs:attribute name="selections" type="xs:string" use="required"/>
      <xs:attribute name="focus" type="xs:string" use="required"/>
      <xs:attribute name="candidates" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="stimulus">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="data" type="xs:string" use="required"/>
      <xs:attribute name="source" type="xs:string" use="required"/>
      <xs:attribute name="target" type="xs:string" use="optional"/>
      <xs:attribute name="id" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="recognize">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="text" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
