<?xml version="1.0"?>
<!-- bot-5: a missing name or a name with no tokens is never heard. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="a" expr="null"/>
  <data id="b" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:recognize location="a" name="null" text="'hi'"/>
    <bot:recognize location="b" name="'!!'" text="'!!'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="a === false &amp;&amp; b === false" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
