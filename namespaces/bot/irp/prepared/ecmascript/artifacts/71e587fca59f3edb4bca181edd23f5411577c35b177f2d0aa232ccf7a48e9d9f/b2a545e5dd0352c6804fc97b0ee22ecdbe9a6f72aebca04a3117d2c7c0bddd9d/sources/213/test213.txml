<?xml version="1.0"?>
<!-- bot-2: an empty event raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="stimulus" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:stimulus location="stimulus" event="''" data="null" source="null"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="stimulus === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
