<?xml version="1.0"?>
<!-- bot-3: without a target_device, the device the sources map the stimulus's source to is the candidate. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="devices" expr='["kitchen", "hall"]'/>
  <data id="stimulus" expr='{"event": "bot.ability.listening.output", "data": {}, "source": "mic1"}'/>
  <data id="sources" expr='{"mic1": "hall"}'/>
  <data id="candidates" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:attention location="candidates" stimulus="stimulus" devices="devices" focus="null" sources="sources"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="candidates.length === 1 &amp;&amp; candidates[0] === 'hall'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
