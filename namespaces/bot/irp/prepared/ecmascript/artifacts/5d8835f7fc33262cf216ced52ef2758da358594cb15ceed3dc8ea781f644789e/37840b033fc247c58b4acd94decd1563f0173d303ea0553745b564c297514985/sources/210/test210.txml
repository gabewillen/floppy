<?xml version="1.0"?>
<!-- bot-2: the stimulus envelope holds the event, its data and its source; target and id are absent when not given. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="data" expr='{"text": "hi"}'/>
  <data id="stimulus" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:stimulus location="stimulus" event="'bot.input'" data="data" source="'listening'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="stimulus.event === 'bot.input' &amp;&amp; stimulus.data.text === 'hi' &amp;&amp; stimulus.source === 'listening' &amp;&amp; !('target' in stimulus) &amp;&amp; !('id' in stimulus)" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
