<?xml version="1.0" encoding="UTF-8"?><!-- bot-3: devices that are not an array raise error.execution and assign nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="stimulus" expr="{&#34;event&#34;: &#34;bot.input&#34;, &#34;data&#34;: {}, &#34;source&#34;: null}"/>
  <data id="candidates" expr="'untouched'"/>
  <data id="focus" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:attention location="candidates" focuslocation="focus" stimulus="stimulus" devices="'kitchen'" focus="null"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="candidates === 'untouched' &amp;&amp; focus === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>