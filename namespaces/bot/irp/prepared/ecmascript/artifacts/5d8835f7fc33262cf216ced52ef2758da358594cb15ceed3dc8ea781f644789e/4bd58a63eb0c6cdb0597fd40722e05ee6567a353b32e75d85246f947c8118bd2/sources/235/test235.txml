<?xml version="1.0"?>
<!-- bot-4: a focus_device among the candidates and a clear_focus with a focus pass. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="selections" expr='[{"event": "bot.focus_device", "data": {"device": "kitchen"}}, {"event": "bot.clear_focus", "target": "bot"}]'/>
  <data id="dispatching" expr="null"/>
  <data id="rejection" expr="'unset'"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:verdict location="dispatching" rejectionlocation="rejection" selections="selections" focus="'kitchen'" candidates="['kitchen']"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="rejection === null &amp;&amp; dispatching.length === 2" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
