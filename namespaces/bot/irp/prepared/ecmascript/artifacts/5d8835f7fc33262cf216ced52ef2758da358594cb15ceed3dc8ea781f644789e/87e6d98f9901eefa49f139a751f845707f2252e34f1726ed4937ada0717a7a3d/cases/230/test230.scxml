<?xml version="1.0" encoding="UTF-8"?><!-- bot-4: the ignore selections are removed, the others kept in order, and nothing is refused. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="selections" expr="[{&#34;event&#34;: &#34;bot.ability.cognition.ignore&#34;, &#34;data&#34;: {}}, {&#34;event&#34;: &#34;bot.say&#34;, &#34;data&#34;: {&#34;text&#34;: &#34;hi&#34;}}]"/>
  <data id="dispatching" expr="null"/>
  <data id="rejection" expr="'unset'"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:verdict location="dispatching" rejectionlocation="rejection" selections="selections" focus="null" candidates="[]"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="rejection === null &amp;&amp; dispatching.length === 1 &amp;&amp; dispatching[0].event === 'bot.say'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>