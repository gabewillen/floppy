<?xml version="1.0"?>
<!-- bot-3: the stimulus's device is not appended twice. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="devices" expr='["kitchen"]'/>
  <data id="stimulus" expr='{"event": "bot.input", "data": {"target_device": "kitchen"}, "source": null}'/>
  <data id="candidates" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:attention location="candidates" stimulus="stimulus" devices="devices" focus="'kitchen'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="candidates.length === 1 &amp;&amp; candidates[0] === 'kitchen'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
