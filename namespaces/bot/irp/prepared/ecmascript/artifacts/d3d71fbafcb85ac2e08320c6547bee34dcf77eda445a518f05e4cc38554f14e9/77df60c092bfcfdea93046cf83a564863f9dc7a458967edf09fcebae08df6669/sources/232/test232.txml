<?xml version="1.0"?>
<!-- bot-4: a focus_device without a device is refused with pydantic's detail. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="selections" expr='[{"event": "bot.focus_device", "data": {}}]'/>
  <data id="dispatching" expr="null"/>
  <data id="rejection" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:verdict location="dispatching" rejectionlocation="rejection" selections="selections" focus="null" candidates="['kitchen']"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="rejection === 'Processing selected invalid focus selection data for event: bot.focus_device: device: missing: Field required'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
