<?xml version="1.0" encoding="UTF-8"?><!-- bot-2: the stimulus envelope holds the event, its data and its source; target and id are absent when not given. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="data" expr="{&#34;text&#34;: &#34;hi&#34;}"/>
  <data id="stimulus" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:stimulus location="stimulus" event="'bot.input'" data="data" source="'listening'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="stimulus.event === 'bot.input' &amp;&amp; stimulus.data.text === 'hi' &amp;&amp; stimulus.source === 'listening' &amp;&amp; !('target' in stimulus) &amp;&amp; !('id' in stimulus)" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>