<?xml version="1.0" encoding="UTF-8"?><!-- bot-2: an empty source is null; a given target and id are included, a null one as null. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="stimulus" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:stimulus location="stimulus" event="'bot.input'" data="null" source="''" target="'bot'" id="null"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="stimulus.source === null &amp;&amp; stimulus.data === null &amp;&amp; stimulus.target === 'bot' &amp;&amp; ('id' in stimulus) &amp;&amp; stimulus.id === null" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>