<?xml version="1.0"?>
<!-- bot-2: an empty source is null; a given target and id are included, a null one as null. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot">
<datamodel>
  <data id="stimulus" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <bot:stimulus location="stimulus" event="'bot.input'" data="null" source="''" target="'bot'" id="null"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="stimulus.source === null &amp;&amp; stimulus.data === null &amp;&amp; stimulus.target === 'bot' &amp;&amp; ('id' in stimulus) &amp;&amp; stimulus.id === null" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
