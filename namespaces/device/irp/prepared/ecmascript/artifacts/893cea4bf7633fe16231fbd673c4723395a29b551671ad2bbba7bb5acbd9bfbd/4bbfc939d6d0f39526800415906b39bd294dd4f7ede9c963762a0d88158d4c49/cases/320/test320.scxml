<?xml version="1.0" encoding="UTF-8"?><!-- device-3: a target no running session of the run answers assigns nothing and raises nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:device="https://github.com/stateforward/floppy/namespaces/device" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="read" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <device:snapshot location="read" target="'#_scxml_' + _sessionid + '.nobody'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="executed" cond="read === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>