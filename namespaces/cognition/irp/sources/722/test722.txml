<?xml version="1.0"?>
<!-- cognition-3: the environment renders as the original's block, the turn's situation before the stimulus: the bot itself and each held device with its attributes. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="s" expr='{"event": "bot.input", "data": "hi", "source": "gabe"}'/>
  <data id="e" expr="[]"/>
  <data id="d" expr="[]"/>
  <data id="env" expr='{"id": "room", "self": {"state": "processing", "owned_devices": {"lamp": {"ref": "lamp", "id": "session.lamp", "state": "on", "attributes": {"level": 3}}}}}'/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" stimulus="s" prior_episodes="e" standing_directives="d" environment="env"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="f === null &amp;&amp; p.indexOf('&lt;environment id=&quot;room&quot;&gt;\n  &lt;self state=&quot;processing&quot;&gt;\n    &lt;owned_devices&gt;\n      &lt;device ref=&quot;lamp&quot; id=&quot;session.lamp&quot; state=&quot;on&quot;&gt;\n        &lt;level&gt;3&lt;/level&gt;\n      &lt;/device&gt;') === 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
