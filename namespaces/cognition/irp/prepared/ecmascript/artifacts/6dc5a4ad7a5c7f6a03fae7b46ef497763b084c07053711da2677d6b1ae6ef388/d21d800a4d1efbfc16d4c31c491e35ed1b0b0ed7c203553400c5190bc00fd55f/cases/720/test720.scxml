<?xml version="1.0" encoding="UTF-8"?><!-- cognition-3: a stimulus with text data renders as its input's content, stamped with its event and source, beside the empty lists. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="s" expr="{&#34;event&#34;: &#34;bot.input&#34;, &#34;data&#34;: &#34;hi&#34;, &#34;source&#34;: &#34;gabe&#34;}"/>
  <data id="e" expr="[]"/>
  <data id="d" expr="[]"/>
  <data id="expected" expr="&#34;&lt;cognition:processor_input&gt;\n  &lt;host_input&gt;\n    &lt;processing:input&gt;\n      &lt;input content=\&#34;hi\&#34; stimulus:event=\&#34;bot.input\&#34; stimulus:source=\&#34;gabe\&#34; /&gt;\n    &lt;/processing:input&gt;\n  &lt;/host_input&gt;\n  &lt;prior_episodes count=\&#34;0\&#34; /&gt;\n  &lt;standing_directives count=\&#34;0\&#34; /&gt;\n&lt;/cognition:processor_input&gt;&#34;"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" stimulus="s" prior_episodes="e" standing_directives="d"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="f === null &amp;&amp; p === expected" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>