<?xml version="1.0" encoding="UTF-8"?><!-- cognition-3: the content is laid out stable first: the recent turns, the situation (what was already done), the stimulus, then the feedback; the system channel is the instructions then the self block. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="sys" expr="'unset'"/>
  <data id="s" expr="({event: &#34;bot.input&#34;, data: &#34;hi&#34;, source: &#34;gabe&#34;})"/>
  <data id="me" expr="({name: &#34;Floppy&#34;})"/>
  <data id="r" expr="[{at: &#34;2026-07-07T12:00:01.5Z&#34;, direction: &#34;heard&#34;, speakers: [{ref: &#34;voice:1&#34;, role: &#34;source&#34;}], text: &#34;hi&#34;}]"/>
  <data id="a" expr="[{target: &#34;session.lamp&#34;, event: &#34;bot.device.lamp.on&#34;, reason: &#34;asked&#34;}]"/>
  <data id="expected" expr="[&#34;&lt;cognition:recalled&gt;&#34;, &#34;  &lt;recent&gt;&#34;, &#34;    &lt;memory:turn at=\&#34;12:00:01Z\&#34; direction=\&#34;heard\&#34; who=\&#34;voice:1\&#34;&gt;hi&lt;/memory:turn&gt;&#34;, &#34;  &lt;/recent&gt;&#34;, &#34;&lt;/cognition:recalled&gt;&#34;, &#34;&lt;cognition:acted&gt;&#34;, &#34;  &lt;percepts count=\&#34;1\&#34;&gt;&#34;, &#34;    &lt;item&gt;0&lt;/item&gt;&#34;, &#34;  &lt;/percepts&gt;&#34;, &#34;  &lt;acts count=\&#34;1\&#34;&gt;&#34;, &#34;    &lt;cognition:event target=\&#34;session.lamp\&#34; event=\&#34;bot.device.lamp.on\&#34; reason=\&#34;asked\&#34; /&gt;&#34;, &#34;  &lt;/acts&gt;&#34;, &#34;&lt;/cognition:acted&gt;&#34;, &#34;&lt;str stimulus:event=\&#34;bot.input\&#34; stimulus:source=\&#34;gabe\&#34;&gt;hi&lt;/str&gt;&#34;, &#34;fix it&#34;].join(&#34;\n&#34;)"/>
  <data id="expected_system" expr="&#34;sys\n\n&lt;persona&gt;&lt;name taken_by=\&#34;you\&#34;&gt;Floppy&lt;/name&gt;&lt;/persona&gt;&#34;"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" systemlocation="sys" stimulus="s" self="me" recent="r" acted="a" feedback="'fix it'" instructions="'sys'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="f === null &amp;&amp; p === expected &amp;&amp; sys === expected_system" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>