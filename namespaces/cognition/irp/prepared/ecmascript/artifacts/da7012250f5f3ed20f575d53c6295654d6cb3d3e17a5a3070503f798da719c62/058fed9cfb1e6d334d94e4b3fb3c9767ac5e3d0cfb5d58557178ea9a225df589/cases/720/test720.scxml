<?xml version="1.0" encoding="UTF-8"?><!-- cognition-3: a stimulus with text data is the root element of its own block: its payload's type, its text, stamped with its event and source. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="s" expr="{&#34;event&#34;: &#34;bot.input&#34;, &#34;data&#34;: &#34;hi&#34;, &#34;source&#34;: &#34;gabe&#34;}"/>
  <data id="expected" expr="&#34;&lt;string stimulus:event=\&#34;bot.input\&#34; stimulus:source=\&#34;gabe\&#34;&gt;hi&lt;/string&gt;&#34;"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" stimulus="s"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="f === null &amp;&amp; p === expected" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>