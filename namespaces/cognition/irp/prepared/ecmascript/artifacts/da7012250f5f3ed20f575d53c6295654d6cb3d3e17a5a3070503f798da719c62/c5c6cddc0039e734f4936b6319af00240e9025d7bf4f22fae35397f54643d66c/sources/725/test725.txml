<?xml version="1.0"?>
<!-- cognition-3: without a stimulus attribute the content has no stimulus block: the situation and the feedback alone. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="env" expr='{"id": "room", "self": {"state": "processing"}}'/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" environment="env" feedback="'fix it'"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="f === null &amp;&amp; p.indexOf('&lt;environment id=&quot;room&quot;&gt;') === 0 &amp;&amp; p.indexOf('stimulus:') === -1 &amp;&amp; p.indexOf('&lt;null') === -1 &amp;&amp; p.slice(-7) === '\nfix it'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
