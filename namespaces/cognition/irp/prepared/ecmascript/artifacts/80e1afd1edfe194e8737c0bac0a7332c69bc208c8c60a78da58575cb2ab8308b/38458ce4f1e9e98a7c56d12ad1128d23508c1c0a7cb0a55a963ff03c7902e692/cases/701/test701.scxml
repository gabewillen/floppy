<?xml version="1.0" encoding="UTF-8"?><!-- cognition-1: a model-facing content without prior_episodes raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="'untouched'"/>
  <data id="s" expr="{&#34;event&#34;: &#34;bot.input&#34;, &#34;data&#34;: &#34;hi&#34;, &#34;source&#34;: &#34;gabe&#34;}"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" stimulus="s" standing_directives="[]"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="p === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>