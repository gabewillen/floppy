<?xml version="1.0" encoding="UTF-8"?><!-- cognition-2: a stimulus's source names no device: without a target_device there is no candidate. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="devices" expr="[&#34;kitchen&#34;, &#34;hall&#34;]"/>
  <data id="stimulus" expr="{&#34;event&#34;: &#34;bot.ability.listening.output&#34;, &#34;data&#34;: {}, &#34;source&#34;: &#34;hall&#34;}"/>
  <data id="candidates" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:attention_bias_for_turn location="candidates" stimulus="stimulus" devices="devices" focus="null"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="candidates.length === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>