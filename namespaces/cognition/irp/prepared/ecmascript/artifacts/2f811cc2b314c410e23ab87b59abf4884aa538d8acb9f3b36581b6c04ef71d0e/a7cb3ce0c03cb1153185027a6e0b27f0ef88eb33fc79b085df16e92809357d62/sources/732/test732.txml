<?xml version="1.0"?>
<!-- cognition-4: without failurelocation a projection over a budget raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition">
<datamodel>
  <data id="p" expr="'untouched'"/>
  <data id="s" expr="({event: 'bot.input', source: 'gabe', data: {items: Array.from({length: 4097}, (_, i) =&gt; i)}})"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" stimulus="s" prior_episodes="[]" standing_directives="[]"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="p === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
