<?xml version="1.0" encoding="UTF-8"?><!-- cognition-4: a stimulus over the bytes the instructions and the schema leave of the prompt's fails with the original's message, recalled items or not. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="'unset'"/>
  <data id="f" expr="null"/>
  <data id="s" expr="({event: 'bot.input', source: 'gabe', data: {text: '&amp;'.repeat(30000)}})"/>
  <data id="e" expr="[{stimulus_name: 'small'}]"/>
  <data id="d" expr="[{text: 'small'}]"/>
  <data id="i" expr="'é'.repeat(32000)"/>
  <data id="t" expr="({pad: 'é'.repeat(30000)})"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" stimulus="s" prior_episodes="e" standing_directives="d" instructions="i" schema="t"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="p === null &amp;&amp; f === 'prompt projection encoded byte budget exceeded'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>