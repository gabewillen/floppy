<?xml version="1.0" encoding="UTF-8"?><!-- cognition-3: the environment renders as the original's block, the turn's situation before the stimulus: the bot itself and each held device with its attributes. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="s" expr="{&#34;event&#34;: &#34;bot.input&#34;, &#34;data&#34;: &#34;hi&#34;, &#34;source&#34;: &#34;gabe&#34;}"/>
  <data id="e" expr="[]"/>
  <data id="d" expr="[]"/>
  <data id="env" expr="{&#34;id&#34;: &#34;room&#34;, &#34;self&#34;: {&#34;state&#34;: &#34;processing&#34;, &#34;owned_devices&#34;: {&#34;lamp&#34;: {&#34;ref&#34;: &#34;lamp&#34;, &#34;id&#34;: &#34;session.lamp&#34;, &#34;state&#34;: &#34;on&#34;, &#34;attributes&#34;: {&#34;level&#34;: 3}}}}}"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" stimulus="s" prior_episodes="e" standing_directives="d" environment="env"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="f === null &amp;&amp; p.indexOf('&lt;environment id=&#34;room&#34;&gt;\n  &lt;self state=&#34;processing&#34;&gt;\n    &lt;owned_devices&gt;\n      &lt;device ref=&#34;lamp&#34; id=&#34;session.lamp&#34; state=&#34;on&#34;&gt;\n        &lt;level&gt;3&lt;/level&gt;\n      &lt;/device&gt;') === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>