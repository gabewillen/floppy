<?xml version="1.0" encoding="UTF-8"?><!-- cognition-3: without a stimulus attribute the content has no stimulus block: the situation and the feedback alone, as the reference's decision instructions are. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="env" expr="{&#34;id&#34;: &#34;room&#34;, &#34;self&#34;: {&#34;state&#34;: &#34;processing&#34;}}"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" environment="env" feedback="'fix it'"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="f === null &amp;&amp; p.indexOf('&lt;environment id=&#34;room&#34;&gt;') === 0 &amp;&amp; p.indexOf('stimulus:') === -1 &amp;&amp; p.indexOf('none_type') === -1 &amp;&amp; p.slice(-7) === '\nfix it'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>