<?xml version="1.0" encoding="UTF-8"?><!-- cognition-3: prior episodes and standing directives render as cognition:cognitive_episode and cognition:directive elements, each list with its count, in a cognition:recalled block before the stimulus. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="f" expr="'unset'"/>
  <data id="s" expr="{&#34;event&#34;: &#34;bot.input&#34;, &#34;data&#34;: &#34;hi&#34;, &#34;source&#34;: &#34;gabe&#34;}"/>
  <data id="e" expr="[{&#34;focus&#34;: &#34;lamp&#34;, &#34;focus_candidates&#34;: [&#34;lamp&#34;], &#34;stimulus_name&#34;: &#34;bot.input&#34;, &#34;output&#34;: [{&#34;event&#34;: &#34;bot.say&#34;, &#34;data&#34;: {&#34;text&#34;: &#34;hi&#34;}, &#34;target&#34;: &#34;session&#34;}]}]"/>
  <data id="d" expr="[{&#34;text&#34;: &#34;Be brief.&#34;}]"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" stimulus="s" prior_episodes="e" standing_directives="d"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="f === null &amp;&amp; p.indexOf('&lt;cognition:recalled&gt;\n  &lt;prior_episodes') === 0 &amp;&amp; p.indexOf('&lt;/cognition:recalled&gt;\n&lt;str stimulus:event=&#34;bot.input&#34;') &gt; 0 &amp;&amp; p.indexOf('&lt;prior_episodes count=&#34;1&#34;&gt;\n    &lt;cognition:cognitive_episode focus=&#34;lamp&#34; stimulus_name=&#34;bot.input&#34;&gt;') &gt; 0 &amp;&amp; p.indexOf('&lt;cognition:event target=&#34;session&#34; event=&#34;bot.say&#34;&gt;\n          &lt;data&gt;\n            &lt;entry key=&#34;text&#34; value=&#34;hi&#34; /&gt;') &gt; 0 &amp;&amp; p.indexOf('&lt;standing_directives count=&#34;1&#34;&gt;\n    &lt;cognition:directive text=&#34;Be brief.&#34; kind=&#34;instruction&#34; /&gt;') &gt; 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>