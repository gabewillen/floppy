<?xml version="1.0" encoding="UTF-8"?><!-- cognition-7: a ceiling that is not a whole number raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="c" expr="[{event: &#34;light&#34;, schema: {}}]"/>
  <data id="o" expr="'untouched'"/>
  <data id="h" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:within_ceiling location="o" heldlocation="h" choices="c" ceiling="1.5"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="o === 'untouched' &amp;&amp; h === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>