<?xml version="1.0"?>
<!-- cognition-1: a model-facing content with content raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:cognition="https://github.com/stateforward/floppy/namespaces/cognition">
<datamodel>
  <data id="p" expr="'untouched'"/>
  <data id="f" expr="'untouched'"/>
  <data id="s" expr='{"event": "bot.input", "data": "hi", "source": "gabe"}'/>
  <data id="e" expr="[]"/>
  <data id="d" expr="[]"/>
</datamodel>
<state id="s0">
  <onentry>
    <cognition:model_facing_content location="p" failurelocation="f" stimulus="s" prior_episodes="e" standing_directives="d">x</cognition:model_facing_content>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="p === 'untouched' &amp;&amp; f === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
