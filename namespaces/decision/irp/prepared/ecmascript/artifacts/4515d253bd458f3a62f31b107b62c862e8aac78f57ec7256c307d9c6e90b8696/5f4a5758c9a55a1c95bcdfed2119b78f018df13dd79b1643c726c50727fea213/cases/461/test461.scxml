<?xml version="1.0" encoding="UTF-8"?><!-- decision-8: a child that has finished is no running session: reading it assigns nothing and raises nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="offers" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <send event="timeout" delay="5s"/>
  </onentry>
  <invoke id="child" type="http://www.w3.org/TR/scxml/">
    <content>
      <scxml version="1.0" initial="done" datamodel="ecmascript">
        <final id="done"/>
      </scxml>
    </content>
  </invoke>
  <transition event="done.invoke">
    <decision:offers location="offers" target="'#_child'"/>
    <raise event="read"/>
  </transition>
  <transition event="read" cond="offers === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>