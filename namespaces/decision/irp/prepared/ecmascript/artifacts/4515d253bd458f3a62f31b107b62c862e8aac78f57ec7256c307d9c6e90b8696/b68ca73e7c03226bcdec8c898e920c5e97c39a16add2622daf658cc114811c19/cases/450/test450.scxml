<?xml version="1.0" encoding="UTF-8"?><!-- decision-7: the offers are the declared events the child's unguarded event:schema transitions take, with their declared efforts; a guarded transition is never offered and still takes its event from a later one, and a schemaless or undeclared event is not offered. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <send event="timeout" delay="5s"/>
  </onentry>
  <invoke id="child" type="http://www.w3.org/TR/scxml/">
    <content>
      <scxml xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" version="1.0" initial="c0" datamodel="ecmascript">
        <datamodel>
          <data id="offerable" expr="({'tool.alpha': {effort: 2}, 'tool.beta': {}, 'tool.gamma': {}, 'tool.delta': {}})"/>
        </datamodel>
        <state id="c0">
          <onentry>
            <send event="childReady" target="#_parent"/>
          </onentry>
          <transition event="tool.beta" cond="true" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
          <transition event="tool.alpha" event:schema="{&#34;type&#34;: &#34;object&#34;, &#34;description&#34;: &#34;Alpha.&#34;}"/>
          <transition event="tool.beta" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
          <transition event="tool.gamma"/>
          <transition event="tool.epsilon" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
        </state>
      </scxml>
    </content>
  </invoke>
  <transition event="childReady">
    <decision:offers location="offers" target="'#_child'"/>
    <raise event="read"/>
  </transition>
  <transition event="read" cond="offers.length === 1 &amp;&amp; offers[0].event === 'tool.alpha' &amp;&amp; offers[0].effort === 2 &amp;&amp; offers[0].description === 'Alpha.' &amp;&amp; offers[0].schema.type === 'object'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>