<?xml version="1.0" encoding="UTF-8"?><!-- decision-6: an effort that is not a whole number from 0 to 1000 raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:choice location="choices" effort="1.5"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="choices === 'untouched'" target="s1"/>
  <transition event="*" target="fail"/>
  <transition event="tool.alpha" event:schema="{&#34;type&#34;: &#34;object&#34;}" target="fail"/>
</state>
<state id="s1">
  <onentry>
    <decision:choice location="choices" effort="1001"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="choices === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>