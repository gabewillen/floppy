<?xml version="1.0" encoding="UTF-8"?><!-- decision-7: undeclared="all" offers every event the walk finds, with the efforts of those declared, and a child that declares nothing offers nothing by default. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="declared" expr="null"/>
  <data id="everything" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <send event="timeout" delay="5s"/>
  </onentry>
  <invoke id="child" type="http://www.w3.org/TR/scxml/">
    <content>
      <scxml xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" version="1.0" initial="c0" datamodel="ecmascript">
        <state id="c0">
          <onentry>
            <send event="childReady" target="#_parent"/>
          </onentry>
          <transition event="tool.alpha" cond="true" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
          <transition event="tool.beta" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
          <transition event="tool.gamma.*" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
        </state>
      </scxml>
    </content>
  </invoke>
  <transition event="childReady">
    <decision:offers location="declared" target="'#_child'" undeclared="none"/>
    <decision:offers location="everything" target="'#_child'" undeclared="all"/>
    <raise event="read"/>
  </transition>
  <transition event="read" cond="declared.length === 0 &amp;&amp; everything.length === 2 &amp;&amp; everything[0].event === 'tool.beta' &amp;&amp; everything[1].event === 'tool.gamma' &amp;&amp; !('effort' in everything[0])" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>