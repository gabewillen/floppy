<?xml version="1.0"?>
<!-- decision-5: an entry whose schema has no such property raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="source" expr='[{"event": "bot.focus_device", "schema": {"type": "object", "properties": {"device": {"type": "string"}}}}, {"event": "bot.say", "schema": {"type": "object"}}]'/>
  <data id="choices" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:pin location="choices" event="bot.say" property="device" values="['kitchen']"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="choices === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
