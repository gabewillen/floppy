<?xml version="1.0" encoding="UTF-8"?><!-- decision-9: the selection schema has one strict branch per offered event, with a target enum only for targeted events. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="[{&#34;event&#34;: &#34;bot.say&#34;, &#34;schema&#34;: {&#34;$schema&#34;: &#34;https://json-schema.org/draft/2020-12/schema&#34;, &#34;title&#34;: &#34;Say&#34;, &#34;type&#34;: &#34;object&#34;, &#34;properties&#34;: {&#34;text&#34;: {&#34;type&#34;: &#34;string&#34;}}}, &#34;description&#34;: &#34;Say it.&#34;}, {&#34;event&#34;: &#34;tool.go&#34;, &#34;schema&#34;: {&#34;type&#34;: &#34;object&#34;}, &#34;target&#34;: &#34;a&#34;}, {&#34;event&#34;: &#34;tool.go&#34;, &#34;schema&#34;: {&#34;type&#34;: &#34;object&#34;}, &#34;target&#34;: &#34;b&#34;}]"/>
  <data id="schema" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:selection location="schema" choices="choices"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="schema.properties.events.items.anyOf.length === 2 &amp;&amp; schema.additionalProperties === false &amp;&amp; schema.properties.events.items.anyOf[0].properties.event.enum[0] === 'bot.say' &amp;&amp; !('target' in schema.properties.events.items.anyOf[0].properties) &amp;&amp; !('title' in schema.properties.events.items.anyOf[0].properties.data) &amp;&amp; schema.properties.events.items.anyOf[0].description === 'Say it.' &amp;&amp; schema.properties.events.items.anyOf[1].properties.target.enum.join(',') === 'a,b'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>