<?xml version="1.0"?>
<!-- decision-9: the selection schema has one strict branch per offered event, with a target enum only for targeted events. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="choices" expr='[{"event": "bot.say", "schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Say", "type": "object", "properties": {"text": {"type": "string"}}}, "description": "Say it."}, {"event": "tool.go", "schema": {"type": "object"}, "target": "a"}, {"event": "tool.go", "schema": {"type": "object"}, "target": "b"}]'/>
  <data id="schema" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:selection location="schema" choices="choices"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="schema.properties.events.items.anyOf.length === 2 &amp;&amp; schema.additionalProperties === false &amp;&amp; schema.properties.events.items.anyOf[0].properties.event.enum[0] === 'bot.say' &amp;&amp; !('target' in schema.properties.events.items.anyOf[0].properties) &amp;&amp; !('title' in schema.properties.events.items.anyOf[0].properties.data) &amp;&amp; schema.properties.events.items.anyOf[0].description === 'Say it.' &amp;&amp; schema.properties.events.items.anyOf[1].properties.target.enum.join(',') === 'a,b'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
