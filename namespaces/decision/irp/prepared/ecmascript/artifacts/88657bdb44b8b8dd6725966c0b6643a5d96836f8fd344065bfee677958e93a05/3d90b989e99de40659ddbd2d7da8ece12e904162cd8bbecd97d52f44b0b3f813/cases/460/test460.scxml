<?xml version="1.0" encoding="UTF-8"?><!-- decision-8: the names are the events, with @target for a targeted choice, space separated. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="[{&#34;event&#34;: &#34;bot.say&#34;, &#34;schema&#34;: {}}, {&#34;event&#34;: &#34;tool.go&#34;, &#34;schema&#34;: {}, &#34;target&#34;: &#34;a&#34;}, {&#34;event&#34;: &#34;tool.go&#34;, &#34;schema&#34;: {}, &#34;target&#34;: &#34;b&#34;}, {&#34;event&#34;: &#34;tool.only&#34;, &#34;schema&#34;: {}, &#34;target&#34;: &#34;a&#34;}]"/>
  <data id="names" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:names location="names" choices="choices"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="names === 'bot.say tool.go@a tool.go@b tool.only@a'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>