<?xml version="1.0" encoding="UTF-8"?><!-- decision-4: over the bound, every description is dropped, and the choices are not reported over. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="[{&#34;event&#34;: &#34;tool.a&#34;, &#34;description&#34;: &#34;xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx&#34;, &#34;schema&#34;: {&#34;$schema&#34;: &#34;https://json-schema.org/draft/2020-12/schema&#34;, &#34;title&#34;: &#34;A&#34;, &#34;examples&#34;: [{}], &#34;type&#34;: &#34;object&#34;, &#34;description&#34;: &#34;yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy&#34;, &#34;properties&#34;: {&#34;title&#34;: {&#34;type&#34;: &#34;string&#34;, &#34;title&#34;: &#34;T&#34;}}}}]"/>
  <data id="over" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:compact location="choices" bound="200" overlocation="over"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="over === false &amp;&amp; choices.length === 1 &amp;&amp; !('description' in choices[0]) &amp;&amp; !('description' in choices[0].schema)" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>