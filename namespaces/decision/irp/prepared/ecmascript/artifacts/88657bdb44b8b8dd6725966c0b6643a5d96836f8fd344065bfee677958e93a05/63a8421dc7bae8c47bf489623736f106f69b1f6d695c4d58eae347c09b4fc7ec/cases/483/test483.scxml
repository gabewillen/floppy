<?xml version="1.0" encoding="UTF-8"?><!-- decision-10: an observation that is not a number raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="tuner" expr="'untouched'"/>
  <data id="threshold" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:tuner location="tuner" thresholdlocation="threshold" observe="'high'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="tuner === 'untouched' &amp;&amp; threshold === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>