<?xml version="1.0" encoding="UTF-8"?><!-- decision-6: an effort is written as the effort of every choice the element writes, and a choice without one carries none. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="weight" expr="2"/>
  <data id="heavy" expr="null"/>
  <data id="light" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:choice location="heavy" effort="weight"/>
    <decision:choice location="light" events="tool.alpha"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition event="tool.alpha" event:schema="{&#34;type&#34;: &#34;object&#34;}" target="s0"/>
  <transition event="tool.beta" event:schema="{&#34;type&#34;: &#34;object&#34;}" target="s0"/>
  <transition cond="heavy.length === 2 &amp;&amp; heavy[0].effort === 2 &amp;&amp; heavy[1].effort === 2 &amp;&amp; light.length === 1 &amp;&amp; !('effort' in light[0])" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>