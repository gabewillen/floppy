<?xml version="1.0"?>
<!-- decision-3: a transition whose cond is false is not offered; one whose cond is true is. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event">
<datamodel>
  <data id="choices" expr="null"/>
  <data id="on" expr="true"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:choice location="choices"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition event="tool.off" cond="!on" event:schema='{"type": "object"}' target="s0"/>
  <transition event="tool.on" cond="on" event:schema='{"type": "object"}' target="s0"/>
  <transition cond="choices.length === 1 &amp;&amp; choices[0].event === 'tool.on'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
