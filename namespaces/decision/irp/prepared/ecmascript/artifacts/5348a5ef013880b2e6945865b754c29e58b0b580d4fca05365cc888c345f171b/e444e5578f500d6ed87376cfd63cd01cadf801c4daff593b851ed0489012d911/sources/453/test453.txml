<?xml version="1.0"?>
<!-- decision-7: a selection that is not an object with an event fails as malformed. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="choices" expr='[{"event": "bot.say", "schema": {}}, {"event": "tool.go", "schema": {}, "target": "a"}, {"event": "tool.go", "schema": {}, "target": "b"}, {"event": "tool.only", "schema": {}, "target": "a"}]'/>
  <data id="selections" expr='[{"data": {}}]'/>
  <data id="placed" expr="null"/>
  <data id="rejection" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:route location="placed" rejectionlocation="rejection" selections="selections" choices="choices"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="rejection === 'Processing selected a malformed event selection.' &amp;&amp; placed.length === 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
