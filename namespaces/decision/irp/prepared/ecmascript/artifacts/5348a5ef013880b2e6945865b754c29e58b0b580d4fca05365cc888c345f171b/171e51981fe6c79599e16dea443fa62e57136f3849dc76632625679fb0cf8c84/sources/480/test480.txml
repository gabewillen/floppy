<?xml version="1.0"?>
<!-- decision-10: a tuner state that is not one is replaced by the initial state, and the warmup threshold is the floor. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="tuner" expr="'garbage'"/>
  <data id="threshold" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:tuner location="tuner" thresholdlocation="threshold"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="tuner.mean === 70 &amp;&amp; tuner['var'] === 100 &amp;&amp; tuner.n === 0 &amp;&amp; threshold === 0.35" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
