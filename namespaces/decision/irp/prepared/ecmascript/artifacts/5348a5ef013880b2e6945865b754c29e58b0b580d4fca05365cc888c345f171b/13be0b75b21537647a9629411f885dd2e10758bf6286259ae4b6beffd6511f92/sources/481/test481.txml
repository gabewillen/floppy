<?xml version="1.0"?>
<!-- decision-10: the first observation sets the mean and counts once. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="tuner" expr="null"/>
  <data id="threshold" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:tuner location="tuner" thresholdlocation="threshold" observe="90"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="tuner.mean === 90 &amp;&amp; tuner.n === 1 &amp;&amp; threshold === 0.35" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
