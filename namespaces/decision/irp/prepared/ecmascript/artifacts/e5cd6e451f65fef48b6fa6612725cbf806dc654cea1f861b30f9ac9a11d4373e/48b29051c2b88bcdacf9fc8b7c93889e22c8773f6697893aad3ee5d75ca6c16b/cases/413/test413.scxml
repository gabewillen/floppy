<?xml version="1.0" encoding="UTF-8"?><!-- decision-3: a transition whose cond is false is not offered; one whose cond is true is. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="null"/>
  <data id="on" expr="true"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:choice location="choices"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition event="tool.off" cond="!on" event:schema="{&#34;type&#34;: &#34;object&#34;}" target="s0"/>
  <transition event="tool.on" cond="on" event:schema="{&#34;type&#34;: &#34;object&#34;}" target="s0"/>
  <transition cond="choices.length === 1 &amp;&amp; choices[0].event === 'tool.on'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>