<?xml version="1.0" encoding="UTF-8"?><!-- decision-7: an offerable that is not an object of {effort?} entries raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="offers" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <send event="timeout" delay="5s"/>
  </onentry>
  <invoke id="child" type="http://www.w3.org/TR/scxml/">
    <content>
      <scxml xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" version="1.0" initial="c0" datamodel="ecmascript">
        <datamodel>
          <data id="offerable" expr="({'tool.alpha': {effort: 1001}})"/>
        </datamodel>
        <state id="c0">
          <onentry>
            <send event="childReady" target="#_parent"/>
          </onentry>
          <transition event="tool.alpha" event:schema="{&#34;type&#34;: &#34;object&#34;}"/>
        </state>
      </scxml>
    </content>
  </invoke>
  <transition event="childReady">
    <decision:offers location="offers" target="'#_child'"/>
    <raise event="read"/>
  </transition>
  <transition event="error.execution" cond="offers === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>