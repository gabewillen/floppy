<?xml version="1.0" encoding="UTF-8"?><!-- decision-2: the choices are the events of the active transitions that carry an event:schema, with their schema and description, in document order; * and schemaless transitions are not offered. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="choices" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:choice location="choices"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition event="tool.alpha" event:schema="{&#34;type&#34;: &#34;object&#34;, &#34;description&#34;: &#34;Alpha the thing.\nMore.&#34;, &#34;title&#34;: &#34;Alpha&#34;}" target="s0"/>
  <transition event="tool.beta.*" event:schema="{&#34;type&#34;: &#34;object&#34;, &#34;title&#34;: &#34;Beta&#34;}" target="s0"/>
  <transition event="*" event:schema="{&#34;type&#34;: &#34;object&#34;}" target="s0"/>
  <transition event="untyped" target="s0"/>
  <transition cond="choices.length === 2 &amp;&amp; choices[0].event === 'tool.alpha' &amp;&amp; choices[0].description === 'Alpha the thing.' &amp;&amp; choices[0].schema.title === 'Alpha' &amp;&amp; choices[1].event === 'tool.beta' &amp;&amp; choices[1].description === 'Beta'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>