<?xml version="1.0" encoding="UTF-8"?><!-- decision-7: a target no running session of the run answers assigns nothing and raises nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="offers" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:offers location="offers" target="'#_nobody'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="executed" cond="offers === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>