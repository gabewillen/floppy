<?xml version="1.0" encoding="UTF-8"?><!-- decision-5: after the warmup the threshold is the mean less k_sigma deviations, never under half the floor. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="tuner" expr="{&#34;mean&#34;: 80, &#34;var&#34;: 100, &#34;n&#34;: 8}"/>
  <data id="threshold" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:tuner location="tuner" thresholdlocation="threshold"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="Math.abs(threshold - 0.70) &lt; 1e-9 &amp;&amp; tuner.n === 8" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>