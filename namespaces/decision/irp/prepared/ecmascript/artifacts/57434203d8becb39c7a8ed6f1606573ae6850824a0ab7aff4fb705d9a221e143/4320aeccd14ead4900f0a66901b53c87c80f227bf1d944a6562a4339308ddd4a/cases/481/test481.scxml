<?xml version="1.0" encoding="UTF-8"?><!-- decision-5: the first observation sets the mean and counts once. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="tuner" expr="null"/>
  <data id="threshold" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:tuner location="tuner" thresholdlocation="threshold" observe="90"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="tuner.mean === 90 &amp;&amp; tuner.n === 1 &amp;&amp; threshold === 0.35" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>