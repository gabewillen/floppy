<?xml version="1.0"?>
<!-- decision-2: an event an earlier transition of the same state already takes is offered once. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event">
<datamodel>
  <data id="choices" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:choice location="choices"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition event="tool.alpha" event:schema='{"type": "object", "title": "First"}' target="s0"/>
  <transition event="tool.alpha" event:schema='{"type": "object", "title": "Second"}' target="s0"/>
  <transition cond="choices.length === 1 &amp;&amp; choices[0].event === 'tool.alpha' &amp;&amp; choices[0].schema.title === 'First'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
