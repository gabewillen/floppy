<?xml version="1.0"?>
<!-- decision-8: the names are the events, with @target for a targeted choice, space separated. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="choices" expr='[{"event": "bot.say", "schema": {}}, {"event": "tool.go", "schema": {}, "target": "a"}, {"event": "tool.go", "schema": {}, "target": "b"}, {"event": "tool.only", "schema": {}, "target": "a"}]'/>
  <data id="names" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:names location="names" choices="choices"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="names === 'bot.say tool.go@a tool.go@b tool.only@a'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
