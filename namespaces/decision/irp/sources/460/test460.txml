<?xml version="1.0"?>
<!-- decision-8: a target no running session of the run answers assigns nothing and raises nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="offers" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:offers location="offers" target="'#_nobody'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="executed" cond="offers === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
