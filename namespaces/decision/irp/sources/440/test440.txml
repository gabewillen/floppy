<?xml version="1.0"?>
<!-- decision-6: assembling keeps the document's own choices untagged, then each offer's in member-name order tagged with its name, and reports the size. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="own" expr='[{"event": "bot.say", "schema": {"type": "object"}}]'/>
  <data id="offers" expr='{"zeta": [{"event": "z.go", "schema": {"type": "object"}}], "alpha": [{"event": "a.go", "schema": {"type": "object"}}]}'/>
  <data id="choices" expr="null"/>
  <data id="over" expr="null"/>
  <data id="size" expr="null"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:assemble location="choices" choices="own" offers="offers" overlocation="over" sizelocation="size"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="over === false &amp;&amp; size &gt; 0 &amp;&amp; choices.map(function (c) { return c.event + '@' + (c.target || ''); }).join(',') === 'bot.say@,a.go@alpha,z.go@zeta'" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
