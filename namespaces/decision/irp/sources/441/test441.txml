<?xml version="1.0"?>
<!-- decision-6: an effort that is not a whole number from 0 to 1000 raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event">
<datamodel>
  <data id="choices" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:choice location="choices" effort="1.5"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="choices === 'untouched'" target="s1"/>
  <transition event="*" conf:targetfail=""/>
  <transition event="tool.alpha" event:schema='{"type": "object"}' conf:targetfail=""/>
</state>
<state id="s1">
  <onentry>
    <decision:choice location="choices" effort="1001"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="choices === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
