<?xml version="1.0"?>
<!-- decision-5: an observation that is not a number raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision">
<datamodel>
  <data id="tuner" expr="'untouched'"/>
  <data id="threshold" expr="'untouched'"/>
</datamodel>
<state id="s0">
  <onentry>
    <decision:tuner location="tuner" thresholdlocation="threshold" observe="'high'"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="tuner === 'untouched' &amp;&amp; threshold === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
