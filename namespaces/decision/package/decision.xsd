<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of floppy's `decision` extension namespace (namespaces/decision).
  It governs structure only; the extension component governs what the
  element does. Bind it with the prefix `decision` by convention.

  decision:choice  location (required): receives the canonical choices of the
                   enabled event:schema transitions.
                   events (optional): a white-space separated list of SCXML
                   event descriptors; the choices keep only the events one of
                   them matches. No other attribute, no content.
                   Choosing among them is the decision service's
                   work (services/decision): executable content stays
                   synchronous and quick.
  decision:compact location (required): the choice array it rewrites in
                   place for a model: $schema, title and examples dropped
                   from every schema (property names kept); over bound
                   bytes, descriptions dropped too; still over, [].
                   bound (optional): a decimal integer, default 32768.
                   overlocation (optional): receives whether the choices
                   were still over the bound. No other attribute, no
                   content.
  decision:pin     location (required): the choice array whose event's
                   schema property it pins. event, property (required):
                   which. values (required): an expression of a JSON array,
                   the property's enum; empty, the event is removed.
  decision:assemble location (required): receives the turn's choices: the
                   choices expression's, then each offers member's tagged
                   with its name as target, compacted as decision:compact
                   does but kept when still over bound.
                   choices, offers (required): expressions.
                   bound (optional): a decimal integer, default 32768.
                   overlocation, sizelocation (optional): receive whether
                   the choices are over the bound, and their size in bytes.
  decision:route   location (required): receives every selection placed on
                   the target offering it ({event, data, target}), or []
                   when one cannot be placed.
                   rejectionlocation (required): receives the first
                   unplaceable selection's message (the original
                   SelectionRejectionError), else null.
                   selections, choices (required): expressions.
  decision:names   location (required): receives the choices' names
                   (event or event@target, space separated).
                   choices (required): an expression.
  decision:selection location (required): receives the original's
                   dispatch tool schema ({events: [anyOf one branch per
                   offered event]}, each branch {event, data, reason?,
                   target?}, the tool's description its root description)
                   of the choices. choices (required): an expression.
  decision:tuner   location (required): the confidence tuner state
                   {mean, var, n} it keeps (reset when malformed).
                   observe (optional): an expression of a reported 0-100
                   confidence the state observes.
                   thresholdlocation (optional): receives the threshold as
                   a probability.
                   None of them takes another attribute or content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/floppy/namespaces/decision"
           elementFormDefault="qualified">
  <xs:element name="choice">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="events" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="compact">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="bound" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:nonNegativeInteger">
            <xs:pattern value="[0-9]+"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="overlocation" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="pin">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="property" type="xs:string" use="required"/>
      <xs:attribute name="values" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="assemble">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="choices" type="xs:string" use="required"/>
      <xs:attribute name="offers" type="xs:string" use="required"/>
      <xs:attribute name="bound" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:nonNegativeInteger">
            <xs:pattern value="[0-9]+"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="overlocation" type="xs:string" use="optional"/>
      <xs:attribute name="sizelocation" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="route">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="rejectionlocation" type="xs:string" use="required"/>
      <xs:attribute name="selections" type="xs:string" use="required"/>
      <xs:attribute name="choices" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="names">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="choices" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="selection">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="choices" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="tuner">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="thresholdlocation" type="xs:string" use="optional"/>
      <xs:attribute name="observe" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
