<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of floppy's `decision` extension namespace (namespaces/decision).
  It governs structure only; the extension component governs what the
  element does. Bind it with the prefix `decision` by convention.

  decision:choice  location (required): receives the canonical choices of the
                   enabled event:schema transitions.
                   events (optional): a white-space separated list of SCXML
                   event descriptors; the choices keep only the events one of
                   them matches. No other attribute, no content.
                   Choosing among them is the decision service's
                   work (services/decision): executable content stays
                   synchronous and quick.
  decision:offers  location (required): receives the canonical choices
                   another session offers its parent, read from its live
                   session (decision D242). target (required): an
                   expression of the session's <send> target. undeclared
                   (optional, none or all): whether only the events the
                   session declares in its offerable data are offered (none,
                   the default) or every one (all). No other attribute, no
                   content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/floppy/namespaces/decision"
           elementFormDefault="qualified">
  <xs:element name="choice">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="events" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="offers">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="target" type="xs:string" use="required"/>
      <xs:attribute name="undeclared" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="all"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
