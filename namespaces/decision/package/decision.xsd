<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of floppy's `decision` extension namespace (namespaces/decision).
  It governs structure only; the extension component governs what the
  element does. Bind it with the prefix `decision` by convention.

  decision:choice  location (required): receives the canonical choices of the
                   enabled event:schema transitions.
                   events (optional): a white-space separated list of SCXML
                   event descriptors; the choices keep only the events one of
                   them matches. No other attribute, no content.
                   Choosing among them is the decision service's
                   work (services/decision): executable content stays
                   synchronous and quick.
  decision:pin     location (required): the choice array whose event's
                   schema property it pins. event, property (required):
                   which. values (required): an expression of a JSON array,
                   the property's enum; empty, the event is removed.
  decision:tuner   location (required): the confidence tuner state
                   {mean, var, n} it keeps (reset when malformed).
                   observe (optional): an expression of a reported 0-100
                   confidence the state observes.
                   thresholdlocation (optional): receives the threshold as
                   a probability.
                   None of them takes another attribute or content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/floppy/namespaces/decision"
           elementFormDefault="qualified">
  <xs:element name="choice">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="events" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="pin">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="event" type="xs:string" use="required"/>
      <xs:attribute name="property" type="xs:string" use="required"/>
      <xs:attribute name="values" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="tuner">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="thresholdlocation" type="xs:string" use="optional"/>
      <xs:attribute name="observe" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
