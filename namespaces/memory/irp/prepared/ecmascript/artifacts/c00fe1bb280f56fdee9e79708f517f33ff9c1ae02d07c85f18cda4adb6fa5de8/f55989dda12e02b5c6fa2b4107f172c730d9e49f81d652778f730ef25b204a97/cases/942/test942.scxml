<?xml version="1.0" encoding="UTF-8"?><!-- memory-5: a bare bounded scalar lands under value; a long string, null or an array projects to nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="a" expr="null"/>
  <data id="b" expr="null"/>
  <data id="c" expr="null"/>
  <data id="e" expr="null"/>
  <data id="long" expr="'x'.repeat(41)"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:stm_projection location="a" data="7"/>
    <memory:stm_projection location="b" data="long"/>
    <memory:stm_projection location="c" data="null"/>
    <memory:stm_projection location="e" data="[1, 2]"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="a.value === 7 &amp;&amp; Object.keys(b).length === 0 &amp;&amp; Object.keys(c).length === 0 &amp;&amp; Object.keys(e).length === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>