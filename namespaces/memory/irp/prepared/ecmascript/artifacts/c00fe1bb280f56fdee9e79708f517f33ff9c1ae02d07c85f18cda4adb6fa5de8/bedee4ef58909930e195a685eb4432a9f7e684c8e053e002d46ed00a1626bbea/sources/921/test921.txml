<?xml version="1.0"?>
<!-- memory-3: a value that is not a string is skipped. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory">
<datamodel>
  <data id="c" expr="null"/>
  <data id="r" expr="({rowcount: 2, rows: [{columns: ['content'], values: [5]}, {columns: ['content'], values: [null]}]})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:contents location="c" result="r"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="c.length === 0" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
