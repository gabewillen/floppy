<?xml version="1.0"?>
<!-- memory-5: an object keeps its bounded scalar fields and drops the rest (long strings, nested values, null, an empty key). -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory">
<datamodel>
  <data id="p" expr="null"/>
  <data id="d" expr="({kind: 'knock', count: 3, ratio: 0.5, flag: true, edge: 'y'.repeat(40), long: 'x'.repeat(41), nested: {a: 1}, list: [1], none: null, '': 'empty'})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:stm_projection location="p" data="d"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="JSON.stringify(Object.keys(p).sort()) === '[&quot;count&quot;,&quot;edge&quot;,&quot;flag&quot;,&quot;kind&quot;,&quot;ratio&quot;]' &amp;&amp; p.kind === 'knock' &amp;&amp; p.ratio === 0.5" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
