<?xml version="1.0" encoding="UTF-8"?><!-- memory-4: words that are not a string raise error.execution and assign nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="t" expr="'untouched'"/>
  <data id="w" expr="['not', 'words']"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:cut_at_word location="t" words="w"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="t === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>