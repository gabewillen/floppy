<?xml version="1.0" encoding="UTF-8"?><!-- memory-4: longer words are cut at the last whole word within 2048 bytes (the bound inside a word drops it), trailing space removed. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="t" expr="null"/>
  <data id="w" expr="'word '.repeat(409) + 'longword'"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:cut_at_word location="t" words="w"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="t.cut === true &amp;&amp; t.text === 'word '.repeat(409).slice(0, -1)" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>