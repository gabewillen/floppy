<?xml version="1.0" encoding="UTF-8"?><!-- memory-5: an object keeps at most 16 fields, the first in its order. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="d" expr="({z0: [], z1: 0, z2: 0, z3: 0, z4: 0, z5: 0, z6: 0, z7: 0, z8: 0, z9: 0, za: 0, zb: 0, zc: 0, zd: 0, ze: 0, zf: 0, zg: 0, zh: 0})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:stm_projection location="p" data="d"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="Object.keys(p).length === 16 &amp;&amp; !('z0' in p) &amp;&amp; ('zg' in p) &amp;&amp; !('zh' in p)" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>