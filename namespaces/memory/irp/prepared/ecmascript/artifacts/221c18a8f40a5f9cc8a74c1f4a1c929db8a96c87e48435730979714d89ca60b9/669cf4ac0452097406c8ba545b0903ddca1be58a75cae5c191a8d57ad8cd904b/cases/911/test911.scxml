<?xml version="1.0" encoding="UTF-8"?><!-- memory-2: repeated identities are written once, and every number is written as its JSON number. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="m" expr="({source_ids: ['a', 'a'], target_ids: [], content: [1e21, 0.00001, 3], content_type: 'text/x'})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:to_json location="p" message="m"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="p === '{&#34;content&#34;:{&#34;__stateforward_memory_content__&#34;:&#34;list&#34;,&#34;value&#34;:[1e+21,0.00001,3]},&#34;content_type&#34;:&#34;text/x&#34;,&#34;source_ids&#34;:[&#34;a&#34;],&#34;target_ids&#34;:[]}'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>