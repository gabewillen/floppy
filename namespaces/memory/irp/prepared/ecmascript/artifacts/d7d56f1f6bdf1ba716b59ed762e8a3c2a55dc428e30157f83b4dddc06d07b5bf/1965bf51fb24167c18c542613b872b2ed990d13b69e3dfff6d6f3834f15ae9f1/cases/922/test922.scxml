<?xml version="1.0" encoding="UTF-8"?><!-- memory-3: a result without a rows array raises error.execution and assigns nothing. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="c" expr="'untouched'"/>
  <data id="r" expr="({rowcount: 0})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:contents location="c" result="r"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="c === 'untouched'" target="pass"/>
  <transition event="*" target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>