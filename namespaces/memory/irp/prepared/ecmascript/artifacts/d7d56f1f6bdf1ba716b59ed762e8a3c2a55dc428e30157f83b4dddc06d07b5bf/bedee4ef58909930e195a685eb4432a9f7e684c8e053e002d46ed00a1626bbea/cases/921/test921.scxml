<?xml version="1.0" encoding="UTF-8"?><!-- memory-3: a value that is not a string is skipped. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="c" expr="null"/>
  <data id="r" expr="({rowcount: 2, rows: [{columns: ['content'], values: [5]}, {columns: ['content'], values: [null]}]})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:contents location="c" result="r"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="c.length === 0" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>