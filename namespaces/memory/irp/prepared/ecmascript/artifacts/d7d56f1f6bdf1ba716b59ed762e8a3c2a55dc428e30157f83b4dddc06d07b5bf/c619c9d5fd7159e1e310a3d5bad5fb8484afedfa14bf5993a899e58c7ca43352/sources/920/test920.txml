<?xml version="1.0"?>
<!-- memory-3: each row's JSON object is read in order, and every other row is skipped. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory">
<datamodel>
  <data id="c" expr="null"/>
  <data id="r" expr="({rowcount: 4, rows: [{columns: ['content'], values: ['{&quot;a&quot;: 1}']}, {columns: ['content'], values: ['[1]']}, {columns: ['content'], values: ['not json']}, {columns: ['content'], values: ['{&quot;b&quot;: 2}']}]})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:contents location="c" result="r"/>
  </onentry>
  <transition event="error.execution" conf:targetfail=""/>
  <transition cond="c.length === 2 &amp;&amp; c[0].a === 1 &amp;&amp; c[1].b === 2" conf:targetpass=""/>
  <transition conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
