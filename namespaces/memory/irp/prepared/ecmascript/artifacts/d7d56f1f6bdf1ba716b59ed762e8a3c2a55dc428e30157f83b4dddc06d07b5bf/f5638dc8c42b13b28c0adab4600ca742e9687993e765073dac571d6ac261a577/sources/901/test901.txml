<?xml version="1.0"?>
<!-- memory-1: a contents with an undeclared attribute raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory">
<datamodel>
  <data id="c" expr="'untouched'"/>
  <data id="r" expr="({rows: []})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:contents location="c" result="r" statement="0"/>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="c === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
