<?xml version="1.0"?>
<!-- memory-1: a to_json with content raises error.execution and assigns nothing. -->
<scxml initial="s0" version="1.0" conf:datamodel="" xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory">
<datamodel>
  <data id="p" expr="'untouched'"/>
  <data id="m" expr="({source_ids: [], target_ids: [], content: 'x', content_type: 'text/plain'})"/>
</datamodel>
<state id="s0">
  <onentry>
    <memory:to_json location="p" message="m">x</memory:to_json>
    <raise event="executed"/>
  </onentry>
  <transition event="error.execution" cond="p === 'untouched'" conf:targetpass=""/>
  <transition event="*" conf:targetfail=""/>
</state>
<conf:pass/>
<conf:fail/>
</scxml>
