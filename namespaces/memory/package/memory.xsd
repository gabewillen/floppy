<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Schema of floppy's `memory` extension namespace (namespaces/memory):
  the JSON a conversation memory row holds and the short-term register's
  helpers. It governs structure only; the extension component governs
  what the element does. Bind it with the prefix `memory` by convention.

  memory:to_json         location (required): receives the JSON text of a
                         conversation memory row.
                         message (required): an expression.
  memory:contents        location (required): receives the JSON objects of one
                         statement's result, each row's first value parsed.
                         result (required): an expression.
  memory:cut_at_word     location (required): receives {text, cut}, the words
                         within 2048 UTF-8 bytes cut at a whole word.
                         words (required): an expression.
  memory:stm_projection  location (required): receives the bounded scalar
                         projection of a stimulus's data.
                         data (required): an expression.
                         None takes another attribute or content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://github.com/stateforward/floppy/namespaces/memory"
           elementFormDefault="qualified">
  <xs:element name="to_json">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="message" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="contents">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="result" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="cut_at_word">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="words" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="stm_projection">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required"/>
      <xs:attribute name="data" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
