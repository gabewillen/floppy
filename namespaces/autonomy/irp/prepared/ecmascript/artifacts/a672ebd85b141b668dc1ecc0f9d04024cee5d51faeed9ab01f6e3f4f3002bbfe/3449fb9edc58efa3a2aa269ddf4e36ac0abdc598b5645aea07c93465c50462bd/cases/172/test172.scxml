<?xml version="1.0" encoding="UTF-8"?><!-- autonomy-2: a focus that is undefined is left out. --><scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:autonomy="https://github.com/stateforward/floppy/namespaces/autonomy" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="s0" version="1.0" datamodel="ecmascript">
<datamodel>
  <data id="p" expr="null"/>
  <data id="s" expr="({event: 'x', data: {focus: 'stale'}})"/>
  <data id="i" expr="({focus_candidates: []})"/>
</datamodel>
<state id="s0">
  <onentry>
    <autonomy:behavior_input_payload location="p" stimulus="s" focus="i.focus" focus_candidates="i.focus_candidates"/>
  </onentry>
  <transition event="error.execution" target="fail"/>
  <transition cond="JSON.stringify(p) === '{&#34;focus_candidates&#34;:[]}'" target="pass"/>
  <transition target="fail"/>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>