{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.seeing.sight",
  "description": "A sight. cause=change hands on exactly one view that changed past the eye's threshold; cause=look hands on every fresh view, newest first, and holds no view when nothing is in view.",
  "additionalProperties": false,
  "properties": {
    "cause": {
      "description": "Why this sight was handed on: a view changed (change), or you asked to look (look).",
      "enum": [
        "change",
        "look"
      ],
      "examples": [
        "change",
        "look"
      ],
      "title": "Cause",
      "type": "string"
    },
    "views": {
      "description": "The views seen, newest first. Exactly one for a change; none to four for a look.",
      "items": {
        "additionalProperties": false,
        "description": "What one source showed: the image itself, how much it changed since the last view of that source the eye handed on, and how old it was when handed on.",
        "examples": [
          {
            "image": "media/frame-7.jpg",
            "media_type": "image/jpeg",
            "kind": "camera",
            "participants": [],
            "change": 0.42,
            "age_ms": 120,
            "objects": [
              {
                "label": "cup",
                "confidence": 0.87,
                "box": {
                  "x": 0.4,
                  "y": 0.5,
                  "width": 0.1,
                  "height": 0.15
                }
              }
            ],
            "description": "A cup on a desk beside an open laptop."
          }
        ],
        "properties": {
          "image": {
            "description": "The view, as a reference (a URI reference) to the image exactly as its source produced it; floppy passes media by reference, never as bytes [floppy field].",
            "examples": [
              "media/image-1"
            ],
            "format": "uri-reference",
            "minLength": 1,
            "title": "Image",
            "type": "string"
          },
          "media_type": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The image's media type as the stimulus gave it, such as image/png or image/jpeg (the original's Image.media_type) [floppy field].",
            "examples": [
              "image/png",
              "image/jpeg"
            ],
            "title": "Media Type"
          },
          "kind": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Low-cardinality provenance hint copied from the stimulus (for example camera, screen).",
            "examples": [
              "camera",
              "screen"
            ],
            "title": "Kind"
          },
          "participants": {
            "default": [],
            "description": "Who the source's device stamped on the stimulus, copied unchanged. Empty when it knew no one.",
            "examples": [
              [
                {
                  "ref": "person-42",
                  "role": "source"
                }
              ]
            ],
            "items": {
              "additionalProperties": false,
              "description": "Someone who took part in a stimulus: an opaque, producer-stable identity reference and the role it played (source: who produced it; target: who it was addressed to).",
              "examples": [
                {
                  "ref": "+15555550100",
                  "role": "source"
                },
                {
                  "ref": "person-42",
                  "role": "target"
                }
              ],
              "properties": {
                "ref": {
                  "description": "Opaque, producer-stable identity such as a phone number, an app person id, or a chat handle. Never a display name chosen by the bot.",
                  "examples": [
                    "+15555550100",
                    "person-42",
                    "caller"
                  ],
                  "maxLength": 200,
                  "minLength": 1,
                  "title": "Ref",
                  "type": "string"
                },
                "role": {
                  "description": "source: who produced the stimulus (speaker, sender). target: who it was addressed to.",
                  "enum": [
                    "source",
                    "target"
                  ],
                  "examples": [
                    "source",
                    "target"
                  ],
                  "title": "Role",
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "role"
              ],
              "title": "Participant",
              "type": "object"
            },
            "maxItems": 32,
            "title": "Participants",
            "type": "array"
          },
          "change": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How much this view changed since the last view of the same source that was handed on, 0 (same) to 1 (entirely different), as the change measure rates it. Null for a source's first view and for a look.",
            "examples": [
              0.42,
              null
            ],
            "title": "Change"
          },
          "age_ms": {
            "description": "How long ago the view arrived, in milliseconds, when it was handed on.",
            "examples": [
              0,
              120
            ],
            "minimum": 0,
            "title": "Age Ms",
            "type": "integer"
          },
          "objects": {
            "anyOf": [
              {
                "description": "The objects found, by descending confidence with unrated objects last.",
                "items": {
                  "additionalProperties": false,
                  "description": "One object found in the image: its label as the detector produced it, and where it is.",
                  "examples": [
                    {
                      "label": "cup",
                      "confidence": 0.87,
                      "box": {
                        "x": 0.4,
                        "y": 0.5,
                        "width": 0.1,
                        "height": 0.15
                      }
                    }
                  ],
                  "properties": {
                    "label": {
                      "description": "What the detector called the object, exactly as it produced it.",
                      "examples": [
                        "cup",
                        "person"
                      ],
                      "maxLength": 100,
                      "minLength": 1,
                      "title": "Label",
                      "type": "string"
                    },
                    "confidence": {
                      "anyOf": [
                        {
                          "maximum": 1.0,
                          "minimum": 0.0,
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "How sure the detector was, 0..1; null when it does not rate its findings.",
                      "examples": [
                        0.87,
                        null
                      ],
                      "title": "Confidence"
                    },
                    "box": {
                      "additionalProperties": false,
                      "description": "Where the object is, in normalized image coordinates: as fractions of the image's width and height, x and y the top-left corner (0,0 is the image's top-left), width and height the box's size.",
                      "examples": [
                        {
                          "x": 0.25,
                          "y": 0.1,
                          "width": 0.2,
                          "height": 0.35
                        }
                      ],
                      "properties": {
                        "x": {
                          "description": "Left edge, as a fraction of the image width.",
                          "examples": [
                            0.25
                          ],
                          "maximum": 1.0,
                          "minimum": 0.0,
                          "title": "X",
                          "type": "number"
                        },
                        "y": {
                          "description": "Top edge, as a fraction of the image height.",
                          "examples": [
                            0.1
                          ],
                          "maximum": 1.0,
                          "minimum": 0.0,
                          "title": "Y",
                          "type": "number"
                        },
                        "width": {
                          "description": "Box width, as a fraction of the image width.",
                          "examples": [
                            0.2
                          ],
                          "exclusiveMinimum": 0.0,
                          "maximum": 1.0,
                          "title": "Width",
                          "type": "number"
                        },
                        "height": {
                          "description": "Box height, as a fraction of the image height.",
                          "examples": [
                            0.35
                          ],
                          "exclusiveMinimum": 0.0,
                          "maximum": 1.0,
                          "title": "Height",
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "title": "Box",
                      "type": "object"
                    }
                  },
                  "required": [
                    "label",
                    "confidence",
                    "box"
                  ],
                  "title": "DetectedObject",
                  "type": "object"
                },
                "maxItems": 32,
                "title": "Objects",
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Objects found in the view, most confident first. Empty when the object stage found nothing; null when no object stage is composed or it could not answer.",
            "title": "Objects"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A few plain sentences about what the view shows, as the describer put it; null when no describer is composed or it could not answer.",
            "examples": [
              "A cup on a desk beside an open laptop.",
              null
            ],
            "title": "Description"
          }
        },
        "required": [
          "image",
          "age_ms"
        ],
        "title": "View",
        "type": "object"
      },
      "maxItems": 4,
      "title": "Views",
      "type": "array"
    },
    "participants": {
      "default": [],
      "description": "Who is in this sight: the views' stamped participants, first occurrence first.",
      "examples": [
        [
          {
            "ref": "person-42",
            "role": "source"
          }
        ]
      ],
      "items": {
        "additionalProperties": false,
        "description": "Someone who took part in a stimulus: an opaque, producer-stable identity reference and the role it played (source: who produced it; target: who it was addressed to).",
        "examples": [
          {
            "ref": "+15555550100",
            "role": "source"
          },
          {
            "ref": "person-42",
            "role": "target"
          }
        ],
        "properties": {
          "ref": {
            "description": "Opaque, producer-stable identity such as a phone number, an app person id, or a chat handle. Never a display name chosen by the bot.",
            "examples": [
              "+15555550100",
              "person-42",
              "caller"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Ref",
            "type": "string"
          },
          "role": {
            "description": "source: who produced the stimulus (speaker, sender). target: who it was addressed to.",
            "enum": [
              "source",
              "target"
            ],
            "examples": [
              "source",
              "target"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "role"
        ],
        "title": "Participant",
        "type": "object"
      },
      "maxItems": 32,
      "title": "Participants",
      "type": "array"
    }
  },
  "required": [
    "cause",
    "views"
  ],
  "type": "object",
  "if": {
    "properties": {
      "cause": {
        "const": "change"
      }
    }
  },
  "then": {
    "properties": {
      "views": {
        "maxItems": 1,
        "minItems": 1
      }
    }
  },
  "examples": [
    {
      "cause": "change",
      "views": [
        {
          "image": "media/frame-7.jpg",
          "media_type": "image/jpeg",
          "kind": "camera",
          "participants": [],
          "change": null,
          "age_ms": 0
        }
      ],
      "participants": []
    },
    {
      "cause": "look",
      "views": [],
      "participants": []
    }
  ]
}
