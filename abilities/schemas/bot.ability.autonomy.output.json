{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.autonomy.output",
  "description": "The autonomy stage's answer to one turn: handled by a behavior with its selections, unhandled (the cascade goes on to intuition), or failed [floppy fields; mosfet.py's Autonomy stage].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn",
    "handled",
    "services",
    "reason"
  ],
  "properties": {
    "turn": {
      "description": "The body's processing turn this event belongs to, counted from 1 [floppy field].",
      "minimum": 1,
      "type": "integer"
    },
    "handled": {
      "type": "boolean",
      "description": "Whether a behavior handled every percept of the turn."
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1,
            "description": "The selected event's name."
          },
          "data": {
            "description": "The selected event's data."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "The session id of the event's recipient; a trusted seed's selection names none."
          }
        },
        "description": "One selection."
      },
      "description": "A handled turn's selections, in the percepts' arrival order."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The behaviors tried, in order."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "behavior when handled; no-behaviors or unhandled when not; the failure when it failed."
    },
    "failed": {
      "const": true,
      "description": "Present when autonomy failed."
    },
    "acted": {
      "type": "object",
      "required": [
        "percepts",
        "acts"
      ],
      "additionalProperties": false,
      "description": "An unhandled turn's percepts a behavior handled, and their selections.",
      "properties": {
        "percepts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "The handled percepts' positions."
        },
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1,
                "description": "The selected event's name."
              },
              "data": {
                "description": "The selected event's data."
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "description": "The session id of the event's recipient; a trusted seed's selection names none."
              }
            },
            "description": "One selection."
          },
          "description": "What the handling behaviors selected."
        }
      }
    }
  }
}
