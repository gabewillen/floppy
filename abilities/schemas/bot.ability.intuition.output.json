{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.intuition.output",
  "description": "The decision layer's answer to one turn: handled with its selections, unhandled (escalating), or failed [floppy fields; mosfet.py's System 1 stage, since renamed Decision].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn",
    "handled",
    "reason",
    "acted",
    "confidence_tuner",
    "bytes_per_token"
  ],
  "properties": {
    "turn": {
      "description": "The body's processing turn this event belongs to, counted from 1 [floppy field].",
      "minimum": 1,
      "type": "integer"
    },
    "handled": {
      "type": "boolean",
      "description": "Whether the decision handled the turn."
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event"
        ],
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1,
            "description": "The selected event's name."
          },
          "data": {
            "description": "The selected event's data."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "The session id of the event's one offerer, when one session offers it."
          }
        }
      },
      "description": "A handled turn's selections."
    },
    "acted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event"
        ],
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1,
            "description": "The selected event's name."
          },
          "data": {
            "description": "The selected event's data."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "The session id of the event's one offerer, when one session offers it."
          }
        }
      },
      "description": "What the stage sent, each to its target."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "none when handled; low_confidence, deliberative_input or empty_product when it escalates; the failure when it failed."
    },
    "hand_to": {
      "type": "string",
      "enum": [
        "intuition",
        "reasoning"
      ],
      "description": "The tier a pass handed the turn to."
    },
    "failed": {
      "const": true,
      "description": "Present when the decision failed."
    },
    "confidence_tuner": {
      "type": "object",
      "description": "The decision layer's confidence tuner state, on the 0-100 scale.",
      "required": [
        "mean",
        "var",
        "n"
      ],
      "additionalProperties": false,
      "properties": {
        "mean": {
          "type": "number"
        },
        "var": {
          "type": "number"
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bytes_per_token": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "The fewest bytes a token any answer showed so far."
    }
  }
}
