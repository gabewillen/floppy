{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.conversation.snapshot.output",
  "description": "Current transient detector registry observation.",
  "properties": {
    "request_ref": {
      "minLength": 1,
      "title": "Request Ref",
      "type": "string"
    },
    "detector_refs": {
      "default": [],
      "description": "Transient (relationship reference, source identity) detector keys.",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          }
        ],
        "type": "array"
      },
      "title": "Detector Refs",
      "type": "array"
    }
  },
  "required": [
    "request_ref"
  ],
  "type": "object"
}
