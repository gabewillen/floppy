{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.offers",
  "description": "[floppy name] An ability's current choices, sent to its parent from each stable state: the events it takes now, as <decision:choice> writes them.",
  "type": "object",
  "properties": {
    "ability": {
      "type": "string",
      "minLength": 1,
      "description": "The offering ability's invoke id."
    },
    "choices": {
      "type": "array",
      "description": "The canonical choices: one entry per event the ability takes now.",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "description": "The event's resolved event:schema."
          },
          "description": {
            "type": "string"
          },
          "effort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "description": "How heavy an action the event is, as its offering ability declares it (<decision:choice effort>, decision D206); 0 when absent. A tier is offered only the choices within its effort ceiling [floppy field]."
          }
        },
        "required": [
          "event",
          "schema"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ability",
    "choices"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "ability": "cognition",
      "choices": [
        {
          "event": "bot.ability.cognition.ignore",
          "schema": {
            "type": "object"
          }
        }
      ]
    }
  ]
}
