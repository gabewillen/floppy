{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.memory.output",
  "description": "Memory apply output after a committed transaction. results align 1:1 with input statements. On rollback the ability fails and this payload is not emitted.",
  "additionalProperties": false,
  "properties": {
    "results": {
      "description": "One StatementResult per InputData.statements entry, same order.",
      "items": {
        "additionalProperties": false,
        "description": "Outcome of one statement inside a committed transaction.",
        "properties": {
          "rowcount": {
            "description": "Affected or returned row count.",
            "title": "Rowcount",
            "type": "integer"
          },
          "rows": {
            "default": [],
            "description": "Result rows for SELECT (empty for pure DML without RETURNING).",
            "items": {
              "additionalProperties": false,
              "description": "One result row with ordered columns.",
              "properties": {
                "columns": {
                  "description": "Column names in result order.",
                  "items": {
                    "type": "string"
                  },
                  "title": "Columns",
                  "type": "array"
                },
                "values": {
                  "description": "Cell values aligned with columns.",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": "Values",
                  "type": "array"
                }
              },
              "required": [
                "columns",
                "values"
              ],
              "title": "Row",
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "rowcount"
        ],
        "title": "StatementResult",
        "type": "object"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "results"
  ],
  "type": "object",
  "examples": [
    {
      "results": [
        {
          "rowcount": 1,
          "rows": [
            {
              "columns": [
                "content"
              ],
              "values": [
                "{\"kind\":\"fact\",\"text\":\"Floppy\"}"
              ]
            }
          ]
        }
      ]
    }
  ]
}
