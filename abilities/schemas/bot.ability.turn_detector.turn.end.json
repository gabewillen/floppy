{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.turn_detector.turn.end",
  "description": "Turn boundary carrying an optional final text or audio chunk.",
  "examples": [
    {
      "conversation_ref": "support-call",
      "source_participant_ref": "caller",
      "turn_ref": "turn-1"
    }
  ],
  "properties": {
    "conversation_ref": {
      "default": "conversation",
      "examples": [
        "support-call"
      ],
      "minLength": 1,
      "title": "Conversation Ref",
      "type": "string"
    },
    "turn_ref": {
      "description": "Stable reference for the active turn.",
      "minLength": 1,
      "title": "Turn Ref",
      "type": "string"
    },
    "source_participant_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      ],
      "default": "caller",
      "examples": [
        "caller"
      ],
      "title": "Source Participant Ref"
    },
    "content": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "audio": "#/$defs/AudioStimulus",
              "content": "#/$defs/ContentStimulus",
              "event": "#/$defs/EventStimulus",
              "image": "#/$defs/ImageStimulus",
              "text": "#/$defs/TextStimulus"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "description": "Audio content produced by a participant.",
              "examples": [
                {
                  "channels": 1,
                  "content": "media/audio-1",
                  "kind": "audio",
                  "sample_rate_hz": 16000,
                  "source_participant_ref": "caller"
                }
              ],
              "properties": {
                "kind": {
                  "const": "audio",
                  "default": "audio",
                  "title": "Kind",
                  "type": "string"
                },
                "source_participant_ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    }
                  ],
                  "description": "Participant that produced the audio.",
                  "title": "Source Participant Ref"
                },
                "content": {
                  "description": "Reference (a URI reference) to this chunk's audio; floppy passes media by reference, never as bytes [floppy field].",
                  "format": "uri-reference",
                  "title": "Content",
                  "type": "string"
                },
                "sample_rate_hz": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Sample rate of raw PCM content in hertz. Required for correct STT packaging when content is not a WAV container.",
                  "examples": [
                    16000,
                    48000
                  ],
                  "title": "Sample Rate Hz"
                },
                "channels": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Channel count of raw PCM content. Defaults to mono when omitted at the decoder.",
                  "examples": [
                    1
                  ],
                  "title": "Channels"
                }
              },
              "required": [
                "source_participant_ref",
                "content"
              ],
              "title": "AudioStimulus",
              "type": "object"
            },
            {
              "description": "Text content produced by a participant.",
              "properties": {
                "kind": {
                  "const": "text",
                  "default": "text",
                  "title": "Kind",
                  "type": "string"
                },
                "source_participant_ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    }
                  ],
                  "description": "Participant that produced the text.",
                  "title": "Source Participant Ref"
                },
                "content": {
                  "description": "Readable text content.",
                  "minLength": 1,
                  "title": "Content",
                  "type": "string"
                }
              },
              "required": [
                "source_participant_ref",
                "content"
              ],
              "title": "TextStimulus",
              "type": "object"
            },
            {
              "description": "Image content produced by a participant.",
              "properties": {
                "kind": {
                  "const": "image",
                  "default": "image",
                  "title": "Kind",
                  "type": "string"
                },
                "source_participant_ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    }
                  ],
                  "description": "Participant that produced the image.",
                  "title": "Source Participant Ref"
                },
                "content": {
                  "description": "Reference (a URI reference) to the image; floppy passes media by reference, never as bytes [floppy field].",
                  "format": "uri-reference",
                  "title": "Content",
                  "type": "string"
                }
              },
              "required": [
                "source_participant_ref",
                "content"
              ],
              "title": "ImageStimulus",
              "type": "object"
            },
            {
              "description": "Structured event content produced by a participant or service.",
              "properties": {
                "kind": {
                  "const": "event",
                  "default": "event",
                  "title": "Kind",
                  "type": "string"
                },
                "source_participant_ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    }
                  ],
                  "description": "Event source participant.",
                  "title": "Source Participant Ref"
                },
                "event": {
                  "description": "Stable modeled event name.",
                  "minLength": 1,
                  "title": "Event",
                  "type": "string"
                },
                "payload": {
                  "additionalProperties": true,
                  "description": "Structured event payload.",
                  "title": "Payload",
                  "type": "object"
                }
              },
              "required": [
                "source_participant_ref",
                "event"
              ],
              "title": "EventStimulus",
              "type": "object"
            },
            {
              "description": "Modality-neutral content carried through a participant turn.",
              "properties": {
                "kind": {
                  "const": "content",
                  "default": "content",
                  "title": "Kind",
                  "type": "string"
                },
                "source_participant_ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    }
                  ],
                  "description": "Participant that produced the content.",
                  "title": "Source Participant Ref"
                },
                "content": {
                  "description": "Uninterpreted content payload.",
                  "title": "Content"
                },
                "content_type": {
                  "description": "Content modality or media type.",
                  "minLength": 1,
                  "title": "Content Type",
                  "type": "string"
                }
              },
              "required": [
                "source_participant_ref",
                "content",
                "content_type"
              ],
              "title": "ContentStimulus",
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional final turn chunk.",
      "title": "Content"
    }
  },
  "required": [
    "turn_ref"
  ],
  "type": "object"
}
