{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.conversation.output",
  "additionalProperties": false,
  "description": "The current exchange, emitted after each commit: the inbound that opened it and what the bot said since. An inbound commit opens a new exchange; the bot's outbound messages join it; the next inbound replaces it. Nothing earlier is carried.",
  "properties": {
    "parent": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "description": "Canonical HSM event name that emitted this upstream payload.",
              "examples": [
                "environment.sound",
                "bot.ability.listening.speech.output"
              ],
              "minLength": 1,
              "title": "Event",
              "type": "string"
            },
            "data": {
              "additionalProperties": false,
              "description": "Complete typed payload emitted by the upstream event.",
              "examples": [
                {
                  "channels": null,
                  "content": "What is the weather like?",
                  "content_type": "text/plain",
                  "sample_rate_hz": null,
                  "source_ids": [
                    "caller"
                  ],
                  "target_ids": []
                }
              ],
              "properties": {
                "source_ids": {
                  "description": "One or more opaque identities that produced this content.",
                  "examples": [
                    [
                      "caller"
                    ],
                    [
                      "left-speaker",
                      "right-speaker"
                    ]
                  ],
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "number"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "maxItems": 4,
                  "minItems": 1,
                  "title": "Source Ids",
                  "type": "array",
                  "uniqueItems": true
                },
                "target_ids": {
                  "description": "Zero or more opaque identities addressed by this content; an empty set means the addressee is unknown or the input is ambient.",
                  "examples": [
                    [],
                    [
                      "bot"
                    ]
                  ],
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "number"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "maxItems": 4,
                  "title": "Target Ids",
                  "type": "array",
                  "uniqueItems": true
                },
                "content": {
                  "description": "Modality-specific content carried without interpretation by Conversation. text/* uses str; audio/* uses bytes (base64 on JSON wires); other modalities may use structured objects.",
                  "examples": [
                    "What is the weather like?",
                    "AAECAw=="
                  ],
                  "title": "Content"
                },
                "content_type": {
                  "description": "Content media type or modality label; it is data, not an event route.",
                  "examples": [
                    "text/plain",
                    "audio/pcm",
                    "audio/raw",
                    "application/x-sign-language"
                  ],
                  "minLength": 1,
                  "title": "Content Type",
                  "type": "string"
                },
                "sample_rate_hz": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Sample rate of raw PCM audio content in hertz. Required for correct STT packaging when content_type is audio/pcm, audio/raw, or similar non-container audio. Omit for text and WAV.",
                  "examples": [
                    16000,
                    48000
                  ],
                  "title": "Sample Rate Hz"
                },
                "channels": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Channel count of raw PCM audio content. Omit for text and self-describing containers.",
                  "examples": [
                    1
                  ],
                  "title": "Channels"
                }
              },
              "required": [
                "source_ids",
                "target_ids",
                "content",
                "content_type"
              ],
              "title": "TurnData",
              "type": "object"
            },
            "id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Upstream HSM event correlation id, when the emitter stamped one.",
              "examples": [
                "turn-123"
              ],
              "title": "Id"
            },
            "source": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Upstream HSM event source identity, when stamped by its producer.",
              "examples": [
                "phone-1"
              ],
              "title": "Source"
            },
            "target": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Upstream HSM event target identity, when stamped for delivery.",
              "examples": [
                "listening-1"
              ],
              "title": "Target"
            }
          },
          "required": [
            "event",
            "data"
          ],
          "title": "StimulusData[TurnData]",
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The exact typed inbound event that opened this exchange, when one exists."
    },
    "messages": {
      "default": [],
      "description": "The current exchange in causal order: the inbound message that opened it, then the bot's outbound messages committed since. Empty of anything before that inbound.",
      "items": {
        "additionalProperties": false,
        "description": "One immutable, model-safe inbound or outbound message of the current exchange. A model reads who said it (participants), which way, and what was said (content); provenance and the opaque source_ids and target_ids are correlation: they stay on the typed data and are left out of what a model is shown.",
        "examples": [
          {
            "content": "Hello",
            "content_type": "text/plain",
            "direction": "inbound",
            "provenance": {
              "event": "bot.ability.conversation.input",
              "id": "turn-1",
              "source": "caller",
              "target": "conversation"
            },
            "source_ids": [
              "caller"
            ],
            "target_ids": [
              "bot"
            ]
          }
        ],
        "properties": {
          "direction": {
            "description": "Whether the message came from a participant or the bot.",
            "enum": [
              "inbound",
              "outbound"
            ],
            "title": "Direction",
            "type": "string"
          },
          "source_ids": {
            "description": "Opaque source identities associated with the message.",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                }
              ]
            },
            "maxItems": 4,
            "title": "Source Ids",
            "type": "array",
            "uniqueItems": true
          },
          "target_ids": {
            "description": "Opaque target identities associated with the message.",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                }
              ]
            },
            "maxItems": 4,
            "title": "Target Ids",
            "type": "array",
            "uniqueItems": true
          },
          "content": {
            "default": null,
            "description": "Decoded text or JSON-safe structured content; raw media bytes are never accepted here."
          },
          "content_type": {
            "description": "Media type of the model-safe message content.",
            "minLength": 1,
            "title": "Content Type",
            "type": "string"
          },
          "participants": {
            "default": [],
            "description": "Who produced or was addressed by this message, stamped by its producer and never inferred: an inbound message carries the participants stamped on the turn it was built from (who spoke, and to whom), and Speaking stamps the bot's own voice ref on what it said.",
            "examples": [
              [],
              [
                {
                  "ref": "voice:tts:warm",
                  "role": "source"
                }
              ]
            ],
            "items": {
              "additionalProperties": false,
              "description": "Someone who took part in a stimulus: an opaque, producer-stable identity reference and the role it played (source: who produced it; target: who it was addressed to).",
              "examples": [
                {
                  "ref": "+15555550100",
                  "role": "source"
                },
                {
                  "ref": "person-42",
                  "role": "target"
                },
                {
                  "own": true,
                  "ref": "voice:3f2a9c",
                  "role": "source"
                }
              ],
              "properties": {
                "ref": {
                  "description": "Opaque, producer-stable identity such as a phone number, an app person id, or a chat handle. Never a display name chosen by the bot.",
                  "examples": [
                    "+15555550100",
                    "person-42",
                    "caller"
                  ],
                  "maxLength": 200,
                  "minLength": 1,
                  "title": "Ref",
                  "type": "string"
                },
                "role": {
                  "description": "source: who produced the stimulus (speaker, sender). target: who it was addressed to.",
                  "enum": [
                    "source",
                    "target"
                  ],
                  "examples": [
                    "source",
                    "target"
                  ],
                  "title": "Role",
                  "type": "string"
                },
                "own": {
                  "default": false,
                  "description": "True when the producer knows this participant is the bot itself, for example the bot's own voice heard back or the voice it spoke with. Stamped only by that producer; never inferred.",
                  "examples": [
                    false,
                    true
                  ],
                  "title": "Own",
                  "type": "boolean"
                },
                "resembles": {
                  "default": [],
                  "description": "For an identity its producer made just now (nobody it knew): the known identities it resembles, best first, at most 3. Stamped only by that producer; never a link.",
                  "examples": [
                    [
                      {
                        "ref": "voice:7b1e04",
                        "similarity": 0.42
                      }
                    ]
                  ],
                  "items": {
                    "additionalProperties": false,
                    "description": "A known identity this new one resembles: its ref and how similar the two are (-1..1). Perception data only: it links nothing, and it is never a print.",
                    "examples": [
                      {
                        "ref": "voice:7b1e04",
                        "similarity": 0.42
                      }
                    ],
                    "properties": {
                      "ref": {
                        "description": "The ref of the known identity, as its producer stamps it.",
                        "examples": [
                          "voice:7b1e04"
                        ],
                        "maxLength": 200,
                        "minLength": 1,
                        "title": "Ref",
                        "type": "string"
                      },
                      "similarity": {
                        "description": "How similar the two are, -1..1; higher is more alike.",
                        "examples": [
                          0.42
                        ],
                        "maximum": 1.0,
                        "minimum": -1.0,
                        "title": "Similarity",
                        "type": "number"
                      }
                    },
                    "required": [
                      "ref",
                      "similarity"
                    ],
                    "type": "object"
                  },
                  "maxItems": 3,
                  "title": "Resembles",
                  "type": "array"
                }
              },
              "required": [
                "ref",
                "role"
              ],
              "title": "Participant",
              "type": "object"
            },
            "maxItems": 32,
            "title": "Participants",
            "type": "array"
          },
          "provenance": {
            "additionalProperties": false,
            "description": "Typed event provenance for this committed message.",
            "examples": [
              {
                "event": "bot.ability.conversation.append",
                "id": "append-1",
                "source": "speaking",
                "target": "conversation"
              }
            ],
            "properties": {
              "event": {
                "description": "Canonical event that committed this message.",
                "minLength": 1,
                "title": "Event",
                "type": "string"
              },
              "id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Correlation id of the committing event.",
                "title": "Id"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "HSM source identity of the committing event.",
                "title": "Source"
              },
              "target": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "HSM target identity of the committing event.",
                "title": "Target"
              },
              "session_ref": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Conversation relationship reference, when known.",
                "title": "Session Ref"
              },
              "turn_ref": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Turn detector reference, when known.",
                "title": "Turn Ref"
              }
            },
            "required": [
              "event"
            ],
            "title": "MessageProvenance",
            "type": "object"
          }
        },
        "required": [
          "direction",
          "source_ids",
          "target_ids",
          "content_type",
          "provenance"
        ],
        "title": "Message",
        "type": "object"
      },
      "title": "Messages",
      "type": "array"
    }
  },
  "type": "object",
  "examples": [
    {
      "messages": [
        {
          "content": "Hello",
          "content_type": "text/plain",
          "direction": "inbound",
          "provenance": {
            "event": "bot.ability.conversation.input",
            "id": "turn-1"
          },
          "source_ids": [
            "caller"
          ],
          "target_ids": [
            "bot"
          ]
        }
      ]
    }
  ]
}
