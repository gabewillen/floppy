{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.turn_detector.failed",
  "description": "Failure terminal for participant turn assembly.",
  "properties": {
    "stage": {
      "const": "turn",
      "default": "turn",
      "title": "Stage",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "participant_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      ],
      "default": "bot",
      "title": "Participant Ref"
    },
    "conversation_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Ref"
    },
    "turn_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Ref"
    },
    "source_participant_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Participant Ref"
    }
  },
  "required": [
    "message"
  ],
  "type": "object"
}
