<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Routines ability: it keeps the ACTIVE persistent routines of behavior inventory running and
  forwards their ticks. The cognition (abilities/cognition/cognition.scx) invokes it
  as its long-lived child "routines", with the memory's address as <param name="memory">.

    active { inventory { reconciling { recalling } -> running
                         -bot.ability.routines.reconcile-> reconciling },
             chain { chain_off | chain_on } }

  Reconciling: with no memory (null) it
  logs <log label="routines" expr="'absent'"> and runs nothing. Otherwise
  it selects, through the Memory ability (abilities/memory/memory.scx), the
  ACTIVE persistent bot_behavior rows in inventory order and raises
  bot.ability.routines.reconciled {running}; when the rows' names,
  sources (the paths of their programs, decision D121) or updated_at (a
  revised program keeps its path) differ
  from the running set, the
  chain restarts on them: the routines that are gone or no longer ACTIVE
  stop, the changed ones restart and the new ones start. A recall that
  fails is logged as bot.ability.routines.reconcile.failed and keeps the
  running set. A reconcile that arrives while reconciling re-enters it,
  which cancels the recall in hand and reads the inventory again.

  Chain: SCXML holds a fixed set of invokes per state, so the routines run
  as a chain of runners (abilities/routines_runner/routines_runner.scx): chain_on invokes
  the first runner with the running set, and re-entering it (cancelling
  the runner, SCXML 6.4) restarts the chain.

  Ticks: each bot.behavior.tick the chain passes up goes to the cognition
  (#_parent), which hands it to the body as a stimulus: a new turn the bot
  decides on. A tick that arrives while reconciling waits in the data
  model queue ticks and is taken in
  running, in order: forwarded when its routine is in the running set,
  else dropped as stale (logged routines.stale).

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline).

  Bindings: the Memory ability's sql service, with its directory granted by
  the run (scx run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="routines" initial="active">
  <datamodel>
    <!-- The address of the bot's memory (the cognition's), or null. -->
    <data id="memory" expr="null"/>
    <!-- The id of each request this document last sent the memory, by
         the state that sent it (decision D265). -->
    <data id="memory_requests" expr="({})"/>
    <!-- The behaviors of one status and lifetime: plain rows, portable to both engines. -->
    <data id="select_routines">SELECT name, source, updated_at FROM bot_behavior WHERE status = ? AND lifetime = ? ORDER BY name</data>
    <!-- The rows the last recall selected, and the ones the chain runs. -->
    <data id="desired" expr="[]"/>
    <data id="routines" expr="[]"/>
    <data id="restart" expr="false"/>
    <!-- Ticks deferred while reconciling. -->
    <data id="ticks" expr="[]"/>
  </datamodel>
  <script src="routines.js"/>

  <parallel id="active">
    <state id="inventory" initial="reconciling">
      <transition event="bot.ability.routines.reconcile" event:schema="../schemas/bot.ability.routines.reconcile.json"
                  type="internal" target="reconciling"/>

      <state id="reconciling" initial="recalling">
        <transition cond="hasNoMemory()" target="running">
          <log label="routines" expr="'absent'"/>
        </transition>

        <!-- One read of behavior inventory. -->
        <state id="recalling">
          <onentry>
            <if cond="hasMemory()">
              <send event="bot.ability.memory.input" targetexpr="memory" idlocation="memory_requests.recall">
                <param name="id" expr="memory_requests.recall"/>
                <param name="statements" expr="routinesSelectStatements()"/>
              </send>
            </if>
          </onentry>
          <transition event="bot.ability.memory.output" cond="isMemoryReply('recall')" event:schema="../schemas/bot.ability.memory.output.json" target="running">
            <assign location="desired" expr="routinesFromMemoryOutput(_event)"/>
            <assign location="restart" expr="isRevisionChanged()"/>
            <assign location="routines" expr="desired"/>
            <raise event="bot.ability.routines.reconciled"/>
          </transition>
          <transition event="bot.ability.failed" cond="isMemoryReply('recall')" event:schema="../schemas/bot.ability.failed.json" target="running">
            <log label="bot.ability.routines.reconcile.failed" expr="reconcileFailedLog(_event.data.message)"/>
          </transition>
          <transition event="error.*" target="running">
            <log label="bot.ability.routines.reconcile.failed" expr="reconcileFailedLog(_event.name)"/>
          </transition>
        </state>
      </state>

      <state id="running">
        <transition cond="hasRunningTick()">
          <send event="bot.behavior.tick" target="#_parent">
            <content expr="ticks[0]"/>
          </send>
          <assign location="ticks" expr="ticks.slice(1)"/>
        </transition>
        <transition cond="ticks.length &gt; 0">
          <log label="routines.stale" expr="ticks[0].name"/>
          <assign location="ticks" expr="ticks.slice(1)"/>
        </transition>
      </state>
    </state>

    <!-- The running set, as a chain of runners. -->
    <state id="chain" initial="chain_off">
      <transition event="bot.ability.routines.reconciled" cond="restartsOnRoutines()"
                  type="internal" target="chain_on">
        <log label="bot.ability.routines.reconciled" expr="routineNames()"/>
      </transition>
      <transition event="bot.ability.routines.reconciled" cond="restart" type="internal" target="chain_off">
        <log label="bot.ability.routines.reconciled" expr="''"/>
      </transition>

      <state id="chain_off"/>
      <state id="chain_on">
        <invoke id="runner" type="scxml" src="../routines_runner/routines_runner.scx">
          <param name="routines" expr="routines"/>
        </invoke>
        <transition event="bot.behavior.tick" event:schema="../schemas/bot.behavior.tick.json"
                    cond="In('reconciling')">
          <assign location="ticks" expr="ticks.concat([_event.data])"/>
          <log label="routines.deferred" expr="_event.data.name"/>
        </transition>
        <transition event="bot.behavior.tick" event:schema="../schemas/bot.behavior.tick.json">
          <send event="bot.behavior.tick" target="#_parent">
            <content expr="_event.data"/>
          </send>
        </transition>
        <transition event="error.communication.runner" target="chain_off">
          <log label="routines.failed" expr="_event.name"/>
        </transition>
      </state>
    </state>
  </parallel>
</scxml>
