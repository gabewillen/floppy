<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Memory ability (mosfet abilities/memory: memory.py Memory,
  store.py MemoryStore on providers/sqlite_memory): one transaction of
  mosfet's Statements against the bot's memory database, through the sql
  service (services/sql). An ability that remembers invokes it from the
  state that needs memory (reasoning's recalling and retaining, the
  identity's recalling and adopting, the conversation's recalling), so
  attaching memory is implicit: the invocation is the attachment, and
  leaving the invoking state cancels it.

    migrating -> applying -> applied (final)

  Input: the <param>s database (the database file, in the directory the run
  grants the sql service) and statements (mosfet's InputData.statements:
  [{sql, parameters?}], at least one).

  migrating invokes the migration ability (abilities/migration.scx, Alembic's
  upgrade head) with mosfet's revisions 0001 and 0002 (abilities/memory/,
  the same tables, columns, defaults and indexes as mosfet's Alembic
  scripts), so the database carries Alembic's alembic_version as mosfet's
  does and a mosfet database is used in place. A database at a revision the
  history does not hold is refused untouched. applying then runs the
  statements in one transaction.

  Output (to the parent, as mosfet's Memory answers): bot.ability.memory.output
  {results} (mosfet's OutputData: one result per statement, in order), or
  bot.ability.failed {message} (mosfet's FailureData) when nothing was
  committed. Then the session ends.

  Bindings: the migration namespace package (through the migration
  ability) and the sql service package (a run grants it its directory: scx
  run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="memory" initial="migrating">
  <datamodel>
    <!-- The invoker's <param>s. -->
    <data id="database" expr="null"/>
    <data id="statements" expr="[]"/>
    <!-- The schema: mosfet's Alembic revisions, one file each. -->
    <data id="revision_0001" src="memory/0001_initial_memory_schema.json"/>
    <data id="revision_0002" src="memory/0002_behavior_lifetime.json"/>
    <data id="failure" expr="null"/>
  </datamodel>

  <!-- Bring the database to the head revision. -->
  <state id="migrating">
    <invoke id="migration" type="scxml" src="migration.scx">
      <param name="database" expr="database"/>
      <param name="revisions" expr="[revision_0001, revision_0002]"/>
    </invoke>
    <transition event="bot.ability.migration.output" event:schema="schemas/bot.ability.migration.output.json"
                cond="_event.invokeid === 'migration'" target="applying"/>
    <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json"
                cond="_event.invokeid === 'migration'" target="failing">
      <assign location="failure" expr="_event.data.message"/>
    </transition>
    <transition event="error.*" target="failing">
      <assign location="failure" expr="'Memory could not run (' + _event.name + ')'"/>
    </transition>
  </state>

  <!-- Apply the statements, in one transaction. -->
  <state id="applying">
    <invoke id="apply" type="https://github.com/stateforward/floppy/services/sql">
      <param name="database" expr="database"/>
      <param name="statements" expr="statements"/>
    </invoke>
    <transition event="sql.result" cond="_event.invokeid === 'apply'" target="applied">
      <send event="bot.ability.memory.output" target="#_parent">
        <param name="results" expr="_event.data.results"/>
      </send>
    </transition>
    <transition event="sql.failed" cond="_event.invokeid === 'apply'" target="failing">
      <assign location="failure" expr="_event.data.message"/>
    </transition>
    <transition event="error.*" target="failing">
      <assign location="failure" expr="'Memory could not run (' + _event.name + ')'"/>
    </transition>
  </state>

  <state id="failing">
    <onentry>
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="failure"/>
      </send>
    </onentry>
    <transition target="applied"/>
  </state>

  <final id="applied"/>
</scxml>
