<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Memory ability (mosfet abilities/memory: memory.py Memory,
  store.py MemoryStore on providers/sqlite_memory): one transaction of
  mosfet's Statements against the bot's memory database, through the sql
  service (services/sql, SQLite) or the pgsql service (services/pgsql,
  Postgres over its wire protocol, mosfet's providers/postgres_memory). An ability that remembers invokes it from the
  state that needs memory (reasoning's recalling and retaining, the
  identity's recalling and adopting, the conversation's running), so
  memory is an invoked child of that state: entering the state starts it,
  and leaving the state cancels it.

    opening -> migrating -> applying -> applied (final)

  Input: the <param>s database and statements (mosfet's
  InputData.statements: [{sql, parameters?}], at least one). The database
  names the engine: a file path is a SQLite database in the directory the
  run grants the sql service; a Postgres connection URI
  (postgresql://USER@IP:PORT/DBNAME) is a Postgres database the run lets
  the pgsql service reach. The statements are the invoker's own SQL,
  passed to the engine unchanged.

  opening picks the engine. migrating reads the schema version: SQLite's
  PRAGMA user_version, or Postgres's alembic_version table (mosfet's
  Alembic version table, created when missing). applying runs, in one
  transaction, the migrations the database lacks (mosfet's Alembic
  revisions 0001 and 0002, in each engine's dialect: the same tables,
  columns, defaults and indexes; SQLite records them as user_version 1 and
  2, Postgres as alembic_version '0001' and '0002', and Postgres's
  defaulted created_at and updated_at are TIMESTAMPTZ DEFAULT NOW(), as
  postgres_memory declares created_at) and then the statements. A database
  whose version is newer than 2 is refused untouched. Two invocations that
  migrate one fresh database at once are serialized by the engine; the
  one that loses retries once from opening.

  Output (to the parent, as mosfet's Memory answers): bot.ability.memory.output
  {results} (mosfet's OutputData: one result per statement, in order,
  without the migrations'), or bot.ability.failed {message} (mosfet's
  FailureData) when nothing was committed. Then the session ends.

  Bindings: the sql and pgsql service packages; a run grants both (scx
  run's dir option for sql, and its wasi option inherit-network for
  pgsql), because scx binds every service a document names before the
  run starts, though a run uses only the engine its database names.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" name="memory" initial="opening">
  <datamodel>
    <!-- The invoker's <param>s. -->
    <data id="database" expr="null"/>
    <data id="statements" expr="[]"/>
    <!-- The schema: the head version and each revision's statements. -->
    <data id="head" expr="2"/>
    <data id="version" expr="0"/>
    <data id="revision_0001" expr="[
      'CREATE TABLE IF NOT EXISTS bot_memory (memory_id TEXT NOT NULL, scope TEXT DEFAULT \'memory\' NOT NULL, context_ref TEXT, subject_ref TEXT, kind TEXT, sensitivity TEXT, retention TEXT, content TEXT NOT NULL, content_format TEXT DEFAULT \'text/plain\' NOT NULL, query_tags TEXT, metadata_json TEXT DEFAULT \'{}\' NOT NULL, created_at TEXT DEFAULT (CURRENT_TIMESTAMP) NOT NULL, PRIMARY KEY (memory_id))',
      'CREATE INDEX IF NOT EXISTS bot_memory_context_idx ON bot_memory (context_ref, subject_ref)',
      'CREATE INDEX IF NOT EXISTS bot_memory_query_idx ON bot_memory (query_tags)',
      'CREATE INDEX IF NOT EXISTS bot_memory_scope_idx ON bot_memory (scope, created_at)',
      'CREATE TABLE IF NOT EXISTS bot_behavior (name TEXT NOT NULL, source TEXT NOT NULL, description TEXT DEFAULT \'\' NOT NULL, examples_json TEXT DEFAULT \'[]\' NOT NULL, status TEXT DEFAULT \'ACTIVE\' NOT NULL, status_reason TEXT DEFAULT \'\' NOT NULL, status_updated_at TEXT DEFAULT \'\' NOT NULL, used_count TEXT DEFAULT \'0\' NOT NULL, last_used_at TEXT DEFAULT \'\' NOT NULL, failed_count TEXT DEFAULT \'0\' NOT NULL, last_failed_at TEXT DEFAULT \'\' NOT NULL, created_at TEXT DEFAULT (CURRENT_TIMESTAMP) NOT NULL, updated_at TEXT DEFAULT (CURRENT_TIMESTAMP) NOT NULL, PRIMARY KEY (name))',
      'CREATE TABLE IF NOT EXISTS bot_behavior_trigger (behavior_name TEXT NOT NULL, &quot;trigger&quot; TEXT NOT NULL, PRIMARY KEY (behavior_name, &quot;trigger&quot;), FOREIGN KEY(behavior_name) REFERENCES bot_behavior (name) ON DELETE CASCADE)',
      'CREATE INDEX IF NOT EXISTS bot_behavior_trigger_event_idx ON bot_behavior_trigger (&quot;trigger&quot;)',
      'CREATE TABLE IF NOT EXISTS bot_stm_memory (stm_id TEXT NOT NULL, stimulus_name TEXT NOT NULL, payload_json TEXT DEFAULT \'{}\' NOT NULL, event_id TEXT, source TEXT, target TEXT, created_at TEXT NOT NULL, last_accessed_at TEXT, PRIMARY KEY (stm_id))',
      'CREATE INDEX IF NOT EXISTS bot_stm_memory_recent_idx ON bot_stm_memory (stimulus_name, created_at)',
      'CREATE INDEX IF NOT EXISTS bot_stm_memory_created_idx ON bot_stm_memory (created_at)',
      'PRAGMA user_version = 1'
    ]"/>
    <data id="revision_0002" expr="[
      'ALTER TABLE bot_behavior ADD COLUMN lifetime TEXT DEFAULT \'turn\' NOT NULL',
      'PRAGMA user_version = 2'
    ]"/>
    <data id="revision_0001_postgres" expr="[
      'CREATE TABLE IF NOT EXISTS bot_memory (memory_id TEXT NOT NULL, scope TEXT DEFAULT \'memory\' NOT NULL, context_ref TEXT, subject_ref TEXT, kind TEXT, sensitivity TEXT, retention TEXT, content TEXT NOT NULL, content_format TEXT DEFAULT \'text/plain\' NOT NULL, query_tags TEXT, metadata_json TEXT DEFAULT \'{}\' NOT NULL, created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL, PRIMARY KEY (memory_id))',
      'CREATE INDEX IF NOT EXISTS bot_memory_context_idx ON bot_memory (context_ref, subject_ref)',
      'CREATE INDEX IF NOT EXISTS bot_memory_query_idx ON bot_memory (query_tags)',
      'CREATE INDEX IF NOT EXISTS bot_memory_scope_idx ON bot_memory (scope, created_at)',
      'CREATE TABLE IF NOT EXISTS bot_behavior (name TEXT NOT NULL, source TEXT NOT NULL, description TEXT DEFAULT \'\' NOT NULL, examples_json TEXT DEFAULT \'[]\' NOT NULL, status TEXT DEFAULT \'ACTIVE\' NOT NULL, status_reason TEXT DEFAULT \'\' NOT NULL, status_updated_at TEXT DEFAULT \'\' NOT NULL, used_count TEXT DEFAULT \'0\' NOT NULL, last_used_at TEXT DEFAULT \'\' NOT NULL, failed_count TEXT DEFAULT \'0\' NOT NULL, last_failed_at TEXT DEFAULT \'\' NOT NULL, created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL, updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL, PRIMARY KEY (name))',
      'CREATE TABLE IF NOT EXISTS bot_behavior_trigger (behavior_name TEXT NOT NULL, &quot;trigger&quot; TEXT NOT NULL, PRIMARY KEY (behavior_name, &quot;trigger&quot;), FOREIGN KEY(behavior_name) REFERENCES bot_behavior (name) ON DELETE CASCADE)',
      'CREATE INDEX IF NOT EXISTS bot_behavior_trigger_event_idx ON bot_behavior_trigger (&quot;trigger&quot;)',
      'CREATE TABLE IF NOT EXISTS bot_stm_memory (stm_id TEXT NOT NULL, stimulus_name TEXT NOT NULL, payload_json TEXT DEFAULT \'{}\' NOT NULL, event_id TEXT, source TEXT, target TEXT, created_at TEXT NOT NULL, last_accessed_at TEXT, PRIMARY KEY (stm_id))',
      'CREATE INDEX IF NOT EXISTS bot_stm_memory_recent_idx ON bot_stm_memory (stimulus_name, created_at)',
      'CREATE INDEX IF NOT EXISTS bot_stm_memory_created_idx ON bot_stm_memory (created_at)',
      'INSERT INTO alembic_version (version_num) VALUES (\'0001\')'
    ]"/>
    <data id="revision_0002_postgres" expr="[
      'ALTER TABLE bot_behavior ADD COLUMN lifetime TEXT DEFAULT \'turn\' NOT NULL',
      'UPDATE alembic_version SET version_num = \'0002\' WHERE version_num = \'0001\''
    ]"/>
    <!-- Postgres's schema version: Alembic's version table, created when
         missing, and its row. -->
    <data id="alembic_version" expr="[
      {sql: 'CREATE TABLE IF NOT EXISTS alembic_version (version_num VARCHAR(32) NOT NULL, CONSTRAINT alembic_version_pkc PRIMARY KEY (version_num))'},
      {sql: 'SELECT version_num FROM alembic_version'}
    ]"/>
    <data id="migrations" expr="[]"/>
    <data id="retried" expr="false"/>
    <data id="failure" expr="null"/>
  </datamodel>

  <!-- Pick the engine the database names. -->
  <state id="opening">
    <transition cond="/^postgres(ql)?:\/\//.test(database)" target="migrating_postgres"/>
    <transition target="migrating_sqlite"/>
  </state>

  <!-- Read the database's schema version. -->
  <state id="migrating" initial="migrating_sqlite">
    <state id="migrating_sqlite">
      <invoke id="reading" type="https://github.com/stateforward/floppy/services/sql">
        <param name="database" expr="database"/>
        <param name="statements" expr="[{sql: 'PRAGMA user_version'}]"/>
      </invoke>
      <transition event="sql.result" cond="_event.invokeid === 'reading'" target="applying_sqlite">
        <assign location="version" expr="_event.data.results[0].rows[0].values[0]"/>
        <assign location="migrations" expr="version &lt; 1 ? revision_0001.concat(revision_0002) : version &lt; 2 ? revision_0002 : []"/>
        <assign location="migrations" expr="migrations.map(sql =&gt; ({sql: sql}))"/>
      </transition>
    </state>
    <state id="migrating_postgres">
      <invoke id="reading_postgres" type="https://github.com/stateforward/floppy/services/pgsql">
        <param name="database" expr="database"/>
        <param name="statements" expr="alembic_version"/>
      </invoke>
      <transition event="sql.result" cond="_event.invokeid === 'reading_postgres'" target="applying_postgres">
        <assign location="version" expr="_event.data.results[1].rows.length ? parseInt(_event.data.results[1].rows[0].values[0], 10) : 0"/>
        <assign location="migrations" expr="version &lt; 1 ? revision_0001_postgres.concat(revision_0002_postgres) : version &lt; 2 ? revision_0002_postgres : []"/>
        <assign location="migrations" expr="migrations.map(sql =&gt; ({sql: sql}))"/>
      </transition>
    </state>
    <transition event="sql.failed" cond="_event.invokeid === 'reading_postgres' &amp;&amp; !retried" target="opening">
      <assign location="retried" expr="true"/>
    </transition>
    <transition event="sql.failed" cond="_event.invokeid.startsWith('reading')" target="failing">
      <assign location="failure" expr="_event.data.message"/>
    </transition>
    <transition event="error.*" target="failing">
      <assign location="failure" expr="'Memory could not run (' + _event.name + ')'"/>
    </transition>
  </state>

  <!-- Migrate what is missing and apply the statements, in one
       transaction. -->
  <state id="applying" initial="applying_sqlite">
    <transition cond="!(version &gt;= 0 &amp;&amp; version &lt;= head)" target="failing">
      <assign location="failure" expr="'the memory database\'s schema version is not one this ability knows'"/>
    </transition>
    <state id="applying_sqlite">
      <invoke id="apply" type="https://github.com/stateforward/floppy/services/sql">
        <param name="database" expr="database"/>
        <param name="statements" expr="migrations.concat(statements)"/>
      </invoke>
    </state>
    <state id="applying_postgres">
      <invoke id="apply_postgres" type="https://github.com/stateforward/floppy/services/pgsql">
        <param name="database" expr="database"/>
        <param name="statements" expr="migrations.concat(statements)"/>
      </invoke>
    </state>
    <transition event="sql.result" cond="_event.invokeid.startsWith('apply')" target="applied">
      <send event="bot.ability.memory.output" target="#_parent">
        <param name="results" expr="_event.data.results.slice(migrations.length)"/>
      </send>
    </transition>
    <transition event="sql.failed" cond="_event.invokeid.startsWith('apply') &amp;&amp; migrations.length &gt; 0 &amp;&amp; !retried" target="opening">
      <assign location="retried" expr="true"/>
    </transition>
    <transition event="sql.failed" cond="_event.invokeid.startsWith('apply')" target="failing">
      <assign location="failure" expr="_event.data.message"/>
    </transition>
    <transition event="error.*" target="failing">
      <assign location="failure" expr="'Memory could not run (' + _event.name + ')'"/>
    </transition>
  </state>

  <state id="failing">
    <onentry>
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="failure"/>
      </send>
    </onentry>
    <transition target="applied"/>
  </state>

  <final id="applied"/>
</scxml>
