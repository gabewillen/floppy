<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Reasoning stage (mosfet abilities/cognition/reasoning): the slow
  System 2 pass. The cognition (abilities/cognition.scx) invokes it once
  per turn that intuition left unhandled.

    recalling (memory seam) -> applying (an invoked generate service)
      -> retaining (memory seam) -> done

  Memory is an honest seam until phase 3: recalling and retaining each log
  <log label="memory" expr="'absent'"> and send their mosfet result event to itself (#_internal)
  (bot.ability.reasoning.recalled, bot.ability.reasoning.retained) with
  memory_consulted (and memory_written) false and nothing recalled; the
  model request carries no recalled episode. Phase 3 replaces each such send
  with an <invoke> of services/memory.

  Choices: the body's assembled choices for the turn (the <param>
  choices: the body's own and each ability's offers, tagged with the
  offering ability's invoke id as target). A selection is returned, not
  taken: the body routes it. The structured-output schema is built from
  the choices as mosfet's dispatch tool: {events: [anyOf one branch per
  offered event]}, each branch {event (a one-value enum), data (the event's
  schema without $schema, title and examples), reason, and target (an enum
  of the abilities offering it) when an ability offers it}, every field
  required and no extra property, sent strict. The generate service
  returns only a reply that satisfies it; a selection outside the choices
  (event or target) is rejected by cond as well. With no choices the stage
  fails without a model call.

  Input: the <param>s turn, stimulus, focus, focus_candidates, choices and
  model. Output: <donedata>, received by the cognition as
  done.invoke.reasoning:

    {turn, handled: true, selected: [{event, data, reason, target?}]}
    {turn, handled: false, failed: true, reason}

  The cognition's hop timeout bounds the stage (leaving it cancels the model
  call, SCXML 6.4).

  Bindings: the generate service package,
  resolved from their repository URIs; env scopes FLOPPY_API_KEY and
  FLOPPY_BASE_URL to the service's <invoke> (no default backend: without
  either it answers generate.failed unconfigured). The generate service's
  events are recorded by <finalize>.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="reasoning" initial="recalling">
  <datamodel>
    <!-- The turn, from the cognition's <param>s. -->
    <data id="turn" expr="0"/>
    <data id="stimulus" expr="null"/>
    <data id="focus" expr="null"/>
    <data id="focus_candidates" expr="[]"/>
    <data id="model" expr="'Qwen/Qwen3.8-Flash-Next'"/>
    <data id="choices" expr="[]"/>
    <data id="system" expr="'You are the deliberate reasoning of floppy, a small companion robot. You receive one stimulus the robot observed, as JSON, with what the robot is looking at. Select every event the robot should take for it from the offered events (an empty list selects none), with its data, its target when the event names one, and a short reason. When an offered event says something, give it the complete text to say.'"/>
    <!-- The model call: its schema, invocation, and reply. -->
    <data id="schema" expr="null"/>
    <data id="gen_id" expr="null"/>
    <data id="selected" expr="null"/>
    <data id="gen_failure" expr="null"/>
    <data id="result" expr="null"/>
  </datamodel>
  <script>
    function isObject(value) {
      return value !== null &amp;&amp; typeof value === 'object' &amp;&amp; !Array.isArray(value);
    }
    function bodyInput() {
      return {focus: focus, focus_candidates: focus_candidates};
    }
    // A choice's schema as a branch's data: the payload contract only.
    function dataSchema(schema) {
      var copy = {};
      Object.keys(isObject(schema) ? schema : {}).forEach(function (key) {
        if (['$schema', 'title', 'examples'].indexOf(key) &lt; 0) {
          copy[key] = schema[key];
        }
      });
      if (copy.type === undefined) {
        copy.type = 'object';
      }
      if (copy.additionalProperties === undefined) {
        copy.additionalProperties = false;
      }
      return copy;
    }
    // The offered events in choices order, each with the targets offering
    // it (an empty list: the body's own event).
    function offeredEvents() {
      var events = [];
      var byName = {};
      choices.forEach(function (choice) {
        if (byName[choice.event] === undefined) {
          byName[choice.event] = {event: choice.event, schema: choice.schema, description: choice.description, targets: []};
          events.push(byName[choice.event]);
        }
        if (typeof choice.target === 'string' &amp;&amp; byName[choice.event].targets.indexOf(choice.target) &lt; 0) {
          byName[choice.event].targets.push(choice.target);
        }
      });
      return events;
    }
    // mosfet processing._selection_item_branch / dispatch_tool.
    function selectionSchema(offered) {
      return {
        type: 'object',
        properties: {
          events: {
            type: 'array',
            description: 'All events necessary for the input this turn; an empty array selects none.',
            items: {
              anyOf: offered.map(function (choice) {
                var branch = {
                  type: 'object',
                  description: typeof choice.description === 'string' ? choice.description : choice.event,
                  properties: {
                    event: {type: 'string', 'enum': [choice.event]},
                    data: dataSchema(choice.schema),
                    reason: {type: 'string', description: 'A short reason this event was selected.'}
                  },
                  required: ['event', 'data', 'reason'],
                  additionalProperties: false
                };
                if (choice.targets.length &gt; 0) {
                  branch.properties.target = {type: 'string', 'enum': choice.targets, description: 'The ability that receives this event.'};
                  branch.required.push('target');
                }
                return branch;
              })
            }
          }
        },
        required: ['events'],
        additionalProperties: false
      };
    }
    function onChoices(events) {
      var offered = offeredEvents();
      return Array.isArray(events) &amp;&amp; events.every(function (item) {
        var match = offered.filter(function (choice) { return isObject(item) &amp;&amp; choice.event === item.event; })[0];
        return match !== undefined &amp;&amp; (match.targets.length === 0
          ? item.target === undefined
          : match.targets.indexOf(item.target) &gt;= 0);
      });
    }
    function fail(reason) {
      result = {turn: turn, handled: false, failed: true, reason: reason};
    }
  </script>

  <!-- Memory seam (phase 3): nothing is recalled. -->
  <state id="recalling">
    <onentry>
      <log label="memory" expr="'absent'"/>
      <send event="bot.ability.reasoning.recalled" target="#_internal">
        <param name="turn" expr="turn"/>
        <param name="host_input" expr="({input: stimulus})"/>
        <param name="prior_episodes" expr="[]"/>
        <param name="memory_consulted" expr="false"/>
        <param name="input" expr="bodyInput()"/>
      </send>
    </onentry>
    <transition event="bot.ability.reasoning.recalled" event:schema="schemas/bot.ability.reasoning.recalled.json"
                cond="isObject(_event.data) &amp;&amp; _event.data.turn === turn &amp;&amp; _event.data.memory_consulted === false &amp;&amp; choices.length === 0"
                target="done">
      <script>fail('the reasoning has no choices to select from');</script>
    </transition>
    <transition event="bot.ability.reasoning.recalled" event:schema="schemas/bot.ability.reasoning.recalled.json"
                cond="isObject(_event.data) &amp;&amp; _event.data.turn === turn &amp;&amp; _event.data.memory_consulted === false"
                target="applying"/>
  </state>

  <!-- One structured model call; leaving this state cancels it. -->
  <state id="applying">
    <onentry>
      <assign location="schema" expr="selectionSchema(offeredEvents())"/>
      <assign location="selected" expr="null"/>
      <assign location="gen_failure" expr="null"/>
      <log label="reasoning" expr="'turn ' + turn + ': ' + choices.map(function (c) { return c.target === undefined ? c.event : c.event + '@' + c.target; }).join(' ')"/>
    </onentry>
    <invoke idlocation="gen_id" type="https://github.com/stateforward/floppy/services/generate"
            env:apikey="FLOPPY_API_KEY" env:baseurl="FLOPPY_BASE_URL">
      <param name="model" expr="model"/>
      <param name="system" expr="system"/>
      <param name="prompt" expr="JSON.stringify({stimulus: stimulus, focus: focus, focus_candidates: focus_candidates})"/>
      <param name="schema" expr="schema"/>
      <param name="schemaname" expr="'dispatch'"/>
      <param name="strict" expr="true"/>
      <finalize>
        <assign location="selected" expr="_event.name === 'generate.result' &amp;&amp; isObject(_event.data) &amp;&amp; isObject(_event.data.json) ? _event.data.json.events : selected"/>
        <assign location="gen_failure" expr="_event.name === 'generate.failed' &amp;&amp; isObject(_event.data) ? _event.data.code : gen_failure"/>
      </finalize>
    </invoke>

    <transition event="done.invoke" cond="_event.invokeid === gen_id &amp;&amp; selected !== null &amp;&amp; onChoices(selected)" target="retaining"/>
    <transition event="done.invoke" cond="_event.invokeid === gen_id &amp;&amp; selected !== null" target="done">
      <log label="reasoning.rejected" expr="'a selection outside the offered choices'"/>
      <script>fail('the reasoning selected an event outside its choices');</script>
    </transition>
    <transition event="done.invoke" cond="_event.invokeid === gen_id" target="done">
      <script>fail('the reasoning failed (' + (gen_failure === null ? 'no selection' : gen_failure) + ')');</script>
    </transition>
    <transition event="error.*" target="done">
      <script>fail('the reasoning could not run (' + _event.name + ')');</script>
    </transition>
  </state>

  <!-- Memory seam (phase 3): nothing is written. -->
  <state id="retaining">
    <onentry>
      <log label="memory" expr="'absent'"/>
      <send event="bot.ability.reasoning.retained" target="#_internal">
        <param name="turn" expr="turn"/>
        <param name="result" expr="selected"/>
        <param name="memory_consulted" expr="false"/>
        <param name="memory_written" expr="false"/>
        <param name="input" expr="bodyInput()"/>
      </send>
    </onentry>
    <transition event="bot.ability.reasoning.retained" event:schema="schemas/bot.ability.reasoning.retained.json"
                cond="isObject(_event.data) &amp;&amp; _event.data.turn === turn &amp;&amp; _event.data.memory_written === false"
                target="done">
      <assign location="result" expr="({turn: turn, handled: true, selected: selected})"/>
    </transition>
  </state>

  <final id="done">
    <donedata>
      <content expr="result"/>
    </donedata>
  </final>
</scxml>
