<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Interpretation (mosfet abilities/listening/interpretation.py):
  the slow half of listening, which works out what a scored sound turns
  out to be. The listening (abilities/listening.scx) invokes it as its
  long-lived child "interpretation" and hands it each scored sound.

    Idle -bot.ability.listening.sensitivity.output-> Working {
      DetectingVoice -> ClassifyingSound | DecodingSpeech
      ClassifyingSound -> HandingOff | DecodingSpeech
      DecodingSpeech -> HandingOff
      HandingOff -> Idle }
    Working -bot.ability.listening.stage.failed-> Idle

  Input: bot.ability.listening.sensitivity.output {sound, parent,
  perceived_level_db} (mosfet's sensitivity OutputData) from the
  listening. Scored sounds that arrive while Working wait, in order, in
  the data model queue and are taken on the return to Idle (mosfet defers
  them): interpretation is serial, and the score was taken on arrival.

  Stages, each a child invoked from its state (leaving the state cancels
  it, SCXML 6.4) and bounded by the stage timer, mosfet's 30 s stage
  operation timeout (stage_timeout_ms): bot.ability.listening.stage.failed
  {stage, message: "Listening <stage> timed out."} sent to this session
  with that delay.

  * DetectingVoice invokes abilities/voice_detection.scx, a seam (decision
    D52: no OpenAI-compatible voice activity model). It ends without a
    result, so whether the sound holds voice is unknown: mosfet's
    voice/no-voice routes, its open-speech window (HearingSpeech,
    FeedingSpeech, SpeechEnded), diarization and direct voice
    identification wait for a voice detection model, and each sound is one
    utterance. A reported result fails the stage.
  * ClassifyingSound invokes abilities/sound_classification.scx
    (KindSoundClassifier, mosfet's sound_classifier): a labelled sound is
    non-speech and is handed off as the original environment.sound; an
    unlabelled one may be speech and goes to DecodingSpeech.
  * DecodingSpeech invokes abilities/speech_decoding.scx (the speech
    service). Decoding rewrites the observation into words: the product
    is bot.ability.listening.speech.output (mosfet's SpeechData) with
    content the words, content_type text/plain, voice_detection
    {segments: []} (no voice spans were reported), media_type audio/pcm,
    the sound's sample_rate_hz and channels (1 when unknown), empty
    source_ids (no voice identification result), and parent the
    environment.sound envelope. A sound with no sample rate cannot be
    placed on a timeline and fails the stage, as in mosfet.
  * HandingOff is the one comparison (mosfet _is_audible_product): a
    product whose perceived_level_db is null or at least
    product_threshold_db (mosfet's 3 dB) goes to the listening; a quieter
    one is dropped. Either way the interpretation returns to Idle.

  Failure: a stage failure (its child's failure, an error, or its timer)
  answers the listening with bot.ability.listening.failed {stage, message}
  (mosfet's FailedEventData) and returns to Idle.

  Readiness: on start it sends bot.ability.offers {ability:
  "interpretation", choices: []} to the listening; it offers nothing.

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline). The stages' results are done.invoke
  <donedata>, which scxml.rs does not check, so their shape is checked by
  cond.

  Bindings: none of its own; speech_decoding.scx binds the speech service.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="interpretation" initial="Interpretation">
  <datamodel>
    <!-- Configuration (mosfet's constructor): the product threshold and
         the stage operation timeout. -->
    <data id="product_threshold_db" expr="3.0"/>
    <data id="stage_timeout_ms" expr="30000"/>
    <!-- Scored sounds waiting for the interpretation. -->
    <data id="queue" expr="[]"/>
    <!-- The scored sound in hand, its stage, and what became of it. -->
    <data id="sensed" expr="null"/>
    <data id="stage" expr="null"/>
    <data id="product" expr="null"/>
    <data id="failure" expr="null"/>
  </datamodel>

  <state id="Interpretation" initial="Idle">
    <onentry>
      <send event="bot.ability.offers" target="#_parent">
        <param name="ability" expr="'interpretation'"/>
        <param name="choices" expr="[]"/>
      </send>
    </onentry>

    <!-- Scored sounds queue here, one at a time. -->
    <state id="Idle">
      <transition cond="queue.length &gt; 0" target="Working">
        <assign location="sensed" expr="queue.shift()"/>
      </transition>
      <transition event="bot.ability.listening.sensitivity.output" event:schema="schemas/bot.ability.listening.sensitivity.output.json"
                  cond="!_event.invokeid" target="Working">
        <assign location="sensed" expr="_event.data"/>
      </transition>
    </state>

    <!-- One busy region: the queue and the stage failure policy live
         once, not on every stage. -->
    <state id="Working" initial="DetectingVoice">
      <onentry>
        <assign location="product" expr="null"/>
        <assign location="failure" expr="null"/>
      </onentry>
      <transition event="bot.ability.listening.sensitivity.output" event:schema="schemas/bot.ability.listening.sensitivity.output.json"
                  cond="!_event.invokeid">
        <assign location="queue" expr="queue.concat([_event.data])"/>
      </transition>
      <transition event="bot.ability.listening.stage.failed" event:schema="schemas/bot.ability.listening.stage.failed.json"
                  cond="!_event.invokeid &amp;&amp; _event.data.stage === stage" target="Idle">
        <send event="bot.ability.listening.failed" target="#_parent">
          <content expr="_event.data"/>
        </send>
      </transition>
      <!-- A stage child that cannot run. -->
      <transition event="error.*" cond="stage !== null">
        <send event="bot.ability.listening.stage.failed" target="#_internal">
          <content expr="({stage: stage, message: 'Listening ' + stage + ' could not run (' + _event.name + ')'})"/>
        </send>
      </transition>

      <!-- Voice detection: a seam, so voice is unknown. -->
      <state id="DetectingVoice">
        <onentry>
          <assign location="stage" expr="'voice_detection'"/>
          <send id="voice-detection-timer" event="bot.ability.listening.stage.failed" delayexpr="stage_timeout_ms + 'ms'">
            <content expr="({stage: stage, message: 'Listening ' + stage + ' timed out.'})"/>
          </send>
        </onentry>
        <onexit>
          <cancel sendid="voice-detection-timer"/>
        </onexit>
        <invoke id="voice_detection" type="scxml" src="voice_detection.scx">
          <param name="audio" expr="sensed.sound.audio"/>
          <param name="media_type" expr="sensed.sound.media_type === undefined ? null : sensed.sound.media_type"/>
          <param name="sample_rate_hz" expr="sensed.sound.sample_rate_hz === undefined ? null : sensed.sound.sample_rate_hz"/>
          <param name="channels" expr="sensed.sound.channels === undefined ? null : sensed.sound.channels"/>
        </invoke>
        <transition event="done.invoke.voice_detection" cond="_event.data === undefined || _event.data === null" target="ClassifyingSound"/>
        <transition event="done.invoke.voice_detection">
          <send event="bot.ability.listening.stage.failed" target="#_internal">
            <content expr="({stage: stage, message: 'Voice detection reported spans; the interpretation takes only an absent voice detection.'})"/>
          </send>
        </transition>
      </state>

      <!-- Non-speech labelling: a labelled sound is not speech. -->
      <state id="ClassifyingSound">
        <onentry>
          <assign location="stage" expr="'sound_classification'"/>
          <send id="sound-classification-timer" event="bot.ability.listening.stage.failed" delayexpr="stage_timeout_ms + 'ms'">
            <content expr="({stage: stage, message: 'Listening ' + stage + ' timed out.'})"/>
          </send>
        </onentry>
        <onexit>
          <cancel sendid="sound-classification-timer"/>
        </onexit>
        <invoke id="sound_classification" type="scxml" src="sound_classification.scx">
          <param name="audio" expr="sensed.sound.audio"/>
          <param name="media_type" expr="sensed.sound.media_type === undefined ? null : sensed.sound.media_type"/>
          <param name="kind" expr="sensed.sound.kind === undefined ? null : sensed.sound.kind"/>
        </invoke>
        <transition event="done.invoke.sound_classification"
                    cond="Array.isArray(Object(_event.data).labels) &amp;&amp; _event.data.labels.length &gt; 0" target="HandingOff">
          <assign location="product" expr="({event: 'environment.sound', data: sensed.sound})"/>
        </transition>
        <transition event="done.invoke.sound_classification" cond="Array.isArray(Object(_event.data).labels)" target="DecodingSpeech"/>
        <transition event="done.invoke.sound_classification">
          <send event="bot.ability.listening.stage.failed" target="#_internal">
            <content expr="({stage: stage, message: 'Sound classification child produced invalid output.'})"/>
          </send>
        </transition>
      </state>

      <!-- Speech decoding rewrites the observation into words. -->
      <state id="DecodingSpeech">
        <onentry>
          <assign location="stage" expr="'speech_decoding'"/>
          <send id="speech-decoding-timer" event="bot.ability.listening.stage.failed" delayexpr="stage_timeout_ms + 'ms'">
            <content expr="({stage: stage, message: 'Listening ' + stage + ' timed out.'})"/>
          </send>
        </onentry>
        <onexit>
          <cancel sendid="speech-decoding-timer"/>
        </onexit>
        <invoke id="speech_decoding" type="scxml" src="speech_decoding.scx">
          <param name="audio" expr="sensed.sound.audio"/>
          <param name="media_type" expr="sensed.sound.media_type === undefined ? null : sensed.sound.media_type"/>
        </invoke>
        <transition event="done.invoke.speech_decoding"
                    cond="typeof Object(_event.data).text === 'string' &amp;&amp; typeof sensed.sound.sample_rate_hz === 'number'" target="HandingOff">
          <assign location="product" expr="({event: 'bot.ability.listening.speech.output', data: {content: _event.data.text, content_type: 'text/plain'}})"/>
          <assign location="product.data.voice_detection" expr="({segments: []})"/>
          <assign location="product.data.sample_rate_hz" expr="sensed.sound.sample_rate_hz"/>
          <assign location="product.data.channels" expr="typeof sensed.sound.channels === 'number' ? sensed.sound.channels : 1"/>
          <assign location="product.data.media_type" expr="'audio/pcm'"/>
          <assign location="product.data.source_ids" expr="[]"/>
          <assign location="product.data.parent" expr="sensed.parent === undefined ? null : sensed.parent"/>
        </transition>
        <transition event="done.invoke.speech_decoding" cond="typeof Object(_event.data).text === 'string'">
          <send event="bot.ability.listening.stage.failed" target="#_internal">
            <content expr="({stage: stage, message: 'Speech decoding completed on sound with no sample rate to place it on a timeline.'})"/>
          </send>
        </transition>
        <transition event="done.invoke.speech_decoding">
          <send event="bot.ability.listening.stage.failed" target="#_internal">
            <content expr="({stage: stage, message: typeof Object(_event.data).message === 'string' ? _event.data.message : 'Listening speech_decoding child failed.'})"/>
          </send>
        </transition>
      </state>

      <!-- The one comparison: is enough of this left for a turn? -->
      <state id="HandingOff">
        <onentry>
          <assign location="stage" expr="null"/>
        </onentry>
        <transition cond="sensed.perceived_level_db == null || sensed.perceived_level_db &gt;= product_threshold_db" target="Idle">
          <if cond="product.event === 'environment.sound'">
            <send event="environment.sound" target="#_parent">
              <content expr="product.data"/>
            </send>
          <else/>
            <send event="bot.ability.listening.speech.output" target="#_parent">
              <content expr="product.data"/>
            </send>
          </if>
        </transition>
        <transition target="Idle"/>
      </state>
    </state>
  </state>
</scxml>
