<?xml version="1.0" encoding="UTF-8"?>
<!-- sensitivity-5: after the window, the mouth's arrival is scored as quiet. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="sensitivity" type="scxml" src="../../../sensitivity.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'sensitivity' &amp;&amp; _event.data.choices.length === 0" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.speaking.efference" target="#_sensitivity"><content expr='{"mouth": "speaker", "duration": 0.05}'/></send>
      <send event="harness.waited" delay="300ms"/>
    </onentry>
    <transition event="harness.waited" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.listening.sensitivity.score" target="#_sensitivity"><content expr='{"stimulus": {"event": "environment.sound", "data": {"audio": "media/a.wav", "received_level_db": -30, "amplitude_db": -10}, "source": "speaker"}}'/></send>
    </onentry>
    <transition event="bot.ability.listening.sensitivity.output" cond="_event.data.perceived_level_db === -30" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
