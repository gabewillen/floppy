<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's VoiceIdentification (the reference abilities/hearing/voice/
  identification.py): one voice embedding per voice segment, through the
  speech service's identify operation (the original's voice classifier: pyannote
  speaker embeddings, WeSpeaker ResNet34; here LocalAI's
  POST {base}/voice/embed, which serves the same WeSpeaker model). The
  interpretation (abilities/interpretation/interpretation.scx) invokes it from
  IdentifyingVoice (the diarized segments) and IdentifyingVoiceDirect (the
  opening voice span of a sound, the original's direct identification); the
  interpretation's stage timer bounds it, and leaving the state cancels it
  and its service call (SCXML 6.4).

    identifying { clipping -> applying } -> applied (final)

  Input: either the <param> segments (the original's InputData: voice segments,
  each a reference to its clipped PCM with its format and span), or, for
  direct identification, audio, sample_rate_hz and channels (the sound's
  PCM), start_seconds and end_seconds (its first voice span) and output
  (where the clip is written); and model (LocalAI's
  voice-detect-wespeaker-resnet34 by default).

  clipping (direct identification only): the speech service's clip step
  (the original's _voice_segment_from_detection: the span clamped to the sound
  and clipped by whole frames); its done data is the one segment.

  applying: the speech service's identify operation, answered
  bot.ability.hearing.voice.identification.output {embeddings} (the original's
  OutputData, in segment order).

  Output: <donedata>, received by the interpretation as
  done.invoke.voice_identification: {segments, embeddings}, or {message}
  (the original's FailureData) when a step answers bot.ability.failed, answers
  something else, or cannot run.

  Bindings: the speech service package; env scopes FLOPPY_VOICE_BASE_URL
  and FLOPPY_VOICE_API_KEY to the identify <invoke> (no default backend,
  decision D31). The run grants the service the media directory. An
  invoked service's events are not checked against event:schema, so their
  shape is checked by cond.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="voice_identification" initial="identifying">
  <datamodel>
    <!-- The invoker's <param>s. -->
    <data id="segments" expr="null"/>
    <data id="audio" expr="null"/>
    <data id="sample_rate_hz" expr="null"/>
    <data id="channels" expr="null"/>
    <data id="start_seconds" expr="null"/>
    <data id="end_seconds" expr="null"/>
    <data id="output" expr="null"/>
    <data id="model" expr="'voice-detect-wespeaker-resnet34'"/>
    <!-- The result. -->
    <data id="result" expr="null"/>
  </datamodel>
  <script src="voice_identification.js"/>

  <state id="identifying" initial="clipping">
    <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" target="applied">
      <assign location="result" expr="failedResult(_event)"/>
    </transition>
    <transition event="error.*" target="applied">
      <assign location="result" expr="errorResult(_event)"/>
    </transition>

    <!-- Direct identification clips the opening voice span first. -->
    <state id="clipping">
      <transition cond="hasSegments()" target="applying"/>
      <invoke id="clipper" type="https://github.com/stateforward/floppy/services/speech">
        <param name="operation" expr="'clip'"/>
        <param name="audio" expr="audio"/>
        <param name="sample_rate_hz" expr="sample_rate_hz"/>
        <param name="channels" expr="channels"/>
        <param name="start_seconds" expr="start_seconds"/>
        <param name="end_seconds" expr="end_seconds"/>
        <param name="output" expr="output"/>
      </invoke>
      <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" target="applied">
        <assign location="result" expr="clipFailedResult(_event)"/>
      </transition>
      <transition event="done.invoke.clipper" cond="isClippedSegment(_event)" target="applying">
        <assign location="segments" expr="clippedSegments(_event)"/>
      </transition>
      <transition event="done.invoke.clipper" target="applied">
        <assign location="result" expr="unclippedResult()"/>
      </transition>
    </state>

    <state id="applying">
      <invoke id="identifier" type="https://github.com/stateforward/floppy/services/speech"
              env:baseurl="FLOPPY_VOICE_BASE_URL" env:apikey="FLOPPY_VOICE_API_KEY">
        <param name="operation" expr="'identify'"/>
        <param name="model" expr="model"/>
        <param name="segments" expr="segments"/>
      </invoke>
      <transition event="bot.ability.hearing.voice.identification.output"
                  cond="hasEmbeddings(_event)" target="applied">
        <assign location="result" expr="identifiedResult(_event)"/>
      </transition>
      <transition event="done.invoke.identifier" target="applied">
        <assign location="result" expr="unidentifiedResult()"/>
      </transition>
      <!-- Failures here, as in identifying, before the catch-all below. -->
      <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" target="applied">
        <assign location="result" expr="failedResult(_event)"/>
      </transition>
      <transition event="error.*" target="applied">
        <assign location="result" expr="errorResult(_event)"/>
      </transition>
      <!-- Anything else the identifier sends. -->
      <transition event="*" target="applied">
        <assign location="result" expr="mismatchedResult()"/>
      </transition>
    </state>
  </state>

  <final id="applied">
    <donedata>
      <content expr="result"/>
    </donedata>
  </final>
</scxml>
