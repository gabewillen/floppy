<?xml version="1.0" encoding="UTF-8"?>
<!-- voice_identification-4: a span past the sound holds no audio. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="voice_identification" type="scxml" src="../../../voice_identification.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.hearing.voice.identification.input" target="#_voice_identification"><content expr="({id: &quot;r1&quot;, audio: 'media/sound.raw', sample_rate_hz: 8000, channels: 1, start_seconds: 2, end_seconds: 3, output: 'media/clip'})"/></send>
    </onentry>
    <transition event="bot.ability.failed" cond='_event.data.id === "r1" &amp;&amp; (function (_event) { return _event.data.message === "Voice identification opening segment conversion failed: Voice segment clipping failed: the span holds no audio." &amp;&amp; Object.keys(_event.data).length === 1; })({name: _event.name, data: (function (data) { var copy = JSON.parse(JSON.stringify(data)); delete copy.id; return copy; })(_event.data)})' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
