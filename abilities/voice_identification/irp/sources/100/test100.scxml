<?xml version="1.0" encoding="UTF-8"?>
<!-- voice_identification-1: two segments come back with one embedding each, in segment order. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="voice_identification" type="scxml" src="../../../voice_identification.scx">
    <param name="segments" expr='[{"audio":"media/first.raw","channels":1,"end_seconds":0.5,"media_type":"audio/pcm","sample_rate_hz":8000,"start_seconds":0},{"audio":"media/second.raw","channels":1,"end_seconds":1,"media_type":"audio/pcm","sample_rate_hz":8000,"start_seconds":0.5}]'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.voice_identification" cond="Object.keys(_event.data).sort().join() === 'embeddings,segments' &amp;&amp; JSON.stringify(_event.data.embeddings) === &quot;[{\&quot;confidence\&quot;:null,\&quot;embedding\&quot;:[0.1,0.2],\&quot;model\&quot;:\&quot;voice-detect-wespeaker-resnet34\&quot;},{\&quot;confidence\&quot;:null,\&quot;embedding\&quot;:[0.3,0.4],\&quot;model\&quot;:\&quot;voice-detect-wespeaker-resnet34\&quot;}]&quot; &amp;&amp; _event.data.segments.length === 2 &amp;&amp; _event.data.segments[0].audio === &quot;media/first.raw&quot; &amp;&amp; _event.data.segments[0].channels === 1 &amp;&amp; _event.data.segments[0].end_seconds === 0.5 &amp;&amp; _event.data.segments[0].media_type === &quot;audio/pcm&quot; &amp;&amp; _event.data.segments[0].sample_rate_hz === 8000 &amp;&amp; _event.data.segments[0].start_seconds === 0 &amp;&amp; _event.data.segments[1].audio === &quot;media/second.raw&quot; &amp;&amp; _event.data.segments[1].channels === 1 &amp;&amp; _event.data.segments[1].end_seconds === 1 &amp;&amp; _event.data.segments[1].media_type === &quot;audio/pcm&quot; &amp;&amp; _event.data.segments[1].sample_rate_hz === 8000 &amp;&amp; _event.data.segments[1].start_seconds === 0.5" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
