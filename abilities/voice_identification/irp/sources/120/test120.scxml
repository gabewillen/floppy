<?xml version="1.0" encoding="UTF-8"?>
<!-- voice_identification-3: the opening voice span is clipped (its end clamped to the sound) and identified. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="voice_identification" type="scxml" src="../../../voice_identification.scx">
    <param name="audio" expr="'media/sound.raw'"/>
    <param name="sample_rate_hz" expr="8000"/>
    <param name="channels" expr="1"/>
    <param name="start_seconds" expr="0.25"/>
    <param name="end_seconds" expr="2"/>
    <param name="output" expr="'media/clip'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.voice_identification" cond="Object.keys(_event.data).sort().join() === 'embeddings,segments' &amp;&amp; JSON.stringify(_event.data.embeddings) === &quot;[{\&quot;confidence\&quot;:null,\&quot;embedding\&quot;:[0.5,0.6],\&quot;model\&quot;:\&quot;voice-detect-wespeaker-resnet34\&quot;}]&quot; &amp;&amp; _event.data.segments.length === 1 &amp;&amp; _event.data.segments[0].audio === &quot;media/clip&quot; &amp;&amp; _event.data.segments[0].channels === 1 &amp;&amp; _event.data.segments[0].end_seconds === 1 &amp;&amp; _event.data.segments[0].media_type === &quot;audio/pcm&quot; &amp;&amp; _event.data.segments[0].sample_rate_hz === 8000 &amp;&amp; _event.data.segments[0].start_seconds === 0.25" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
