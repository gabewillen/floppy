<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Cognition ability (mosfet abilities/cognition/cognition.py): the
  autonomy -> intuition -> reasoning cascade, with cancellation, hop
  timeouts and reboot requests. The body (bots/floppy/floppy.scx) invokes it
  as its child "cognition" and sends it one bot.ability.cognition.input per
  processing turn; it answers that turn with exactly one of
  bot.ability.cognition.output {turn, output} or bot.ability.failed
  {message, turn, input}, acknowledges bot.ability.cognition.cancel {turn}
  with bot.ability.cognition.cancelled {turn}, and asks the body for
  bot.reboot {reason} when a stage does not answer in time.

    idle -input-> processing { running_autonomy -> running_intuition ->
                               running_reasoning,
                               completing, failing,
                               cancelling { autonomy, intuition, reasoning,
                                            acknowledging } } -> idle
    processing -hop timeout-> rebooting (bot.reboot to the body, which
      re-enters live and so restarts this ability)

  Stages: each stage is an SCXML child invoked per turn inside its substate
  (abilities/autonomy.scx, intuition.scx, reasoning.scx, beside this
  document) with the turn as <param>s; it answers through its top-level
  final state's <donedata>, received here as done.invoke.<stage> (the
  invoke ids are the stage names; the substates are running_<stage>):
  {turn, handled, selected?, reason?, tuner?, failed?}. Leaving a stage's
  substate cancels it (SCXML 6.4), which replaces mosfet's stage cancel
  tokens. Handled ends the turn with the stage's selections as the output;
  unhandled goes on to the next stage (autonomy's honest seam always does);
  failed (or an error.* from the stage) answers bot.ability.failed. The
  intuition tuner state is passed in by <param> and kept from the donedata.

  Hop timeouts: each stage substate arms
  bot.ability.cognition.child.hop.timed_out (hop_timeout_ms, mosfet's 30 s)
  and cancels it on exit; the transition takes only the timer of the stage
  in hand (_event.sendid, SCXML 5.10.1). A timeout goes to rebooting, which
  sends bot.reboot {reason: "cognition_child_teardown_failed"} to the body.

  Cancel: bot.ability.cognition.cancel for the turn in hand moves to
  cancelling/<stage>; leaving the stage's substate already cancelled it, so
  acknowledging sends bot.ability.cognition.cancelled {turn} at once and
  returns to idle. mosfet's 5 s cancel teardown bound has nothing to wait
  for here (an SCXML invoke cancel is synchronous); the body's cancel timer
  still bounds the acknowledgement.

  Ignore: bot.ability.cognition.ignore is taken here (in idle and
  processing) and does nothing but log; it is this ability's offer.

  Reflection: absent until phase 5; each output is followed by
  <log label="reflection" expr="'absent (phase 5)'">.

  Readiness: every entry into idle sends bot.ability.offers {ability,
  choices} to the parent: the choices <decision:choice events=...> reads,
  bot.ability.cognition.ignore, compacted ($schema, title and examples
  dropped) and held to max_offers_bytes (32 KiB; over it the offer is empty
  and logged). The stages are per-turn children that offer nothing, so
  there are no descendant offers to relay.

  Choices: each turn's input carries the body's assembled choices (its own
  and every ability's offers, tagged with their target); they go to
  reasoning, whose selections the body routes.

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline) and are rechecked by cond; the stages'
  donedata is rechecked by cond.

  Bindings: the decision namespace package; the stages bind their own
  services (intuition: decision with TYPESAFE_API_KEY and
  TYPESAFE_BASE_URL; reasoning: generate with FLOPPY_API_KEY and
  FLOPPY_BASE_URL). The model is the body's (a <param> of the body's
  invoke), else the default below, and goes to reasoning.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="cognition" initial="idle">
  <datamodel>
    <data id="model" expr="'Qwen/Qwen3.8-Flash-Next'"/>
    <data id="hop_timeout_ms" expr="30000"/>
    <!-- The turn in hand. -->
    <data id="turn" expr="0"/>
    <data id="stimulus" expr="null"/>
    <data id="focus" expr="null"/>
    <data id="focus_candidates" expr="[]"/>
    <data id="choices" expr="[]"/>
    <!-- The intuition's confidence tuner (mosfet ConfidenceTuner). -->
    <data id="tuner" expr="({mean: 70, variance: 100, n: 0})"/>
    <!-- The stage in hand: its name, hop timer, and answer. -->
    <data id="stage" expr="null"/>
    <data id="hop_timer" expr="null"/>
    <data id="selected" expr="[]"/>
    <data id="failure" expr="null"/>
    <data id="reboot_reason" expr="null"/>
    <!-- The offers. -->
    <data id="offering" expr="false"/>
    <data id="offered" expr="[]"/>
    <data id="max_offers_bytes" expr="32768"/>
  </datamodel>
  <script>
    function isObject(value) {
      return value !== null &amp;&amp; typeof value === 'object' &amp;&amp; !Array.isArray(value);
    }
    function isTurn(value) {
      return Number.isInteger(value) &amp;&amp; value &gt;= 1;
    }
    function isOptionalString(value) {
      return value === undefined || value === null || typeof value === 'string';
    }
    // schemas/bot.ability.cognition.input.json
    function validInput(data) {
      return isObject(data)
        &amp;&amp; Object.keys(data).every(function (k) { return ['turn', 'stimulus', 'focus', 'focus_candidates', 'choices'].indexOf(k) &gt;= 0; })
        &amp;&amp; isTurn(data.turn)
        &amp;&amp; isObject(data.stimulus)
        &amp;&amp; Object.keys(data.stimulus).every(function (k) { return ['event', 'data', 'id', 'source', 'target'].indexOf(k) &gt;= 0; })
        &amp;&amp; typeof data.stimulus.event === 'string' &amp;&amp; data.stimulus.event.length &gt; 0
        &amp;&amp; data.stimulus.data !== undefined
        &amp;&amp; isOptionalString(data.stimulus.id) &amp;&amp; isOptionalString(data.stimulus.source) &amp;&amp; isOptionalString(data.stimulus.target)
        &amp;&amp; isOptionalString(data.focus)
        &amp;&amp; (data.focus_candidates === undefined
            || (Array.isArray(data.focus_candidates) &amp;&amp; data.focus_candidates.every(function (c) { return typeof c === 'string'; })))
        &amp;&amp; (data.choices === undefined || (Array.isArray(data.choices) &amp;&amp; data.choices.every(validChoice)));
    }
    function validChoice(c) {
      return isObject(c)
        &amp;&amp; Object.keys(c).every(function (k) { return ['event', 'schema', 'description', 'target'].indexOf(k) &gt;= 0; })
        &amp;&amp; typeof c.event === 'string' &amp;&amp; c.event.length &gt; 0 &amp;&amp; c.schema !== undefined
        &amp;&amp; (c.description === undefined || typeof c.description === 'string')
        &amp;&amp; (c.target === undefined || (typeof c.target === 'string' &amp;&amp; c.target.length &gt; 0));
    }
    // An offered schema without $schema, title and examples (property
    // names are kept).
    function compactSchema(schema) {
      if (Array.isArray(schema)) { return schema.map(compactSchema); }
      if (!isObject(schema)) { return schema; }
      var out = {};
      Object.keys(schema).forEach(function (key) {
        var value = schema[key];
        if (['$schema', 'title', 'examples'].indexOf(key) &gt;= 0) { return; }
        if (['properties', 'patternProperties', '$defs', 'definitions'].indexOf(key) &gt;= 0 &amp;&amp; isObject(value)) {
          var named = {};
          Object.keys(value).forEach(function (name) { named[name] = compactSchema(value[name]); });
          out[key] = named;
        } else if (['enum', 'const', 'required', 'default'].indexOf(key) &gt;= 0) {
          out[key] = value;
        } else {
          out[key] = compactSchema(value);
        }
      });
      return out;
    }
    function compactOffers(list) {
      var compacted = list.map(function (choice) {
        var entry = {event: choice.event, schema: compactSchema(choice.schema)};
        if (typeof choice.description === 'string') { entry.description = choice.description; }
        return entry;
      });
      return JSON.stringify(compacted).length &lt;= max_offers_bytes ? compacted : [];
    }
    // schemas/bot.ability.cognition.cancel.json
    function validCancel(data) {
      return isObject(data) &amp;&amp; isTurn(data.turn);
    }
    function cancelsTurn(data) {
      return validCancel(data) &amp;&amp; data.turn === turn;
    }
    // A stage's donedata for the turn in hand.
    function answer(data) {
      return isObject(data) &amp;&amp; data.turn === turn &amp;&amp; typeof data.handled === 'boolean';
    }
    function handled(data) {
      return answer(data) &amp;&amp; data.handled === true &amp;&amp; data.failed !== true &amp;&amp; Array.isArray(data.selected);
    }
    function failed(data) {
      return answer(data) &amp;&amp; data.failed === true;
    }
    function reasonOf(data) {
      return typeof data.reason === 'string' &amp;&amp; data.reason.length &gt; 0 ? data.reason : 'the stage failed';
    }
    function bodyInput() {
      return {focus: focus, focus_candidates: focus_candidates};
    }
    // The intuition's tuner state from its donedata.
    function keepTuner(data) {
      if (isObject(data.tuner)) {
        tuner = data.tuner;
      }
    }
    function hopTimedOut() {
      return _event.sendid === hop_timer &amp;&amp; isObject(_event.data) &amp;&amp; _event.data.turn === turn;
    }
  </script>

  <!-- Waits for the body's turn. -->
  <state id="idle">
    <onentry>
      <assign location="offering" expr="true"/>
      <decision:choice location="offered" events="bot.ability.cognition.ignore"/>
      <assign location="offering" expr="false"/>
      <if cond="compactOffers(offered).length &lt; offered.length">
        <log label="cognition.offers.dropped" expr="'the offers are over ' + max_offers_bytes + ' bytes'"/>
      </if>
      <assign location="offered" expr="compactOffers(offered)"/>
      <log label="cognition.offers" expr="offered.map(function (choice) { return choice.event; }).join(' ')"/>
      <send event="bot.ability.offers" target="#_parent">
        <param name="ability" expr="'cognition'"/>
        <param name="choices" expr="offered"/>
      </send>
    </onentry>
    <transition event="bot.ability.cognition.input" event:schema="schemas/bot.ability.cognition.input.json"
                cond="validInput(_event.data)" target="processing">
      <assign location="turn" expr="_event.data.turn"/>
      <assign location="stimulus" expr="_event.data.stimulus"/>
      <assign location="focus" expr="_event.data.focus === undefined ? null : _event.data.focus"/>
      <assign location="focus_candidates" expr="_event.data.focus_candidates === undefined ? [] : _event.data.focus_candidates"/>
      <assign location="choices" expr="_event.data.choices === undefined ? [] : _event.data.choices"/>
    </transition>
    <transition event="bot.ability.cognition.input">
      <log label="cognition.rejected" expr="'bot.ability.cognition.input does not satisfy schemas/bot.ability.cognition.input.json'"/>
    </transition>
    <!-- Nothing in flight: acknowledge at once. -->
    <transition event="bot.ability.cognition.cancel" event:schema="schemas/bot.ability.cognition.cancel.json"
                cond="validCancel(_event.data)">
      <send event="bot.ability.cognition.cancelled" target="#_parent">
        <param name="turn" expr="_event.data.turn"/>
      </send>
    </transition>
    <transition event="bot.ability.cognition.ignore" event:schema="schemas/bot.ability.cognition.ignore.json"
                cond="offering || isObject(_event.data)">
      <log label="cognition.ignore" expr="'idle'"/>
    </transition>
  </state>

  <!-- One turn of the cascade. -->
  <state id="processing" initial="running_autonomy">
    <onentry>
      <assign location="selected" expr="[]"/>
      <assign location="failure" expr="null"/>
      <log label="cognition" expr="'turn ' + turn + ': ' + stimulus.event"/>
    </onentry>
    <transition event="bot.ability.cognition.ignore" event:schema="schemas/bot.ability.cognition.ignore.json"
                cond="isObject(_event.data)">
      <log label="cognition.ignore" expr="'turn ' + turn"/>
    </transition>
    <!-- A stage that does not answer in time: ask the body for a reboot. -->
    <transition event="bot.ability.cognition.child.hop.timed_out" event:schema="schemas/bot.ability.cognition.child.hop.timed_out.json"
                cond="hopTimedOut()" target="rebooting">
      <log label="cognition.hop.timed_out" expr="'turn ' + turn + ': ' + stage + ' after ' + hop_timeout_ms + ' ms'"/>
      <assign location="reboot_reason" expr="'cognition_child_teardown_failed'"/>
    </transition>

    <state id="running_autonomy">
      <onentry>
        <assign location="stage" expr="'autonomy'"/>
        <send idlocation="hop_timer" event="bot.ability.cognition.child.hop.timed_out" delayexpr="hop_timeout_ms + 'ms'">
          <param name="turn" expr="turn"/>
        </send>
      </onentry>
      <onexit>
        <cancel sendidexpr="hop_timer"/>
      </onexit>
      <invoke id="autonomy" type="scxml" src="autonomy.scx">
        <param name="turn" expr="turn"/>
        <param name="input" expr="bodyInput()"/>
      </invoke>
      <transition event="bot.ability.cognition.cancel" event:schema="schemas/bot.ability.cognition.cancel.json"
                  cond="cancelsTurn(_event.data)" target="cancelling_autonomy"/>
      <transition event="done.invoke.autonomy" cond="handled(_event.data)" target="completing">
        <log label="cognition.stage" expr="'autonomy handled'"/>
        <assign location="selected" expr="_event.data.selected"/>
      </transition>
      <transition event="done.invoke.autonomy" cond="answer(_event.data) &amp;&amp; !failed(_event.data)" target="running_intuition">
        <log label="cognition.stage" expr="'autonomy unhandled (' + _event.data.reason + ')'"/>
      </transition>
      <transition event="done.invoke.autonomy" cond="answer(_event.data)" target="failing">
        <assign location="failure" expr="reasonOf(_event.data)"/>
      </transition>
      <transition event="error.*" cond="_event.invokeid === 'autonomy'" target="failing">
        <assign location="failure" expr="'the autonomy could not run (' + _event.name + ')'"/>
      </transition>
    </state>

    <state id="running_intuition">
      <onentry>
        <assign location="stage" expr="'intuition'"/>
        <send idlocation="hop_timer" event="bot.ability.cognition.child.hop.timed_out" delayexpr="hop_timeout_ms + 'ms'">
          <param name="turn" expr="turn"/>
        </send>
      </onentry>
      <onexit>
        <cancel sendidexpr="hop_timer"/>
      </onexit>
      <invoke id="intuition" type="scxml" src="intuition.scx">
        <param name="turn" expr="turn"/>
        <param name="stimulus" expr="stimulus"/>
        <param name="focus" expr="focus"/>
        <param name="focus_candidates" expr="focus_candidates"/>
        <param name="tuner" expr="tuner"/>
      </invoke>
      <transition event="bot.ability.cognition.cancel" event:schema="schemas/bot.ability.cognition.cancel.json"
                  cond="cancelsTurn(_event.data)" target="cancelling_intuition"/>
      <transition event="done.invoke.intuition" cond="handled(_event.data)" target="completing">
        <script>keepTuner(_event.data);</script>
        <log label="cognition.tuner" expr="JSON.stringify(tuner)"/>
        <log label="cognition.stage" expr="'intuition handled (' + _event.data.reason + ')'"/>
        <assign location="selected" expr="_event.data.selected"/>
      </transition>
      <transition event="done.invoke.intuition" cond="answer(_event.data) &amp;&amp; !failed(_event.data)" target="running_reasoning">
        <script>keepTuner(_event.data);</script>
        <log label="cognition.tuner" expr="JSON.stringify(tuner)"/>
        <log label="cognition.stage" expr="'intuition unhandled (' + _event.data.reason + ')'"/>
      </transition>
      <transition event="done.invoke.intuition" cond="answer(_event.data)" target="failing">
        <script>keepTuner(_event.data);</script>
        <log label="cognition.tuner" expr="JSON.stringify(tuner)"/>
        <assign location="failure" expr="'the intuition failed: ' + reasonOf(_event.data)"/>
      </transition>
      <transition event="error.*" cond="_event.invokeid === 'intuition'" target="failing">
        <assign location="failure" expr="'the intuition could not run (' + _event.name + ')'"/>
      </transition>
    </state>

    <state id="running_reasoning">
      <onentry>
        <assign location="stage" expr="'reasoning'"/>
        <send idlocation="hop_timer" event="bot.ability.cognition.child.hop.timed_out" delayexpr="hop_timeout_ms + 'ms'">
          <param name="turn" expr="turn"/>
        </send>
      </onentry>
      <onexit>
        <cancel sendidexpr="hop_timer"/>
      </onexit>
      <invoke id="reasoning" type="scxml" src="reasoning.scx">
        <param name="turn" expr="turn"/>
        <param name="stimulus" expr="stimulus"/>
        <param name="focus" expr="focus"/>
        <param name="focus_candidates" expr="focus_candidates"/>
        <param name="choices" expr="choices"/>
        <param name="model" expr="model"/>
      </invoke>
      <transition event="bot.ability.cognition.cancel" event:schema="schemas/bot.ability.cognition.cancel.json"
                  cond="cancelsTurn(_event.data)" target="cancelling_reasoning"/>
      <transition event="done.invoke.reasoning" cond="handled(_event.data)" target="completing">
        <log label="cognition.stage" expr="'reasoning handled'"/>
        <assign location="selected" expr="_event.data.selected"/>
      </transition>
      <transition event="done.invoke.reasoning" cond="answer(_event.data)" target="failing">
        <assign location="failure" expr="reasonOf(_event.data)"/>
      </transition>
      <transition event="error.*" cond="_event.invokeid === 'reasoning'" target="failing">
        <assign location="failure" expr="'the reasoning could not run (' + _event.name + ')'"/>
      </transition>
    </state>

    <!-- The turn's answer. -->
    <state id="completing">
      <onentry>
        <send event="bot.ability.cognition.output" target="#_parent">
          <param name="turn" expr="turn"/>
          <param name="output" expr="selected"/>
        </send>
        <log label="reflection" expr="'absent (phase 5)'"/>
      </onentry>
      <transition target="idle"/>
    </state>
    <state id="failing">
      <onentry>
        <log label="cognition.failed" expr="failure"/>
        <send event="bot.ability.failed" target="#_parent">
          <param name="message" expr="failure"/>
          <param name="turn" expr="turn"/>
          <param name="input" expr="bodyInput()"/>
        </send>
      </onentry>
      <transition target="idle"/>
    </state>

    <!-- Cancelled: leaving the stage's substate cancelled the stage. -->
    <state id="cancelling" initial="cancelling_intuition">
      <state id="cancelling_autonomy">
        <onentry><log label="cognition.cancelled" expr="'autonomy'"/></onentry>
        <transition target="acknowledging"/>
      </state>
      <state id="cancelling_intuition">
        <onentry><log label="cognition.cancelled" expr="'intuition'"/></onentry>
        <transition target="acknowledging"/>
      </state>
      <state id="cancelling_reasoning">
        <onentry><log label="cognition.cancelled" expr="'reasoning'"/></onentry>
        <transition target="acknowledging"/>
      </state>
      <state id="acknowledging">
        <onentry>
          <send event="bot.ability.cognition.cancelled" target="#_parent">
            <param name="turn" expr="turn"/>
          </send>
        </onentry>
        <transition target="idle"/>
      </state>
    </state>
  </state>

  <!-- Waits for the body to restart this ability (it re-enters live). -->
  <state id="rebooting">
    <onentry>
      <send event="bot.reboot" target="#_parent">
        <param name="reason" expr="reboot_reason"/>
      </send>
    </onentry>
    <!-- The turn is lost: acknowledge a cancel for it at once. -->
    <transition event="bot.ability.cognition.cancel" event:schema="schemas/bot.ability.cognition.cancel.json"
                cond="validCancel(_event.data)">
      <send event="bot.ability.cognition.cancelled" target="#_parent">
        <param name="turn" expr="_event.data.turn"/>
      </send>
    </transition>
  </state>
</scxml>
