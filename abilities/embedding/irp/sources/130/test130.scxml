<?xml version="1.0" encoding="UTF-8"?>
<!-- embedding-4: inputs the schema refuses raise error.execution at the send; the next is served. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="embedding" type="scxml" src="../../../embedding.scx">
    <param name="dimensions" expr="2"/>
    <param name="timeout_ms" expr="600000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.embedding.input" target="#_embedding"><content expr='{"id": "embedding-1", "role": "query", "items": []}'/></send>
    </onentry>
    <transition event="error.execution" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.embedding.input" target="#_embedding"><content expr='{"id": "embedding-1", "role": "query", "items": [{"parts": [{"kind": "text"}]}]}'/></send>
    </onentry>
    <transition event="error.execution" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.embedding.input" target="#_embedding"><content expr='{"role": "query", "items": [{"parts": [{"kind": "text", "text": "no id"}]}]}'/></send>
    </onentry>
    <transition event="error.execution" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="bot.ability.embedding.input" target="#_embedding"><content expr='{"id": "embedding-1", "role": "query", "items": [{"parts": [{"kind": "text", "text": "fine"}]}]}'/></send>
    </onentry>
    <transition event="bot.ability.embedding.output" cond='_event.data.id === "embedding-1" &amp;&amp; _event.data.role === "query" &amp;&amp; _event.data.space.model === "embeddinggemma-2" &amp;&amp; _event.data.space.dimensions === 2 &amp;&amp; JSON.stringify(_event.data.vectors.map(function (v) { return v.values; })) === "[[1,0]]"' target="step4"/>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
