<?xml version="1.0" encoding="UTF-8"?>
<!-- embedding-2: a request sent while one is in flight is served after it, in order. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="embedding" type="scxml" src="../../../embedding.scx">
    <param name="dimensions" expr="2"/>
    <param name="timeout_ms" expr="600000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.embedding.input" target="#_embedding"><content expr='{"id": "first", "role": "query", "items": [{"parts": [{"kind": "text", "text": "first"}]}]}'/></send>
      <send event="bot.ability.embedding.input" target="#_embedding"><content expr='{"id": "second", "role": "document", "items": [{"parts": [{"kind": "text", "text": "second"}]}]}'/></send>
    </onentry>
    <transition event="bot.ability.embedding.output" cond='_event.data.id === "first" &amp;&amp; _event.data.role === "query" &amp;&amp; _event.data.space.model === "embeddinggemma-2" &amp;&amp; _event.data.space.dimensions === 2 &amp;&amp; JSON.stringify(_event.data.vectors.map(function (v) { return v.values; })) === "[[1,0]]"' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.embedding.output" cond='_event.data.id === "second" &amp;&amp; _event.data.role === "document" &amp;&amp; _event.data.space.model === "embeddinggemma-2" &amp;&amp; _event.data.space.dimensions === 2 &amp;&amp; JSON.stringify(_event.data.vectors.map(function (v) { return v.values; })) === "[[0,1]]"' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
