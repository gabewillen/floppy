<?xml version="1.0" encoding="UTF-8"?>
<!-- reading-8: an input that arrives while an image is being read waits its turn. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="reading" type="scxml" src="../../../reading.scx">
    <param name="stage_timeout_ms" expr="120000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.reading.input" target="#_reading"><content expr='{"kind": "image", "content": "media/receipt.png"}'/></send>
      <send event="bot.ability.reading.input" target="#_reading"><content expr='{"kind": "text", "content": "Read this note."}'/></send>
    </onentry>
    <transition event="bot.ability.reading.output" cond='_event.data.text === "Total due: $14.21" &amp;&amp; _event.data.source_kind === "image" &amp;&amp; _event.data.confidence === 1' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.reading.output" cond='_event.data.text === "Read this note." &amp;&amp; _event.data.source_kind === "text" &amp;&amp; _event.data.confidence === 1' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
