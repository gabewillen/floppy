<?xml version="1.0" encoding="UTF-8"?>
<!-- communication-2: text input is a turn whose stimulus's exchange is the input, inbound, with the turn's participants. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="communication" type="scxml" src="../../../communication.scx">
    <param name="environment" expr="_sessionid"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.communication.input" target="#_communication"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "hello there", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.data.messages.length === 1 &amp;&amp; _event.data.stimulus.data.messages[0].direction === 'inbound' &amp;&amp; _event.data.stimulus.data.messages[0].content === 'hello there' &amp;&amp; JSON.stringify(_event.data.stimulus.data.messages[0].participants) === &quot;[{\&quot;ref\&quot;:\&quot;gabe\&quot;,\&quot;role\&quot;:\&quot;source\&quot;},{\&quot;ref\&quot;:\&quot;floppy\&quot;,\&quot;role\&quot;:\&quot;target\&quot;}]&quot; &amp;&amp; !('sequence' in _event.data.stimulus.data.messages[0])" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
