<?xml version="1.0" encoding="UTF-8"?>
<!-- communication-6: a respond without parts, or with empty words, is refused by its schema at the send. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="communication" type="scxml" src="../../../communication.scx">
    <param name="environment" expr="_sessionid"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.communication.respond" target="#_communication"><content expr='{"parts": []}'/></send>
    </onentry>
    <transition event="error.execution" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.communication.respond" target="#_communication"><content expr='{"parts": [{"words": ""}]}'/></send>
    </onentry>
    <transition event="error.execution" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="bot.ability.communication.input" target="#_communication"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "still here", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.data.messages[0].content === 'still here'" target="step4"/>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.memory.stm.turn"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
