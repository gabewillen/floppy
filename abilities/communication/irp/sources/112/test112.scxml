<?xml version="1.0" encoding="UTF-8"?>
<!-- communication-2: input that arrives while a response is said is heard at once, before speaking answers. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="communication" type="scxml" src="../../../communication.scx">
    <param name="environment" expr="_sessionid"/>
    <param name="encoding_timeout_ms" expr="600000"/>
    <param name="response_timeout_ms" expr="600000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.communication.respond" target="#_communication"><content expr='{"parts": [{"words": "hold on"}]}'/></send>
      <send event="bot.ability.communication.input" target="#_communication"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "are you there", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.data.messages.length === 1 &amp;&amp; _event.data.stimulus.data.messages[0].content === 'are you there'" target="step2"/>
  </state>
  <state id="step2">
    <transition event="bot.ability.speaking.output" cond="_event.data.text === 'hold on'" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <decision:offers location="offers" target="'#_communication'"/>
    </onentry>
    <transition cond="offers.length === 1 &amp;&amp; offers[0].event === 'bot.ability.communication.respond' &amp;&amp; offers[0].effort === undefined &amp;&amp; offers[0].target === undefined &amp;&amp; offers[0].schema.required.indexOf('parts') &gt;= 0" target="step4"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.speaking.efference"/>
  <transition event="environment.sound"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
