<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Communication ability (the reference abilities/communication/
  communication.py): it holds the conversation, admits communication input
  into it, and says the response the cognition selects through Speaking.
  The body (bots/floppy/floppy.scx) invokes it as its child
  "communication".

    communication { inactive -children ready-> active
                    active -respond-> preparing_response -> dispatching_response
                      -> responding -speaking output, failure or hop timeout->
                      active }

  Children: communication holds <invoke id="conversation"> (abilities/
  conversation/conversation.scx, the one active conversation) and <invoke
  id="speaking"> (abilities/speaking/speaking.scx). Each is ready with its
  first bot.ability.offers; inactive waits for both (the original attaches the
  conversation composite there). A child that cannot start, or ends, sends
  bot.ability.communication.failed {message} to the body and ends this
  ability in its final state degraded.

  Input: bot.ability.communication.input {source_ids, target_ids, content,
  content_type, ...} in active goes to the conversation as
  bot.ability.conversation.routed_input {parent} (the original's routed input to
  the active conversation; parent is the input event as an envelope). The
  conversation hands a text product over as bot.ability.cognition.input
  {stimulus}, which goes on to the body unchanged (the body grants it a
  turn); its bot.ability.conversation.output goes on to the body unchanged
  when its latest message is inbound (a product that is not text; the original
  _has_conversation_product) and is history only otherwise; and its
  bot.ability.conversation.failed {stage, message} goes on to the body
  unchanged (the original forwards these terminals).

  Responding: bot.ability.communication.respond {text} (non-blank) in
  active numbers the response (preparing_response), sends
  bot.ability.speaking.input {text} to the speaking child
  (dispatching_response), and waits in responding, bounded by the hop
  timer bot.ability.communication.response.hop.timed_out
  (response_timeout_ms, 36 s: speaking's 30 s encoding bound plus the
  original's 6 s, decision D96; the transition takes only the timer
  of the response in hand, _event.sendid). Speaking's output goes on to the
  body as bot.ability.speaking.output. A speaking failure
  (bot.ability.failed) or the hop timeout answers the body with
  bot.ability.communication.failed {message}. Input that arrives outside
  active, and responses that arrive while one is in hand, are held by
  <event:defer/> (scxml.rs namespaces/event) and come back, in order, on
  the return to active, where they are taken as on arrival (the original defers
  them); a response in inactive is not taken (the original's inactive has
  no transition for it).

  Speaking's routes: speaking records the words it said as an outbound
  bot.ability.conversation.append, which the communication passes to the
  conversation (a sibling is out of speaking's reach), and its playout,
  bot.ability.speaking.efference and then environment.sound, goes on to
  the body in order, whatever the state.

  Activate: bot.ability.communication.activate {} keeps the one
  conversation active (a catalog of conversations to switch between is
  loaded through memory, phase 3); it is taken and logged in inactive only,
  as the original's Communication takes it only there.

  Offers: every entry into active sends bot.ability.offers {ability:
  "communication", choices} to the body: <decision:choice events=
  "bot.ability.communication.respond"> (the original's enabled transitions in
  active; activate is enabled only in inactive, and input is not a tool
  event), compacted by <decision:compact>
  ($schema, title and examples dropped; over 32 KiB descriptions dropped
  too; still over, the offer is empty and logged). The children offer
  nothing, so nothing is relayed.

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline). scxml.rs checks them where each event is
  created: a send whose data a schema rejects is not routed and raises
  error.execution in its sender. Each event it takes has one sender, so
  its name and the active state route it; conds only correlate (which
  timer) and keep the original's non-blank response check.

  Bindings: the decision namespace package; speaking's (the conversation
  namespace and vocal's speech service).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="communication" initial="communication">
  <datamodel>
    <data id="response_timeout_ms" expr="36000"/>
    <!-- Speaking's encoding bound, passed to it (decision D96). -->
    <data id="encoding_timeout_ms" expr="30000"/>
    <!-- The memory database file, for the conversation (null:
         no memory). -->
    <data id="database" expr="null"/>
    <data id="ready" expr="({})"/>
    <!-- The response in hand: its number, words and hop timer. -->
    <data id="operation" expr="0"/>
    <data id="response" expr="null"/>
    <data id="hop_timer" expr="null"/>
    <data id="failure" expr="null"/>
    <!-- The offers. -->
    <data id="offering" expr="false"/>
    <data id="offered" expr="[]"/>
    <data id="offers_over" expr="false"/>
    <data id="offer_names" expr="''"/>
    <!-- The children. -->
    <data id="children" expr="['conversation', 'speaking']"/>
  </datamodel>
  <script src="communication.js"/>

  <state id="communication" initial="inactive">
    <invoke id="conversation" type="scxml" src="../conversation/conversation.scx">
      <param name="database" expr="database"/>
    </invoke>
    <invoke id="speaking" type="scxml" src="../speaking/speaking.scx">
      <param name="encoding_timeout_ms" expr="encoding_timeout_ms"/>
    </invoke>

    <transition event="bot.ability.offers" event:schema="schemas/bot.ability.offers.json">
      <assign location="ready[_event.data.ability]" expr="true"/>
    </transition>
    <!-- Conversation products go on to the body: a text product as its
         stimulus handoff, any other whose latest message is inbound as
         the output itself; the rest is history. -->
    <transition event="bot.ability.cognition.input" event:schema="schemas/bot.ability.cognition.input.json">
      <log label="communication.product" expr="productSequence(_event)"/>
      <send event="bot.ability.cognition.input" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
    <transition event="bot.ability.conversation.output" event:schema="schemas/bot.ability.conversation.output.json">
      <log label="communication.history" expr="historyLength(_event)"/>
      <if cond="isInboundProduct(_event)">
        <send event="bot.ability.conversation.output" target="#_parent">
          <content expr="_event.data"/>
        </send>
      </if>
    </transition>
    <!-- A snapshot of the conversation's participants (the communication
         requests none). -->
    <transition event="bot.ability.conversation.snapshot.output" event:schema="schemas/bot.ability.conversation.snapshot.output.json">
      <log label="communication.snapshot" expr="_event.data.request_ref"/>
    </transition>
    <!-- A conversation that could not take an input fails it (the original's
         conversation failed terminal, forwarded unchanged). -->
    <transition event="bot.ability.conversation.failed" event:schema="schemas/bot.ability.conversation.failed.json">
      <log label="communication.rejected" expr="conversationFailedLog(_event)"/>
      <send event="bot.ability.conversation.failed" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
    <!-- A child that cannot run, or ends, degrades the ability. -->
    <transition event="error.*" target="degraded">
      <assign location="failure" expr="childRunFailure(_event)"/>
    </transition>
    <transition event="done.invoke.conversation done.invoke.speaking" target="degraded">
      <assign location="failure" expr="childEndFailure(_event)"/>
    </transition>
    <!-- Speaking's record of what it said, and its playout. -->
    <transition event="bot.ability.conversation.append" event:schema="schemas/bot.ability.conversation.append.json">
      <send event="bot.ability.conversation.append" target="#_conversation">
        <content expr="_event.data"/>
      </send>
    </transition>
    <transition event="bot.ability.speaking.efference" event:schema="schemas/bot.ability.speaking.efference.json">
      <send event="bot.ability.speaking.efference" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
    <transition event="environment.sound" event:schema="schemas/environment.sound.json">
      <send event="environment.sound" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
    <!-- A speaking answer for no response in hand. -->
    <transition event="bot.ability.speaking.output bot.ability.failed">
      <log label="communication.stale" expr="_event.name"/>
    </transition>

    <!-- Waits for the conversation and speaking. A child that cannot
         start raises its error with no invokeid (SCXML 6.4.2). -->
    <state id="inactive">
      <transition cond="childrenReady()" target="active"/>
      <transition event="error.*" target="degraded">
        <assign location="failure" expr="childStartFailure(_event)"/>
      </transition>
      <transition event="bot.ability.communication.input" event:schema="schemas/bot.ability.communication.input.json">
        <event:defer/>
        <log label="communication.deferred" expr="_event.name"/>
      </transition>
      <transition event="bot.ability.communication.activate" event:schema="schemas/bot.ability.communication.activate.json">
        <log label="communication.activate" expr="'conversation'"/>
      </transition>
    </state>

    <state id="active">
      <onentry>
        <assign location="offering" expr="true"/>
        <decision:choice location="offered" events="bot.ability.communication.respond"/>
        <assign location="offering" expr="false"/>
        <decision:compact location="offered" bound="32768" overlocation="offers_over"/>
        <if cond="offers_over">
          <log label="communication.offers.dropped" expr="'the offers are over 32768 bytes'"/>
        </if>
        <decision:names location="offer_names" choices="offered"/>
        <log label="communication.offers" expr="offer_names"/>
        <send event="bot.ability.offers" target="#_parent">
          <param name="ability" expr="'communication'"/>
          <param name="choices" expr="offered"/>
        </send>
      </onentry>
      <transition event="bot.ability.communication.respond" event:schema="schemas/bot.ability.communication.respond.json"
                  cond="hasRespond(_event)" target="preparing_response">
        <assign location="response" expr="_event.data.text"/>
      </transition>
      <transition event="bot.ability.communication.respond" event:schema="schemas/bot.ability.communication.respond.json">
        <log label="communication.rejected" expr="'bot.ability.communication.respond needs one non-blank text'"/>
        <send event="bot.ability.communication.failed" target="#_parent">
          <param name="message" expr="'Communication response text must be non-blank.'"/>
        </send>
      </transition>
      <transition event="bot.ability.communication.input" event:schema="schemas/bot.ability.communication.input.json">
        <send event="bot.ability.conversation.routed_input" target="#_conversation">
          <param name="parent" expr="routedParent(_event)"/>
        </send>
      </transition>
    </state>

    <!-- The response is numbered. -->
    <state id="preparing_response">
      <onentry>
        <assign location="operation" expr="nextOperation()"/>
      </onentry>
      <transition target="dispatching_response"/>
    </state>

    <!-- The response goes to speaking. -->
    <state id="dispatching_response">
      <onentry>
        <send event="bot.ability.speaking.input" target="#_speaking">
          <param name="text" expr="response"/>
        </send>
      </onentry>
      <transition target="responding"/>
    </state>

    <!-- Waits (bounded) for speaking's answer. -->
    <state id="responding">
      <onentry>
        <send idlocation="hop_timer" event="bot.ability.communication.response.hop.timed_out" delayexpr="responseTimeoutDelay()">
          <param name="operation" expr="operation"/>
        </send>
      </onentry>
      <onexit>
        <cancel sendidexpr="hop_timer"/>
      </onexit>
      <transition event="bot.ability.speaking.output" event:schema="schemas/bot.ability.speaking.output.json" target="active">
        <send event="bot.ability.speaking.output" target="#_parent">
          <content expr="_event.data"/>
        </send>
      </transition>
      <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json" target="active">
        <send event="bot.ability.communication.failed" target="#_parent">
          <param name="message" expr="_event.data.message"/>
        </send>
      </transition>
      <transition event="bot.ability.communication.response.hop.timed_out" event:schema="schemas/bot.ability.communication.response.hop.timed_out.json"
                  cond="isResponseHopTimeout(_event)" target="active">
        <log label="communication.hop.timed_out" expr="hopTimedOutMessage()"/>
        <send event="bot.ability.communication.failed" target="#_parent">
          <param name="message" expr="'Speaking response timed out.'"/>
        </send>
      </transition>
      <transition event="bot.ability.communication.input bot.ability.communication.respond">
        <event:defer/>
        <log label="communication.deferred" expr="_event.name"/>
      </transition>
    </state>
  </state>

  <!-- A child could not run: the ability ends (the body degrades). -->
  <final id="degraded">
    <onentry>
      <log label="communication.degraded" expr="failure"/>
      <send event="bot.ability.communication.failed" target="#_parent">
        <param name="message" expr="failure"/>
      </send>
    </onentry>
  </final>
</scxml>
