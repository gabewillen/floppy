<?xml version="1.0" encoding="UTF-8"?>
<!-- migration-3: a step the engine refuses fails the migration with the engine's message. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="migration" type="scxml" src="../../../migration.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
    <param name="revisions" expr='[{"revision": "a", "down_revision": null, "upgrade": [{"sql": "SELECT * FROM nowhere"}], "downgrade": []}]'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.failed" cond="typeof _event.data.message === 'string' &amp;&amp; _event.data.message.indexOf('no such table: nowhere') &gt;= 0" target="step1"/>
  </state>
  <state id="step1">
    <transition event="done.invoke.migration" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
