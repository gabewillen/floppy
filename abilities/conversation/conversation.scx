<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Conversation ability in text mode (mosfet
  abilities/communication/conversation): the committed history of one
  conversation. The communication (abilities/communication/communication.scx) invokes it
  as its child "conversation", routes each admitted input to it as
  bot.ability.conversation.input, and records each spoken response with
  bot.ability.conversation.append.

    inactive -input-> active { waiting -input-> recalling -> waiting }
    append (inactive or active): commit the outbound message

  Inputs: recalling (mosfet Conversation's memory stage): with a database
  (the <param> database, the memory database file) it invokes the memory
  ability (abilities/memory/memory.scx) with one transaction that recalls
  the relationship's memories (content where query_tags
  conversation_memory and context_ref is the relationship, oldest first,
  at most 50, mosfet conversation_memory_recall_input) and then remembers
  the input ({source_ids, target_ids, content, content_type} as JSON, kind
  conversation, mosfet conversation_memory_insert_input); the
  relationship is the message's session_ref. The recalled memories are
  host-only (mosfet excludes them from the output) and are logged by
  count only. A memory failure answers bot.ability.conversation.failed
  {stage: "memory", message} and commits nothing. Without a database it
  logs <log label="memory" expr="'absent'">. The inbound message is then
  committed with
  the next sequence: text/* content as given, audio/* content dropped
  (media never enters the model-facing history), any other content as
  given; its provenance is the input event, with session_ref the
  relationship of its sorted source and target identities. Each message is
  also indexed in transcripts, keyed by its sorted source identities (one
  transcript per participant set; inference of participants and
  relationships from voice embeddings, mosfet's turn detectors, is phase 6).

  Appends: outbound messages only, committed with the next sequence and
  provenance event bot.ability.conversation.append; an append whose
  provenance id was already committed is not committed again.

  Output: every commit answers the parent with
  bot.ability.conversation.output {parent, messages}: parent is the input
  that caused the latest inbound commit (an envelope {event, data}), and
  messages is the committed history in causal order, its last
  max_messages messages only (a bound on what reaches the model per turn;
  sequences stay the history's).

  Readiness: the session's start sends bot.ability.offers
  {ability: "conversation", choices: []} to the parent; it offers nothing
  (mosfet's conversation input is not a tool event).

  Commits: <conversation:commit> (the conversation namespace) builds each
  committed message and its transcript key (its sorted source ids); the
  document appends it to history and transcripts and remembers each
  committed outbound provenance id in appended.

  Bindings: the conversation namespace package and the memory ability's
  sql service package (a run grants it its directory: scx run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="conversation" initial="conversation">
  <datamodel>
    <data id="max_messages" expr="20"/>
    <data id="history" expr="[]"/>
    <data id="transcripts" expr="({})"/>
    <data id="parent" expr="null"/>
    <data id="input" expr="null"/>
    <data id="participants" expr="null"/>
    <!-- The message in hand, and the provenance ids committed so far. -->
    <data id="message" expr="null"/>
    <data id="appended" expr="[]"/>
    <!-- Memory: the database file (null: no memory) and mosfet's
         statements (conversation/memory.py). A memory id is the next
         rowid as 32 hex digits: the sql service's randomblob is not
         unique across invocations. -->
    <data id="database" expr="null"/>
    <data id="memory_select" expr="'SELECT content FROM bot_memory WHERE query_tags = ?1 AND context_ref = ?2 ORDER BY created_at, memory_id LIMIT 50'"/>
    <data id="memory_insert" expr="'INSERT INTO bot_memory (memory_id, scope, context_ref, subject_ref, kind, sensitivity, retention, content, content_format, query_tags) VALUES ((SELECT printf(\'%032x\', coalesce(max(rowid), 0) + 1) FROM bot_memory), ?1, ?2, NULL, ?3, ?4, ?5, ?6, ?7, ?8)'"/>
    <data id="statements" expr="[]"/>
    <data id="remembered" expr="null"/>
  </datamodel>
  <script src="conversation.js"/>

  <state id="conversation" initial="inactive">
    <onentry>
      <send event="bot.ability.offers" target="#_parent">
        <param name="ability" expr="'conversation'"/>
        <param name="choices" expr="[]"/>
      </send>
    </onentry>

    <state id="inactive">
      <transition event="bot.ability.conversation.input" event:schema="schemas/bot.ability.conversation.input.json"
                  target="recalling">
        <assign location="input" expr="_event.data"/>
      </transition>
    </state>

    <state id="active" initial="waiting">
      <state id="waiting">
        <transition event="bot.ability.conversation.input" event:schema="schemas/bot.ability.conversation.input.json"
                    target="recalling">
          <assign location="input" expr="_event.data"/>
        </transition>
      </state>

      <!-- Recall the relationship's memories and remember the input, or
           nothing without a database; then commit the inbound message. -->
      <state id="recalling" initial="recalling_from">
        <onentry>
          <assign location="parent" expr="inputEnvelope()"/>
          <conversation:commit location="message" keylocation="participants" direction="inbound"
                               event="parent.event" message="input" sequence="history.length"/>
        </onentry>
        <state id="recalling_from">
          <transition cond="isMemoryAbsent()" target="committing">
            <log label="memory" expr="'absent'"/>
          </transition>
          <transition target="recalling_memory"/>
        </state>
        <state id="recalling_memory">
          <onentry>
            <assign location="remembered" expr="rememberedInput()"/>
            <assign location="statements" expr="memoryRecallStatements()"/>
            <assign location="statements" expr="statementsWithMemoryInsert()"/>
            <assign location="statements[1].parameters" expr="memoryInsertParameters()"/>
          </onentry>
          <invoke id="remember" type="scxml" src="../memory/memory.scx">
            <param name="database" expr="database"/>
            <param name="statements" expr="statements"/>
          </invoke>
          <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json"
                      cond="isFromMemory(_event)" target="committing">
            <log label="conversation.memories" expr="memoriesLog(_event)"/>
          </transition>
          <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json"
                      cond="isFromMemory(_event)" target="waiting">
            <send event="bot.ability.conversation.failed" target="#_parent">
              <param name="stage" expr="'memory'"/>
              <param name="message" expr="memoryFailedMessage(_event)"/>
            </send>
          </transition>
        </state>
        <state id="committing">
          <transition target="waiting">
            <assign location="history" expr="historyWithMessage()"/>
            <assign location="transcripts[participants]" expr="transcriptWithMessage()"/>
            <log label="conversation" expr="inboundCommitLog()"/>
            <send event="bot.ability.conversation.output" target="#_parent">
              <param name="parent" expr="parent"/>
              <param name="messages" expr="outputMessages()"/>
            </send>
          </transition>
        </state>
      </state>
    </state>

    <!-- An outbound record, in either state, committed once. -->
    <transition event="bot.ability.conversation.append" event:schema="schemas/bot.ability.conversation.append.json"
                cond="isNewOutboundAppend(_event)">
      <conversation:commit location="message" keylocation="participants" direction="outbound"
                           event="_event.name" message="_event.data.message"
                           provenance="_event.data.message.provenance" sequence="history.length"/>
      <assign location="history" expr="historyWithMessage()"/>
      <assign location="transcripts[participants]" expr="transcriptWithMessage()"/>
      <if cond="hasProvenanceId()">
        <assign location="appended" expr="appendedWithProvenance()"/>
      </if>
      <log label="conversation" expr="outboundCommitLog()"/>
      <send event="bot.ability.conversation.output" target="#_parent">
        <param name="parent" expr="parent"/>
        <param name="messages" expr="outputMessages()"/>
      </send>
    </transition>
    <transition event="bot.ability.conversation.append" event:schema="schemas/bot.ability.conversation.append.json"
                cond="isOutboundAppend(_event)">
      <log label="conversation" expr="alreadyCommittedLog(_event)"/>
    </transition>
    <transition event="bot.ability.conversation.*">
      <log label="conversation.rejected" expr="rejectedLog(_event)"/>
    </transition>
  </state>
</scxml>
