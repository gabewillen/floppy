<?xml version="1.0" encoding="UTF-8"?>
<!-- conversation-3: structured content is kept and answered as the conversation output; the first turn is the first name. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="conversation" type="scxml" src="../../../conversation.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.conversation.input" target="#_conversation"><content expr='{"source_ids": [[2, 1.25], "bob"], "target_ids": ["bot"], "content": {"b": 1, "a": [true, null]}, "content_type": "application/json"}'/></send>
    </onentry>
    <transition event="bot.ability.conversation.output" cond="_event.data.messages.length === 1 &amp;&amp; _event.data.messages[0].content.b === 1 &amp;&amp; _event.data.messages[0].content.a[0] === true &amp;&amp; _event.data.messages[0].content.a[1] === null &amp;&amp; _event.data.messages[0].provenance.turn_ref === 'input-1:turn:bob'" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
