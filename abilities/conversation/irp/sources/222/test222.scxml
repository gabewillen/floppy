<?xml version="1.0" encoding="UTF-8"?>
<!-- conversation-13: without a database an embedding is its own participant. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="conversation" type="scxml" src="../../../conversation.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'conversation' &amp;&amp; _event.data.choices.length === 0" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.conversation.input" target="#_conversation"><content expr='{"source_ids": [[0.28, 0.96]], "target_ids": [], "content": "hi", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'bot.ability.conversation.output' &amp;&amp; _event.data.stimulus.source === 'conversation' &amp;&amp; _event.data.stimulus.data.messages.length === 1 &amp;&amp; !('sequence' in _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1]) &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].direction === 'inbound' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content === &quot;hi&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content_type === 'text/plain' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.turn_ref === &quot;input-1:turn:track-[0.28,0.96]&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.session_ref === &quot;relationship-{\&quot;identity_groups\&quot;:[[],[[0.28,0.96]]]}&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.event === &quot;bot.ability.conversation.input&quot; &amp;&amp; _event.data.stimulus.data.parent.event === &quot;bot.ability.conversation.input&quot; &amp;&amp; JSON.stringify(_event.data.participants) === &quot;[]&quot;" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
