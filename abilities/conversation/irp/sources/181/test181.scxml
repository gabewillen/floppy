<?xml version="1.0" encoding="UTF-8"?>
<!-- conversation-9: a database the memory cannot open fails the input at the memory stage. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/nowhere/floppy.sqlite'"/>
  </invoke>
  <invoke id="conversation" type="scxml" src="../../../conversation.scx">
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
    <param name="memory_timeout_ms" expr="600000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.conversation.input" target="#_conversation"><content expr='{"source_ids": ["alice"], "target_ids": [], "content": "hello", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.conversation.failed" cond="_event.data.stage === 'memory' &amp;&amp; typeof _event.data.message === 'string' &amp;&amp; _event.data.message.length &gt; 0" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.conversation.snapshot.request" target="#_conversation"><content expr='{"request_ref": "s-1"}'/></send>
    </onentry>
    <transition event="bot.ability.conversation.snapshot.output" cond='_event.data.request_ref === "s-1" &amp;&amp; JSON.stringify(_event.data.detector_refs) === "[]"' target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.memory.stm.turn"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
