<?xml version="1.0" encoding="UTF-8"?>
<!-- conversation-8: white space only: the detector closes the turn with nothing to show, and nothing is committed. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="conversation" type="scxml" src="../../../conversation.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'conversation' &amp;&amp; _event.data.choices.length === 0" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.conversation.input" target="#_conversation"><content expr='{"source_ids": ["alice"], "target_ids": [], "content": "   ", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.conversation.failed" cond='_event.data.stage === "turn_detector" &amp;&amp; _event.data.message === "Turn closed with neither text, audio, nor modality-neutral content."' target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.conversation.input" target="#_conversation"><content expr='{"source_ids": ["alice"], "target_ids": [], "content": "next", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'bot.ability.conversation.output' &amp;&amp; _event.data.stimulus.source === 'conversation' &amp;&amp; _event.data.stimulus.data.messages.length === 1 &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].sequence === 0 &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].direction === 'inbound' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content === &quot;next&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content_type === 'text/plain' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.turn_ref === &quot;input-2:turn:alice&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.session_ref === &quot;relationship-{\&quot;identity_groups\&quot;:[[],[\&quot;alice\&quot;]]}&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.event === &quot;bot.ability.conversation.input&quot; &amp;&amp; _event.data.stimulus.data.parent.event === &quot;bot.ability.conversation.input&quot;" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
