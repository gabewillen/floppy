<?xml version="1.0" encoding="UTF-8"?>
<!-- conversation-12: an outbound message carries the participants its append stamps, and none when it stamps none. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="conversation" type="scxml" src="../../../conversation.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.conversation.append" target="#_conversation"><content expr='{"message": {"direction": "outbound", "source_ids": ["bot"], "target_ids": ["alice"], "content": "hi", "content_type": "text/plain", "provenance": {"event": "x.y", "id": "r-1"}, "participants": [{"ref": "voice:warm", "role": "source", "own": true}]}}'/></send>
    </onentry>
    <transition event="bot.ability.conversation.output" cond='_event.data.messages.length === 1 &amp;&amp; JSON.stringify(_event.data.messages[0].participants) === "[{\"own\":true,\"ref\":\"voice:warm\",\"role\":\"source\"}]"' target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.conversation.append" target="#_conversation"><content expr='{"message": {"direction": "outbound", "source_ids": ["bot"], "target_ids": ["alice"], "content": "again", "content_type": "text/plain", "provenance": {"event": "x.y", "id": "r-2"}}}'/></send>
    </onentry>
    <transition event="bot.ability.conversation.output" cond='_event.data.messages.length === 2 &amp;&amp; JSON.stringify(_event.data.messages[1].participants) === "[]"' target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
