<?xml version="1.0" encoding="UTF-8"?>
<!-- conversation-13: a different voice is a new person. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <invoke id="conversation" type="scxml" src="../../../conversation.scx">
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
    <param name="memory_timeout_ms" expr="600000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.conversation.input" target="#_conversation"><content expr='{"source_ids": [[0.28, 0.96]], "target_ids": [], "content": "hi", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'bot.ability.conversation.output' &amp;&amp; _event.data.stimulus.source === 'conversation' &amp;&amp; _event.data.stimulus.data.messages.length === 1 &amp;&amp; !('sequence' in _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1]) &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].direction === 'inbound' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content === &quot;hi&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content_type === 'text/plain' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.turn_ref === &quot;input-1:turn:person-1&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.session_ref === &quot;relationship-{\&quot;identity_groups\&quot;:[[],[\&quot;person-1\&quot;]]}&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.event === &quot;bot.ability.conversation.input&quot; &amp;&amp; _event.data.stimulus.data.parent.event === &quot;bot.ability.conversation.input&quot; &amp;&amp; JSON.stringify(_event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].source_ids) === &quot;[\&quot;person-1\&quot;]&quot; &amp;&amp; JSON.stringify(_event.data.participants) === &quot;[{\&quot;ref\&quot;:\&quot;person-1\&quot;,\&quot;role\&quot;:\&quot;source\&quot;}]&quot;" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.conversation.input" target="#_conversation"><content expr='{"source_ids": [[0.96, -0.28]], "target_ids": [], "content": "hello", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'bot.ability.conversation.output' &amp;&amp; _event.data.stimulus.source === 'conversation' &amp;&amp; _event.data.stimulus.data.messages.length === 1 &amp;&amp; !('sequence' in _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1]) &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].direction === 'inbound' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content === &quot;hello&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].content_type === 'text/plain' &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.turn_ref === &quot;input-2:turn:person-2&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.session_ref === &quot;relationship-{\&quot;identity_groups\&quot;:[[],[\&quot;person-1\&quot;]]}&quot; &amp;&amp; _event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].provenance.event === &quot;bot.ability.conversation.input&quot; &amp;&amp; _event.data.stimulus.data.parent.event === &quot;bot.ability.conversation.input&quot; &amp;&amp; JSON.stringify(_event.data.stimulus.data.messages[_event.data.stimulus.data.messages.length - 1].source_ids) === &quot;[\&quot;person-2\&quot;]&quot; &amp;&amp; JSON.stringify(_event.data.participants) === &quot;[{\&quot;ref\&quot;:\&quot;person-2\&quot;,\&quot;role\&quot;:\&quot;source\&quot;}]&quot;" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.memory.stm.turn"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
