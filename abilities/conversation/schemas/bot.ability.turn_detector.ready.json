{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.turn_detector.ready",
  "description": "Typed readiness terminal for one owner-context detector.",
  "properties": {
    "participant_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      ],
      "title": "Participant Ref"
    },
    "conversation_ref": {
      "minLength": 1,
      "title": "Conversation Ref",
      "type": "string"
    }
  },
  "required": [
    "participant_ref",
    "conversation_ref"
  ],
  "type": "object"
}
