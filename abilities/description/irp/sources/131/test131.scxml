<?xml version="1.0" encoding="UTF-8"?>
<!-- description-4: 4001 characters are an output its schema refuses. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="description" type="scxml" src="../../../description.scx">
    <param name="image" expr="'media/scene.png'"/>
    <param name="media_type" expr="'image/png'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.failed" cond='JSON.stringify(_event.data) === "{\"message\":\"Description produced output that does not match its output schema.\"}"' target="step1"/>
  </state>
  <state id="step1">
    <transition event="done.invoke.description" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
