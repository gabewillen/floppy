<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Conversation ability in text mode (mosfet
  abilities/communication/conversation): the committed history of one
  conversation. The communication (abilities/communication.scx) invokes it
  as its child "conversation", routes each admitted input to it as
  bot.ability.conversation.input, and records each spoken response with
  bot.ability.conversation.append.

    inactive -input-> active { waiting -input-> recalling -> waiting }
    append (inactive or active): commit the outbound message

  Inputs: recalling is the memory seam (phase 3): it logs
  <log label="memory" expr="'absent'"> and recalls nothing (no recalled
  memory reaches the output). The inbound message is then committed with
  the next sequence: text/* content as given, audio/* content dropped
  (media never enters the model-facing history), any other content as
  given; its provenance is the input event, with session_ref the
  relationship of its sorted source and target identities. Each message is
  also indexed in transcripts, keyed by its sorted source identities (one
  transcript per participant set; inference of participants and
  relationships from voice embeddings, mosfet's turn detectors, is phase 6).

  Appends: outbound messages only, committed with the next sequence and
  provenance event bot.ability.conversation.append; an append whose
  provenance id was already committed is not committed again.

  Output: every commit answers the parent with
  bot.ability.conversation.output {parent, messages}: parent is the input
  that caused the latest inbound commit (an envelope {event, data}), and
  messages is the committed history in causal order, its last
  max_messages messages only (a bound on what reaches the model per turn;
  sequences stay the history's).

  Readiness: the session's start sends bot.ability.offers
  {ability: "conversation", choices: []} to the parent; it offers nothing
  (mosfet's conversation input is not a tool event).

  Commits: <conversation:commit> (the conversation namespace) builds each
  committed message and its transcript key (its sorted source ids); the
  document appends it to history and transcripts and remembers each
  committed outbound provenance id in appended.

  Bindings: the conversation namespace package (no service, no I/O).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="conversation" initial="conversation">
  <datamodel>
    <data id="max_messages" expr="20"/>
    <data id="history" expr="[]"/>
    <data id="transcripts" expr="({})"/>
    <data id="parent" expr="null"/>
    <data id="input" expr="null"/>
    <data id="participants" expr="null"/>
    <!-- The message in hand, and the provenance ids committed so far. -->
    <data id="message" expr="null"/>
    <data id="appended" expr="[]"/>
  </datamodel>
  <script>
    function isObject(value) {
      return value !== null &amp;&amp; typeof value === 'object' &amp;&amp; !Array.isArray(value);
    }
    function isIdentity(value) {
      return typeof value === 'string'
        || (Array.isArray(value) &amp;&amp; value.every(function (n) { return typeof n === 'number'; }));
    }
    function identities(list, least) {
      return Array.isArray(list) &amp;&amp; list.length &gt;= least &amp;&amp; list.every(isIdentity)
        &amp;&amp; list.every(function (id, i) {
          return list.findIndex(function (other) { return JSON.stringify(other) === JSON.stringify(id); }) === i;
        });
    }
    function optionalCount(value) {
      return value === undefined || value === null || (Number.isInteger(value) &amp;&amp; value &gt;= 1);
    }
    // schemas/bot.ability.conversation.input.json
    function validInput(data) {
      return isObject(data)
        &amp;&amp; Object.keys(data).every(function (k) {
          return ['source_ids', 'target_ids', 'content', 'content_type', 'sample_rate_hz', 'channels'].indexOf(k) &gt;= 0;
        })
        &amp;&amp; identities(data.source_ids, 1) &amp;&amp; identities(data.target_ids, 0)
        &amp;&amp; data.content !== undefined
        &amp;&amp; typeof data.content_type === 'string' &amp;&amp; data.content_type.length &gt; 0
        &amp;&amp; optionalCount(data.sample_rate_hz) &amp;&amp; optionalCount(data.channels);
    }
    // schemas/bot.ability.conversation.append.json (outbound only).
    function validAppend(data) {
      if (!isObject(data) || !isObject(data.message)) { return false; }
      var m = data.message;
      return m.direction === 'outbound'
        &amp;&amp; identities(m.source_ids, 0) &amp;&amp; identities(m.target_ids, 0)
        &amp;&amp; typeof m.content_type === 'string' &amp;&amp; m.content_type.length &gt; 0
        &amp;&amp; isObject(m.provenance);
    }
  </script>

  <state id="conversation" initial="inactive">
    <onentry>
      <send event="bot.ability.offers" target="#_parent">
        <param name="ability" expr="'conversation'"/>
        <param name="choices" expr="[]"/>
      </send>
    </onentry>

    <state id="inactive">
      <transition event="bot.ability.conversation.input" event:schema="schemas/bot.ability.conversation.input.json"
                  cond="validInput(_event.data)" target="recalling">
        <assign location="input" expr="_event.data"/>
      </transition>
    </state>

    <state id="active" initial="waiting">
      <state id="waiting">
        <transition event="bot.ability.conversation.input" event:schema="schemas/bot.ability.conversation.input.json"
                    cond="validInput(_event.data)" target="recalling">
          <assign location="input" expr="_event.data"/>
        </transition>
      </state>

      <!-- Memory seam (phase 3): nothing is recalled. -->
      <state id="recalling">
        <onentry>
          <log label="memory" expr="'absent'"/>
          <assign location="parent" expr="({event: 'bot.ability.conversation.input', data: input})"/>
        </onentry>
        <transition target="waiting">
          <conversation:commit location="message" keylocation="participants" direction="inbound"
                               event="parent.event" message="input" sequence="history.length"/>
          <assign location="history" expr="history.concat([message])"/>
          <assign location="transcripts[participants]" expr="(transcripts[participants] || []).concat([message.sequence])"/>
          <log label="conversation" expr="'inbound ' + (history.length - 1) + ' from ' + participants + ' (' + transcripts[participants].length + ' in its transcript)'"/>
          <send event="bot.ability.conversation.output" target="#_parent">
            <param name="parent" expr="parent"/>
            <param name="messages" expr="history.slice(Math.max(0, history.length - max_messages))"/>
          </send>
        </transition>
      </state>
    </state>

    <!-- An outbound record, in either state, committed once. -->
    <transition event="bot.ability.conversation.append" event:schema="schemas/bot.ability.conversation.append.json"
                cond="validAppend(_event.data) &amp;&amp; appended.indexOf(_event.data.message.provenance.id) &lt; 0">
      <conversation:commit location="message" keylocation="participants" direction="outbound"
                           event="_event.name" message="_event.data.message"
                           provenance="_event.data.message.provenance" sequence="history.length"/>
      <assign location="history" expr="history.concat([message])"/>
      <assign location="transcripts[participants]" expr="(transcripts[participants] || []).concat([message.sequence])"/>
      <if cond="typeof message.provenance.id === 'string'">
        <assign location="appended" expr="appended.concat([message.provenance.id])"/>
      </if>
      <log label="conversation" expr="'outbound ' + (history.length - 1)"/>
      <send event="bot.ability.conversation.output" target="#_parent">
        <param name="parent" expr="parent"/>
        <param name="messages" expr="history.slice(Math.max(0, history.length - max_messages))"/>
      </send>
    </transition>
    <transition event="bot.ability.conversation.append" event:schema="schemas/bot.ability.conversation.append.json"
                cond="validAppend(_event.data)">
      <log label="conversation" expr="'outbound ' + _event.data.message.provenance.id + ' already committed'"/>
    </transition>
    <transition event="bot.ability.conversation.*">
      <log label="conversation.rejected" expr="_event.name + ' does not satisfy its schema'"/>
    </transition>
  </state>
</scxml>
