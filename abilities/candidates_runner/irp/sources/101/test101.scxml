<?xml version="1.0" encoding="UTF-8"?>
<!-- candidates_runner-1: the candidate gets the turn and input &lt;param&gt;s. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="candidates_runner" type="scxml" src="../../../candidates_runner.scx">
    <param name="turn" expr="7"/>
    <param name="input" expr='{"text": "hello", "focus": null, "focus_candidates": []}'/>
    <param name="candidates" expr="[{&quot;name&quot;: &quot;Echo&quot;, &quot;source&quot;: &quot;&lt;scxml xmlns=\&quot;http://www.w3.org/2005/07/scxml\&quot; version=\&quot;1.0\&quot; datamodel=\&quot;ecmascript\&quot; initial=\&quot;done\&quot;&gt;&lt;datamodel&gt;&lt;data id=\&quot;turn\&quot; expr=\&quot;0\&quot;/&gt;&lt;data id=\&quot;input\&quot; expr=\&quot;null\&quot;/&gt;&lt;/datamodel&gt;&lt;final id=\&quot;done\&quot;&gt;&lt;donedata&gt;&lt;content expr=\&quot;({turn: turn, handled: true, selected: [{event: 'bot.ability.cognition.ignore', data: {turn: turn, text: input.text}}]})\&quot;/&gt;&lt;/donedata&gt;&lt;/final&gt;&lt;/scxml&gt;&quot;}]"/>
    <param name="choices" expr="[]"/>
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.candidates_runner" cond="_event.data.tried.join(' ') === &quot;Echo&quot; &amp;&amp; _event.data.tried.length === 1 &amp;&amp; _event.data.handled === true &amp;&amp; _event.data.rejection === null &amp;&amp; _event.data.selected[0].data.turn === 7 &amp;&amp; _event.data.selected[0].data.text === 'hello'" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
