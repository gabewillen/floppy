<?xml version="1.0" encoding="UTF-8"?>
<!-- candidates_runner-1: a handled candidate answers the turn with its own selections. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="candidates_runner" type="scxml" src="../../../candidates_runner.scx">
    <param name="turn" expr="3"/>
    <param name="input" expr='{"text": "hello", "focus": null, "focus_candidates": []}'/>
    <param name="candidates" expr='[{"name": "A", "source": "irp/behaviors/200e73a7af5935bb.scxml"}]'/>
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.candidates_runner" cond="_event.data.tried.join(' ') === &quot;A&quot; &amp;&amp; _event.data.tried.length === 1 &amp;&amp; _event.data.handled === true &amp;&amp; _event.data.rejection === null &amp;&amp; _event.data.selected.length === 1 &amp;&amp; _event.data.selected[0].event === 'bot.ability.cognition.ignore' &amp;&amp; _event.data.selected[0].reason === 'handled'" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
