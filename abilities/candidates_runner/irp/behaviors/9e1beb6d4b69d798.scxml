<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="done"><datamodel><data id="turn" expr="0"/><data id="input" expr="null"/></datamodel><final id="done"><donedata><content expr="({turn: turn + 1, handled: true, selected: [{event: 'bot.ability.cognition.ignore', data: {}}]})"/></donedata></final></scxml>