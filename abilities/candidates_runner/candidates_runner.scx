<?xml version="1.0" encoding="UTF-8"?>
<!--
  The candidates runner: the learned turn behaviors Autonomy
  (abilities/autonomy/autonomy.scx) tries one at a time, as a chain of
  SCXML children. One runner runs the first
  candidate of its candidates <param> and, when that one does not answer
  the turn, invokes itself for the rest; Autonomy invokes the first
  runner.

    running -> dispatching -> using -> answered
    running | dispatching -> recording_failure -> recorded_failure
    recorded_failure -> rejected | advancing
    running -> advancing -> running_rest -> passed   (unhandled when no rest is left)

  Each runner enters running once, so its silence timer needs no cancel
  and no check of which send it is: a timeout that fires after the
  candidate answered arrives in a state that does not take it, and one
  pending when the runner ends dies with the runner's session.

  Input: the <param>s turn, input (the candidate's input, as
  <autonomy:behavior_input_payload> builds it), candidates (the behaviors left to try, in inventory
  order: [{name, source}], at least one), memory, silence_ms and
  memory_timeout_ms.

  Candidates: as Autonomy describes; the candidate's source is the path
  of its program (the builder's <name>.scx, beside its <name>.json and
  <name>.js; decision D121), run as the child "candidate" by <invoke
  srcexpr> with the <param>s turn and input. Handled with selections, dispatching sends each to the session
  its target names (#_scxml_ + target, decision D104; a learned behavior
  names its targets, the session ids its turn's choices carry) and then
  raises bot.ability.autonomy.candidate.dispatch.succeeded, which a send
  that failed (error.*, raised before it) preempts: sent, the use is
  persisted and the runner answers; failed, the failure is persisted and
  the runner answers the failure. Not handled, silent within silence_ms, or an error.* for it
  (its failure persisted): the rest run.

  Output (donedata): {tried, handled, selected, rejection}: tried names the
  candidates this runner and the rest tried, in order; selected is the
  handled candidate's selections; rejection is the failed dispatch's
  message (null otherwise).

  Memory: each transaction invokes the Memory ability
  (abilities/memory/memory.scx); one that fails or outlasts
  memory_timeout_ms is logged (autonomy.behavior_usage.persistence_failed)
  and takes the same effect as one persisted.

  Bindings: none of its own (the Memory ability binds the sql service).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="candidates_runner" initial="running">
  <datamodel>
    <data id="turn" expr="0"/>
    <data id="input" expr="null"/>
    <data id="candidates" expr="[]"/>
    <data id="memory" expr="null"/>
    <!-- The id of each request this document last sent the memory, by
         the state that sent it (decision D265). -->
    <data id="memory_requests" expr="({})"/>
    <data id="silence_ms" expr="1000"/>
    <data id="memory_timeout_ms" expr="10000"/>
    <data id="answer" expr="null"/>
    <!-- The handled candidate's selection being sent (the <foreach>
         item), and why its dispatch failed (null when sent). -->
    <data id="s" expr="null"/>
    <data id="rejection" expr="null"/>
    <!-- The rest's output. -->
    <data id="rest_output" expr="null"/>
    <data id="used_sql">UPDATE bot_behavior SET used_count = CAST(CAST(used_count AS INTEGER) + 1 AS TEXT), last_used_at = replace(substr(CAST(CURRENT_TIMESTAMP AS TEXT), 1, 19), ' ', 'T') || 'Z' WHERE name = ?</data>
    <data id="failed_sql">UPDATE bot_behavior SET failed_count = CAST(CAST(failed_count AS INTEGER) + 1 AS TEXT), last_failed_at = replace(substr(CAST(CURRENT_TIMESTAMP AS TEXT), 1, 19), ' ', 'T') || 'Z' WHERE name = ?</data>
  </datamodel>
  <script src="candidates_runner.js"/>

  <!-- The first candidate. -->
  <state id="running">
    <onentry>
      <log label="autonomy.candidate" expr="candidateName()"/>
      <send event="bot.ability.autonomy.candidate.silent" delayexpr="silenceDelay()"/>
    </onentry>
    <invoke id="candidate" type="scxml" srcexpr="candidateSource()">
      <param name="turn" expr="turn"/>
      <param name="input" expr="input"/>
    </invoke>
    <transition event="done.invoke.candidate" cond="isBehaviorHandled(_event)" target="dispatching">
      <assign location="answer" expr="_event.data.selected"/>
    </transition>
    <transition event="done.invoke.candidate" target="advancing">
      <log label="autonomy.candidate.advance" expr="candidateAdvanceLog(_event)"/>
    </transition>
    <transition event="bot.ability.autonomy.candidate.silent" target="advancing">
      <log label="autonomy.candidate.silent" expr="candidateSilentLog()"/>
    </transition>
    <!-- A source that does not load or compile fails the invocation with
         no invokeid (SCXML 3.12.2); nothing else here raises one. -->
    <transition event="error.*" target="recording_failure">
      <log label="autonomy.candidate.failed" expr="candidateFailedLog(_event)"/>
    </transition>
  </state>

  <!-- The handled candidate's selections are sent before its use is
       persisted. -->
  <state id="dispatching">
    <onentry>
      <foreach array="answer" item="s">
        <send eventexpr="s.event" targetexpr="'#_scxml_' + s.target">
          <content expr="selectionData(s)"/>
        </send>
      </foreach>
    </onentry>
    <!-- Its own block, so it runs after a send that failed above and the
         failure (raised first) preempts it. -->
    <onentry>
      <raise event="bot.ability.autonomy.candidate.dispatch.succeeded"/>
    </onentry>
    <transition event="bot.ability.autonomy.candidate.dispatch.succeeded" target="using"/>
    <transition event="error.*" target="recording_failure">
      <assign location="rejection" expr="dispatchFailure(_event)"/>
      <log label="autonomy.candidate.failed" expr="candidateRejectedLog()"/>
    </transition>
  </state>

  <!-- The handled candidate's use is persisted. -->
  <state id="using">
    <onentry>
      <send event="bot.ability.autonomy.behavior_usage.persistence_failed" delayexpr="memoryTimeoutDelay()"/>
      <send event="bot.ability.memory.input" targetexpr="memory" idlocation="memory_requests.usage">
        <param name="id" expr="memory_requests.usage"/>
        <param name="statements" expr="usedPersistenceStatements()"/>
      </send>
    </onentry>
    <!-- The update's results: nothing to keep. -->
    <transition event="bot.ability.memory.output" cond="isMemoryReply('usage')" event:schema="../schemas/bot.ability.memory.output.json" target="answered"/>
    <!-- A failed persistence takes the same effect as one persisted. -->
    <transition event="bot.ability.failed" cond="isMemoryReply('usage')" event:schema="../schemas/bot.ability.failed.json" target="answered">
      <log label="autonomy.behavior_usage.persistence_failed" expr="usageFailedReason(_event.data.message)"/>
    </transition>
    <transition event="error.*" target="answered">
      <log label="autonomy.behavior_usage.persistence_failed" expr="usageFailedReason(_event.name)"/>
    </transition>
    <transition event="bot.ability.autonomy.behavior_usage.persistence_failed" target="answered">
      <log label="autonomy.behavior_usage.persistence_failed" expr="usageTimedOutReason()"/>
    </transition>
  </state>

  <!-- A failed candidate's failure is persisted, then the rest run; a
       rejected one's, then the runner answers the rejection. -->
  <state id="recording_failure">
    <onentry>
      <send event="bot.ability.autonomy.behavior_usage.persistence_failed" delayexpr="memoryTimeoutDelay()"/>
      <send event="bot.ability.memory.input" targetexpr="memory" idlocation="memory_requests.failure">
        <param name="id" expr="memory_requests.failure"/>
        <param name="statements" expr="failedPersistenceStatements()"/>
      </send>
    </onentry>
    <transition event="bot.ability.memory.output" cond="isMemoryReply('failure')" event:schema="../schemas/bot.ability.memory.output.json" target="recorded_failure"/>
    <!-- A failed persistence takes the same effect as one persisted. -->
    <transition event="bot.ability.failed" cond="isMemoryReply('failure')" event:schema="../schemas/bot.ability.failed.json" target="recorded_failure">
      <log label="autonomy.behavior_usage.persistence_failed" expr="usageFailedReason(_event.data.message)"/>
    </transition>
    <transition event="error.*" target="recorded_failure">
      <log label="autonomy.behavior_usage.persistence_failed" expr="usageFailedReason(_event.name)"/>
    </transition>
    <transition event="bot.ability.autonomy.behavior_usage.persistence_failed" target="recorded_failure">
      <log label="autonomy.behavior_usage.persistence_failed" expr="usageTimedOutReason()"/>
    </transition>
  </state>

  <state id="recorded_failure">
    <transition cond="isRejected()" target="rejected"/>
    <transition target="advancing"/>
  </state>

  <state id="advancing">
    <transition cond="hasRest()" target="running_rest"/>
    <transition target="unhandled"/>
  </state>

  <!-- The rest of the chain, whose output this runner passes up. -->
  <state id="running_rest">
    <invoke id="rest" type="scxml" src="candidates_runner.scx">
      <param name="turn" expr="turn"/>
      <param name="input" expr="input"/>
      <param name="candidates" expr="restCandidates()"/>
      <param name="memory" expr="memory"/>
      <param name="silence_ms" expr="silence_ms"/>
      <param name="memory_timeout_ms" expr="memory_timeout_ms"/>
    </invoke>
    <transition event="done.invoke.rest" target="passed">
      <assign location="rest_output" expr="_event.data"/>
    </transition>
    <transition event="error.*" target="unhandled">
      <log label="autonomy.candidate.failed" expr="restFailedLog(_event)"/>
    </transition>
  </state>

  <final id="answered">
    <donedata>
      <content expr="answeredOutput()"/>
    </donedata>
  </final>

  <final id="rejected">
    <donedata>
      <content expr="rejectedOutput()"/>
    </donedata>
  </final>

  <final id="unhandled">
    <donedata>
      <content expr="unhandledOutput()"/>
    </donedata>
  </final>

  <final id="passed">
    <donedata>
      <content expr="passedOutput()"/>
    </donedata>
  </final>
</scxml>
