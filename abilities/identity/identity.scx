<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Identity ability over text (mosfet abilities/identity): the
  bot's sense of its own name. The body (bots/floppy/floppy.scx) invokes it
  as its child "identity".

    recalling -bot.ability.identity.recalled-> knowing {
      listening -heard text-> recognizing -> listening }
    knowing -bot.ability.identity.adopt-> adopting
      -bot.ability.identity.adopted-> knowing

  A bot is born nameless: nothing in the body supplies a name. name is the
  invoker's <param name="name"> when it passes one (tests do; the body does
  not), else null.

  recalling (mosfet Identity._recall_name): with a database (the <param>
  database, the memory database file) it invokes the memory ability
  (abilities/memory/memory.scx) to select the adopted names (query_tags
  self_name, subject_ref self, oldest first, at most 50, mosfet
  identity/name.py) and sends bot.ability.identity.recalled {name} to
  #_internal with the last one, else with the name the session started
  with ({text, kind: "fact"}, or null). A recall that fails sends
  bot.ability.failed {message: "Identity could not recall a name from
  memory: ..."} to the parent and then recalls the session's name, as
  mosfet does. Without a database it logs <log label="memory"
  expr="'absent'"> and recalls the session's name.

  Recognition (mosfet recognition.hears_name, the text recognizer): the
  body relays each outside bot.ability.communication.input to this
  ability. <bot:recognize> decides whether its text (a string content with
  a text/* content_type) names the bot: the name's case-folded
  letter-and-digit tokens appear as a whole run in the text's (so a bot
  named "Al" is not addressed by "always"). Addressed:
  bot.ability.identity.addressed {name} goes to the body, which takes it
  as a turn's stimulus. Not addressed, or no name yet, produces nothing: a
  nameless bot only hears words. Other content is not heard (audio is
  phase 6).

  Adoption: bot.ability.identity.adopt {name, reason?} is offered (as the
  model-callable act of taking a name) on every entry into knowing,
  through <decision:choice events="bot.ability.identity.adopt">, compacted
  by <decision:compact> ($schema, title and examples dropped), in
  bot.ability.offers {ability: "identity", choices}, from knowing's
  onentry (<decision:choice> reads knowing's own transitions there,
  before a child is entered); the first offers are the ability's
  readiness. adopting
  (mosfet Identity._adopt_name) writes the name down before answering to
  it: with a database it inserts the name (scope long_term, kind fact,
  query_tags self_name, subject_ref self, and the recall orders ties in
  created_at by memory_id, so two adoptions in one second keep their
  order) and sends
  bot.ability.identity.adopted {name: {text, kind: "fact"}, persisted:
  true} (persisted [floppy field]) to #_internal; a write that fails sends
  bot.ability.identity.adopt.failed {message: "Identity could not remember
  the name it took: ..."} to #_internal and the bot keeps its old name
  (fail-closed). Without a database it logs <log label="memory"
  expr="'absent'"> and sends adopted with persisted false.

  Logs: identity.name (each name taken, recalled or adopted),
  identity.heard (whether a relayed text addressed the bot), and
  identity.offers.

  Contracts: every event it takes names its abilities/schemas/ file by
  event:schema. A send or raise whose data does not satisfy it is
  error.execution in its sender, and input from outside the session that
  does not is refused, so no cond rechecks a payload.

  Bindings: the bot and decision namespace packages and the memory ability's
  sql service package (a run grants it its directory: scx run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="identity" initial="recalling">
  <datamodel>
    <data id="name" expr="null"/>
    <data id="addressed" expr="false"/>
    <data id="adopting_name" expr="null"/>
    <!-- The offers. -->
    <data id="offered" expr="[]"/>
    <data id="offers_over" expr="false"/>
    <data id="offer_names" expr="''"/>
    <!-- Memory: the database file (null: no memory) and mosfet's
         statements (identity/name.py). The SQL runs on both
         engines (SQLite and Postgres). A memory id is the next row count
         as 32 zero-padded digits (neither engine's randomness is unique
         across invocations in Wasm); JSON rows are told by their
         content_format, oldest first by created_at, then memory_id. -->
    <data id="database" expr="null"/>
    <data id="name_select" expr="'SELECT content FROM bot_memory WHERE query_tags = ?1 AND subject_ref = ?2 AND content_format = \'application/json\' ORDER BY created_at, memory_id LIMIT 50'"/>
    <data id="name_insert" expr="'INSERT INTO bot_memory (memory_id, scope, context_ref, subject_ref, kind, sensitivity, retention, content, content_format, query_tags) VALUES ((SELECT substr(\'00000000000000000000000000000000\', 1, 32 - length(n)) || n FROM (SELECT CAST(COUNT(*) + 1 AS TEXT) AS n FROM bot_memory) AS c), ?1, NULL, ?2, ?3, ?4, ?5, ?6, ?7, ?8)'"/>
    <data id="recalled_name" expr="null"/>
    <data id="name_parameters" expr="[]"/>
  </datamodel>
  <script src="identity.js"/>

  <!-- Wake up remembering the name, when there is a memory to have
       remembered it in; else the name the session started with. -->
  <state id="recalling" initial="recalling_from">
    <onentry>
      <assign location="recalled_name" expr="recalledName()"/>
    </onentry>
    <state id="recalling_from">
      <transition cond="hasNoDatabase()" target="recalling_nothing"/>
      <transition target="recalling_memory"/>
    </state>
    <state id="recalling_nothing">
      <onentry>
        <log label="memory" expr="'absent'"/>
        <send event="bot.ability.identity.recalled" target="#_internal">
          <param name="name" expr="recalled_name"/>
        </send>
      </onentry>
    </state>
    <state id="recalling_memory">
      <invoke id="recall" type="scxml" src="../memory/memory.scx">
        <param name="database" expr="database"/>
        <param name="statements" expr="nameSelectStatements()"/>
      </invoke>
      <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json"
                  cond="isFromInvoke(_event, 'recall')">
        <assign location="recalled_name" expr="recalledNameFromMemory(_event)"/>
        <send event="bot.ability.identity.recalled" target="#_internal">
          <param name="name" expr="recalled_name"/>
        </send>
      </transition>
      <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json"
                  cond="isFromInvoke(_event, 'recall')">
        <send event="bot.ability.failed" target="#_parent">
          <param name="message" expr="recallFailedMessage(_event)"/>
        </send>
        <send event="bot.ability.identity.recalled" target="#_internal">
          <param name="name" expr="recalled_name"/>
        </send>
      </transition>
    </state>
    <transition event="bot.ability.identity.recalled" event:schema="schemas/bot.ability.identity.recalled.json" target="knowing">
      <assign location="name" expr="recalledNameText(_event)"/>
      <log label="identity.name" expr="recalledNameLog()"/>
    </transition>
  </state>

  <state id="knowing" initial="listening">
    <!-- The offers, read on entry: the choices are knowing's own
         transitions, since no child is entered yet. -->
    <onentry>
      <decision:choice location="offered" events="bot.ability.identity.adopt"/>
      <decision:compact location="offered" bound="32768" overlocation="offers_over"/>
      <if cond="offers_over">
        <log label="identity.offers.dropped" expr="'the offers are over 32768 bytes'"/>
      </if>
      <decision:names location="offer_names" choices="offered"/>
      <log label="identity.offers" expr="offer_names"/>
      <send event="bot.ability.offers" target="#_parent">
        <param name="ability" expr="'identity'"/>
        <param name="choices" expr="offered"/>
      </send>
    </onentry>
    <!-- Offered for the whole time the ability is knowing: a bot can be
         given a name mid-sentence. -->
    <transition event="bot.ability.identity.adopt" event:schema="schemas/bot.ability.identity.adopt.json" target="adopting">
      <assign location="adopting_name" expr="_event.data.name"/>
    </transition>

    <state id="listening">
      <!-- A nameless bot hears words and nothing follows from them. -->
      <transition event="bot.ability.communication.input" event:schema="schemas/bot.ability.communication.input.json"
                  cond="canRecognize()" target="recognizing">
        <bot:recognize location="addressed" name="name" text="_event.data.content_type.indexOf('text/') === 0 ? _event.data.content : null"/>
      </transition>
    </state>

    <!-- One recognition decision about one heard text. -->
    <state id="recognizing">
      <transition cond="addressed" target="listening">
        <log label="identity.heard" expr="addressedLog()"/>
        <send event="bot.ability.identity.addressed" target="#_parent">
          <param name="name" expr="name"/>
        </send>
      </transition>
      <transition target="listening">
        <log label="identity.heard" expr="'not addressed'"/>
      </transition>
    </state>
  </state>

  <!-- Take the selected name and write it down before answering to it
       (fail-closed: a name that could not be written down is not taken). -->
  <state id="adopting" initial="adopting_from">
    <state id="adopting_from">
      <transition cond="hasNoDatabase()" target="adopting_nothing"/>
      <transition target="adopting_memory"/>
    </state>
    <state id="adopting_nothing">
      <onentry>
        <log label="memory" expr="'absent'"/>
        <send event="bot.ability.identity.adopted" target="#_internal">
          <param name="name" expr="adoptedName()"/>
          <param name="persisted" expr="false"/>
        </send>
      </onentry>
    </state>
    <state id="adopting_memory">
      <onentry>
        <assign location="name_parameters" expr="nameInsertParameters()"/>
        <assign location="name_parameters" expr="nameInsertParametersCompleted()"/>
      </onentry>
      <invoke id="remember" type="scxml" src="../memory/memory.scx">
        <param name="database" expr="database"/>
        <param name="statements" expr="nameInsertStatements()"/>
      </invoke>
      <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json"
                  cond="isFromInvoke(_event, 'remember')">
        <send event="bot.ability.identity.adopted" target="#_internal">
          <param name="name" expr="adoptedName()"/>
          <param name="persisted" expr="true"/>
        </send>
      </transition>
      <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json"
                  cond="isFromInvoke(_event, 'remember')">
        <send event="bot.ability.identity.adopt.failed" target="#_internal">
          <param name="message" expr="adoptFailedMessage(_event)"/>
        </send>
      </transition>
    </state>
    <transition event="bot.ability.identity.adopted" event:schema="schemas/bot.ability.identity.adopted.json" target="knowing">
      <assign location="name" expr="_event.data.name.text"/>
      <log label="identity.name" expr="adoptedNameLog(_event)"/>
    </transition>
    <transition event="bot.ability.identity.adopt.failed" event:schema="schemas/bot.ability.identity.adopt.failed.json" target="knowing">
      <log label="identity.adopt.failed" expr="_event.data.message"/>
    </transition>
  </state>
</scxml>
