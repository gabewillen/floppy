<?xml version="1.0" encoding="UTF-8"?>
<!-- identity-4: a name that is only part of a word does not address it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:device="https://github.com/stateforward/floppy/namespaces/device" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="snapshot" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="identity" type="scxml" src="../../../identity.scx">
    <param name="name" expr='"Al"'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.communication.input" target="#_identity"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "always", "content_type": "text/plain"}'/></send>
      <send event="harness.waited" delay="500ms"/>
    </onentry>
    <transition event="harness.waited" target="step2"/>
  </state>
  <state id="step2" initial="step2_read">
    <onentry>
      <send event="harness.snapshot.deadline" id="step2_deadline" delay="30s"/>
    </onentry>
    <onexit><cancel sendid="step2_deadline"/></onexit>
    <transition event="harness.snapshot.deadline" target="fail"><log label="unexpected" expr="'snapshot ' + JSON.stringify(snapshot)"/></transition>
    <state id="step2_read">
      <onentry>
        <device:snapshot location="snapshot" target="'#_identity'"/>
      </onentry>
      <transition cond="snapshot.attributes.addressed === false" target="step3"/>
      <transition target="step2_again"/>
    </state>
    <state id="step2_again">
      <onentry><send event="harness.waited" delay="100ms"/></onentry>
      <transition event="harness.waited" target="step2_read"/>
    </state>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
