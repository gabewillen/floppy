<?xml version="1.0" encoding="UTF-8"?>
<!-- identity-7: input that arrives while adopting is heard with the adopted name. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="identity" type="scxml" src="../../../identity.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.identity.adopt" target="#_identity"><content expr='{"name": "Pip"}'/></send>
      <send event="bot.ability.communication.input" target="#_identity"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "Pip?", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.identity.named" cond="_event.data.name === 'Pip'" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <decision:offers location="offers" target="'#_identity'"/>
    </onentry>
    <transition cond="offers.length === 1 &amp;&amp; offers[0].event === 'bot.ability.identity.adopt' &amp;&amp; offers[0].effort === 1 &amp;&amp; offers[0].target === undefined &amp;&amp; offers[0].schema.required[0] === 'name' &amp;&amp; typeof offers[0].description === 'string'" target="step3"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step3">
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'bot.ability.identity.addressed' &amp;&amp; _event.data.stimulus.data.name === &quot;Pip&quot; &amp;&amp; _event.data.stimulus.source === 'identity'" target="step4"/>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
