<?xml version="1.0" encoding="UTF-8"?>
<!-- identity-5: with a database the adopted name is written down, then answered to; a second adoption replaces it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" xmlns:device="https://github.com/stateforward/floppy/namespaces/device" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
  <data id="snapshot" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <invoke id="identity" type="scxml" src="../../../identity.scx">
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.identity.adopt" target="#_identity"><content expr='{"name": "Floppy"}'/></send>
    </onentry>
    <transition event="bot.ability.identity.named" cond="_event.data.name === 'Floppy'" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <decision:offers location="offers" target="'#_identity'"/>
    </onentry>
    <transition cond="offers.length === 1 &amp;&amp; offers[0].event === 'bot.ability.identity.adopt' &amp;&amp; offers[0].effort === 1 &amp;&amp; offers[0].target === undefined &amp;&amp; offers[0].schema.required[0] === 'name' &amp;&amp; typeof offers[0].description === 'string'" target="step3"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step3">
    <onentry>
      <send event="bot.ability.identity.adopt" target="#_identity"><content expr='{"name": "Pip"}'/></send>
    </onentry>
    <transition event="bot.ability.identity.named" cond="_event.data.name === 'Pip'" target="step4"/>
  </state>
  <state id="step4">
    <onentry>
      <decision:offers location="offers" target="'#_identity'"/>
    </onentry>
    <transition cond="offers.length === 1 &amp;&amp; offers[0].event === 'bot.ability.identity.adopt' &amp;&amp; offers[0].effort === 1 &amp;&amp; offers[0].target === undefined &amp;&amp; offers[0].schema.required[0] === 'name' &amp;&amp; typeof offers[0].description === 'string'" target="step5"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step5">
    <onentry>
      <send event="bot.ability.communication.input" target="#_identity"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "Floppy?", "content_type": "text/plain"}'/></send>
      <send event="harness.waited" delay="500ms"/>
    </onentry>
    <transition event="harness.waited" target="step6"/>
  </state>
  <state id="step6" initial="step6_read">
    <onentry>
      <send event="harness.snapshot.deadline" id="step6_deadline" delay="30s"/>
    </onentry>
    <onexit><cancel sendid="step6_deadline"/></onexit>
    <transition event="harness.snapshot.deadline" target="fail"><log label="unexpected" expr="'snapshot ' + JSON.stringify(snapshot)"/></transition>
    <state id="step6_read">
      <onentry>
        <device:snapshot location="snapshot" target="'#_identity'"/>
      </onentry>
      <transition cond="snapshot.attributes.addressed === false" target="step7"/>
      <transition target="step6_again"/>
    </state>
    <state id="step6_again">
      <onentry><send event="harness.waited" delay="100ms"/></onentry>
      <transition event="harness.waited" target="step6_read"/>
    </state>
  </state>
  <state id="step7" initial="step7_read">
    <onentry>
      <send event="bot.ability.communication.input" target="#_identity"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "Pip?", "content_type": "text/plain"}'/></send>
      <send event="harness.snapshot.deadline" id="step7_deadline" delay="30s"/>
    </onentry>
    <onexit><cancel sendid="step7_deadline"/></onexit>
    <transition event="harness.snapshot.deadline" target="fail"><log label="unexpected" expr="'snapshot ' + JSON.stringify(snapshot)"/></transition>
    <state id="step7_read">
      <onentry>
        <device:snapshot location="snapshot" target="'#_identity'"/>
      </onentry>
      <transition cond="snapshot.attributes.addressed === true &amp;&amp; snapshot.attributes.name === &quot;Pip&quot; &amp;&amp; snapshot.state === 'listening'" target="step8"/>
      <transition target="step7_again"/>
    </state>
    <state id="step7_again">
      <onentry><send event="harness.waited" delay="100ms"/></onentry>
      <transition event="harness.waited" target="step7_read"/>
    </state>
  </state>
  <state id="step8">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
