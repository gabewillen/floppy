<?xml version="1.0" encoding="UTF-8"?>
<!-- identity-5: with a database the adopted name is written down, then answered to; a second adoption replaces it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="identity" type="scxml" src="../../../identity.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'identity' &amp;&amp; _event.data.choices.length === 1 &amp;&amp; _event.data.choices[0].event === 'bot.ability.identity.adopt' &amp;&amp; _event.data.choices[0].target === undefined &amp;&amp; _event.data.choices[0].schema.required[0] === 'name' &amp;&amp; _event.data.choices[0].schema.title === undefined &amp;&amp; _event.data.choices[0].schema['$schema'] === undefined &amp;&amp; _event.data.choices[0].schema.properties.reason.examples === undefined &amp;&amp; typeof _event.data.choices[0].description === 'string'" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.identity.adopt" target="#_identity"><content expr='{"name": "Floppy"}'/></send>
    </onentry>
    <transition event="bot.ability.identity.named" cond="_event.data.name === 'Floppy'" target="step2"/>
  </state>
  <state id="step2">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'identity' &amp;&amp; _event.data.choices.length === 1 &amp;&amp; _event.data.choices[0].event === 'bot.ability.identity.adopt' &amp;&amp; _event.data.choices[0].target === undefined &amp;&amp; _event.data.choices[0].schema.required[0] === 'name' &amp;&amp; _event.data.choices[0].schema.title === undefined &amp;&amp; _event.data.choices[0].schema['$schema'] === undefined &amp;&amp; _event.data.choices[0].schema.properties.reason.examples === undefined &amp;&amp; typeof _event.data.choices[0].description === 'string'" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="bot.ability.identity.adopt" target="#_identity"><content expr='{"name": "Pip"}'/></send>
    </onentry>
    <transition event="bot.ability.identity.named" cond="_event.data.name === 'Pip'" target="step4"/>
  </state>
  <state id="step4">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'identity' &amp;&amp; _event.data.choices.length === 1 &amp;&amp; _event.data.choices[0].event === 'bot.ability.identity.adopt' &amp;&amp; _event.data.choices[0].target === undefined &amp;&amp; _event.data.choices[0].schema.required[0] === 'name' &amp;&amp; _event.data.choices[0].schema.title === undefined &amp;&amp; _event.data.choices[0].schema['$schema'] === undefined &amp;&amp; _event.data.choices[0].schema.properties.reason.examples === undefined &amp;&amp; typeof _event.data.choices[0].description === 'string'" target="step5"/>
  </state>
  <state id="step5">
    <onentry>
      <send event="bot.ability.communication.input" target="#_identity"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "Floppy?", "content_type": "text/plain"}'/></send>
      <send event="harness.waited" delay="500ms"/>
    </onentry>
    <transition event="harness.waited" target="step6"/>
  </state>
  <state id="step6">
    <onentry>
      <send event="bot.ability.communication.input" target="#_identity"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "Pip?", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'bot.ability.identity.addressed' &amp;&amp; _event.data.stimulus.data.name === &quot;Pip&quot; &amp;&amp; _event.data.stimulus.source === 'identity'" target="step7"/>
  </state>
  <state id="step7">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
