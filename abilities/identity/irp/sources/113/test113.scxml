<?xml version="1.0" encoding="UTF-8"?>
<!-- identity-2: rows that do not decode as a name are skipped, so the name adopted before them is recalled. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="identity" type="scxml" src="../../../identity.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
    <param name="name_select" expr="&quot;SELECT content FROM (SELECT 1 AS n, '{\&quot;text\&quot;: \&quot;Pip\&quot;, \&quot;kind\&quot;: \&quot;fact\&quot;}' AS content UNION ALL SELECT 2, '{\&quot;text\&quot;: \&quot;' UNION ALL SELECT 3, '{\&quot;text\&quot;: \&quot;\&quot;, \&quot;kind\&quot;: \&quot;fact\&quot;}' UNION ALL SELECT 4, '{\&quot;text\&quot;: \&quot;Bo\&quot;, \&quot;kind\&quot;: \&quot;fact\&quot;, \&quot;reason\&quot;: \&quot;x\&quot;}') AS stored WHERE ?1 = 'self_name' AND ?2 = 'self' ORDER BY n&quot;"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.communication.input" target="#_identity"><content expr='{"source_ids": ["gabe"], "target_ids": ["floppy"], "content": "hey pip", "content_type": "text/plain"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'bot.ability.identity.addressed' &amp;&amp; _event.data.stimulus.data.name === &quot;Pip&quot; &amp;&amp; _event.data.stimulus.source === 'identity'" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
