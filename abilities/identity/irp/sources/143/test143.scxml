<?xml version="1.0" encoding="UTF-8"?>
<!-- identity-5: a name it cannot write down is not taken: the failure is answered and it offers again. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/nowhere/floppy.sqlite'"/>
  </invoke>
  <invoke id="identity" type="scxml" src="../../../identity.scx">
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
    <param name="bring_up_timeout_ms" expr="1500"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.failed" cond='_event.data.message === "Identity could not recall a name: memory did not answer within the bring-up budget."' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.ready" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.identity.adopt" target="#_identity"><content expr='{"name": "Pip"}'/></send>
    </onentry>
    <transition event="bot.ability.failed" cond="_event.data.message.indexOf('Identity could not remember the name it took: ') === 0" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <decision:offers location="offers" target="'#_identity'"/>
    </onentry>
    <transition cond="offers.length === 1 &amp;&amp; offers[0].event === 'bot.ability.identity.adopt' &amp;&amp; offers[0].effort === 1 &amp;&amp; offers[0].target === undefined &amp;&amp; offers[0].schema.required[0] === 'name' &amp;&amp; typeof offers[0].description === 'string'" target="step4"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step4">
    <onentry>
      <send event="bot.ability.identity.ask" target="#_identity"><content expr="{}"/></send>
    </onentry>
    <transition event="bot.ability.identity.named" cond="_event.data.name === null" target="step5"/>
  </state>
  <state id="step5">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
