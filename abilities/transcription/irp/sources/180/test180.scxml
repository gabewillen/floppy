<?xml version="1.0" encoding="UTF-8"?>
<!-- transcription-9: with provider live, what GPT-Live says goes to the parent as its copy, then its chunk. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="transcription" type="scxml" src="../../../transcription.scx">
    <param name="provider" expr="'live'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.listening.sensitivity.output" target="#_transcription"><content expr='{"sound": {"audio": "media/voiced.wav", "media_type": "audio/wav", "sample_rate_hz": 16000, "channels": 1}, "perceived_level_db": 10}'/></send>
    </onentry>
    <transition event="bot.ability.speaking.efference" cond="_event.data.mouth === 'live' &amp;&amp; _event.data.duration &gt; 0 &amp;&amp; _event.data.duration &lt;= 0.1 &amp;&amp; _event.data.sample_rate_hz === 16000" target="step2"/>
  </state>
  <state id="step2">
    <transition event="bot.ability.live.audio" cond="_event.data.audio === 'media/floppy-live.0.pcm' &amp;&amp; _event.data.sequence === 0 &amp;&amp; _event.data.duration === 0.1 &amp;&amp; _event.data.media_type === 'audio/pcm'" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.listening.transcription.turn"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
