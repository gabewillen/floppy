<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's VoiceDetection as the interpretation applies it (mosfet.py's
  VoiceDetection, which the interpretation holds for its lifetime): the
  sound normalized to PCM, then its voice spans. The interpretation
  (abilities/interpretation/interpretation.scx) invokes it once, as its
  long-lived child voice_detection, and sends it each sound to judge from
  DetectingVoice, FeedingSpeech and DetectingOwnVoice; the
  interpretation's stage timer bounds each request.

    idle -bot.ability.hearing.voice.detection.input-> detecting {
      normalizing -> applying } -> idle

  Configuration: the <param> model (the voice activity model; LocalAI's
  silero-vad by default).

  Requests: bot.ability.hearing.voice.detection.input {id, audio,
  media_type?, sample_rate_hz?, channels?, output?}: a reference to the
  sound's audio, as environment.sound carries it, the sound's format, and
  where the sound's PCM is written when it is a WAV container. The
  detection answers its parent with bot.ability.hearing.voice.detection.output
  {id, sound, segments} (the normalized sound fields and its clip-local
  voice spans, empty for no voice), or bot.ability.failed {id, message}
  when a step answers bot.ability.failed, answers something else, or
  cannot run. One sound is judged at a time; a request that arrives while
  one is in flight replaces it (leaving detecting cancels its service
  call, SCXML 6.4), because the interpretation is serial and has given up
  on the one it no longer waits for.

  normalizing: the speech service's normalize step (a WAV container's
  signed 16-bit PCM written to output; raw, audio/l16 or unnamed audio
  with a rate and channels is audio/pcm; anything else, or a container
  that cannot be read, is unchanged). Its done data is the sound as the
  rest of the interpretation reads it.

  applying: the speech service's detect operation on the sound as it
  arrived (a WAV container keeps its true rate; raw PCM is read in the
  sound's format, 16 kHz mono when it names none): LocalAI's
  POST {base}/vad, answered bot.ability.hearing.voice.detection.output
  {segments}.

  Presence: each request judges one clip and announces no start or end
  of voice across clips (the interpretation reads the segments only); the
  interpretation's own open-speech window (HearingSpeech) is that
  presence.

  Bindings: the speech service package; env scopes FLOPPY_VOICE_BASE_URL
  and FLOPPY_VOICE_API_KEY to the detect <invoke> (no default backend,
  decision D31: without a base URL the service answers bot.ability.failed,
  and without a key it asks a keyless backend with no key header, decision
  D127). The run grants the service the media directory (scx run's dir
  option). An invoked service's events are not checked against
  event:schema, so their shape is checked by cond.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="voice_detection" initial="idle">
  <datamodel>
    <!-- The invoker's <param>. -->
    <data id="model" expr="'silero-vad'"/>
    <!-- The request being judged, and its normalized sound. -->
    <data id="request" expr="null"/>
    <data id="sound" expr="null"/>
    <!-- The current service call's generated invoke ids: a cancelled call's
         late events (still delivered, SCXML 6.4) are not this request's. -->
    <data id="normalizer" expr="null"/>
    <data id="detector" expr="null"/>
  </datamodel>
  <script src="voice_detection.js"/>

  <state id="idle">
    <transition event="bot.ability.hearing.voice.detection.input"
                event:schema="../schemas/bot.ability.hearing.voice.detection.input.json" target="detecting">
      <assign location="request" expr="_event.data"/>
    </transition>
  </state>

  <!-- Any failure answers {id, message}. -->
  <state id="detecting" initial="normalizing">
    <onentry>
      <assign location="sound" expr="null"/>
    </onentry>
    <!-- A newer sound replaces this one. -->
    <transition event="bot.ability.hearing.voice.detection.input"
                event:schema="../schemas/bot.ability.hearing.voice.detection.input.json" target="detecting">
      <assign location="request" expr="_event.data"/>
    </transition>
    <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" cond="_event.invokeid === normalizer || _event.invokeid === detector" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <content expr="failedResult(_event)"/>
      </send>
    </transition>
    <transition event="error.*" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <content expr="errorResult(_event)"/>
      </send>
    </transition>

    <state id="normalizing">
      <invoke idlocation="normalizer" type="https://github.com/stateforward/floppy/services/speech">
        <param name="operation" expr="'normalize'"/>
        <param name="audio" expr="request.audio"/>
        <param name="media_type" expr="requested('media_type')"/>
        <param name="sample_rate_hz" expr="requested('sample_rate_hz')"/>
        <param name="channels" expr="requested('channels')"/>
        <param name="output" expr="requested('output')"/>
      </invoke>
      <transition event="done.invoke" cond="_event.invokeid === normalizer &amp;&amp; isNormalizedSound(_event)" target="applying">
        <assign location="sound" expr="_event.data"/>
      </transition>
      <transition event="done.invoke" cond="_event.invokeid === normalizer" target="idle">
        <send event="bot.ability.failed" target="#_parent">
          <content expr="unnormalizedResult()"/>
        </send>
      </transition>
    </state>

    <state id="applying">
      <invoke idlocation="detector" type="https://github.com/stateforward/floppy/services/speech"
              env:baseurl="FLOPPY_VOICE_BASE_URL" env:apikey="FLOPPY_VOICE_API_KEY">
        <param name="operation" expr="'detect'"/>
        <param name="model" expr="model"/>
        <param name="audio" expr="request.audio"/>
        <param name="media_type" expr="requested('media_type')"/>
        <param name="sample_rate_hz" expr="requested('sample_rate_hz')"/>
        <param name="channels" expr="requested('channels')"/>
      </invoke>
      <!-- A newer sound, before the catch-all below. -->
      <transition event="bot.ability.hearing.voice.detection.input"
                  event:schema="../schemas/bot.ability.hearing.voice.detection.input.json" target="detecting">
        <assign location="request" expr="_event.data"/>
      </transition>
      <transition event="bot.ability.hearing.voice.detection.output" event:schema="../schemas/bot.ability.hearing.voice.detection.output.json"
                  cond="_event.invokeid === detector &amp;&amp; hasSegments(_event)" target="idle">
        <send event="bot.ability.hearing.voice.detection.output" target="#_parent">
          <content expr="detectedResult(_event)"/>
        </send>
      </transition>
      <transition event="done.invoke" cond="_event.invokeid === detector" target="idle">
        <send event="bot.ability.failed" target="#_parent">
          <content expr="undetectedResult()"/>
        </send>
      </transition>
      <!-- Failures here, as in detecting, before the catch-all below. -->
      <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" cond="_event.invokeid === detector" target="idle">
        <send event="bot.ability.failed" target="#_parent">
          <content expr="failedResult(_event)"/>
        </send>
      </transition>
      <transition event="error.*" target="idle">
        <send event="bot.ability.failed" target="#_parent">
          <content expr="errorResult(_event)"/>
        </send>
      </transition>
      <!-- Anything else the detector sends. -->
      <transition event="*" cond="_event.invokeid === detector" target="idle">
        <send event="bot.ability.failed" target="#_parent">
          <content expr="mismatchedResult()"/>
        </send>
      </transition>
    </state>
  </state>
</scxml>
