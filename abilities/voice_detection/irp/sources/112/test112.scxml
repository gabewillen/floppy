<?xml version="1.0" encoding="UTF-8"?>
<!-- voice_detection-2: another media type is left unchanged and still detected. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="voice_detection" type="scxml" src="../../../voice_detection.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.hearing.voice.detection.input" target="#_voice_detection"><content expr="({id: &quot;r1&quot;, audio: 'media/sound.raw', media_type: 'audio/mpeg', output: 'media/sound.pcm'})"/></send>
    </onentry>
    <transition event="bot.ability.hearing.voice.detection.output" cond="_event.data.id === 'r1' &amp;&amp; Object.keys(_event.data).sort().join() === &quot;id,segments,sound&quot; &amp;&amp; JSON.stringify(_event.data.sound) === &quot;{\&quot;audio\&quot;:\&quot;media/sound.raw\&quot;,\&quot;channels\&quot;:null,\&quot;media_type\&quot;:\&quot;audio/mpeg\&quot;,\&quot;sample_rate_hz\&quot;:null}&quot; &amp;&amp; JSON.stringify(_event.data.segments) === &quot;[]&quot;" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
