<?xml version="1.0" encoding="UTF-8"?>
<!-- voice_detection-1: spans with start_seconds/end_seconds and a score are read too. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="voice_detection" type="scxml" src="../../../voice_detection.scx">
    <param name="audio" expr="'media/sound.wav'"/>
    <param name="media_type" expr="'audio/wav'"/>
    <param name="output" expr="'media/sound.pcm'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.voice_detection" cond='Object.keys(_event.data).sort().join() === "sound,voice_detection" &amp;&amp; JSON.stringify(_event.data.sound) === "{\"audio\":\"media/sound.pcm\",\"channels\":1,\"media_type\":\"audio/pcm\",\"sample_rate_hz\":8000}" &amp;&amp; JSON.stringify(_event.data.voice_detection) === "{\"segments\":[{\"confidence\":0.5,\"end_seconds\":0.75,\"start_seconds\":0.25}]}"' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
