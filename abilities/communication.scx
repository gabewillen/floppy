<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Communication ability (mosfet abilities/communication/
  communication.py): it holds the conversation, admits communication input
  into it, and says the response the cognition selects through Speaking.
  The body (bots/floppy/floppy.scx) invokes it as its child
  "communication".

    attached { inactive -children ready-> active
               active -respond-> preparing_response -> dispatching_response
                 -> responding -speaking output, failure or hop timeout->
                 active }

  Children: attached holds <invoke id="conversation"> (abilities/
  conversation.scx, the one active conversation) and <invoke
  id="speaking"> (abilities/speaking.scx, text mode). Each is ready with its
  first bot.ability.offers; inactive waits for both (mosfet attaches the
  conversation composite there). A child that cannot start, or ends, sends
  bot.ability.communication.failed {message} to the body and ends this
  ability in its final state degraded.

  Input: bot.ability.communication.input {source_ids, target_ids, content,
  content_type, ...} in active goes to the conversation as
  bot.ability.conversation.input (mosfet's routed input to the active
  conversation). The conversation answers every commit with
  bot.ability.conversation.output {parent, messages}; one whose last
  message is inbound is a conversation product and goes on to the body,
  which takes it as a turn's stimulus; the others are history only.

  Responding: bot.ability.communication.respond {text} (non-blank) in
  active numbers the response (preparing_response), sends
  bot.ability.speaking.input {text} to the speaking child
  (dispatching_response), and waits in responding, bounded by the hop
  timer bot.ability.communication.response.hop.timed_out
  (response_timeout_ms, mosfet's 6 s; the transition takes only the timer
  of the response in hand, _event.sendid). Speaking's output goes on to the
  body as bot.ability.speaking.output and is recorded in the conversation
  as an outbound bot.ability.conversation.append (mosfet's Speaking records
  it; here the communication does, since only it can reach the
  conversation). A speaking failure or the hop timeout answers the body
  with bot.ability.communication.failed {message}. Input and responses that
  arrive outside active wait in the data model queue, in order, and are
  taken on the return to active (mosfet defers them).

  Activate: bot.ability.communication.activate {} keeps the one
  conversation active (a catalog of conversations to switch between is
  loaded through memory, phase 3); it is taken and logged in inactive only,
  as mosfet's Communication takes it only there.

  Offers: every entry into active sends bot.ability.offers {ability:
  "communication", choices} to the body: <decision:choice events=
  "bot.ability.communication.respond"> (mosfet's enabled transitions in
  active; activate is enabled only in inactive, and input is not a tool
  event), compacted by <decision:compact>
  ($schema, title and examples dropped; over 32 KiB descriptions dropped
  too; still over, the offer is empty and logged). The children offer
  nothing, so nothing is relayed.

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline). scxml.rs checks them where each event is
  created: a send whose data a schema rejects is not routed and raises
  error.execution in its sender, so conds only correlate (which child,
  which timer) and keep mosfet's non-blank response check.

  Outbound record: <conversation:commit direction="outbound"> builds the
  spoken response's message (sequence 0: the conversation numbers it when
  it commits it), which the communication appends.

  Bindings: the decision and conversation namespace packages (no service,
  no I/O).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="communication" initial="attached">
  <datamodel>
    <data id="response_timeout_ms" expr="6000"/>
    <!-- The memory database file, for the conversation (null:
         no memory). -->
    <data id="database" expr="null"/>
    <data id="ready" expr="({})"/>
    <data id="queue" expr="[]"/>
    <!-- The response in hand: its number, words and hop timer. -->
    <data id="operation" expr="0"/>
    <data id="response" expr="null"/>
    <data id="hop_timer" expr="null"/>
    <data id="failure" expr="null"/>
    <!-- The offers. -->
    <data id="offering" expr="false"/>
    <data id="offered" expr="[]"/>
    <data id="offers_over" expr="false"/>
    <data id="offer_names" expr="''"/>
    <!-- The children, and the outbound record of a spoken response. -->
    <data id="children" expr="['conversation', 'speaking']"/>
    <data id="spoken" expr="null"/>
  </datamodel>

  <state id="attached" initial="inactive">
    <invoke id="conversation" type="scxml" src="conversation.scx">
      <param name="database" expr="database"/>
    </invoke>
    <invoke id="speaking" type="scxml" src="speaking.scx"/>

    <transition event="bot.ability.offers" event:schema="schemas/bot.ability.offers.json"
                cond="children.indexOf(_event.invokeid) &gt;= 0 &amp;&amp; _event.data.ability === _event.invokeid">
      <assign location="ready[_event.invokeid]" expr="true"/>
    </transition>
    <!-- Conversation products go on to the body; the rest is history. -->
    <transition event="bot.ability.conversation.output" event:schema="schemas/bot.ability.conversation.output.json"
                cond="_event.invokeid === 'conversation' &amp;&amp; _event.data.messages.length &gt; 0 &amp;&amp; _event.data.messages.slice(-1)[0].direction === 'inbound'">
      <log label="communication.product" expr="String(_event.data.messages[_event.data.messages.length - 1].sequence)"/>
      <send event="bot.ability.conversation.output" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
    <transition event="bot.ability.conversation.output" event:schema="schemas/bot.ability.conversation.output.json"
                cond="_event.invokeid === 'conversation'">
      <log label="communication.history" expr="String(_event.data.messages.length)"/>
    </transition>
    <!-- A conversation that could not take an input fails it (mosfet's
         conversation failed terminal). -->
    <transition event="bot.ability.conversation.failed" event:schema="schemas/bot.ability.conversation.failed.json"
                cond="_event.invokeid === 'conversation'">
      <log label="communication.rejected" expr="_event.data.stage + ': ' + _event.data.message"/>
      <send event="bot.ability.communication.failed" target="#_parent">
        <param name="message" expr="_event.data.message"/>
      </send>
    </transition>
    <!-- A child that cannot run, or ends, degrades the ability. -->
    <transition event="error.*" cond="children.indexOf(_event.invokeid) &gt;= 0" target="degraded">
      <assign location="failure" expr="'the ' + _event.invokeid + ' child could not run (' + _event.name + ')'"/>
    </transition>
    <transition event="done.invoke" cond="children.indexOf(_event.invokeid) &gt;= 0" target="degraded">
      <assign location="failure" expr="'the ' + _event.invokeid + ' child ended'"/>
    </transition>
    <!-- A speaking answer for no response in hand. -->
    <transition event="bot.ability.speaking.output bot.ability.speaking.apply.failed" cond="_event.invokeid === 'speaking'">
      <log label="communication.stale" expr="_event.name"/>
    </transition>

    <!-- Waits for the conversation and speaking. A child that cannot
         start raises its error with no invokeid (SCXML 6.4.2). -->
    <state id="inactive">
      <transition cond="ready.conversation === true &amp;&amp; ready.speaking === true" target="active"/>
      <transition event="error.*" target="degraded">
        <assign location="failure" expr="'a child could not start (' + _event.name + ')'"/>
      </transition>
      <transition event="bot.ability.communication.input bot.ability.communication.respond" cond="children.indexOf(_event.invokeid) &lt; 0">
        <assign location="queue" expr="queue.concat([{event: _event.name, data: _event.data}])"/>
        <log label="communication.deferred" expr="_event.name"/>
      </transition>
      <transition event="bot.ability.communication.activate" event:schema="schemas/bot.ability.communication.activate.json">
        <log label="communication.activate" expr="'conversation'"/>
      </transition>
    </state>

    <state id="active">
      <onentry>
        <assign location="offering" expr="true"/>
        <decision:choice location="offered" events="bot.ability.communication.respond"/>
        <assign location="offering" expr="false"/>
        <decision:compact location="offered" bound="32768" overlocation="offers_over"/>
        <if cond="offers_over">
          <log label="communication.offers.dropped" expr="'the offers are over 32768 bytes'"/>
        </if>
        <decision:names location="offer_names" choices="offered"/>
        <log label="communication.offers" expr="offer_names"/>
        <send event="bot.ability.offers" target="#_parent">
          <param name="ability" expr="'communication'"/>
          <param name="choices" expr="offered"/>
        </send>
      </onentry>
      <!-- What waited, in order, and checked as on arrival (mosfet
           re-dispatches a deferred event through the same guards). -->
      <transition cond="queue.length &gt; 0 &amp;&amp; queue[0].event === 'bot.ability.communication.input'">
        <send event="bot.ability.conversation.input" target="#_conversation">
          <content expr="queue.shift().data"/>
        </send>
      </transition>
      <transition cond="queue.length &gt; 0 &amp;&amp; queue[0].event === 'bot.ability.communication.respond' &amp;&amp; /\S/.test(queue[0].data.text)" target="preparing_response">
        <assign location="response" expr="queue.shift().data.text"/>
      </transition>
      <transition cond="queue.length &gt; 0 &amp;&amp; queue[0].event === 'bot.ability.communication.respond'">
        <assign location="queue" expr="queue.slice(1)"/>
        <log label="communication.rejected" expr="'bot.ability.communication.respond needs one non-blank text'"/>
        <send event="bot.ability.communication.failed" target="#_parent">
          <param name="message" expr="'Communication response text must be non-blank.'"/>
        </send>
      </transition>
      <transition event="bot.ability.communication.respond" event:schema="schemas/bot.ability.communication.respond.json"
                  cond="offering || (children.indexOf(_event.invokeid) &lt; 0 &amp;&amp; /\S/.test(_event.data.text))" target="preparing_response">
        <assign location="response" expr="_event.data.text"/>
      </transition>
      <transition event="bot.ability.communication.respond" event:schema="schemas/bot.ability.communication.respond.json"
                  cond="children.indexOf(_event.invokeid) &lt; 0">
        <log label="communication.rejected" expr="'bot.ability.communication.respond needs one non-blank text'"/>
        <send event="bot.ability.communication.failed" target="#_parent">
          <param name="message" expr="'Communication response text must be non-blank.'"/>
        </send>
      </transition>
      <transition event="bot.ability.communication.input" event:schema="schemas/bot.ability.communication.input.json"
                  cond="children.indexOf(_event.invokeid) &lt; 0">
        <send event="bot.ability.conversation.input" target="#_conversation">
          <content expr="_event.data"/>
        </send>
      </transition>
    </state>

    <!-- The response is numbered. -->
    <state id="preparing_response">
      <onentry>
        <assign location="operation" expr="operation + 1"/>
      </onentry>
      <transition target="dispatching_response"/>
    </state>

    <!-- The response goes to speaking. -->
    <state id="dispatching_response">
      <onentry>
        <send event="bot.ability.speaking.input" target="#_speaking">
          <param name="text" expr="response"/>
        </send>
      </onentry>
      <transition target="responding"/>
    </state>

    <!-- Waits (bounded) for speaking's answer. -->
    <state id="responding">
      <onentry>
        <send idlocation="hop_timer" event="bot.ability.communication.response.hop.timed_out" delayexpr="response_timeout_ms + 'ms'">
          <param name="operation" expr="operation"/>
        </send>
      </onentry>
      <onexit>
        <cancel sendidexpr="hop_timer"/>
      </onexit>
      <transition event="bot.ability.speaking.output" event:schema="schemas/bot.ability.speaking.output.json"
                  cond="_event.invokeid === 'speaking'" target="active">
        <send event="bot.ability.speaking.output" target="#_parent">
          <content expr="_event.data"/>
        </send>
        <conversation:commit location="spoken" direction="outbound" event="'bot.ability.conversation.append'"
                             message="({source_ids: [], target_ids: [], content: _event.data.text, content_type: 'text/plain'})"
                             provenance="({id: 'response-' + operation})" sequence="0"/>
        <send event="bot.ability.conversation.append" target="#_conversation">
          <param name="message" expr="spoken"/>
        </send>
      </transition>
      <transition event="bot.ability.speaking.apply.failed" event:schema="schemas/bot.ability.speaking.apply.failed.json"
                  cond="_event.invokeid === 'speaking'" target="active">
        <send event="bot.ability.communication.failed" target="#_parent">
          <param name="message" expr="_event.data.message"/>
        </send>
      </transition>
      <transition event="bot.ability.communication.response.hop.timed_out" event:schema="schemas/bot.ability.communication.response.hop.timed_out.json"
                  cond="_event.sendid === hop_timer &amp;&amp; _event.data.operation === operation" target="active">
        <log label="communication.hop.timed_out" expr="'response ' + operation + ' after ' + response_timeout_ms + ' ms'"/>
        <send event="bot.ability.communication.failed" target="#_parent">
          <param name="message" expr="'Speaking response timed out.'"/>
        </send>
      </transition>
      <transition event="bot.ability.communication.input bot.ability.communication.respond" cond="children.indexOf(_event.invokeid) &lt; 0">
        <assign location="queue" expr="queue.concat([{event: _event.name, data: _event.data}])"/>
        <log label="communication.deferred" expr="_event.name"/>
      </transition>
    </state>
  </state>

  <!-- A child could not run: the ability ends (the body degrades). -->
  <final id="degraded">
    <onentry>
      <log label="communication.degraded" expr="failure"/>
      <send event="bot.ability.communication.failed" target="#_parent">
        <param name="message" expr="failure"/>
      </send>
    </onentry>
  </final>
</scxml>
