<?xml version="1.0" encoding="UTF-8"?>
<!-- voice_diarization-2: raw PCM is read in the given format. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="voice_diarization" type="scxml" src="../../../voice_diarization.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.hearing.voice.diarization.input" target="#_voice_diarization"><content expr="({id: &quot;r1&quot;, audio: 'media/utterance.raw', sample_rate_hz: 8000, channels: 1, output: 'media/segment'})"/></send>
    </onentry>
    <transition event="bot.ability.hearing.voice.diarization.output" cond='_event.data.id === "r1" &amp;&amp; (function (_event) { return JSON.stringify(_event.data) === "{\"segments\":[{\"audio\":\"media/segment-0\",\"channels\":1,\"confidence\":null,\"end_seconds\":0.6,\"media_type\":\"audio/pcm\",\"sample_rate_hz\":8000,\"start_seconds\":0.2}]}"; })({name: _event.name, data: (function (data) { var copy = JSON.parse(JSON.stringify(data)); delete copy.id; return copy; })(_event.data)})' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
