<?xml version="1.0" encoding="UTF-8"?>
<!-- voice_diarization-2: raw PCM is read in the given format. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="voice_diarization" type="scxml" src="../../../voice_diarization.scx">
    <param name="audio" expr="'media/utterance.raw'"/>
    <param name="sample_rate_hz" expr="8000"/>
    <param name="channels" expr="1"/>
    <param name="output" expr="'media/segment'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.voice_diarization" cond='JSON.stringify(_event.data) === "{\"segments\":[{\"audio\":\"media/segment-0\",\"channels\":1,\"confidence\":null,\"end_seconds\":0.6,\"media_type\":\"audio/pcm\",\"sample_rate_hz\":8000,\"start_seconds\":0.2}]}"' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
