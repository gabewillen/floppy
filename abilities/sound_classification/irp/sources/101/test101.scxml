<?xml version="1.0" encoding="UTF-8"?>
<!-- sound_classification-1: with no kind, it is still answered at once, unlabeled. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="sound_classification" type="scxml" src="../../../sound_classification.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.hearing.sound.classification.input" target="#_sound_classification"><content expr="({id: &quot;r1&quot;, audio: 'media/bark.wav', media_type: 'audio/wav'})"/></send>
    </onentry>
    <transition event="bot.ability.hearing.sound.classification.output" cond="_event.data.id === &quot;r1&quot; &amp;&amp; (function (_event) { return _event.data.labels.length === 0 &amp;&amp; !('confidence' in _event.data); })({name: _event.name, data: (function (data) { var copy = JSON.parse(JSON.stringify(data)); delete copy.id; return copy; })(_event.data)})" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
