<?xml version="1.0" encoding="UTF-8"?>
<!-- sound_classification-3: a kind that is no string is unlabeled. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="sound_classification" type="scxml" src="../../../sound_classification.scx">
    <param name="audio" expr="'media/bark.wav'"/>
    <param name="media_type" expr="'audio/wav'"/>
    <param name="kind" expr="42"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.sound_classification" cond="_event.data.labels.length === 0 &amp;&amp; !('confidence' in _event.data)" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
