<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's SoundClassification: non-speech sound labelled from the sound's
  kind, with no model. The interpretation
  (abilities/interpretation/interpretation.scx) invokes it once, as its
  long-lived child sound_classification (mosfet.py's Interpretation holds
  its SoundClassification), and sends it each sound from ClassifyingSound.

    idle -bot.ability.hearing.sound.classification.input-> idle

  Requests: bot.ability.hearing.sound.classification.input {id, audio,
  media_type?, kind?}. Each is labelled at once and answered to the
  parent as bot.ability.hearing.sound.classification.output: a kind that
  is null or blank is unlabeled, {id, labels: []}; any other kind,
  trimmed, is the one label with confidence 1.0, {id, labels: [kind],
  confidence: 1.0}.

  Bindings: none (no service, no I/O).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="sound_classification" initial="idle">
  <datamodel>
    <!-- The label's confidence. -->
    <data id="confidence" expr="1.0"/>
  </datamodel>
  <script src="sound_classification.js"/>

  <state id="idle">
    <transition event="bot.ability.hearing.sound.classification.input"
                event:schema="../schemas/bot.ability.hearing.sound.classification.input.json">
      <send event="bot.ability.hearing.sound.classification.output" target="#_parent">
        <content expr="classifiedOutput(_event)"/>
      </send>
    </transition>
  </state>
</scxml>
