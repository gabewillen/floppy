<?xml version="1.0" encoding="UTF-8"?>
<!-- speaking-12: the progress counts the seconds played across the chunks, up to the whole reply. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="speaking" type="scxml" src="../../../speaking.scx">
    <param name="encoding_timeout_ms" expr="600000"/>
    <param name="provider" expr="null"/>
    <param name="model" expr="'tts-1'"/>
    <param name="voice" expr="'alloy'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.speaking.input" target="#_speaking"><content expr='{"parts": [{"words": "one two three four"}]}'/></send>
    </onentry>
    <transition event="bot.ability.speaking.progress" cond="_event.data.spoken_seconds === 0" target="step2"/>
  </state>
  <state id="step2">
    <transition event="bot.ability.speaking.progress" cond="_event.data.spoken_seconds === 0.5" target="step3"/>
  </state>
  <state id="step3">
    <transition event="bot.ability.speaking.progress" cond="_event.data.spoken_seconds === 1" target="step4"/>
  </state>
  <state id="step4">
    <transition event="bot.ability.speaking.progress" cond="_event.data.spoken_seconds === 1.5" target="step5"/>
  </state>
  <state id="step5">
    <transition event="bot.ability.speaking.progress" cond="_event.data.spoken_seconds === 2" target="step6"/>
  </state>
  <state id="step6">
    <transition event="bot.ability.speaking.output" cond="_event.data.text === &quot;one two three four&quot; &amp;&amp; _event.data.media_type === 'audio/pcm' &amp;&amp; _event.data.sample_rate_hz === 24000 &amp;&amp; _event.data.channels === 1 &amp;&amp; _event.data.spoken === &quot;one two three four&quot; &amp;&amp; _event.data.unspoken === &quot;&quot; &amp;&amp; _event.data.outcome === 'completed' &amp;&amp; _event.data.voice_id === null" target="step7"/>
  </state>
  <state id="step7">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.speaking.efference"/>
  <transition event="environment.sound"/>
  <transition event="bot.ability.conversation.append"/>
  <transition event="bot.ability.listening.enroll"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
