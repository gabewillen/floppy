<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Speaking ability (the reference abilities/speaking/speaking.py): it
  encodes text to speech, plays it out as environment.sound, and records
  the words in the conversation. The communication (abilities/
  communication/communication.scx) invokes it as its child "speaking" and routes each
  selected response to it. Cognition never selects it directly (the original:
  bot.ability.speaking.input is not offered).

    idle -bot.ability.speaking.input-> encoding -> playing -> recording
      -> idle

  encoding invokes the vocal SpeechEncoding (abilities/vocal/vocal.scx, its
  child "vocal", which invokes the speech service) and, once vocal is ready (its
  first bot.ability.offers), sends it bot.ability.vocal.speech.encoding.input
  {text}. The audio is written to output_prefix + operation + "." + the
  media subtype (a path in the media directory the run grants the speech
  service). Its bot.ability.vocal.speech.encoding.output is the encoded
  speech: the audio reference with its media_type, sample_rate_hz and
  channels (speaking's own, the original's 24000 Hz mono audio/pcm, where the
  encoder leaves one null), and its duration when the encoder measured one
  (the speech service measures it for linear PCM). Synthesis is bounded
  by encoding_timeout_ms, 30 s (decision D98: the original's 5 s is
  shorter than Gemini's unstreamed synthesis of a sentence, which answers
  only once the whole clip exists; 30 s is the original's stage operation
  timeout); leaving encoding cancels vocal and its request.

  playing issues the efference copy first (the original's entry action: the
  copy leaves before the sound does): bot.ability.speaking.efference
  {mouth, duration, media_type, sample_rate_hz, channels} to the parent,
  which carries it to the bot's Listening; mouth is the <data> mouth,
  "speaking", the sound's source (the original's source when no speaker is
  injected; devices are out of scope). As in the original, no copy is sent
  when the encoded form gives no duration. Then the words are logged as
  floppy.say and the audio is broadcast: environment.sound {audio,
  media_type, sample_rate_hz, channels, source} to the parent, which the
  body puts into the environment. source is the mouth (the original stamps
  it as the sound event's source; a relayed SCXML event keeps only its
  data, so it travels in the sound): it is how the listening's sensitivity
  tells the bot's own voice from a sound that only arrives while it speaks.

  recording builds the outbound message with <conversation:commit>
  (the original's Message: direction outbound, content the text, content_type
  text/plain; sequence 0, the conversation numbers it) and sends
  bot.ability.conversation.append {message} to the parent, which holds the
  conversation (a sibling is out of a child's reach: SCXML sends go only to
  #_parent and to a session's own children). It is bounded by the original's 5 s
  (recording_timeout_ms). Then it answers the parent with
  bot.ability.speaking.output {text, media_type, sample_rate_hz, channels}.

  Failures: a vocal failure (its bot.ability.failed), an encoding or
  recording timeout, or a vocal that cannot run answers the parent with
  bot.ability.failed {message} (the original's terminal failure, FailureData)
  and returns to idle. Timers are bot.ability.speaking.apply.failed
  {message} sends (the original's own failure event), taken only by the timer
  in hand (_event.sendid). Input
  that arrives outside idle is held by <event:defer/> (scxml.rs
  namespaces/event; the original defers it in encoding, playing and recording)
  and is taken, in order, on the return to idle.

  Contracts: the input's contract is schemas/bot.ability.speaking.input.json:
  a send whose data it rejects is never routed here and raises
  error.execution in the sender (scxml.rs session.accepts-event-data).
  vocal's events are checked where vocal creates them.

  Readiness: every entry into idle sends bot.ability.offers {ability:
  "speaking", choices: []} to the parent; it offers nothing.

  Bindings: the conversation namespace package; vocal's speech service.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:conversation="https://github.com/stateforward/floppy/namespaces/conversation"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="speaking" initial="idle">
  <datamodel>
    <!-- Configuration (the original's Speaking defaults and bounds). -->
    <data id="sample_rate_hz" expr="24000"/>
    <data id="channels" expr="1"/>
    <data id="media_type" expr="'audio/pcm'"/>
    <!-- The speech provider, model and voice vocal asks the speech
         service for: the original's speech encoder defaults (its gemini
         provider). -->
    <data id="provider" expr="'gemini'"/>
    <data id="model" expr="'gemini-3.1-flash-tts-preview'"/>
    <data id="voice" expr="'Kore'"/>
    <data id="output_prefix" expr="'media/speaking-'"/>
    <!-- The mouth: the efference copy's mouth and the sound's source, so
         the listening can tell its own voice apart. -->
    <data id="mouth" expr="'speaking'"/>
    <data id="encoding_timeout_ms" expr="30000"/>
    <data id="recording_timeout_ms" expr="5000"/>
    <!-- The utterance in hand, its number, the encoded speech and timer. -->
    <data id="operation" expr="0"/>
    <data id="text" expr="null"/>
    <data id="encoded" expr="null"/>
    <data id="product" expr="null"/>
    <data id="message" expr="null"/>
    <data id="timer" expr="null"/>
  </datamodel>
  <script src="speaking.js"/>

  <state id="idle">
    <onentry>
      <send event="bot.ability.offers" target="#_parent">
        <param name="ability" expr="'speaking'"/>
        <param name="choices" expr="[]"/>
      </send>
    </onentry>
    <transition event="bot.ability.speaking.input" event:schema="schemas/bot.ability.speaking.input.json"
                target="encoding">
      <assign location="text" expr="spokenText(_event.data.text)"/>
    </transition>
  </state>

  <!-- Synthesis: no sound exists yet. -->
  <state id="encoding">
    <onentry>
      <assign location="operation" expr="nextOperation()"/>
      <send idlocation="timer" event="bot.ability.speaking.apply.failed" delayexpr="delay(encoding_timeout_ms)">
        <param name="message" expr="'Speech encoding timed out.'"/>
      </send>
    </onentry>
    <onexit>
      <cancel sendidexpr="timer"/>
    </onexit>
    <!-- The original speaks the stripped text and refuses a blank one. -->
    <transition cond="isBlankText()" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="'Speaking requires non-blank text.'"/>
      </send>
    </transition>
    <invoke id="vocal" type="scxml" src="../vocal/vocal.scx">
      <param name="output" expr="outputPath()"/>
      <param name="provider" expr="provider"/>
      <param name="model" expr="model"/>
      <param name="voice" expr="voice"/>
      <param name="media_type" expr="media_type"/>
    </invoke>
    <transition event="bot.ability.offers" event:schema="schemas/bot.ability.offers.json">
      <send event="bot.ability.vocal.speech.encoding.input" target="#_vocal">
        <param name="text" expr="text"/>
      </send>
    </transition>
    <transition event="bot.ability.vocal.speech.encoding.output" event:schema="schemas/bot.ability.vocal.speech.encoding.output.json" target="playing">
      <assign location="encoded" expr="encodedSpeech(_event)"/>
      <assign location="encoded.sample_rate_hz" expr="encodedSampleRate()"/>
      <assign location="encoded.channels" expr="encodedChannels()"/>
      <assign location="encoded.media_type" expr="encodedMediaType()"/>
    </transition>
    <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json" target="idle">
      <assign location="message" expr="_event.data.message"/>
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="message"/>
      </send>
    </transition>
    <transition event="bot.ability.speaking.apply.failed" event:schema="schemas/bot.ability.speaking.apply.failed.json"
                cond="isTimer(_event)" target="idle">
      <log label="speaking.timed_out" expr="encodingTimedOutLog()"/>
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="_event.data.message"/>
      </send>
    </transition>
    <transition event="error.* done.invoke.vocal" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="encodingRunFailure(_event)"/>
      </send>
    </transition>
    <!-- Input that arrives meanwhile waits (the original defers it). -->
    <transition event="bot.ability.speaking.input" event:schema="schemas/bot.ability.speaking.input.json">
      <event:defer/>
      <log label="speaking.deferred" expr="_event.name"/>
    </transition>
  </state>

  <!-- Playout: the copy leaves before the sound does. -->
  <state id="playing">
    <onentry>
      <if cond="hasDuration()">
        <send event="bot.ability.speaking.efference" target="#_parent">
          <param name="mouth" expr="mouth"/>
          <param name="duration" expr="encoded.duration"/>
          <param name="media_type" expr="encoded.media_type"/>
          <param name="sample_rate_hz" expr="encoded.sample_rate_hz"/>
          <param name="channels" expr="encoded.channels"/>
        </send>
      </if>
      <log label="floppy.say" expr="text"/>
      <send event="environment.sound" target="#_parent">
        <param name="audio" expr="encoded.audio"/>
        <param name="media_type" expr="encoded.media_type"/>
        <param name="sample_rate_hz" expr="encoded.sample_rate_hz"/>
        <param name="channels" expr="encoded.channels"/>
        <param name="source" expr="mouth"/>
      </send>
      <assign location="product" expr="speechProduct()"/>
      <raise event="bot.ability.speaking.apply.completed"/>
    </onentry>
    <transition event="bot.ability.speaking.apply.completed" target="recording"/>
    <transition event="error.*" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="playoutFailure(_event)"/>
      </send>
    </transition>
    <!-- Input still waits (the original defers it here too); it was logged
         when it arrived. -->
    <transition event="bot.ability.speaking.input" event:schema="schemas/bot.ability.speaking.input.json">
      <event:defer/>
    </transition>
  </state>

  <!-- The words go into the conversation's history. -->
  <state id="recording">
    <onentry>
      <send idlocation="timer" event="bot.ability.speaking.apply.failed" delayexpr="delay(recording_timeout_ms)">
        <param name="message" expr="'Conversation history recording timed out.'"/>
      </send>
      <conversation:commit location="message" direction="outbound" event="'bot.ability.conversation.append'"
                           message="({source_ids: [], target_ids: [], content: text, content_type: 'text/plain'})"
                           provenance="({id: 'speaking-' + operation})" sequence="0"/>
      <send event="bot.ability.conversation.append" target="#_parent">
        <param name="message" expr="message"/>
      </send>
      <raise event="bot.ability.speaking.conversation.recorded"/>
    </onentry>
    <onexit>
      <cancel sendidexpr="timer"/>
    </onexit>
    <transition event="bot.ability.speaking.conversation.recorded" target="idle">
      <send event="bot.ability.speaking.output" target="#_parent">
        <content expr="product"/>
      </send>
    </transition>
    <transition event="bot.ability.speaking.apply.failed" event:schema="schemas/bot.ability.speaking.apply.failed.json"
                cond="isTimer(_event)" target="idle">
      <log label="speaking.timed_out" expr="recordingTimedOutLog()"/>
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="_event.data.message"/>
      </send>
    </transition>
    <transition event="error.*" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="recordingFailure(_event)"/>
      </send>
    </transition>
    <!-- Input still waits (the original defers it here too); it was logged
         when it arrived. -->
    <transition event="bot.ability.speaking.input" event:schema="schemas/bot.ability.speaking.input.json">
      <event:defer/>
    </transition>
  </state>
</scxml>
