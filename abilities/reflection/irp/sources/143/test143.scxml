<?xml version="1.0" encoding="UTF-8"?>
<!-- reflection-5: a change of a behavior that declined the turn is refused, and refused again fails the select. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <invoke id="reflection" type="scxml" src="../../../reflection.scx">
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
    <param name="select_timeout_ms" expr="300000"/>
    <param name="revising_timeout_ms" expr="300000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.reflection.input" target="#_reflection"><content expr='{"turn": 1, "cognition_input": {"stimulus": {"event": "environment.sound", "data": {"label": "knock"}}, "focus": "door", "focus_candidates": ["door"]}, "cognition_output": [{"event": "bot.ability.communication.respond", "data": {"parts": [{"words": "Hello!"}]}, "reason": "a knock", "target": "communication"}]}'/></send>
    </onentry>
    <transition event="bot.ability.reflection.output" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.reflection.input" target="#_reflection"><content expr='{"turn": 2, "cognition_input": {"stimulus": {"event": "environment.sound", "data": {"label": "knock"}}, "focus": "door", "focus_candidates": ["door"]}, "cognition_output": [{"event": "bot.ability.communication.respond", "data": {"parts": [{"words": "Hello!"}]}, "reason": "a knock", "target": "communication"}]}'/></send>
    </onentry>
    <transition event="bot.ability.reflection.output" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.reflection.input" target="#_reflection"><content expr='{"turn": 3, "cognition_input": {"stimulus": {"event": "environment.sound", "data": {"label": "knock"}}, "focus": "door", "focus_candidates": ["door"]}, "cognition_output": [{"event": "bot.ability.communication.respond", "data": {"parts": [{"words": "Hello!"}]}, "reason": "a knock", "target": "communication"}], "declined": ["GreetOnKnock"]}'/></send>
    </onentry>
    <transition event="bot.ability.failed" cond='_event.data.message === "Selection rejected: bot.behavior.change may not name GreetOnKnock: it rightly declined this turn"' target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
