<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Routines ability (mosfet abilities/cognition/routines.py): it
  keeps the ACTIVE persistent routines of behavior inventory running and
  forwards their ticks. The cognition (abilities/cognition.scx) invokes it
  as its long-lived child "routines" when its routines gate is on, with the
  database path as <param name="memory">.

    active { inventory { reconciling { recalling } -> running
                         -bot.ability.routines.reconcile-> reconciling },
             chain { chain_off | chain_on } }

  Reconciling (mosfet _reconcile_activity): with no memory (null) it
  logs <log label="routines" expr="'absent'"> and runs nothing. Otherwise
  it selects, through the Memory ability (abilities/memory.scx), the
  ACTIVE persistent bot_behavior rows in inventory order (mosfet
  select_active_behaviors_clauses(lifetime=persistent)) and raises
  bot.ability.routines.reconciled {running}; when the rows' names or
  sources (mosfet inventory.revision) differ from the running set, the
  chain restarts on them: the routines that are gone or no longer ACTIVE
  stop, the changed ones restart and the new ones start. A recall that
  fails is logged as bot.ability.routines.reconcile.failed and keeps the
  running set (mosfet: "persistent routines kept their running set"). A
  reconcile that arrives while reconciling re-enters it, which cancels the
  recall in hand and reads the inventory again (mosfet defers it to the
  same effect).

  Chain: SCXML holds a fixed set of invokes per state, so the routines run
  as a chain of runners (abilities/routines_runner.scx): chain_on invokes
  the first runner with the running set, and re-entering it (cancelling
  the runner, SCXML 6.4) restarts the chain.

  Ticks: each bot.behavior.tick the chain passes up goes to the cognition
  (#_parent), which hands it to the body as a stimulus: a new turn the bot
  decides on (mosfet _forward_tick).

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline).

  Bindings: the Memory ability's sql service, with its directory granted by
  the run (scx run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="routines" initial="active">
  <datamodel>
    <!-- The memory database path (the cognition's memory), or null. -->
    <data id="memory" expr="null"/>
    <!-- mosfet select_active_behaviors_clauses: the rows as one JSON array. -->
    <data id="select_routines">SELECT json_group_array(json_object('name', name, 'source', source)) FROM (SELECT name, source FROM bot_behavior WHERE status = ? AND lifetime = ? ORDER BY name)</data>
    <!-- The rows the last recall selected, and the ones the chain runs. -->
    <data id="desired" expr="[]"/>
    <data id="routines" expr="[]"/>
    <data id="restart" expr="false"/>
  </datamodel>

  <parallel id="active">
    <state id="inventory" initial="reconciling">
      <transition event="bot.ability.routines.reconcile" event:schema="schemas/bot.ability.routines.reconcile.json"
                  type="internal" target="reconciling"/>

      <state id="reconciling" initial="recalling">
        <transition cond="memory === null" target="running">
          <log label="routines" expr="'absent'"/>
        </transition>

        <!-- One read of behavior inventory. -->
        <state id="recalling">
          <invoke id="recall" type="scxml" src="memory.scx">
            <param name="database" expr="memory"/>
            <param name="statements" expr="[{sql: select_routines, parameters: ['ACTIVE', 'persistent']}]"/>
          </invoke>
          <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json"
                      cond="_event.invokeid === 'recall'">
            <assign location="desired" expr="JSON.parse(_event.data.results[0].rows[0].values[0])"/>
          </transition>
          <transition event="done.invoke.recall" target="running">
            <assign location="restart" expr="JSON.stringify(desired) !== JSON.stringify(routines)"/>
            <assign location="routines" expr="desired"/>
            <raise event="bot.ability.routines.reconciled"/>
          </transition>
          <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json"
                      cond="_event.invokeid === 'recall'" target="running">
            <log label="bot.ability.routines.reconcile.failed" expr="'Routine inventory load failed: ' + _event.data.message"/>
          </transition>
          <transition event="error.*" target="running">
            <log label="bot.ability.routines.reconcile.failed" expr="'Routine inventory load failed: ' + _event.name"/>
          </transition>
        </state>
      </state>

      <state id="running"/>
    </state>

    <!-- The running set, as a chain of runners. -->
    <state id="chain" initial="chain_off">
      <transition event="bot.ability.routines.reconciled" cond="restart &amp;&amp; routines.length &gt; 0"
                  type="internal" target="chain_on">
        <log label="bot.ability.routines.reconciled" expr="routines.map(r =&gt; r.name).join(' ')"/>
      </transition>
      <transition event="bot.ability.routines.reconciled" cond="restart" type="internal" target="chain_off">
        <log label="bot.ability.routines.reconciled" expr="''"/>
      </transition>

      <state id="chain_off"/>
      <state id="chain_on">
        <invoke id="runner" type="scxml" src="routines_runner.scx">
          <param name="routines" expr="routines"/>
        </invoke>
        <transition event="bot.behavior.tick" event:schema="schemas/bot.behavior.tick.json"
                    cond="_event.invokeid === 'runner'">
          <send event="bot.behavior.tick" target="#_parent">
            <content expr="_event.data"/>
          </send>
        </transition>
        <transition event="error.*" cond="_event.invokeid === 'runner'" target="chain_off">
          <log label="routines.failed" expr="_event.name"/>
        </transition>
      </state>
    </state>
  </parallel>
</scxml>
