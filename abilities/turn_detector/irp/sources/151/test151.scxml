<?xml version="1.0" encoding="UTF-8"?>
<!-- turn_detector-6: a turn with both text and audio fails. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="turn_detector" type="scxml" src="../../../turn_detector.scx">
    <param name="end_of_turn_silence_seconds" expr="60"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.turn_detector.ready" cond='JSON.stringify(_event.data.participant_ref) === "\"bot\"" &amp;&amp; JSON.stringify(_event.data.conversation_ref) === "\"conversation\"" &amp;&amp; Object.keys(_event.data).length === 2' target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.turn_detector.turn.start" target="#_turn_detector"><content expr='{"turn_ref": "t2", "source_participant_ref": "alice", "content": {"kind": "text", "source_participant_ref": "alice", "content": "hi"}}'/></send>
      <send event="bot.ability.turn_detector.turn.end" target="#_turn_detector"><content expr='{"turn_ref": "t2", "source_participant_ref": "alice", "content": {"kind": "audio", "source_participant_ref": "alice", "content": "media/a.pcm"}}'/></send>
    </onentry>
    <transition event="bot.ability.turn_detector.failed" cond='JSON.stringify(_event.data.stage) === "\"turn\"" &amp;&amp; JSON.stringify(_event.data.message) === "\"Turn product cannot contain both text and audio.\"" &amp;&amp; JSON.stringify(_event.data.participant_ref) === "\"bot\"" &amp;&amp; JSON.stringify(_event.data.conversation_ref) === "\"conversation\"" &amp;&amp; JSON.stringify(_event.data.turn_ref) === "\"t2\"" &amp;&amp; JSON.stringify(_event.data.source_participant_ref) === "\"alice\""' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
