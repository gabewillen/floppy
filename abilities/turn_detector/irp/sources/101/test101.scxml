<?xml version="1.0" encoding="UTF-8"?>
<!-- turn_detector-1: its params are the identities it announces, and it is not done. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="turn_detector" type="scxml" src="../../../turn_detector.scx">
    <param name="participant_ref" expr="'agent'"/>
    <param name="conversation_ref" expr="'support-call'"/>
    <param name="end_of_turn_silence_seconds" expr="60"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.turn_detector.ready" cond='JSON.stringify(_event.data.participant_ref) === "\"agent\"" &amp;&amp; JSON.stringify(_event.data.conversation_ref) === "\"support-call\"" &amp;&amp; Object.keys(_event.data).length === 2' target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="harness.waited" delay="1s"/>
    </onentry>
    <transition event="harness.waited" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
