{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.turn_detector.turn.update",
  "description": "Incremental turn content accepted while a participant is open.",
  "examples": [
    {
      "content": {
        "content": "world",
        "kind": "text",
        "source_participant_ref": "caller"
      },
      "conversation_ref": "support-call",
      "source_participant_ref": "caller",
      "turn_ref": "turn-1"
    }
  ],
  "properties": {
    "conversation_ref": {
      "default": "conversation",
      "examples": [
        "support-call"
      ],
      "minLength": 1,
      "title": "Conversation Ref",
      "type": "string"
    },
    "turn_ref": {
      "description": "Stable reference for the active turn.",
      "minLength": 1,
      "title": "Turn Ref",
      "type": "string"
    },
    "source_participant_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      ],
      "default": "caller",
      "examples": [
        "caller"
      ],
      "title": "Source Participant Ref"
    },
    "content": {
      "anyOf": [
        {
          "description": "Text content produced by a participant.",
          "properties": {
            "kind": {
              "const": "text",
              "default": "text",
              "title": "Kind",
              "type": "string"
            },
            "source_participant_ref": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                }
              ],
              "description": "Participant that produced the text.",
              "title": "Source Participant Ref"
            },
            "content": {
              "description": "Readable text content.",
              "minLength": 1,
              "title": "Content",
              "type": "string"
            }
          },
          "required": [
            "source_participant_ref",
            "content"
          ],
          "title": "TextStimulus",
          "type": "object"
        },
        {
          "description": "Audio content produced by a participant.",
          "examples": [
            {
              "channels": 1,
              "content": "media/audio-1",
              "kind": "audio",
              "sample_rate_hz": 16000,
              "source_participant_ref": "caller"
            }
          ],
          "properties": {
            "kind": {
              "const": "audio",
              "default": "audio",
              "title": "Kind",
              "type": "string"
            },
            "source_participant_ref": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                }
              ],
              "description": "Participant that produced the audio.",
              "title": "Source Participant Ref"
            },
            "content": {
              "description": "Reference (a URI reference) to this chunk's audio; floppy passes media by reference, never as bytes [floppy field].",
              "format": "uri-reference",
              "title": "Content",
              "type": "string"
            },
            "sample_rate_hz": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Sample rate of raw PCM content in hertz. Required for correct STT packaging when content is not a WAV container.",
              "examples": [
                16000,
                48000
              ],
              "title": "Sample Rate Hz"
            },
            "channels": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Channel count of raw PCM content. Defaults to mono when omitted at the decoder.",
              "examples": [
                1
              ],
              "title": "Channels"
            }
          },
          "required": [
            "source_participant_ref",
            "content"
          ],
          "title": "AudioStimulus",
          "type": "object"
        }
      ],
      "description": "Incremental text or audio chunk.",
      "title": "Content"
    }
  },
  "required": [
    "turn_ref",
    "content"
  ],
  "type": "object"
}
