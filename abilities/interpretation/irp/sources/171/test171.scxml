<?xml version="1.0" encoding="UTF-8"?>
<!-- interpretation-8: a voiced sound with no sample rate cannot be identified. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="interpretation" type="scxml" src="../../../interpretation.scx">
    <param name="stage_timeout_ms" expr="600000"/>
    <param name="diarizer" expr="false"/>
    <param name="voice_classifier" expr="true"/>
    <param name="affect_classifier" expr="false"/>
    <param name="speech_decoder" expr="false"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.listening.sensitivity.output" target="#_interpretation"><content expr='{"sound": {"audio": "media/voiced.pcm", "media_type": "audio/pcm"}, "parent": {"event": "environment.sound", "data": {"audio": "media/voiced.pcm", "media_type": "audio/pcm"}}, "perceived_level_db": null}'/></send>
    </onentry>
    <transition event="bot.ability.listening.failed" cond='_event.data.stage === "voice_identification" &amp;&amp; _event.data.message === "Voice identification opening segment conversion failed: voice identification requires audio/pcm with sample rate and channels."' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
