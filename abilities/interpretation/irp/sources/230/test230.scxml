<?xml version="1.0" encoding="UTF-8"?>
<!-- interpretation-14: the bot's own voice is learned from speaking's copy and answered with its id. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="interpretation" type="scxml" src="../../../interpretation.scx">
    <param name="stage_timeout_ms" expr="600000"/>
    <param name="diarizer" expr="true"/>
    <param name="voice_classifier" expr="true"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.listening.enroll" target="#_interpretation"><content expr='{"voice_id": null, "segment": {"audio": "media/voiced.pcm", "media_type": "audio/pcm", "sample_rate_hz": 16000, "channels": 1, "start_seconds": 0.0, "end_seconds": 0.1}}'/></send>
    </onentry>
    <transition event="bot.ability.listening.enrolled" cond="_event.data.voice_id === 'self'" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
