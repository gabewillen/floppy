<?xml version="1.0" encoding="UTF-8"?>
<!-- interpretation-9: speech with no sample rate is decoded and then cannot be placed on a timeline. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="interpretation" type="scxml" src="../../../interpretation.scx">
    <param name="stage_timeout_ms" expr="600000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'interpretation' &amp;&amp; _event.data.choices.length === 0" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.listening.sensitivity.output" target="#_interpretation"><content expr='{"sound": {"audio": "media/voiced.pcm"}, "parent": {"event": "environment.sound", "data": {"audio": "media/voiced.pcm"}}, "perceived_level_db": null}'/></send>
      <send event="bot.ability.listening.sensitivity.output" target="#_interpretation"><content expr='{"sound": {"audio": "media/silence.pcm"}, "parent": {"event": "environment.sound", "data": {"audio": "media/silence.pcm"}}, "perceived_level_db": null}'/></send>
    </onentry>
    <transition event="bot.ability.listening.failed" cond='_event.data.stage === "speech_decoding" &amp;&amp; _event.data.message === "Speech decoding completed on sound with no sample rate to place it on a timeline."' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
