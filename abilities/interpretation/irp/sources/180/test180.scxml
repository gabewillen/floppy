<?xml version="1.0" encoding="UTF-8"?>
<!-- interpretation-9: audio that cannot be read fails voice detection; the next sound is interpreted. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="interpretation" type="scxml" src="../../../interpretation.scx">
    <param name="stage_timeout_ms" expr="600000"/>
    <param name="diarizer" expr="false"/>
    <param name="voice_classifier" expr="false"/>
    <param name="affect_classifier" expr="false"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.listening.sensitivity.output" target="#_interpretation"><content expr='{"sound": {"audio": "media/missing.wav", "media_type": "audio/wav", "sample_rate_hz": 16000, "channels": 1}, "parent": {"event": "environment.sound", "data": {"audio": "media/missing.wav", "media_type": "audio/wav", "sample_rate_hz": 16000, "channels": 1}}, "perceived_level_db": null}'/></send>
    </onentry>
    <transition event="bot.ability.listening.failed" cond="_event.data.stage === &quot;voice_detection&quot; &amp;&amp; typeof _event.data.message === 'string' &amp;&amp; _event.data.message.endsWith(&quot;failed: the audio cannot be read.&quot;)" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.listening.sensitivity.output" target="#_interpretation"><content expr='{"sound": {"audio": "media/ring.wav", "media_type": "audio/wav", "sample_rate_hz": 16000, "channels": 1, "kind": "knock"}, "parent": {"event": "environment.sound", "data": {"audio": "media/ring.wav", "media_type": "audio/wav", "sample_rate_hz": 16000, "channels": 1, "kind": "knock"}}, "perceived_level_db": null}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'environment.sound' &amp;&amp; _event.data.stimulus.source === 'listening' &amp;&amp; _event.data.stimulus.data.kind === 'knock'" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
