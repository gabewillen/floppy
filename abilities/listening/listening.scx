<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Listening ability: the ear. It hears an environment.sound,
  scores it against what the body predicted, and hands it on to be
  interpreted. The body
  (bots/floppy/floppy.scx) invokes it as its child "listening", one of its
  input abilities.

    live { initializing -children ready-> Perceiving {
             Listening -environment.sound-> Sensing
             Sensing -sensitivity output or failure-> Listening } }

  Children: live holds <invoke id="sensitivity">
  (abilities/sensitivity/sensitivity.scx, the body's prediction),
  <invoke id="interpretation">
  (abilities/interpretation/interpretation.scx, the slow half) and
  <invoke id="transcription"> (abilities/transcription/transcription.scx,
  the streaming hearing path, mosfet.py's Transcription; the <data>
  streams, true, is its <param> enabled). Each is ready when it
  sends bot.ability.ready; the transcription is ready when its streaming
  session is, and also when it ends (it had no session to hear through,
  or streams is false). initializing waits for all three.
  The sensitivity or the interpretation that cannot start, or ends, ends
  this ability in its final state degraded (the body then degrades the
  bot); the transcription's end only stops it streaming.

  Sensing: environment.sound {audio, ...} from the body goes to the
  sensitivity as bot.ability.listening.sensitivity.score {stimulus} (the
  sound's envelope {event, data, source}: source is the sound's own, the
  transducer it came off, and absent when it names none), bounded by a 30 s stage
  operation timeout (sensitivity_timeout_ms): the sensitivity's
  bot.ability.listening.sensitivity.output goes on to the transcription
  while it streams (transcribing: its session was ready and it has not
  ended), else to the interpretation, and Sensing returns to Listening; the timer,
  bot.ability.listening.sensitivity.failed {stage: "sensitivity",
  message: "Listening sensitivity timed out."} sent to this session with
  that delay, answers the body with bot.ability.listening.failed. Sounds
  that arrive outside Listening are held by <event:defer/> (scxml.rs
  namespaces/event) and taken by Listening, in order:
  scoring is the only stop between the ear and the prediction.

  Turns: the transcription's bot.ability.listening.transcription.turn
  (a turn its session heard end, with its words and sounds) goes to the
  interpretation, which identifies who spoke and hears its tone, and
  hands on its words as speech.

  Products: the interpretation's bot.ability.listening.speech.output
  (decoded speech, diarized or identified voice
  segments, or the PCM of an acoustic observation) is handed to the body
  as bot.ability.cognition.input {stimulus} (the product's envelope, source
  "listening"; the interpretation's terminal handoff), which the
  body grants a turn; the interpretation hands labelled non-speech over
  as its own bot.ability.cognition.input, and that and its
  bot.ability.listening.failed go on to the body unchanged. Either leaves
  from wherever perception is.

  Efference copy: bot.ability.speaking.efference goes to the sensitivity
  from wherever perception is: the report
  modulates perception, it does not interrupt it. The body sends it here
  (its listening_abilities list) just
  before the bot's own speech comes back as environment.sound, so the bot
  can tell its own voice apart: while the copy's window is open the
  sensitivity scores a sound whose source is the copy's mouth against the
  prediction (fully predicted its level is 0, below the interpretation's
  threshold), and any other sound at its received level. The
  interpretation does not interpret the bot's own voice arriving as
  predicted (#30), so it never opens an utterance or joins a person's.

  The copy goes to the interpretation too, which learns the bot's own
  voice from the audio a completed utterance's copy carries.

  Readiness: the entry into Perceiving sends bot.ability.ready to the
  body (decision D242); it offers nothing (the
  listening's input is not a tool event).

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline). Each event it takes has one sender here,
  so its name and the state it arrives in route it: no cond asks who sent
  it.

  Memory: the <param> database (the memory database file, or null) goes
  to the interpretation, which remembers the voices heard as the people
  long-term memory holds (decision D258).

  Bindings: none of its own (the interpretation and its hearing leaves
  bind the speech service, and the interpretation's memory the sql and
  pgsql services).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="listening" initial="live">
  <datamodel>
    <!-- The memory database (the invoker's <param>), which the
         interpretation remembers the voices heard in; null: none. -->
    <data id="database" expr="null"/>
    <data id="sensitivity_timeout_ms" expr="30000"/>
    <!-- Whether the transcription streams what is heard (mosfet.py's
         Listening(transcription=)), and whether it does now: until its
         streaming session is ready, and after it ends, the interpretation
         hears every scored sound. -->
    <data id="streams" expr="true"/>
    <data id="transcribing" expr="false"/>
    <data id="children" expr="['sensitivity', 'interpretation', 'transcription']"/>
    <data id="ready" expr="({})"/>
    <!-- The sound being scored. -->
    <data id="sound" expr="null"/>
    <!-- A product's stimulus envelope, for the handoff. -->
    <data id="product" expr="null"/>
  </datamodel>
  <script src="listening.js"/>

  <state id="live" initial="initializing">
    <invoke id="sensitivity" type="scxml" src="../sensitivity/sensitivity.scx"/>
    <invoke id="interpretation" type="scxml" src="../interpretation/interpretation.scx">
      <param name="database" expr="database"/>
    </invoke>
    <invoke id="transcription" type="scxml" src="../transcription/transcription.scx">
      <param name="enabled" expr="streams"/>
    </invoke>

    <!-- A child's readiness, once (decision D242), named by its invoke id. -->
    <transition event="bot.ability.ready" event:schema="../schemas/bot.ability.ready.json">
      <assign location="ready[_event.invokeid]" expr="true"/>
      <assign location="transcribing" expr="transcribing || isTranscription(_event)"/>
    </transition>
    <!-- The transcription ends when it has no streaming session to hear
         through: the interpretation hears every sound from then on. -->
    <transition event="done.invoke.transcription">
      <assign location="ready.transcription" expr="true"/>
      <assign location="transcribing" expr="false"/>
    </transition>
    <!-- A child that cannot run, or ends, degrades the ability. -->
    <transition event="error.*" target="degraded">
      <log label="listening.degraded" expr="childCouldNotRunLog(_event)"/>
    </transition>
    <transition event="done.invoke.sensitivity done.invoke.interpretation" target="degraded">
      <log label="listening.degraded" expr="childEndedLog(_event)"/>
    </transition>

    <!-- Waits for the sensitivity and the interpretation. A child that
         cannot start raises its error with no invokeid (SCXML 6.4.2). -->
    <state id="initializing">
      <transition cond="everyChildReady(ready)" target="Perceiving"/>
      <transition event="error.*" target="degraded">
        <log label="listening.degraded" expr="childCouldNotStartLog(_event)"/>
      </transition>
      <transition event="environment.sound" event:schema="../schemas/environment.sound.json">
        <event:defer/>
      </transition>
    </state>

    <state id="Perceiving" initial="Listening">
      <onentry>
        <send event="bot.ability.ready" target="#_parent"/>
      </onentry>
      <!-- The body's report of what it is producing reaches the
           prediction from wherever perception happens to be. -->
      <transition event="bot.ability.speaking.efference" event:schema="../schemas/bot.ability.speaking.efference.json">
        <send event="bot.ability.speaking.efference" target="#_sensitivity">
          <content expr="_event.data"/>
        </send>
        <!-- A completed utterance's copy, with its audio, is the bot's own
             voice to learn. -->
        <if cond="typeof _event.data.audio === 'string'">
          <send event="bot.ability.speaking.efference" target="#_interpretation">
            <content expr="_event.data"/>
          </send>
        </if>
      </transition>
      <!-- The interpretation's products and failures, out through this
           ability's own. -->
      <transition event="bot.ability.listening.speech.output" event:schema="../schemas/bot.ability.listening.speech.output.json">
        <assign location="product" expr="({})"/>
        <assign location="product.event" expr="_event.name"/>
        <assign location="product.data" expr="_event.data"/>
        <assign location="product.source" expr="'listening'"/>
        <!-- The speech product's participants ride forward (f6c4e08). -->
        <send event="bot.ability.cognition.input" target="#_parent">
          <param name="stimulus" expr="product"/>
          <param name="participants" expr="productParticipants(_event)"/>
        </send>
      </transition>
      <transition event="bot.ability.cognition.input" event:schema="../schemas/bot.ability.cognition.input.json">
        <send event="bot.ability.cognition.input" target="#_parent">
          <content expr="_event.data"/>
        </send>
      </transition>
      <transition event="bot.ability.listening.failed" event:schema="../schemas/bot.ability.listening.failed.json">
        <send event="bot.ability.listening.failed" target="#_parent">
          <content expr="_event.data"/>
        </send>
      </transition>
      <!-- A turn the transcription heard end: the interpretation finds
           who spoke and hands on its words. -->
      <transition event="bot.ability.listening.transcription.turn" event:schema="../schemas/bot.ability.listening.transcription.turn.json">
        <send event="bot.ability.listening.transcription.turn" target="#_interpretation">
          <content expr="_event.data"/>
        </send>
      </transition>

      <state id="Listening">
        <transition event="environment.sound" event:schema="../schemas/environment.sound.json" target="Sensing">
          <assign location="sound" expr="_event.data"/>
        </transition>
      </state>

      <!-- The only stop between the ear and the prediction. -->
      <state id="Sensing">
        <onentry>
          <send event="bot.ability.listening.sensitivity.score" target="#_sensitivity">
            <content expr="scoreRequest(sound)"/>
          </send>
          <send id="sensing-timer" event="bot.ability.listening.sensitivity.failed" delayexpr="delay(sensitivity_timeout_ms)">
            <content expr="sensitivityTimedOut()"/>
          </send>
        </onentry>
        <onexit>
          <cancel sendid="sensing-timer"/>
        </onexit>
        <transition event="environment.sound" event:schema="../schemas/environment.sound.json">
          <event:defer/>
        </transition>
        <transition event="bot.ability.listening.sensitivity.output" event:schema="../schemas/bot.ability.listening.sensitivity.output.json" target="Listening">
          <if cond="transcribing">
            <send event="bot.ability.listening.sensitivity.output" target="#_transcription">
              <content expr="_event.data"/>
            </send>
          <else/>
            <send event="bot.ability.listening.sensitivity.output" target="#_interpretation">
              <content expr="_event.data"/>
            </send>
          </if>
        </transition>
        <transition event="bot.ability.listening.sensitivity.failed" event:schema="../schemas/bot.ability.listening.sensitivity.failed.json" target="Listening">
          <send event="bot.ability.listening.failed" target="#_parent">
            <content expr="_event.data"/>
          </send>
        </transition>
      </state>
    </state>
  </state>

  <final id="degraded"/>
</scxml>
