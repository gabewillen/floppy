<?xml version="1.0" encoding="UTF-8"?>
<!-- listening-8: a sound without an audio reference is refused at the send; the next is heard. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="listening" type="scxml" src="../../../listening.scx">
    <param name="sensitivity_timeout_ms" expr="600000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="environment.sound" target="#_listening"><content expr='{"kind": "knock"}'/></send>
    </onentry>
    <transition event="error.execution" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="environment.sound" target="#_listening"><content expr='{"audio": "media/ring.wav", "media_type": "audio/wav", "sample_rate_hz": 16000, "channels": 1, "kind": "knock"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond="_event.data.stimulus.event === 'environment.sound' &amp;&amp; _event.data.stimulus.data.kind === 'knock'" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
