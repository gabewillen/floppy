<?xml version="1.0" encoding="UTF-8"?>
<!-- listening-7: a score that outlasts sensitivity_timeout_ms fails the listening's sensitivity stage. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="listening" type="scxml" src="../../../listening.scx">
    <param name="sensitivity_timeout_ms" expr="0"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'listening' &amp;&amp; _event.data.choices.length === 0" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="environment.sound" target="#_listening"><content expr='{"audio": "media/ring.wav", "media_type": "audio/wav", "sample_rate_hz": 16000, "channels": 1, "kind": "knock"}'/></send>
    </onentry>
    <transition event="bot.ability.listening.failed" cond="_event.data.stage === 'sensitivity' &amp;&amp; _event.data.message === 'Listening sensitivity timed out.'" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.cognition.input"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
