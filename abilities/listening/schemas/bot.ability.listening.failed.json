{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.listening.failed",
  "description": "FailureData signal produced when a listening stage cannot complete.",
  "properties": {
    "stage": {
      "description": "Listening pipeline stage that failed.",
      "enum": [
        "sensitivity",
        "voice_detection",
        "sound_classification",
        "voice_diarization",
        "voice_identification",
        "speech_decoding"
      ],
      "examples": [
        "speech_decoding"
      ],
      "title": "Stage",
      "type": "string"
    },
    "message": {
      "description": "Human-readable failure message for the listening stage.",
      "examples": [
        "decoder timed out"
      ],
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "stage",
    "message"
  ],
  "type": "object",
  "examples": [
    {
      "message": "decoder timed out",
      "stage": "speech_decoding"
    }
  ]
}
