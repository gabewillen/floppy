<?xml version="1.0" encoding="UTF-8"?>
<!-- stm-10: a database it cannot open degrades it: it says so, refuses requests, and drops notifications. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="stm" type="scxml" src="../../../stm.scx">
    <param name="database" expr="'/nowhere/floppy.sqlite'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.failed" cond="_event.data.message === 'unavailable: StmMemory is degraded.'" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.memory.stm.record" target="#_stm"><content expr='{"stimulus_name": "environment.sound", "payload": {}}'/></send>
      <send event="bot.ability.memory.stm.recent" target="#_stm"><content expr="{}"/></send>
    </onentry>
    <transition event="bot.ability.failed" cond="_event.data.message === 'unavailable: StmMemory is degraded.'" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.memory.stm.recent_turns" target="#_stm"><content expr="{}"/></send>
    </onentry>
    <transition event="bot.ability.failed" cond="_event.data.message === 'unavailable: StmMemory is degraded.'" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
