<?xml version="1.0" encoding="UTF-8"?>
<!-- stm-2: records are read newest first, optionally for one stimulus, at most limit. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <invoke id="stm" type="scxml" src="../../../stm.scx">
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.memory.stm.record" target="#_stm"><content expr='{"stimulus_name": "environment.sound", "payload": {}}'/></send>
      <send event="bot.ability.memory.stm.record" target="#_stm"><content expr='{"stimulus_name": "environment.visual", "payload": {}}'/></send>
      <send event="bot.ability.memory.stm.record" target="#_stm"><content expr='{"stimulus_name": "environment.sound", "payload": {"n": 3}}'/></send>
      <send event="bot.ability.memory.stm.recent" target="#_stm"><content expr="{}"/></send>
    </onentry>
    <transition event="bot.ability.memory.stm.recent.output" cond='JSON.stringify(_event.data.entries.map((e) =&gt; e.stimulus_name)) === "[\"environment.sound\",\"environment.visual\",\"environment.sound\"]"' target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.memory.stm.recent" target="#_stm"><content expr='{"stimulus_name": "environment.visual"}'/></send>
    </onentry>
    <transition event="bot.ability.memory.stm.recent.output" cond='JSON.stringify(_event.data.entries.map((e) =&gt; e.stimulus_name)) === "[\"environment.visual\"]"' target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="bot.ability.memory.stm.recent" target="#_stm"><content expr='{"limit": 1}'/></send>
    </onentry>
    <transition event="bot.ability.memory.stm.recent.output" cond='JSON.stringify(_event.data.entries.map((e) =&gt; e.stimulus_name)) === "[\"environment.sound\"]" &amp;&amp; _event.data.entries[0].payload.n === 3' target="step4"/>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
