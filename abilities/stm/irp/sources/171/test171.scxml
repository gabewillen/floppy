<?xml version="1.0" encoding="UTF-8"?>
<!-- stm-8: within narrows the window but never widens it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="stm" type="scxml" src="../../../stm.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
    <param name="turn_window_ms" expr="60000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.memory.stm.turn" target="#_stm"><content expr='{"id": "t1", "direction": "heard", "speakers": [], "text": "old", "cut": false, "conversation": "listening"}'/></send>
      <send event="harness.waited" delay="1700ms"/>
    </onentry>
    <transition event="harness.waited" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.memory.stm.turn" target="#_stm"><content expr='{"id": "t2", "direction": "heard", "speakers": [], "text": "new", "cut": false, "conversation": "listening"}'/></send>
      <send event="bot.ability.memory.stm.recent_turns" target="#_stm"><content expr='{"within": 1000}'/></send>
    </onentry>
    <transition event="bot.ability.memory.stm.recent_turns.output" cond='JSON.stringify(_event.data.turns.map((t) =&gt; t.text)) === "[\"new\"]"' target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="bot.ability.memory.stm.recent_turns" target="#_stm"><content expr='{"within": 3600000}'/></send>
    </onentry>
    <transition event="bot.ability.memory.stm.recent_turns.output" cond='JSON.stringify(_event.data.turns.map((t) =&gt; t.text)) === "[\"old\",\"new\"]"' target="step4"/>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
