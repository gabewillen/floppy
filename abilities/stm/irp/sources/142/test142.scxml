<?xml version="1.0" encoding="UTF-8"?>
<!-- stm-5: a stored turn that does not decode as one is skipped; the turns around it are read. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="stm" type="scxml" src="../../../stm.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
    <param name="recent_turns_select" expr="&quot;SELECT turn_id, at, direction, speakers_json, text, cut, conversation FROM (SELECT 2 AS n, 't2' AS turn_id, '2026-07-07T12:00:01.000000+00:00' AS at, 'heard' AS direction, '[]' AS speakers_json, 'good' AS text, 0 AS cut, 'listening' AS conversation UNION ALL SELECT 1, 't1', '2026-07-07T12:00:00.000000+00:00', 'shouted', '[]', 'bad', 0, 'listening') AS stored WHERE ?1 = ?1 AND ?2 = ?2 ORDER BY n DESC&quot;"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.memory.stm.recent_turns" target="#_stm"><content expr="{}"/></send>
    </onentry>
    <transition event="bot.ability.memory.stm.recent_turns.output" cond='JSON.stringify(_event.data.turns.map((t) =&gt; t.text)) === "[\"good\"]"' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
