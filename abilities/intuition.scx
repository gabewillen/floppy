<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Intuition stage (mosfet abilities/cognition/intuition with the
  TypeSafe processor): the fast System 1 pick, made by the decision service
  (never by a free-text model) over the turn's choices, with mosfet's
  self-tuning confidence gate. The cognition (abilities/cognition.scx)
  invokes it once per turn after autonomy left the turn unhandled.

    deciding (an invoked decision service) -> done

  Choices: the turn's choices, the <param> choices: the body's assembled
  snapshot choices (its own enabled event:schema transitions and each
  ability's latest offers, tagged with the offering ability as target), the
  same menu reasoning gets (mosfet collect_offered_events over every
  actor's enabled_call_events). The decision service asks one batch over
  them plus its abstain label (mosfet's pass criterion), filling each
  event's required data from the evidence, the stimulus data (mosfet's
  stimulus data mapping), else the schema's enum or const; an event it
  cannot fill is not offered, so a reply that needs free text goes on to
  reasoning (user answer, 2026-10-08). The event it chooses comes back as
  that event and becomes the turn's one selection {event, data, reason},
  which the body routes to the target offering it (mosfet dispatches the
  selection to its single enabler).

  Confidence (mosfet ConfidenceTuner, 0-100 scale): the tuner state
  {mean, variance, n} comes in as a <param> and goes back in <donedata>, so
  it lives in the cognition across turns. <decision:tuner> keeps it (mosfet's
  defaults: the floor 35 during the warmup of 8 observations, then
  max(floor / 2, mean - k_sigma * std); EMA alpha 0.08, variance floor 100)
  and writes its threshold as a probability, passed to the decision service
  as threshold: a chosen event less probable than that comes back as
  decision.abstain below-threshold with its probability, which the tuner
  observes and the turn escalates (mosfet's low_confidence). The decision
  service reports no probability with a chosen event, so such a turn adds
  no observation (mosfet observes only a reported score). declined (the
  abstain label won) and no-candidates (nothing could be filled) escalate
  too (mosfet's unhandled pass).

  Output: <donedata>, received by the cognition as done.invoke.intuition:

    {turn, handled: true, selected: [{event, data, reason}], reason, tuner}
    {turn, handled: false, reason, tuner}          (escalate to reasoning)
    {turn, handled: false, failed: true, reason, tuner}

  decision.failed, error.*, or no answer within decision_timeout_ms fails
  the stage (the cognition answers the turn with bot.ability.failed); the
  cognition's hop timeout bounds the whole stage too.

  Bindings: the decision namespace and service packages, resolved from their
  repository URIs; env scopes TYPESAFE_API_KEY and TYPESAFE_BASE_URL to the
  service's <invoke> (without a key it answers decision.failed
  unconfigured). An invoked service's events are not checked against
  event:schema (scxml.rs checks only events between SCXML sessions): the
  decision service validates the chosen event's data against the choices'
  schema before returning it, and its own events are shape-checked by cond
  (Object(...) reads a non-object as {}).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       version="1.0" datamodel="ecmascript" name="intuition" initial="deciding">
  <datamodel>
    <!-- The turn, from the cognition's <param>s. -->
    <data id="turn" expr="0"/>
    <data id="stimulus" expr="null"/>
    <data id="focus" expr="null"/>
    <data id="focus_candidates" expr="[]"/>
    <data id="choices" expr="[]"/>
    <data id="tuner" expr="({mean: 70, variance: 100, n: 0})"/>
    <data id="decision_timeout_ms" expr="20000"/>
    <data id="instructions" expr="'You decide what a small companion robot does with one stimulus it observed. Choose the offered event the robot should take for it. Abstain when none of them fits, so slower reasoning handles it.'"/>
    <!-- The decision in flight. -->
    <data id="evidence" expr="({})"/>
    <data id="threshold" expr="0"/>
    <data id="decision_id" expr="null"/>
    <data id="decision_timer" expr="null"/>
    <data id="result" expr="null"/>
    <data id="failed_code" expr="null"/>
  </datamodel>

  <state id="deciding">
    <onentry>
      <assign location="evidence" expr="stimulus !== null &amp;&amp; stimulus.data instanceof Object &amp;&amp; !Array.isArray(stimulus.data) ? stimulus.data : ({})"/>
      <decision:tuner location="tuner" thresholdlocation="threshold"/>
      <log label="intuition" expr="'turn ' + turn + ': threshold ' + threshold"/>
      <send idlocation="decision_timer" event="floppy.intuition.timed_out" delayexpr="decision_timeout_ms + 'ms'"/>
    </onentry>
    <onexit>
      <cancel sendidexpr="decision_timer"/>
    </onexit>
    <invoke idlocation="decision_id" type="https://github.com/stateforward/floppy/services/decision"
            env:apikey="TYPESAFE_API_KEY" env:baseurl="TYPESAFE_BASE_URL">
      <param name="choices" expr="choices"/>
      <param name="state" expr="({stimulus: stimulus, focus: focus, focus_candidates: focus_candidates})"/>
      <param name="data" expr="evidence"/>
      <param name="instructions" expr="instructions"/>
      <param name="threshold" expr="threshold"/>
    </invoke>

    <!-- The decision service's own events. -->
    <transition event="decision.abstain"
                cond="decision_id !== null &amp;&amp; _event.invokeid === decision_id &amp;&amp; ['no-candidates', 'declined', 'below-threshold'].indexOf(Object(_event.data).reason) &gt;= 0"
                target="done">
      <if cond="_event.data.reason === 'below-threshold' &amp;&amp; typeof _event.data.confidence === 'number'">
        <decision:tuner location="tuner" observe="Math.round(_event.data.confidence * 100)"/>
        <log label="intuition" expr="'turn ' + turn + ': low confidence ' + Math.round(_event.data.confidence * 100)"/>
        <assign location="result" expr="({handled: false, reason: 'low_confidence', turn: turn, tuner: tuner})"/>
      <else/>
        <log label="intuition" expr="'turn ' + turn + ': abstained (' + _event.data.reason + ')'"/>
        <assign location="result" expr="({handled: false, reason: _event.data.reason, turn: turn, tuner: tuner})"/>
      </if>
    </transition>
    <transition event="decision.failed" cond="decision_id !== null &amp;&amp; _event.invokeid === decision_id" target="done">
      <assign location="failed_code" expr="typeof Object(_event.data).code === 'string' ? _event.data.code : 'unknown'"/>
      <assign location="result" expr="({handled: false, failed: true, reason: 'the decision failed (' + failed_code + ')', turn: turn, tuner: tuner})"/>
    </transition>
    <!-- The chosen event: one of the choices, its data validated by the
         service against the choice's schema. -->
    <transition event="*" cond="decision_id !== null &amp;&amp; _event.invokeid === decision_id &amp;&amp; _event.name.indexOf('done.') !== 0"
                target="done">
      <log label="intuition" expr="'turn ' + turn + ': ' + _event.name"/>
      <assign location="result" expr="({handled: true, selected: [{event: _event.name, data: Object(_event.data), reason: 'intuition'}], reason: _event.name, turn: turn, tuner: tuner})"/>
    </transition>
    <transition event="floppy.intuition.timed_out" cond="_event.sendid === decision_timer" target="done">
      <assign location="result" expr="({handled: false, failed: true, reason: 'the decision timed out after ' + decision_timeout_ms + ' ms', turn: turn, tuner: tuner})"/>
    </transition>
    <transition event="error.*" target="done">
      <assign location="result" expr="({handled: false, failed: true, reason: 'the decision could not run (' + _event.name + ')', turn: turn, tuner: tuner})"/>
    </transition>
  </state>

  <final id="done">
    <donedata>
      <content expr="result"/>
    </donedata>
  </final>
</scxml>
