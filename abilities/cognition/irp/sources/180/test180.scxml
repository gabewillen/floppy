<?xml version="1.0" encoding="UTF-8"?>
<!-- cognition-9: an input without a stimulus is refused at the sender; the cognition stays idle and acknowledges a cancel at once. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="cognition" type="scxml" src="../../../cognition.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.cognition.input" target="#_cognition"><content expr='{"turn": 1}'/></send>
    </onentry>
    <transition event="error.execution" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.cognition.cancel" target="#_cognition"><content expr='{"turn": 1}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.cancelled" cond="_event.data.turn === 1" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.identity.ask"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
