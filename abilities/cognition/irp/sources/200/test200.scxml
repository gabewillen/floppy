<?xml version="1.0" encoding="UTF-8"?>
<!-- cognition-11: the cognition asks the identity for the bot's name once ready, again after a turn, and no more once told. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="cognition" type="scxml" src="../../../cognition.scx">
    <param name="child_operation_timeout_ms" expr="300000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.identity.ask" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.cognition.input" target="#_cognition"><content expr='{"turn": 1, "stimulus": {"event": "bot.input", "data": {"text": "hello"}, "source": "conversation"}, "focus": null, "focus_candidates": [], "choices": [{"event": "bot.ability.cognition.ignore", "schema": {"additionalProperties": false, "description": "Deliberately ignore this stimulus: no device command, no focus change, no speech. It is for what is not for you: people talking to each other (words that speak to someone else, when no participant that is you, own, is their target), and sounds or sights that ask nothing of you. What someone says to you, a question or only something they tell you, is not ignored: it gets an answer, even a short one. A routine of yours that fires is for you too: what it proposes is not done until you select it. Do not use a device command or focus as a stand-in for ignore. Put why on the selection envelope reason field, not on this empty payload.", "properties": {}, "type": "object"}, "target": "session.cognition"}]}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.output" cond='_event.data.turn === 1 &amp;&amp; _event.data.output.length === 1 &amp;&amp; _event.data.output[0].event === "bot.ability.cognition.ignore"' target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <decision:offers location="offers" target="'#_cognition'"/>
    </onentry>
    <transition cond="offers.length === 2 &amp;&amp; offers.map(function (o) { return o.event; }).sort().join(' ') === &quot;bot.ability.cognition.ignore bot.ability.learning.input&quot; &amp;&amp; offers.every(function (o) { return o.effort === undefined &amp;&amp; o.schema.type === 'object'; })" target="step4"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step4">
    <transition event="bot.ability.identity.ask" target="step5"/>
  </state>
  <state id="step5">
    <onentry>
      <send event="bot.ability.identity.named" target="#_cognition"><content expr='{"name": "Pip"}'/></send>
      <send event="bot.ability.cognition.input" target="#_cognition"><content expr='{"turn": 2, "stimulus": {"event": "bot.input", "data": {"text": "hello"}, "source": "conversation"}, "focus": null, "focus_candidates": [], "choices": [{"event": "bot.ability.cognition.ignore", "schema": {"additionalProperties": false, "description": "Deliberately ignore this stimulus: no device command, no focus change, no speech. It is for what is not for you: people talking to each other (words that speak to someone else, when no participant that is you, own, is their target), and sounds or sights that ask nothing of you. What someone says to you, a question or only something they tell you, is not ignored: it gets an answer, even a short one. A routine of yours that fires is for you too: what it proposes is not done until you select it. Do not use a device command or focus as a stand-in for ignore. Put why on the selection envelope reason field, not on this empty payload.", "properties": {}, "type": "object"}, "target": "session.cognition"}]}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.output" cond='_event.data.turn === 2 &amp;&amp; _event.data.output.length === 1 &amp;&amp; _event.data.output[0].event === "bot.ability.cognition.ignore"' target="step6"/>
  </state>
  <state id="step6">
    <onentry>
      <decision:offers location="offers" target="'#_cognition'"/>
    </onentry>
    <transition cond="offers.length === 2 &amp;&amp; offers.map(function (o) { return o.event; }).sort().join(' ') === &quot;bot.ability.cognition.ignore bot.ability.learning.input&quot; &amp;&amp; offers.every(function (o) { return o.effort === undefined &amp;&amp; o.schema.type === 'object'; })" target="step7"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step7">
    <onentry>
      <send event="bot.ability.cognition.cancel" target="#_cognition"><content expr='{"turn": 3}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.cancelled" cond="_event.data.turn === 3" target="step8"/>
  </state>
  <state id="step8">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
