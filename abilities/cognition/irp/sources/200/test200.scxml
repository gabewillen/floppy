<?xml version="1.0" encoding="UTF-8"?>
<!-- cognition-11: the cognition asks the identity for the bot's name after its offers, again after a turn, and no more once told. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="cognition" type="scxml" src="../../../cognition.scx">
    <param name="child_operation_timeout_ms" expr="300000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'cognition' &amp;&amp; _event.data.choices.length === 2 &amp;&amp; _event.data.choices[0].event === &quot;bot.ability.cognition.ignore&quot; &amp;&amp; _event.data.choices[1].event === &quot;bot.ability.learning.input&quot; &amp;&amp; _event.data.choices[0].schema.title === undefined" target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.identity.ask" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.cognition.input" target="#_cognition"><content expr='{"turn": 1, "stimulus": {"event": "bot.input", "data": {"text": "hello"}, "source": "conversation"}, "focus": null, "focus_candidates": [], "choices": [{"event": "bot.ability.cognition.ignore", "schema": {"additionalProperties": false, "description": "Deliberately ignore this stimulus: no device command, no focus change, no speech. Required when no other offered event should run. Do not use a device command or focus as a stand-in for ignore. Put why on the selection envelope reason field, not on this empty payload.", "properties": {}, "type": "object"}, "target": "session.cognition"}]}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.output" cond='_event.data.turn === 1 &amp;&amp; _event.data.output.length === 1 &amp;&amp; _event.data.output[0].event === "bot.ability.cognition.ignore"' target="step3"/>
  </state>
  <state id="step3">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'cognition' &amp;&amp; _event.data.choices.length === 2 &amp;&amp; _event.data.choices[0].event === &quot;bot.ability.cognition.ignore&quot; &amp;&amp; _event.data.choices[1].event === &quot;bot.ability.learning.input&quot; &amp;&amp; _event.data.choices[0].schema.title === undefined" target="step4"/>
  </state>
  <state id="step4">
    <transition event="bot.ability.identity.ask" target="step5"/>
  </state>
  <state id="step5">
    <onentry>
      <send event="bot.ability.identity.named" target="#_cognition"><content expr='{"name": "Pip"}'/></send>
      <send event="bot.ability.cognition.input" target="#_cognition"><content expr='{"turn": 2, "stimulus": {"event": "bot.input", "data": {"text": "hello"}, "source": "conversation"}, "focus": null, "focus_candidates": [], "choices": [{"event": "bot.ability.cognition.ignore", "schema": {"additionalProperties": false, "description": "Deliberately ignore this stimulus: no device command, no focus change, no speech. Required when no other offered event should run. Do not use a device command or focus as a stand-in for ignore. Put why on the selection envelope reason field, not on this empty payload.", "properties": {}, "type": "object"}, "target": "session.cognition"}]}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.output" cond='_event.data.turn === 2 &amp;&amp; _event.data.output.length === 1 &amp;&amp; _event.data.output[0].event === "bot.ability.cognition.ignore"' target="step6"/>
  </state>
  <state id="step6">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'cognition' &amp;&amp; _event.data.choices.length === 2 &amp;&amp; _event.data.choices[0].event === &quot;bot.ability.cognition.ignore&quot; &amp;&amp; _event.data.choices[1].event === &quot;bot.ability.learning.input&quot; &amp;&amp; _event.data.choices[0].schema.title === undefined" target="step7"/>
  </state>
  <state id="step7">
    <onentry>
      <send event="bot.ability.cognition.cancel" target="#_cognition"><content expr='{"turn": 3}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.cancelled" cond="_event.data.turn === 3" target="step8"/>
  </state>
  <state id="step8">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
