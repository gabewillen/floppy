<?xml version="1.0" encoding="UTF-8"?>
<!-- cognition-7: a cancel for the turn in hand is acknowledged and the cognition is idle again. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="cognition" type="scxml" src="../../../cognition.scx">
    <param name="child_operation_timeout_ms" expr="300000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="bot.ability.cognition.input" target="#_cognition"><content expr='{"turn": 1, "stimulus": {"event": "bot.input", "data": {"text": "hello"}, "source": "conversation"}, "focus": null, "focus_candidates": [], "choices": [{"event": "bot.ability.cognition.ignore", "schema": {"additionalProperties": false, "description": "Deliberately ignore this stimulus: no device command, no focus change, no speech. It is for what is not for you: people talking to each other (words that speak to someone else, when no participant that is you, own, is their target), and sounds or sights that ask nothing of you. What someone says to you, a question or only something they tell you, is not ignored: it gets an answer, even a short one. A routine of yours that fires is for you too: what it proposes is not done until you select it. Do not use a device command or focus as a stand-in for ignore. Put why on the selection envelope reason field, not on this empty payload.", "properties": {}, "type": "object"}, "target": "session.cognition"}]}'/></send>
      <send event="bot.ability.cognition.cancel" target="#_cognition"><content expr='{"turn": 1}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.cancelled" cond="_event.data.turn === 1" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <decision:offers location="offers" target="'#_cognition'"/>
    </onentry>
    <transition cond="offers.length === 2 &amp;&amp; offers.map(function (o) { return o.event; }).sort().join(' ') === &quot;bot.ability.cognition.ignore bot.ability.learning.input&quot; &amp;&amp; offers.every(function (o) { return o.effort === undefined &amp;&amp; o.schema.type === 'object'; })" target="step3"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="bot.ability.identity.ask"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
