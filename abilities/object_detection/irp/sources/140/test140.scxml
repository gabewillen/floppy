<?xml version="1.0" encoding="UTF-8"?>
<!-- object_detection-5: objects come back most confident first, unrated last, ties in the reply's order. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="object_detection" type="scxml" src="../../../object_detection.scx">
    <param name="image" expr="'media/scene.png'"/>
    <param name="media_type" expr="'image/png'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.vision.detection.output" cond='JSON.stringify(_event.data) === "{\"objects\":[{\"box\":{\"height\":0.15,\"width\":0.1,\"x\":0.4,\"y\":0.5},\"confidence\":0.87,\"label\":\"cup\"},{\"box\":{\"height\":0.5,\"width\":0.5,\"x\":0,\"y\":0},\"confidence\":0.5,\"label\":\"left\"},{\"box\":{\"height\":0.5,\"width\":0.5,\"x\":0.5,\"y\":0},\"confidence\":0.5,\"label\":\"right\"},{\"box\":{\"height\":0.5,\"width\":1,\"x\":0,\"y\":0.5},\"confidence\":0,\"label\":\"floor\"},{\"box\":{\"height\":0.5,\"width\":0.25,\"x\":0.75,\"y\":0.25},\"confidence\":null,\"label\":\"lamp\"},{\"box\":{\"height\":1,\"width\":0.25,\"x\":0,\"y\":0},\"confidence\":null,\"label\":\"door\"}]}"' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
