<?xml version="1.0" encoding="UTF-8"?>
<!-- speech_decoding-5: a malformed media_type rejects the decoder's start. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="speech_decoding" type="scxml" src="../../../speech_decoding.scx">
    <param name="audio" expr="'media/speech.wav'"/>
    <param name="media_type" expr="'not a media type'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.speech_decoding" cond='_event.data.message === "SpeechDecoding could not run (error.execution)" &amp;&amp; Object.keys(_event.data).length === 1' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
