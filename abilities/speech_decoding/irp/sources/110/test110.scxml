<?xml version="1.0" encoding="UTF-8"?>
<!-- speech_decoding-2: a gemini model output with no text decodes to empty words. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="speech_decoding" type="scxml" src="../../../speech_decoding.scx">
    <param name="provider" expr="'gemini'"/>
    <param name="model" expr="'gemini-3.5-flash'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.hearing.speech.decoding.input" target="#_speech_decoding"><content expr="({id: &quot;r1&quot;, audio: 'media/speech.wav'})"/></send>
    </onentry>
    <transition event="bot.ability.hearing.speech.decoding.output" cond='_event.data.id === "r1" &amp;&amp; (function (_event) { return _event.data.text === "" &amp;&amp; Object.keys(_event.data).length === 1; })({name: _event.name, data: (function (data) { var copy = JSON.parse(JSON.stringify(data)); delete copy.id; return copy; })(_event.data)})' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
