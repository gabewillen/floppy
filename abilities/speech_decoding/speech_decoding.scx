<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's SpeechDecoding (the reference abilities/hearing/speech/decoding.py):
  speech to words through the speech service (services/speech, operation
  decode with provider "gemini": the Gemini API's POST {base}/interactions,
  decision D94), the original's SpeechDecoder providers. The interpretation
  (abilities/interpretation/interpretation.scx) invokes it once per utterance from
  DecodingSpeech; the interpretation's stage timer bounds it, and leaving
  DecodingSpeech cancels it and the service call (SCXML 6.4).

    applying (an invoked speech service) -> applied (final)

  Input: the <param>s audio (a reference to the utterance's audio in the
  directory the run grants the speech service), media_type, provider and
  model (the original's gemini SpeechDecoder and its default model,
  gemini-3.5-flash, by default; provider null is the OpenAI-compatible
  POST {base}/audio/transcriptions, whisper-1 for example).

  Output: <donedata>, received by the interpretation as
  done.invoke.speech_decoding: {text} (the original's decoded speech, as words)
  when the service answers bot.ability.hearing.speech.decoding.output
  {text}, or {message} (the original's FailureData) when it answers
  bot.ability.failed {message}, answers something else, or cannot run.

  Bindings: the speech service package, resolved from its repository URI;
  env scopes FLOPPY_SPEECH_BASE_URL and FLOPPY_SPEECH_API_KEY to the
  service's <invoke> (no default backend, decision D31: without them the
  service answers bot.ability.failed). The run grants the service the
  media directory (scx run's dir option). An invoked service's events are
  not checked against event:schema (scxml.rs checks only events between
  SCXML sessions), so their shape is checked by cond.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="speech_decoding" initial="applying">
  <datamodel>
    <!-- The invoker's <param>s. -->
    <data id="audio" expr="null"/>
    <data id="media_type" expr="null"/>
    <data id="provider" expr="'gemini'"/>
    <data id="model" expr="'gemini-3.5-flash'"/>
    <!-- The result. -->
    <data id="output" expr="null"/>
  </datamodel>
  <script src="speech_decoding.js"/>

  <state id="applying">
    <invoke id="decoder" type="https://github.com/stateforward/floppy/services/speech"
            env:baseurl="FLOPPY_SPEECH_BASE_URL" env:apikey="FLOPPY_SPEECH_API_KEY">
      <param name="operation" expr="'decode'"/>
      <param name="provider" expr="provider"/>
      <param name="model" expr="model"/>
      <param name="audio" expr="audio"/>
      <param name="media_type" expr="media_type"/>
    </invoke>
    <transition event="bot.ability.hearing.speech.decoding.output"
                cond="hasDecodedText(_event)" target="applied">
      <assign location="output" expr="decodedOutput(_event)"/>
    </transition>
    <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json" target="applied">
      <assign location="output" expr="failedOutput(_event)"/>
    </transition>
    <transition event="done.invoke.decoder" target="applied">
      <assign location="output" expr="undecodedOutput()"/>
    </transition>
    <transition event="error.*" target="applied">
      <assign location="output" expr="errorOutput(_event)"/>
    </transition>
    <!-- Anything else the decoder sends (the transitions above come first). -->
    <transition event="*" target="applied">
      <assign location="output" expr="mismatchedOutput()"/>
    </transition>
  </state>

  <final id="applied">
    <donedata>
      <content expr="output"/>
    </donedata>
  </final>
</scxml>
