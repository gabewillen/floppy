<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's SpeechDecoding: speech to words through the speech service
  (services/speech, operation decode with provider "gemini": the Gemini
  API's POST {base}/interactions, decision D94). The interpretation
  (abilities/interpretation/interpretation.scx) invokes it once, as its
  long-lived child speech_decoding (mosfet.py's Interpretation holds its
  SpeechDecoding), and sends it each utterance from DecodingSpeech; the
  interpretation's stage timer bounds each request.

    idle -bot.ability.hearing.speech.decoding.input-> applying -> idle

  Configuration: the <param>s provider and model (by default provider
  null, the OpenAI-compatible POST {base}/audio/transcriptions, with the
  lab's Nemotron streaming model, nemotron-speech-streaming-en-0.6b;
  provider gemini is Gemini's Interactions API).

  Requests: bot.ability.hearing.speech.decoding.input {id, audio,
  media_type?}: a reference to the utterance's audio in the directory the
  run grants the speech service, and its media type. It answers its
  parent with bot.ability.hearing.speech.decoding.output {id, text} (the
  decoded speech, as words) when the service answers
  bot.ability.hearing.speech.decoding.output {text}, or bot.ability.failed
  {id, message} when the service answers bot.ability.failed {message},
  answers something else, or cannot run. One utterance is decoded at a
  time; a request that arrives while one is in flight replaces it
  (leaving applying cancels its service call, SCXML 6.4).

  Bindings: the speech service package, resolved from its repository URI;
  env scopes FLOPPY_SPEECH_BASE_URL and FLOPPY_SPEECH_API_KEY to the
  service's <invoke> (no default backend, decision D31: without a base URL
  the service answers bot.ability.failed, and without a key it asks a
  keyless backend with no key header, decision D127). The run grants the
  service the media directory (scx run's dir option). An invoked service's
  events are not checked against event:schema (scxml.rs checks only events
  between SCXML sessions), so their shape is checked by cond.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="speech_decoding" initial="idle">
  <datamodel>
    <!-- The invoker's <param>s. -->
    <data id="provider" expr="null"/>
    <data id="model" expr="'nemotron-speech-streaming-en-0.6b'"/>
    <!-- The request being decoded. -->
    <data id="request" expr="null"/>
    <!-- The current service call's generated invoke ids: a cancelled call's
         late events (still delivered, SCXML 6.4) are not this request's. -->
    <data id="decoder" expr="null"/>
  </datamodel>
  <script src="speech_decoding.js"/>

  <state id="idle">
    <transition event="bot.ability.hearing.speech.decoding.input"
                event:schema="../schemas/bot.ability.hearing.speech.decoding.input.json" target="applying">
      <assign location="request" expr="_event.data"/>
    </transition>
  </state>

  <state id="applying">
    <invoke idlocation="decoder" type="https://github.com/stateforward/floppy/services/speech"
            env:baseurl="FLOPPY_SPEECH_BASE_URL" env:apikey="FLOPPY_SPEECH_API_KEY">
      <param name="operation" expr="'decode'"/>
      <param name="provider" expr="provider"/>
      <param name="model" expr="model"/>
      <param name="audio" expr="request.audio"/>
      <param name="media_type" expr="requestedMediaType()"/>
    </invoke>
    <!-- A newer utterance replaces this one. -->
    <transition event="bot.ability.hearing.speech.decoding.input"
                event:schema="../schemas/bot.ability.hearing.speech.decoding.input.json" target="applying">
      <assign location="request" expr="_event.data"/>
    </transition>
    <transition event="bot.ability.hearing.speech.decoding.output" event:schema="../schemas/bot.ability.hearing.speech.decoding.output.json"
                cond="_event.invokeid === decoder &amp;&amp; hasDecodedText(_event)" target="idle">
      <send event="bot.ability.hearing.speech.decoding.output" target="#_parent">
        <content expr="decodedOutput(_event)"/>
      </send>
    </transition>
    <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" cond="_event.invokeid === decoder" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <content expr="failedOutput(_event)"/>
      </send>
    </transition>
    <transition event="done.invoke" cond="_event.invokeid === decoder" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <content expr="undecodedOutput()"/>
      </send>
    </transition>
    <transition event="error.*" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <content expr="errorOutput(_event)"/>
      </send>
    </transition>
    <!-- Anything else the decoder sends (the transitions above come first). -->
    <transition event="*" cond="_event.invokeid === decoder" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <content expr="mismatchedOutput()"/>
      </send>
    </transition>
  </state>
</scxml>
