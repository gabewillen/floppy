<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Autonomy stage (mosfet abilities/cognition/autonomy), as an
  honest seam until phase 5: the cognition (abilities/cognition.scx)
  invokes it first in each turn, and it answers at once that no learned
  behavior handles the turn, so the cascade goes on to intuition.

  Input: the <param>s turn and input, the fields of mosfet's
  bot.ability.autonomy.input (schemas/bot.ability.autonomy.input.json).
  Output: its top-level final state's <donedata>, which the cognition
  receives as done.invoke.autonomy (SCXML 6.4):

    {turn, handled: false, candidates: [], reason: "no-behaviors"}

  Builder seam: behavior is the URI of one builder-produced behavior
  document, null here (no behaviors are installed until phase 5; only the
  tests set it). When set, autonomy invokes it as an SCXML child by
  <invoke id="matched" srcexpr> with the same turn and input, and answers
  with the child's <donedata> handled and selected:

    {turn, handled, selected, candidates: [], reason: "behavior"}

  or, when the child cannot run (an error.* for it),
  {turn, handled: false, failed: true, reason}. A srcexpr child gets no
  schema files (docs/port-plan.md, "Builder output"), so a behavior
  document carries no event:schema reference. A relative behavior URI
  resolves against this document.

  Phase 5 replaces this with mosfet's behavior inventory (Autonomy
  behaviors, Routines and Learning); nothing is recalled or fabricated here.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" name="autonomy" initial="matching">
  <datamodel>
    <data id="turn" expr="0"/>
    <data id="input" expr="null"/>
    <data id="behavior" expr="null"/>
    <data id="answer" expr="null"/>
  </datamodel>

  <!-- No behaviors are installed: nothing matches. -->
  <state id="matching">
    <onentry>
      <if cond="behavior === null">
        <log label="autonomy" expr="'turn ' + turn + ': no behaviors (phase 5)'"/>
      <else/>
        <log label="autonomy" expr="'turn ' + turn + ': one behavior'"/>
      </if>
    </onentry>
    <transition cond="behavior === null" target="done"/>
    <transition target="behaving"/>
  </state>

  <!-- One builder-produced behavior handles the turn, or not. -->
  <state id="behaving">
    <invoke id="matched" type="scxml" srcexpr="behavior">
      <param name="turn" expr="turn"/>
      <param name="input" expr="input"/>
    </invoke>
    <transition event="done.invoke.matched" cond="_event.data.turn === turn" target="answered">
      <assign location="answer" expr="_event.data"/>
    </transition>
    <transition event="error.*" target="failed">
      <assign location="answer" expr="'the behavior could not run (' + _event.name + ')'"/>
    </transition>
  </state>

  <final id="done">
    <donedata>
      <content expr="({turn: turn, handled: false, candidates: [], reason: 'no-behaviors'})"/>
    </donedata>
  </final>

  <final id="answered">
    <donedata>
      <content expr="({turn: turn, handled: answer.handled === true, selected: answer.selected, candidates: [], reason: 'behavior'})"/>
    </donedata>
  </final>

  <final id="failed">
    <donedata>
      <content expr="({turn: turn, handled: false, failed: true, reason: answer})"/>
    </donedata>
  </final>
</scxml>
