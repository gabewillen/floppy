<?xml version="1.0" encoding="UTF-8"?>
<!-- persona-6: a revise that arrives while recalling is taken once it knows. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <invoke id="persona" type="scxml" src="../../../persona.scx">
    <param name="traits" expr='["curious", "  patient with children "]'/>
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.persona.revise" target="#_persona"><content expr='{"text": "I like questions.", "reason": "I keep asking them."}'/></send>
    </onentry>
    <transition event="bot.ability.persona.output" cond='JSON.stringify(_event.data.traits) === "[\"curious\",\"patient with children\"]" &amp;&amp; _event.data.description === null' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.ready" target="step2"/>
  </state>
  <state id="step2">
    <transition event="bot.ability.persona.output" cond='JSON.stringify(_event.data.traits) === "[\"curious\",\"patient with children\"]" &amp;&amp; JSON.stringify(_event.data.description) === "{\"kind\":\"fact\",\"reason\":\"I keep asking them.\",\"text\":\"I like questions.\",\"traits\":[\"curious\",\"patient with children\"]}"' target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <decision:offers location="offers" target="'#_persona'"/>
    </onentry>
    <transition cond="offers.length === 1 &amp;&amp; offers[0].event === 'bot.ability.persona.revise' &amp;&amp; offers[0].effort === 2 &amp;&amp; offers[0].target === undefined &amp;&amp; offers[0].schema.required.join() === 'text,reason' &amp;&amp; offers[0].schema.properties.text.maxLength === 2000 &amp;&amp; offers[0].schema.properties.reason.maxLength === 500 &amp;&amp; typeof offers[0].description === 'string'" target="step4"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
