<?xml version="1.0" encoding="UTF-8"?>
<!-- persona-2: attempts that do not answer in time are asked again until the bring-up budget runs out. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <invoke id="persona" type="scxml" src="../../../persona.scx">
    <param name="traits" expr='["curious", "  patient with children "]'/>
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
    <param name="description_select" expr="&quot;SELECT content FROM (WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM c WHERE x &lt; 20000000) SELECT count(*) AS n, 'x' AS content FROM c) AS slow WHERE ?1 = 'self_persona' AND ?2 = 'self'&quot;"/>
    <param name="recall_attempt_timeout_ms" expr="200"/>
    <param name="bring_up_timeout_ms" expr="1500"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.failed" cond='_event.data.message === "Persona could not recall a description: memory did not answer within the bring-up budget."' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.persona.output" cond='JSON.stringify(_event.data.traits) === "[\"curious\",\"patient with children\"]" &amp;&amp; _event.data.description === null' target="step2"/>
  </state>
  <state id="step2">
    <transition event="bot.ability.ready" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
