<?xml version="1.0" encoding="UTF-8"?>
<!-- persona-4: a text over 2000 characters is refused where it is sent. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="persona" type="scxml" src="../../../persona.scx">
    <param name="traits" expr='["curious", "  patient with children "]'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.persona.output" cond='JSON.stringify(_event.data.traits) === "[\"curious\",\"patient with children\"]" &amp;&amp; _event.data.description === null' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.ready" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.persona.revise" target="#_persona"><content expr="({text: 'a'.repeat(2001), reason: 'long'})"/></send>
    </onentry>
    <transition event="error.execution" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="harness.waited" delay="300ms"/>
    </onentry>
    <transition event="harness.waited" target="step4"/>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
