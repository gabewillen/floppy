<?xml version="1.0" encoding="UTF-8"?>
<!-- persona-1: a persona without a database wakes with its owner's traits and no description, then is ready and offers revise. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="offers" expr="null"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="persona" type="scxml" src="../../../persona.scx">
    <param name="traits" expr='["curious", "  patient with children "]'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.persona.output" cond='JSON.stringify(_event.data.traits) === "[\"curious\",\"patient with children\"]" &amp;&amp; _event.data.description === null' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.ready" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <decision:offers location="offers" target="'#_persona'"/>
    </onentry>
    <transition cond="offers.length === 1 &amp;&amp; offers[0].event === 'bot.ability.persona.revise' &amp;&amp; offers[0].effort === 2 &amp;&amp; offers[0].target === undefined &amp;&amp; offers[0].schema.required.join() === 'text,reason' &amp;&amp; offers[0].schema.properties.text.maxLength === 2000 &amp;&amp; offers[0].schema.properties.reason.maxLength === 500 &amp;&amp; typeof offers[0].description === 'string'" target="step3"/>
    <transition target="fail"><log label="unexpected" expr="'offers ' + JSON.stringify(offers)"/></transition>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
