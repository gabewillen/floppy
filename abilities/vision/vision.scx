<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's VisualClassification ability (mosfet abilities/vision
  classification, with the rule-based classifier of mosfet's mlx_vlm
  provider): it classifies a reading input before the reading pipeline
  routes it. Reading (abilities/reading/reading.scx) invokes it as its long-lived
  child "vision".

    Unclassified -bot.ability.vision.classification.input-> Classifying
      -bot.ability.vision.classification.apply.completed-> Unclassified

  Classifying applies the classifier (mosfet's mlx_vlm VisualClassifier, no
  model): a text input whose text is not blank is text, an image input with
  a reference is image, anything else is unreadable, each with confidence
  1.0 (the classifier's defaults). It sends its classification to itself
  as bot.ability.vision.classification.apply.completed (mosfet's private
  completion), and the transition taking it answers the parent with
  bot.ability.vision.classification.output {kind, confidence}. This
  classifier cannot fail, so bot.ability.vision.classification.apply.failed
  and bot.ability.failed are never raised.

  Media by reference: an image input's content is a reference (a URI
  reference) to the image file in the media directory the run grants;
  classifying it reads nothing.

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema. A send whose data does not satisfy its schema is
  error.execution in its sender, so no cond rechecks a payload.

  Bindings: none (no service, no I/O).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="VisualClassification" initial="Unclassified">
  <datamodel>
    <data id="kind" expr="null"/>
    <data id="content" expr="null"/>
    <data id="classification" expr="null"/>
  </datamodel>
  <script src="vision.js"/>

  <state id="Unclassified">
    <transition event="bot.ability.vision.classification.input"
                event:schema="schemas/bot.ability.vision.classification.input.json" target="Classifying">
      <assign location="kind" expr="_event.data.kind"/>
      <assign location="content" expr="_event.data.content"/>
    </transition>
  </state>

  <!-- The classifier: mosfet's mlx_vlm VisualClassifier rule. -->
  <state id="Classifying">
    <onentry>
      <if cond="classifiesAsText()">
        <assign location="classification" expr="'text'"/>
      <elseif cond="classifiesAsImage()"/>
        <assign location="classification" expr="'image'"/>
      <else/>
        <assign location="classification" expr="'unreadable'"/>
      </if>
      <send event="bot.ability.vision.classification.apply.completed" target="#_internal">
        <param name="kind" expr="classification"/>
        <param name="confidence" expr="1.0"/>
      </send>
    </onentry>
    <transition event="bot.ability.vision.classification.apply.completed"
                event:schema="schemas/bot.ability.vision.classification.apply.completed.json" target="Unclassified">
      <log label="vision.classification" expr="_event.data.kind"/>
      <send event="bot.ability.vision.classification.output" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
  </state>
</scxml>
