<?xml version="1.0" encoding="UTF-8"?>
<!-- autonomy-6: a batch no seed triggers runs nothing: no-behaviors, no acted. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="autonomy" type="scxml" src="../../../autonomy.scx">
    <param name="turn" expr="11"/>
    <param name="input" expr='{"focus": null, "focus_candidates": []}'/>
    <param name="stimulus" expr='{"event": "bot.perceived", "data": {"percepts": [{"stimulus": {"event": "bot.input", "data": {"observation": {"event": "text", "data": "hello"}}, "source": "listening"}, "source": "listening", "participants": []}, {"stimulus": {"event": "environment.sound", "data": "noise", "source": "listening"}, "source": "listening", "participants": []}]}, "source": "session.floppy"}'/>
    <param name="database" expr="null"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.autonomy" cond='_event.data.turn === 11 &amp;&amp; _event.data.handled === false &amp;&amp; _event.data.reason === "no-behaviors" &amp;&amp; JSON.stringify(_event.data.candidates) === "[]" &amp;&amp; _event.data.selected === undefined &amp;&amp; _event.data.acted === undefined' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
