<?xml version="1.0" encoding="UTF-8"?>
<!-- autonomy-1: non-speech stimulus data of any shape runs nothing. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="autonomy" type="scxml" src="../../../autonomy.scx">
    <param name="memory" expr="null"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.autonomy.input" target="#_autonomy"><content expr='{"turn": 4, "input": {"focus": null, "focus_candidates": []}, "stimulus": {"event": "environment.sound", "data": "noise", "source": "listening"}}'/></send>
    </onentry>
    <transition event="bot.ability.autonomy.output" cond='_event.data.turn === 4 &amp;&amp; _event.data.handled === false &amp;&amp; _event.data.reason === "no-behaviors" &amp;&amp; JSON.stringify(_event.data.candidates) === "[]" &amp;&amp; _event.data.selected === undefined' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
