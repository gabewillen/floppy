<?xml version="1.0" encoding="UTF-8"?>
<!-- intuition-4: an event whose required data cannot be filled is not offered. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="intuition" type="scxml" src="../../../intuition.scx">
    <param name="turn" expr="7"/>
    <param name="stimulus" expr='{"event": "bot.input", "data": {"observation": {"event": "text", "data": "hello"}}, "source": "body"}'/>
    <param name="focus" expr="null"/>
    <param name="choices" expr='[{"event": "bot.say", "schema": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}}}]'/>
    <param name="decision_timeout_ms" expr="150000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.intuition" cond="_event.data.turn === 7 &amp;&amp; _event.data.handled === false &amp;&amp; _event.data.reason === &quot;empty_product&quot; &amp;&amp; typeof _event.data.confidence_tuner === 'object' &amp;&amp; _event.data.confidence_tuner.n === 0" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
