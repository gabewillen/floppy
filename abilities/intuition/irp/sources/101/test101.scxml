<?xml version="1.0" encoding="UTF-8"?>
<!-- intuition-1: a required member is filled from the stimulus data. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="intuition" type="scxml" src="../../../intuition.scx">
    <param name="turn" expr="2"/>
    <param name="stimulus" expr='{"event": "bot.input", "data": {"text": "hi"}, "source": "body"}'/>
    <param name="focus" expr="null"/>
    <param name="choices" expr='[{"event": "bot.say", "schema": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}}, "target": "session"}]'/>
    <param name="decision_timeout_ms" expr="150000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.say" cond='JSON.stringify(_event.data) === "{\"text\":\"hi\"}"' target="step1"/>
  </state>
  <state id="step1">
    <transition event="done.invoke.intuition" cond="_event.data.turn === 2 &amp;&amp; _event.data.handled === true &amp;&amp; _event.data.reason === &quot;none&quot; &amp;&amp; typeof _event.data.confidence_tuner === 'object' &amp;&amp; Array.isArray(_event.data.acted) &amp;&amp; typeof _event.data.bytes_per_token === 'number' &amp;&amp; JSON.stringify(_event.data.selected) === &quot;[{\&quot;data\&quot;:{\&quot;text\&quot;:\&quot;hi\&quot;},\&quot;event\&quot;:\&quot;bot.say\&quot;,\&quot;target\&quot;:\&quot;session\&quot;}]&quot;" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
