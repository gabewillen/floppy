<?xml version="1.0" encoding="UTF-8"?>
<!-- intuition-2: the confidence is the selections' minimum, observed by the tuner: 38 clears the warmup floor. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="intuition" type="scxml" src="../../../intuition.scx">
    <param name="turn" expr="1"/>
    <param name="stimulus" expr='{"event": "bot.input", "data": {"observation": {"event": "text", "data": "hello"}}, "source": "body"}'/>
    <param name="focus" expr="null"/>
    <param name="choices" expr='[{"event": "bot.say", "schema": {}, "target": "session"}, {"event": "bot.ability.cognition.ignore", "schema": {}, "target": "session"}]'/>
    <param name="decision_timeout_ms" expr="150000"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.say" target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.cognition.ignore" target="step2"/>
  </state>
  <state id="step2">
    <transition event="done.invoke.intuition" cond="_event.data.turn === 1 &amp;&amp; _event.data.handled === true &amp;&amp; _event.data.reason === &quot;none&quot; &amp;&amp; typeof _event.data.tuner === 'object' &amp;&amp; JSON.stringify(_event.data.selected) === &quot;[{\&quot;data\&quot;:{},\&quot;event\&quot;:\&quot;bot.say\&quot;,\&quot;target\&quot;:\&quot;session\&quot;},{\&quot;data\&quot;:{},\&quot;event\&quot;:\&quot;bot.ability.cognition.ignore\&quot;,\&quot;target\&quot;:\&quot;session\&quot;}]&quot; &amp;&amp; _event.data.tuner.n === 1 &amp;&amp; _event.data.tuner.mean === 38" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
