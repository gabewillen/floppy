<?xml version="1.0" encoding="UTF-8"?>
<!-- seeing-2: a view without media type, kind or participants hands them on as null and empty. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="seeing" type="scxml" src="../../../seeing.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="environment.visual" target="#_seeing"><content expr='{"image": "media/a.png", "source": "camera-1"}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond='JSON.stringify(_event.data) === "{\"participants\":[],\"stimulus\":{\"data\":{\"cause\":\"change\",\"participants\":[],\"views\":[{\"age_ms\":0,\"change\":null,\"description\":null,\"image\":\"media/a.png\",\"kind\":null,\"media_type\":null,\"objects\":null,\"participants\":[]}]},\"event\":\"bot.ability.seeing.sight\",\"source\":\"camera-1\"}}"' target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
