<?xml version="1.0" encoding="UTF-8"?>
<!-- seeing-6: a look sees every fresh view newest first, with the views' participants merged. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="seeing" type="scxml" src="../../../seeing.scx"/>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.offers" cond="_event.data.ability === 'seeing' &amp;&amp; _event.data.choices.length === 1 &amp;&amp; _event.data.choices[0].event === 'bot.ability.seeing.look' &amp;&amp; _event.data.choices[0].target === undefined &amp;&amp; _event.data.choices[0].schema.title === undefined &amp;&amp; _event.data.choices[0].schema['$schema'] === undefined &amp;&amp; _event.data.choices[0].schema.examples === undefined &amp;&amp; _event.data.choices[0].schema.additionalProperties === false" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="environment.visual" target="#_seeing"><content expr='{"image": "media/a.png", "media_type": "image/png", "source": "camera-1", "participants": [{"ref": "person-1", "role": "source"}]}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond='JSON.stringify(_event.data) === "{\"participants\":[{\"ref\":\"person-1\",\"role\":\"source\"}],\"stimulus\":{\"data\":{\"cause\":\"change\",\"participants\":[{\"ref\":\"person-1\",\"role\":\"source\"}],\"views\":[{\"age_ms\":0,\"change\":null,\"description\":null,\"image\":\"media/a.png\",\"kind\":null,\"media_type\":\"image/png\",\"objects\":null,\"participants\":[{\"ref\":\"person-1\",\"role\":\"source\"}]}]},\"event\":\"bot.ability.seeing.sight\",\"source\":\"camera-1\"}}"' target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="harness.waited" delay="10s"/>
    </onentry>
    <transition event="harness.waited" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="environment.visual" target="#_seeing"><content expr='{"image": "media/b.png", "media_type": "image/png", "source": "camera-2", "participants": [{"ref": "person-2", "role": "source"}, {"ref": "person-1", "role": "source"}]}'/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond='JSON.stringify(_event.data) === "{\"participants\":[{\"ref\":\"person-2\",\"role\":\"source\"},{\"ref\":\"person-1\",\"role\":\"source\"}],\"stimulus\":{\"data\":{\"cause\":\"change\",\"participants\":[{\"ref\":\"person-2\",\"role\":\"source\"},{\"ref\":\"person-1\",\"role\":\"source\"}],\"views\":[{\"age_ms\":0,\"change\":null,\"description\":null,\"image\":\"media/b.png\",\"kind\":null,\"media_type\":\"image/png\",\"objects\":null,\"participants\":[{\"ref\":\"person-2\",\"role\":\"source\"},{\"ref\":\"person-1\",\"role\":\"source\"}]}]},\"event\":\"bot.ability.seeing.sight\",\"source\":\"camera-2\"}}"' target="step4"/>
  </state>
  <state id="step4">
    <onentry>
      <send event="harness.waited" delay="10s"/>
    </onentry>
    <transition event="harness.waited" target="step5"/>
  </state>
  <state id="step5">
    <onentry>
      <send event="bot.ability.seeing.look" target="#_seeing"><content expr="({})"/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond='JSON.stringify(_event.data) === "{\"participants\":[{\"ref\":\"person-2\",\"role\":\"source\"},{\"ref\":\"person-1\",\"role\":\"source\"}],\"stimulus\":{\"data\":{\"cause\":\"look\",\"participants\":[{\"ref\":\"person-2\",\"role\":\"source\"},{\"ref\":\"person-1\",\"role\":\"source\"}],\"views\":[{\"age_ms\":10000,\"change\":null,\"description\":null,\"image\":\"media/b.png\",\"kind\":null,\"media_type\":\"image/png\",\"objects\":null,\"participants\":[{\"ref\":\"person-2\",\"role\":\"source\"},{\"ref\":\"person-1\",\"role\":\"source\"}]},{\"age_ms\":20000,\"change\":null,\"description\":null,\"image\":\"media/a.png\",\"kind\":null,\"media_type\":\"image/png\",\"objects\":null,\"participants\":[{\"ref\":\"person-1\",\"role\":\"source\"}]}]},\"event\":\"bot.ability.seeing.sight\",\"source\":\"seeing\"}}"' target="step6"/>
  </state>
  <state id="step6">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
