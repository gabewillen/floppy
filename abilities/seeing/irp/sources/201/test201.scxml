<?xml version="1.0" encoding="UTF-8"?>
<!-- seeing-11: frame difference: a file that is no image is not handed on; a look still sees it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="seeing" type="scxml" src="../../../seeing.scx">
    <param name="measure" expr="'frame_diff'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.ready" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="environment.visual" target="#_seeing"><content expr='{"image": "media/text.png", "media_type": "image/png", "source": "camera-1"}'/></send>
      <send event="harness.waited" delay="1s"/>
    </onentry>
    <transition event="harness.waited" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="bot.ability.seeing.look" target="#_seeing"><content expr="({})"/></send>
    </onentry>
    <transition event="bot.ability.cognition.input" cond='JSON.stringify(_event.data) === "{\"participants\":[],\"stimulus\":{\"data\":{\"cause\":\"look\",\"participants\":[],\"views\":[{\"age_ms\":1000,\"change\":null,\"description\":null,\"image\":\"media/text.png\",\"kind\":null,\"media_type\":\"image/png\",\"objects\":null,\"participants\":[]}]},\"event\":\"bot.ability.seeing.sight\",\"source\":\"seeing\"}}"' target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
