<?xml version="1.0" encoding="UTF-8"?>
<!-- memory-6: two requests sent together are answered in order, and the session goes on. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.memory.input" target="#_memory"><content expr='{"id": "r1", "statements": [{"sql": "INSERT INTO bot_memory (memory_id, content) VALUES (?, ?)", "parameters": ["m1", "A"]}]}'/></send>
      <send event="bot.ability.memory.input" target="#_memory"><content expr='{"id": "r2", "statements": [{"sql": "SELECT content FROM bot_memory"}]}'/></send>
    </onentry>
    <transition event="bot.ability.memory.output" cond="_event.data.id === 'r1' &amp;&amp; _event.data.results[0].rowcount === 1" target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.memory.output" cond="_event.data.id === 'r2' &amp;&amp; _event.data.results[0].rows.length === 1 &amp;&amp; _event.data.results[0].rows[0].values[0] === 'A'" target="step2"/>
  </state>
  <state id="step2">
    <onentry>
      <send event="harness.waited" delay="300ms"/>
    </onentry>
    <transition event="harness.waited" target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
