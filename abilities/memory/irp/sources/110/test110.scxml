<?xml version="1.0" encoding="UTF-8"?>
<!-- memory-2: an insert and a select answer one result each, in order, the parameters bound and the schema's defaults applied. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
    <param name="statements" expr='[{"sql": "INSERT INTO bot_memory (memory_id, content) VALUES (?, ?)", "parameters": ["m1", "Floppy"]}, {"sql": "SELECT content, scope FROM bot_memory WHERE memory_id = ?", "parameters": ["m1"]}]'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.ability.memory.output" cond="_event.data.results.length === 2 &amp;&amp; _event.data.results[0].rowcount === 1 &amp;&amp; _event.data.results[0].rows.length === 0 &amp;&amp; _event.data.results[1].rows.length === 1 &amp;&amp; JSON.stringify(_event.data.results[1].rows[0].columns) === '[&quot;content&quot;,&quot;scope&quot;]' &amp;&amp; _event.data.results[1].rows[0].values[0] === 'Floppy' &amp;&amp; _event.data.results[1].rows[0].values[1] === 'memory'" target="step1"/>
  </state>
  <state id="step1">
    <transition event="done.invoke.memory" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
