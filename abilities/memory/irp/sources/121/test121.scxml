<?xml version="1.0" encoding="UTF-8"?>
<!-- memory-3: a constraint violation answers bot.ability.failed with the engine's message. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.memory.input" target="#_memory"><content expr='{"id": "r1", "statements": [{"sql": "INSERT INTO bot_memory (memory_id, content) VALUES (?, ?)", "parameters": ["m1", "A"]}, {"sql": "INSERT INTO bot_memory (memory_id, content) VALUES (?, ?)", "parameters": ["m1", "B"]}]}'/></send>
    </onentry>
    <transition event="bot.ability.failed" cond="_event.data.id === 'r1' &amp;&amp; typeof _event.data.message === 'string' &amp;&amp; _event.data.message === 'UNIQUE constraint failed: bot_memory.memory_id' &amp;&amp; _event.data.kind === 'store_failed'" target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
