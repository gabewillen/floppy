<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Memory ability: the bot's one memory, a long-lived session that
  serves transactions of statements against the bot's memory database,
  through the sql service (services/sql, SQLite) or the pgsql service
  (services/pgsql, Postgres over its wire protocol). The bot invokes it
  once, as <invoke id="memory"> in floppy.scx's live, and passes its
  address (#_scxml_ + its session id) to every ability as the <param>
  memory; an ability that remembers sends it requests from the state that
  needs memory (decision D262).

    opening -> migrating -> serving { idle <-> applying }
                         -> unavailable

  Input: the <param> database. The database names the engine: a file path
  is a SQLite database in the directory the run grants the sql service; a
  Postgres connection URI (postgresql://USER@IP:PORT/DBNAME) is a Postgres
  database the run lets the pgsql service reach.

  Requests: bot.ability.memory.input {id, statements} ([{sql,
  parameters?}], at least one), from any session. The statements are the
  requester's own SQL, passed to the engine unchanged, in one transaction.
  The memory answers the request's sender (_event.origin) with
  bot.ability.memory.output {id, results} (one result per statement, in
  order), or bot.ability.failed {id, message, kind} when nothing was
  committed, kind one of: unavailable when the database could not be
  brought to the head revision or a service could not run, invalid_input
  when the service refused the statements, store_failed when the
  transaction failed and rolled back, timeout when it did not finish
  within operation_timeout_ms (the <param>, 60 s by default; "Memory did
  not finish within 60s."). One transaction runs at a time: a request that
  arrives while migrating or applying waits (<event:defer/>), in order.

  opening picks the engine. migrating invokes the migration ability
  (abilities/migration/migration.scx, Alembic's upgrade head) once, with
  floppy's revisions in the engine's dialect (abilities/memory/sqlite/ and
  abilities/memory/postgresql/): two revisions. 0001 (decision D193)
  creates the memory, behavior (with its lifetime), behavior trigger and
  short-term register tables, bot_stm_turn, the short-term memory of
  turns, and the people long-term memory holds (bot_person, and
  bot_person_embedding, the embeddings heard for each person, kind
  voice; decision D194); 0002 (decision D256) creates
  bot_memory_embedding, the embeddings of what memory holds (kind text,
  a cognitive episode's words), shaped like bot_person_embedding. On
  Postgres the defaulted created_at and updated_at are TIMESTAMPTZ DEFAULT
  NOW(). The database carries Alembic's alembic_version. A database at a
  revision the history does not hold is refused untouched, and the memory
  is then unavailable: it answers every request with kind unavailable
  (timeout when the migration did not finish within
  operation_timeout_ms).
  applying runs one request's statements in one transaction, then the
  memory is idle again.

  Bindings: the migration namespace package (through the migration
  ability) and the sql and pgsql service packages; a run grants both (scx
  run's dir option for sql, and its wasi option inherit-network for
  pgsql), because scx binds every service a document names before the run
  starts, though a run uses only the engine its database names.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="memory" initial="opening">
  <datamodel>
    <!-- The invoker's <param>s. -->
    <data id="database" expr="null"/>
    <!-- The schema: floppy's Alembic revision, one file per engine
         (decision D193). -->
    <data id="sqlite_0001" src="sqlite/0001_initial_memory_schema.json"/>
    <data id="postgresql_0001" src="postgresql/0001_initial_memory_schema.json"/>
    <data id="sqlite_0002" src="sqlite/0002_memory_embedding.json"/>
    <data id="postgresql_0002" src="postgresql/0002_memory_embedding.json"/>
    <!-- The engine: Postgres for a postgresql:// URI, else SQLite. -->
    <data id="postgres" expr="false"/>
    <!-- A transaction's time bound (60 s), which the invoker may set as a
         <param>. -->
    <data id="operation_timeout_ms" expr="60000"/>
    <!-- Why the database could not be brought to the head revision, and
         the kind every request then fails with: unavailable, or timeout
         when the migration did not finish in time. -->
    <data id="unavailable_reason" expr="null"/>
    <data id="unavailable_kind" expr="'unavailable'"/>
    <!-- The request being applied: its id, its sender and its statements. -->
    <data id="request" expr="null"/>
    <data id="failure" expr="null"/>
    <!-- The failure's kind: unavailable, invalid_input, store_failed or
         timeout. -->
    <data id="failure_kind" expr="null"/>
  </datamodel>
  <script src="memory.js"/>

  <!-- Pick the engine the database names. -->
  <state id="opening">
    <onentry>
      <assign location="postgres" expr="isPostgresDatabase()"/>
    </onentry>
    <transition target="migrating"/>
  </state>

  <!-- Bring the database to the head revision, once, bounded by
       operation_timeout_ms. Requests wait. -->
  <state id="migrating">
    <onentry>
      <send id="migrating-after" event="migrating.after" delayexpr="operationTimeoutDelay()"/>
    </onentry>
    <onexit>
      <cancel sendid="migrating-after"/>
    </onexit>
    <invoke id="migration" type="scxml" src="../migration/migration.scx">
      <param name="database" expr="database"/>
      <param name="revisions" expr="engineRevisions()"/>
    </invoke>
    <transition event="bot.ability.memory.input" event:schema="../schemas/bot.ability.memory.input.json">
      <event:defer/>
    </transition>
    <transition event="bot.ability.migration.output" event:schema="../schemas/bot.ability.migration.output.json" target="serving"/>
    <transition event="migrating.after" target="unavailable">
      <assign location="unavailable_reason" expr="timeoutFailure()"/>
      <assign location="unavailable_kind" expr="'timeout'"/>
    </transition>
    <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" target="unavailable">
      <assign location="unavailable_reason" expr="_event.data.message"/>
    </transition>
    <transition event="error.*" target="unavailable">
      <assign location="unavailable_reason" expr="couldNotRunFailure(_event)"/>
    </transition>
  </state>

  <!-- The database is not serving: every request fails. -->
  <state id="unavailable">
    <transition event="bot.ability.memory.input" event:schema="../schemas/bot.ability.memory.input.json">
      <send event="bot.ability.failed" targetexpr="_event.origin">
        <param name="id" expr="_event.data.id"/>
        <param name="message" expr="unavailable_reason"/>
        <param name="kind" expr="unavailable_kind"/>
      </send>
    </transition>
  </state>

  <state id="serving" initial="idle">
    <state id="idle">
      <transition event="bot.ability.memory.input" event:schema="../schemas/bot.ability.memory.input.json" target="applying">
        <assign location="request" expr="requestOf(_event)"/>
      </transition>
    </state>

    <!-- Apply one request's statements, in one transaction, on the
         database's engine, bounded by operation_timeout_ms: leaving
         applying cancels the transaction. -->
    <state id="applying" initial="applying_from">
      <onentry>
        <send id="applying-after" event="applying.after" delayexpr="operationTimeoutDelay()"/>
      </onentry>
      <onexit>
        <cancel sendid="applying-after"/>
      </onexit>
      <transition event="bot.ability.memory.input" event:schema="../schemas/bot.ability.memory.input.json">
        <event:defer/>
      </transition>
      <transition event="applying.after" target="failing">
        <assign location="failure" expr="timeoutFailure()"/>
        <assign location="failure_kind" expr="'timeout'"/>
      </transition>
      <state id="applying_from">
        <transition cond="postgres" target="applying_postgres"/>
        <transition target="applying_sqlite"/>
      </state>
      <state id="applying_sqlite">
        <invoke id="apply" type="https://github.com/stateforward/floppy/services/sql">
          <param name="database" expr="database"/>
          <param name="statements" expr="request.statements"/>
        </invoke>
      </state>
      <state id="applying_postgres">
        <invoke id="apply_postgres" type="https://github.com/stateforward/floppy/services/pgsql">
          <param name="database" expr="database"/>
          <param name="statements" expr="request.statements"/>
        </invoke>
      </state>
      <transition event="sql.result" target="idle">
        <send event="bot.ability.memory.output" targetexpr="request.origin">
          <param name="id" expr="request.id"/>
          <param name="results" expr="_event.data.results"/>
        </send>
      </transition>
      <!-- The transaction failed and rolled back. -->
      <transition event="sql.failed" target="failing">
        <assign location="failure" expr="_event.data.message"/>
        <assign location="failure_kind" expr="'store_failed'"/>
      </transition>
      <!-- The service refused the statements before opening the database. -->
      <transition event="error.execution" target="failing">
        <assign location="failure" expr="couldNotRunFailure(_event)"/>
        <assign location="failure_kind" expr="'invalid_input'"/>
      </transition>
      <transition event="error.*" target="failing">
        <assign location="failure" expr="couldNotRunFailure(_event)"/>
        <assign location="failure_kind" expr="'unavailable'"/>
      </transition>
    </state>

    <state id="failing">
      <onentry>
        <send event="bot.ability.failed" targetexpr="request.origin">
          <param name="id" expr="request.id"/>
          <param name="message" expr="failure"/>
          <param name="kind" expr="failure_kind"/>
        </send>
      </onentry>
      <transition target="idle"/>
    </state>
  </state>
</scxml>
