<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Memory ability (mosfet abilities/memory: memory.py Memory,
  store.py MemoryStore on providers/sqlite_memory): one transaction of
  mosfet's Statements against the bot's memory database, through the sql
  service (services/sql). An ability that remembers invokes it from the
  state that needs memory (reasoning's recalling and retaining, the
  identity's recalling and adopting, the conversation's recalling), so
  attaching memory is implicit: the invocation is the attachment, and
  leaving the invoking state cancels it.

    migrating -> applying -> applied (final)

  Input: the <param>s database (the database file, in the directory the run
  grants the sql service) and statements (mosfet's InputData.statements:
  [{sql, parameters?}], at least one).

  migrating reads PRAGMA user_version. applying runs, in one transaction,
  the migrations the database lacks (mosfet's Alembic revisions 0001 and
  0002 as user_version 1 and 2: the same tables, columns, defaults and
  indexes, each recorded by its user_version) and then the statements. A
  database whose version is newer than 2 is refused untouched. Two
  invocations that migrate one fresh database at once are serialized by
  SQLite; the one that loses retries once from migrating.

  Output (to the parent, as mosfet's Memory answers): bot.ability.memory.output
  {results} (mosfet's OutputData: one result per statement, in order,
  without the migrations'), or bot.ability.failed {message} (mosfet's
  FailureData) when nothing was committed. Then the session ends.

  Bindings: the sql service package (a run grants it its directory: scx
  run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" name="memory" initial="migrating">
  <datamodel>
    <!-- The invoker's <param>s. -->
    <data id="database" expr="null"/>
    <data id="statements" expr="[]"/>
    <!-- The schema: the head version and each revision's statements. -->
    <data id="head" expr="2"/>
    <data id="version" expr="0"/>
    <data id="revision_0001" expr="[
      'CREATE TABLE IF NOT EXISTS bot_memory (memory_id TEXT NOT NULL, scope TEXT DEFAULT \'memory\' NOT NULL, context_ref TEXT, subject_ref TEXT, kind TEXT, sensitivity TEXT, retention TEXT, content TEXT NOT NULL, content_format TEXT DEFAULT \'text/plain\' NOT NULL, query_tags TEXT, metadata_json TEXT DEFAULT \'{}\' NOT NULL, created_at TEXT DEFAULT (CURRENT_TIMESTAMP) NOT NULL, PRIMARY KEY (memory_id))',
      'CREATE INDEX IF NOT EXISTS bot_memory_context_idx ON bot_memory (context_ref, subject_ref)',
      'CREATE INDEX IF NOT EXISTS bot_memory_query_idx ON bot_memory (query_tags)',
      'CREATE INDEX IF NOT EXISTS bot_memory_scope_idx ON bot_memory (scope, created_at)',
      'CREATE TABLE IF NOT EXISTS bot_behavior (name TEXT NOT NULL, source TEXT NOT NULL, description TEXT DEFAULT \'\' NOT NULL, examples_json TEXT DEFAULT \'[]\' NOT NULL, status TEXT DEFAULT \'ACTIVE\' NOT NULL, status_reason TEXT DEFAULT \'\' NOT NULL, status_updated_at TEXT DEFAULT \'\' NOT NULL, used_count TEXT DEFAULT \'0\' NOT NULL, last_used_at TEXT DEFAULT \'\' NOT NULL, failed_count TEXT DEFAULT \'0\' NOT NULL, last_failed_at TEXT DEFAULT \'\' NOT NULL, created_at TEXT DEFAULT (CURRENT_TIMESTAMP) NOT NULL, updated_at TEXT DEFAULT (CURRENT_TIMESTAMP) NOT NULL, PRIMARY KEY (name))',
      'CREATE TABLE IF NOT EXISTS bot_behavior_trigger (behavior_name TEXT NOT NULL, &quot;trigger&quot; TEXT NOT NULL, PRIMARY KEY (behavior_name, &quot;trigger&quot;), FOREIGN KEY(behavior_name) REFERENCES bot_behavior (name) ON DELETE CASCADE)',
      'CREATE INDEX IF NOT EXISTS bot_behavior_trigger_event_idx ON bot_behavior_trigger (&quot;trigger&quot;)',
      'CREATE TABLE IF NOT EXISTS bot_stm_memory (stm_id TEXT NOT NULL, stimulus_name TEXT NOT NULL, payload_json TEXT DEFAULT \'{}\' NOT NULL, event_id TEXT, source TEXT, target TEXT, created_at TEXT NOT NULL, last_accessed_at TEXT, PRIMARY KEY (stm_id))',
      'CREATE INDEX IF NOT EXISTS bot_stm_memory_recent_idx ON bot_stm_memory (stimulus_name, created_at)',
      'CREATE INDEX IF NOT EXISTS bot_stm_memory_created_idx ON bot_stm_memory (created_at)',
      'PRAGMA user_version = 1'
    ]"/>
    <data id="revision_0002" expr="[
      'ALTER TABLE bot_behavior ADD COLUMN lifetime TEXT DEFAULT \'turn\' NOT NULL',
      'PRAGMA user_version = 2'
    ]"/>
    <data id="migrations" expr="[]"/>
    <data id="retried" expr="false"/>
    <data id="failure" expr="null"/>
  </datamodel>
  <script src="memory.js"/>

  <!-- Read the database's schema version. -->
  <state id="migrating">
    <invoke id="reading" type="https://github.com/stateforward/floppy/services/sql">
      <param name="database" expr="database"/>
      <param name="statements" expr="userVersionStatements()"/>
    </invoke>
    <transition event="sql.result" cond="isReading(_event)" target="applying">
      <assign location="version" expr="userVersion(_event)"/>
      <assign location="migrations" expr="missingRevisions()"/>
      <assign location="migrations" expr="migrationStatements()"/>
    </transition>
    <transition event="sql.failed" cond="isReading(_event)" target="failing">
      <assign location="failure" expr="_event.data.message"/>
    </transition>
    <transition event="error.*" target="failing">
      <assign location="failure" expr="couldNotRunFailure(_event)"/>
    </transition>
  </state>

  <!-- Migrate what is missing and apply the statements, in one
       transaction. -->
  <state id="applying">
    <transition cond="isUnknownVersion()" target="failing">
      <assign location="failure" expr="'the memory database\'s schema version is not one this ability knows'"/>
    </transition>
    <invoke id="apply" type="https://github.com/stateforward/floppy/services/sql">
      <param name="database" expr="database"/>
      <param name="statements" expr="appliedStatements()"/>
    </invoke>
    <transition event="sql.result" cond="isApply(_event)" target="applied">
      <send event="bot.ability.memory.output" target="#_parent">
        <param name="results" expr="statementResults(_event)"/>
      </send>
    </transition>
    <transition event="sql.failed" cond="canRetryMigration(_event)" target="migrating">
      <assign location="retried" expr="true"/>
    </transition>
    <transition event="sql.failed" cond="isApply(_event)" target="failing">
      <assign location="failure" expr="_event.data.message"/>
    </transition>
    <transition event="error.*" target="failing">
      <assign location="failure" expr="couldNotRunFailure(_event)"/>
    </transition>
  </state>

  <state id="failing">
    <onentry>
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="failure"/>
      </send>
    </onentry>
    <transition target="applied"/>
  </state>

  <final id="applied"/>
</scxml>
