<?xml version="1.0" encoding="UTF-8"?>
<!-- reasoning-7: with a database and no choices, the recall still runs and the turn fails for its choices. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="memory" type="scxml" src="../../../../../abilities/memory/memory.scx">
    <param name="database" expr="'/memory/floppy.sqlite'"/>
  </invoke>
  <invoke id="reasoning" type="scxml" src="../../../reasoning.scx">
    <param name="turn" expr="1"/>
    <param name="stimulus" expr='{"event": "bot.input", "data": {"observation": {"event": "text", "data": "say hi"}}, "source": "gabe"}'/>
    <param name="focus" expr="null"/>
    <param name="focus_candidates" expr="[]"/>
    <param name="choices" expr="[]"/>
    <param name="model" expr="'mock-model'"/>
    <param name="memory" expr="'#_scxml_' + _sessionid + '.memory'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="done.invoke.reasoning" cond='_event.data.turn === 1 &amp;&amp; _event.data.handled === false &amp;&amp; _event.data.failed === true &amp;&amp; _event.data.reason === "the reasoning has no choices to select from"' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="generate.progress"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
