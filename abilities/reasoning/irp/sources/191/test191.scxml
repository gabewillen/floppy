<?xml version="1.0" encoding="UTF-8"?>
<!-- reasoning-10: a cancelled turn is never answered; the next turn is. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="reasoning" type="scxml" src="../../../reasoning.scx">
    <param name="model" expr="'mock-model'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.processing.input" target="#_reasoning"><content expr='({turn: 1, stimulus: {"event": "bot.input", "data": {"observation": {"event": "text", "data": "say hi"}}, "source": "gabe"}, focus: null, focus_candidates: [], choices: [{"event": "bot.ability.cognition.ignore", "schema": {"type": "object", "properties": {}, "additionalProperties": false}, "description": "Ignore the stimulus.", "target": "session.reasoning"}, {"event": "bot.ability.communication.respond", "schema": {"type": "object", "properties": {"parts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "properties": {"words": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "required": ["parts"], "additionalProperties": false}, "description": "Say something.", "target": "session"}, {"event": "bot.focus_device", "schema": {"type": "object", "properties": {"device": {"type": "string", "minLength": 1}}, "required": ["device"], "additionalProperties": false}, "description": "Look at a device.", "target": "session"}, {"event": "lamp.on", "schema": {"type": "object", "properties": {}, "additionalProperties": false}, "description": "Turn the lamp on.", "target": "session"}], held: [], environment: null, self: null, acted: [], recent: [], max_context_tokens: null, completion_reserve_tokens: 0, bytes_per_token: 3})'/></send>
      <send event="bot.ability.processing.cancel" target="#_reasoning"><content expr="{}"/></send>
      <send event="bot.ability.processing.input" target="#_reasoning"><content expr='({turn: 2, stimulus: {"event": "bot.input", "data": {"observation": {"event": "text", "data": "say hi"}}, "source": "gabe"}, focus: null, focus_candidates: [], choices: [{"event": "bot.ability.cognition.ignore", "schema": {"type": "object", "properties": {}, "additionalProperties": false}, "description": "Ignore the stimulus.", "target": "session.reasoning"}, {"event": "bot.ability.communication.respond", "schema": {"type": "object", "properties": {"parts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "properties": {"words": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "required": ["parts"], "additionalProperties": false}, "description": "Say something.", "target": "session"}, {"event": "bot.focus_device", "schema": {"type": "object", "properties": {"device": {"type": "string", "minLength": 1}}, "required": ["device"], "additionalProperties": false}, "description": "Look at a device.", "target": "session"}, {"event": "lamp.on", "schema": {"type": "object", "properties": {}, "additionalProperties": false}, "description": "Turn the lamp on.", "target": "session"}], held: [], environment: null, self: null, acted: [], recent: [], max_context_tokens: null, completion_reserve_tokens: 0, bytes_per_token: 3})'/></send>
    </onentry>
    <transition event="bot.ability.communication.respond" cond="_event.data.parts.length === 1 &amp;&amp; _event.data.parts[0].words === 'Hi! I am floppy.'" target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.ability.processing.output" cond="_event.data.turn === 2 &amp;&amp; _event.data.handled === true &amp;&amp; _event.data.selected.length === 1" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="generate.progress"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
