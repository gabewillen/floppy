<?xml version="1.0" encoding="UTF-8"?>
<!-- reasoning-5: a stimulus with over 4096 collection items fails the turn without a model call. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="reasoning" type="scxml" src="../../../reasoning.scx">
    <param name="model" expr="'mock-model'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.processing.input" target="#_reasoning"><content expr="({turn: 1, focus: null, focus_candidates: [], choices: [{&quot;event&quot;: &quot;bot.ability.cognition.ignore&quot;, &quot;schema&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {}, &quot;additionalProperties&quot;: false}, &quot;description&quot;: &quot;Ignore the stimulus.&quot;, &quot;target&quot;: &quot;session.reasoning&quot;}, {&quot;event&quot;: &quot;bot.ability.communication.respond&quot;, &quot;schema&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;parts&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;minItems&quot;: 1, &quot;maxItems&quot;: 64, &quot;items&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;words&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;minLength&quot;: 1}}, &quot;additionalProperties&quot;: false}}}, &quot;required&quot;: [&quot;parts&quot;], &quot;additionalProperties&quot;: false}, &quot;description&quot;: &quot;Say something.&quot;, &quot;target&quot;: &quot;session&quot;}, {&quot;event&quot;: &quot;bot.focus_device&quot;, &quot;schema&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;device&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;minLength&quot;: 1}}, &quot;required&quot;: [&quot;device&quot;], &quot;additionalProperties&quot;: false}, &quot;description&quot;: &quot;Look at a device.&quot;, &quot;target&quot;: &quot;session&quot;}, {&quot;event&quot;: &quot;lamp.on&quot;, &quot;schema&quot;: {&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {}, &quot;additionalProperties&quot;: false}, &quot;description&quot;: &quot;Turn the lamp on.&quot;, &quot;target&quot;: &quot;session&quot;}], stimulus: ({event: 'bot.input', source: 'gabe', data: {items: Array.from({length: 4097}, (_, i) =&gt; i)}}), held: [], environment: null, self: null, acted: [], recent: [], max_context_tokens: null, completion_reserve_tokens: 0, bytes_per_token: 3})"/></send>
    </onentry>
    <transition event="bot.ability.processing.output" cond='_event.data.turn === 1 &amp;&amp; _event.data.handled === false &amp;&amp; _event.data.failed === true &amp;&amp; _event.data.reason === "prompt projection collection item budget exceeded"' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="generate.progress"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
