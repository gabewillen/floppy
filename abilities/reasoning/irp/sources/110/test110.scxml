<?xml version="1.0" encoding="UTF-8"?>
<!-- reasoning-2: no choices fail the turn without a model call (the backend would answer). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="reasoning" type="scxml" src="../../../reasoning.scx">
    <param name="model" expr="'mock-model'"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <onentry>
      <send event="bot.ability.processing.input" target="#_reasoning"><content expr='({turn: 1, stimulus: {"event": "bot.input", "data": {"observation": {"event": "text", "data": "say hi"}}, "source": "gabe"}, focus: null, focus_candidates: [], choices: [], held: [], environment: null, self: null, acted: [], recent: [], max_context_tokens: null, completion_reserve_tokens: 0, bytes_per_token: 3})'/></send>
    </onentry>
    <transition event="bot.ability.processing.output" cond='_event.data.turn === 1 &amp;&amp; _event.data.handled === false &amp;&amp; _event.data.failed === true &amp;&amp; _event.data.reason === "the reasoning has no choices to select from"' target="step1"/>
  </state>
  <state id="step1">
    <transition target="pass"/>
  </state>
  <transition event="generate.progress"/>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
