<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Reasoning stage (mosfet abilities/cognition/reasoning): the slow
  System 2 pass. The cognition (abilities/cognition/cognition.scx) invokes it once
  per turn that intuition left unhandled.

    recalling -> applying (an invoked generate service) -> dispatching ->
      retaining -> done

  Memory (mosfet Reasoning._recall_activity and _retain_activity): with a
  database (the <param> database, the memory database file), recalling
  invokes the memory ability (abilities/memory/memory.scx) with one
  transaction of mosfet's two selects, prior cognitive episodes
  (query_tags cognitive_episode) and standing directives (query_tags
  standing_directive), each for the turn's context or none, oldest first,
  at most 50, and sends itself bot.ability.reasoning.recalled with them and
  memory_consulted true; retaining inserts the turn's episode
  ({focus, focus_candidates, stimulus_name, output, behavior} as JSON,
  query_tags cognitive_episode) and sends itself
  bot.ability.reasoning.retained with memory_written true. The context is
  the stimulus's target_device (mosfet _context_ref_from_input). A recalled
  row that is not a JSON object is skipped, as mosfet skips one that does
  not validate. A memory failure fails the stage ("Reasoning memory recall
  failed: ..."). Without
  a database (mosfet's Reasoning without a memory collaborator) each step
  logs <log label="memory" expr="'absent'"> and sends its event with
  memory_consulted and memory_written false and nothing recalled. The
  model prompt carries the stimulus, the focus, and the recalled
  prior_episodes and standing_directives (mosfet ProcessorInput) as JSON,
  where mosfet renders it as model-facing XML. applying ends on the
  generate service's done.invoke, which stands in for mosfet's private
  bot.ability.reasoning.reasoned completion.

  Choices: the body's assembled choices for the turn (the <param>
  choices: the body's own and each ability's offers, tagged with the
  offering ability's invoke id as target). A selection is returned, not
  taken: the body routes it. The structured-output schema is built from
  the choices by <decision:selection>, as mosfet's dispatch tool:
  {events: [anyOf one branch per offered event]}, each branch {event (a
  one-value enum), data (the event's schema without $schema, title and
  examples), reason, and target (an enum of the abilities offering it) when
  an ability offers it}, every field required and no extra property, sent
  strict. The generate service returns only a reply that satisfies it, so a
  selection outside the choices (event or target) fails the stage as
  schema-mismatch. With no choices the stage fails without a model call.

  Dispatching (mosfet's apply activity dispatches the reasoned selections
  before bot.ability.reasoning.reasoned, cognition.types.
  dispatch_selected_events): <bot:verdict> removes the ignore selections
  and applies attention_selection_error with the turn's focus and
  focus_candidates, then <decision:route> places each on the target
  offering it in the choices (_resolve_target: a selection that names no
  target needs exactly one offerer). A selection that cannot be placed
  fails the stage with mosfet's SelectionRejectionError message, before
  anything is retained.

  Input: the <param>s turn, stimulus, focus, focus_candidates, choices,
  model and database. Output: <donedata>, received by the cognition as
  done.invoke.reasoning:

    {turn, handled: true, selected: [{event, data, reason, target?}]}
    {turn, handled: false, failed: true, reason}

  The cognition's hop timeout bounds the stage (leaving it cancels the model
  call, SCXML 6.4).

  Bindings: the generate service package, the decision namespace
  (<decision:selection> builds the schema, <decision:names> writes the
  logged choice names, <decision:route> places the selections) and the bot
  namespace (<bot:verdict>), resolved from their repository URIs, and the
  memory ability's sql service package (a run grants it its directory,
  scx run's dir option); env scopes FLOPPY_API_KEY and
  FLOPPY_BASE_URL to the service's <invoke> (no default backend: without
  either it answers generate.failed unconfigured). The generate service's
  events are recorded by one transition each.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:bot="https://github.com/stateforward/floppy/namespaces/bot"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="reasoning" initial="recalling">
  <datamodel>
    <!-- The turn, from the cognition's <param>s. -->
    <data id="turn" expr="0"/>
    <data id="stimulus" expr="null"/>
    <data id="focus" expr="null"/>
    <data id="focus_candidates" expr="[]"/>
    <data id="model" expr="'Qwen/Qwen3.8-Flash-Next'"/>
    <data id="choices" expr="[]"/>
    <data id="choice_names" expr="''"/>
    <data id="system" expr="'You are the deliberate reasoning of floppy, a small companion robot. You receive one stimulus the robot observed, as JSON, with what the robot is looking at. Select every event the robot should take for it from the offered events (an empty list selects none), with its data, its target when the event names one, and a short reason. When an offered event says something, give it the complete text to say.'"/>
    <!-- The model call: its schema, invocation, and reply. -->
    <data id="schema" expr="null"/>
    <data id="selected" expr="null"/>
    <data id="gen_failure" expr="null"/>
    <data id="result" expr="null"/>
    <!-- The selections being dispatched, and why they were rejected (null
         when placed). -->
    <data id="dispatch_selections" expr="[]"/>
    <data id="rejection" expr="null"/>
    <!-- Memory: the database file (null: no memory) and mosfet's
         statements (episodes.py, directives.py), with ?2 the context. The SQL runs on both
         engines (SQLite and Postgres). A memory id is the next row count
         as 32 zero-padded digits (neither engine's randomness is unique
         across invocations in Wasm); JSON rows are told by their
         content_format, oldest first by created_at, then memory_id. -->
    <data id="database" expr="null"/>
    <data id="context_ref" expr="null"/>
    <data id="prior_episodes" expr="[]"/>
    <data id="standing_directives" expr="[]"/>
    <data id="statements" expr="[]"/>
    <data id="episode" expr="null"/>
    <data id="episode_select" expr="'SELECT content FROM bot_memory WHERE query_tags = ?1 AND (CAST(?2 AS TEXT) IS NULL OR context_ref IS NULL OR context_ref = ?2) AND content_format = \'application/json\' ORDER BY created_at, memory_id LIMIT 50'"/>
    <data id="episode_insert" expr="'INSERT INTO bot_memory (memory_id, scope, context_ref, subject_ref, kind, sensitivity, retention, content, content_format, query_tags) VALUES ((SELECT substr(\'00000000000000000000000000000000\', 1, 32 - length(n)) || n FROM (SELECT CAST(COUNT(*) + 1 AS TEXT) AS n FROM bot_memory) AS c), ?1, ?2, NULL, ?3, ?4, ?5, ?6, ?7, ?8)'"/>
  </datamodel>
  <script src="reasoning.js"/>

  <!-- Recall prior episodes and standing directives, or nothing without
       a database. -->
  <state id="recalling" initial="recalling_from">
    <onentry>
      <assign location="context_ref" expr="contextRefFromInput()"/>
    </onentry>
    <state id="recalling_from">
      <transition cond="hasNoDatabase()" target="recalling_nothing"/>
      <transition target="recalling_memory"/>
    </state>
    <state id="recalling_nothing">
      <onentry>
        <log label="memory" expr="'absent'"/>
        <send event="bot.ability.reasoning.recalled" target="#_internal">
          <param name="turn" expr="turn"/>
          <param name="host_input" expr="hostInput()"/>
          <param name="prior_episodes" expr="[]"/>
          <param name="memory_consulted" expr="false"/>
          <param name="input" expr="focusInput()"/>
        </send>
      </onentry>
    </state>
    <state id="recalling_memory">
      <onentry>
        <assign location="statements" expr="episodeSelectStatements()"/>
        <assign location="statements" expr="directiveSelectStatements()"/>
      </onentry>
      <invoke id="recall" type="scxml" src="../memory/memory.scx">
        <param name="database" expr="database"/>
        <param name="statements" expr="statements"/>
      </invoke>
      <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json">
        <assign location="prior_episodes" expr="recalledContents(_event, 0)"/>
        <assign location="standing_directives" expr="recalledContents(_event, 1)"/>
        <send event="bot.ability.reasoning.recalled" target="#_internal">
          <param name="turn" expr="turn"/>
          <param name="host_input" expr="hostInput()"/>
          <param name="prior_episodes" expr="prior_episodes"/>
          <param name="standing_directives" expr="standing_directives"/>
          <param name="memory_consulted" expr="true"/>
          <param name="input" expr="focusInput()"/>
        </send>
      </transition>
      <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json" target="done">
        <assign location="result" expr="recallFailedResult(_event.data.message)"/>
      </transition>
      <transition event="error.*" target="done">
        <assign location="result" expr="recallFailedResult(_event.name)"/>
      </transition>
    </state>
    <transition event="bot.ability.reasoning.recalled" event:schema="schemas/bot.ability.reasoning.recalled.json"
                cond="hasRecalledWithoutChoices(_event)"
                target="done">
      <assign location="result" expr="noChoicesResult()"/>
    </transition>
    <transition event="bot.ability.reasoning.recalled" event:schema="schemas/bot.ability.reasoning.recalled.json"
                cond="isCurrentTurn(_event)"
                target="applying"/>
  </state>

  <!-- One structured model call; leaving this state cancels it. -->
  <state id="applying">
    <onentry>
      <decision:selection location="schema" choices="choices"/>
      <assign location="selected" expr="null"/>
      <assign location="gen_failure" expr="null"/>
      <decision:names location="choice_names" choices="choices"/>
      <log label="reasoning" expr="choiceNamesLog()"/>
    </onentry>
    <invoke id="generate" type="https://github.com/stateforward/floppy/services/generate"
            env:apikey="FLOPPY_API_KEY" env:baseurl="FLOPPY_BASE_URL">
      <param name="model" expr="model"/>
      <param name="system" expr="system"/>
      <param name="prompt" expr="modelPrompt()"/>
      <param name="schema" expr="schema"/>
      <param name="schemaname" expr="'dispatch'"/>
      <param name="strict" expr="true"/>
    </invoke>

    <transition event="generate.result">
      <assign location="selected" expr="generatedSelection(_event)"/>
    </transition>
    <transition event="generate.failed">
      <assign location="gen_failure" expr="generateFailure(_event)"/>
    </transition>
    <transition event="done.invoke.generate" cond="hasSelection()" target="dispatching"/>
    <transition event="done.invoke.generate" target="done">
      <assign location="result" expr="failedResult()"/>
    </transition>
    <transition event="error.*" target="done">
      <assign location="result" expr="couldNotRunResult(_event)"/>
    </transition>
  </state>

  <!-- The selections are checked before anything is retained. -->
  <state id="dispatching">
    <onentry>
      <bot:verdict location="dispatch_selections" rejectionlocation="rejection" selections="selected"
                   focus="focus" candidates="focus_candidates"/>
      <if cond="isAccepted()">
        <decision:route location="dispatch_selections" rejectionlocation="rejection" selections="dispatch_selections" choices="choices"/>
      </if>
    </onentry>
    <transition cond="isAccepted()" target="retaining"/>
    <transition target="done">
      <assign location="result" expr="rejectedResult()"/>
    </transition>
  </state>

  <!-- Retain the turn's episode, or nothing without a database. -->
  <state id="retaining" initial="retaining_from">
    <state id="retaining_from">
      <transition cond="hasNoDatabase()" target="retaining_nothing"/>
      <transition target="retaining_memory"/>
    </state>
    <state id="retaining_nothing">
      <onentry>
        <log label="memory" expr="'absent'"/>
        <send event="bot.ability.reasoning.retained" target="#_internal">
          <param name="turn" expr="turn"/>
          <param name="result" expr="selected"/>
          <param name="memory_consulted" expr="false"/>
          <param name="memory_written" expr="false"/>
          <param name="input" expr="focusInput()"/>
        </send>
      </onentry>
    </state>
    <state id="retaining_memory">
      <onentry>
        <assign location="episode" expr="episodeContent()"/>
      </onentry>
      <invoke id="retain" type="scxml" src="../memory/memory.scx">
        <param name="database" expr="database"/>
        <param name="statements" expr="episodeInsertStatements()"/>
      </invoke>
      <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json">
        <send event="bot.ability.reasoning.retained" target="#_internal">
          <param name="turn" expr="turn"/>
          <param name="result" expr="selected"/>
          <param name="memory_consulted" expr="true"/>
          <param name="memory_written" expr="true"/>
          <param name="input" expr="focusInput()"/>
        </send>
      </transition>
      <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json" target="done">
        <assign location="result" expr="retainFailedResult(_event.data.message)"/>
      </transition>
      <transition event="error.*" target="done">
        <assign location="result" expr="retainFailedResult(_event.name)"/>
      </transition>
    </state>
    <transition event="bot.ability.reasoning.retained" event:schema="schemas/bot.ability.reasoning.retained.json"
                cond="isCurrentTurn(_event)" target="done">
      <assign location="result" expr="selectedResult()"/>
    </transition>
  </state>

  <final id="done">
    <donedata>
      <content expr="result"/>
    </donedata>
  </final>
</scxml>
