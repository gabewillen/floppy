<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's Identity ability over text (mosfet abilities/identity): the
  bot's sense of its own name. The body (bots/floppy/floppy.scx) invokes it
  as its child "identity".

    recalling -bot.ability.identity.recalled-> knowing { listening
      -heard text, a name to look for-> recognizing -> listening }
    knowing -bot.ability.identity.adopt-> adopting
      -bot.ability.identity.adopted-> knowing

  A bot is born nameless: nothing in the body supplies a name. name is the
  invoker's <param name="name"> when it passes one (tests do; the body does
  not), else null.

  recalling is the memory seam (phase 3): it logs
  <log label="memory" expr="'absent'">, recalls nothing, and sends
  bot.ability.identity.recalled {name} to #_internal with the name the session started
  with ({text, kind: "fact"}, or null); phase 3 replaces the send with a
  memory read of the self_name fact.

  Recognition (mosfet recognition.hears_name, the text recognizer): the
  body relays each outside bot.ability.communication.input to this ability.
  Its text (a string content with a text/* content_type) is split into
  case-folded letter-and-digit tokens, and the bot is addressed when the
  name's tokens appear as a whole run in it (so a bot named "Al" is not
  addressed by "always"). Addressed: bot.ability.identity.addressed {name}
  goes to the body, which takes it as a turn's stimulus (mosfet hands the
  body a cognition input whose stimulus is this event; the body here wraps
  it, since bot.ability.cognition.input's turn is the body's to number).
  Not addressed, or no name yet, produces nothing: a nameless bot only
  hears words. Other content is not heard (audio is phase 6).

  Adoption: bot.ability.identity.adopt {name, reason?} is offered (as the
  model-callable act of taking a name) on every entry into knowing, through
  <decision:choice events="bot.ability.identity.adopt">, compacted ($schema,
  title and examples dropped), in bot.ability.offers {ability: "identity",
  choices}; the first offers are the ability's readiness. adopting is the
  memory seam for writing the name down: it logs
  <log label="memory" expr="'absent'"> and sends
  bot.ability.identity.adopted {name: {text, kind: "fact"}, persisted:
  false} (persisted [floppy field]: nothing was written) to #_internal; the bot then
  answers to that name. Without memory nothing can fail to be written, so
  bot.ability.identity.adopt.failed is not raised in phase 4. An adopt that
  does not satisfy schemas/bot.ability.identity.adopt.json is logged
  (identity.rejected) and changes nothing.

  Logs: identity.name (each name taken, recalled or adopted),
  identity.heard (whether a relayed text addressed the bot), and
  identity.offers.

  Contracts: the events it takes reference abilities/schemas/ by
  event:schema (never inline) and are rechecked by cond.

  Bindings: the decision namespace package (no service, no I/O).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="identity" initial="recalling">
  <datamodel>
    <data id="name" expr="null"/>
    <data id="heard" expr="null"/>
    <data id="adopting_name" expr="null"/>
    <data id="offering" expr="false"/>
    <data id="offered" expr="[]"/>
    <data id="max_offers_bytes" expr="32768"/>
  </datamodel>
  <script>
    function isObject(value) {
      return value !== null &amp;&amp; typeof value === 'object' &amp;&amp; !Array.isArray(value);
    }
    // schemas/bot.ability.identity.adopt.json
    function validAdopt(data) {
      return isObject(data)
        &amp;&amp; Object.keys(data).every(function (k) { return k === 'name' || k === 'reason'; })
        &amp;&amp; typeof data.name === 'string' &amp;&amp; data.name.length &gt;= 1 &amp;&amp; data.name.length &lt;= 64
        &amp;&amp; (data.reason === undefined || data.reason === null
          || (typeof data.reason === 'string' &amp;&amp; data.reason.length &gt;= 1));
    }
    // schemas/bot.ability.communication.input.json, as far as hearing goes:
    // its text, or null when it carries none.
    function textOf(data) {
      return isObject(data) &amp;&amp; typeof data.content === 'string'
        &amp;&amp; typeof data.content_type === 'string' &amp;&amp; data.content_type.indexOf('text/') === 0
        ? data.content : null;
    }
    // mosfet recognition._tokens: case-folded letter-and-digit tokens.
    function tokens(text) {
      return text.split(/\s+/u).map(function (part) {
        return part.replace(/[^\p{L}\p{N}]/gu, '').toLowerCase();
      }).filter(function (token) { return token.length &gt; 0; });
    }
    // mosfet recognition.hears_name: the name as a whole token run.
    function hearsName(text, wanted) {
      var said = tokens(text);
      var want = tokens(wanted);
      if (want.length === 0 || want.length &gt; said.length) { return false; }
      for (var start = 0; start + want.length &lt;= said.length; start++) {
        var match = true;
        for (var i = 0; i &lt; want.length; i++) {
          if (said[start + i] !== want[i]) { match = false; break; }
        }
        if (match) { return true; }
      }
      return false;
    }
    function nameFact(text) {
      return text === null ? null : {text: text, kind: 'fact'};
    }
    function compactSchema(schema) {
      if (Array.isArray(schema)) { return schema.map(compactSchema); }
      if (!isObject(schema)) { return schema; }
      var out = {};
      Object.keys(schema).forEach(function (key) {
        var value = schema[key];
        if (['$schema', 'title', 'examples'].indexOf(key) &gt;= 0) { return; }
        if (['properties', 'patternProperties', '$defs', 'definitions'].indexOf(key) &gt;= 0 &amp;&amp; isObject(value)) {
          var named = {};
          Object.keys(value).forEach(function (n) { named[n] = compactSchema(value[n]); });
          out[key] = named;
        } else if (['enum', 'const', 'required', 'default'].indexOf(key) &gt;= 0) {
          out[key] = value;
        } else {
          out[key] = compactSchema(value);
        }
      });
      return out;
    }
    function compactOffers(list) {
      var compacted = list.map(function (choice) {
        var entry = {event: choice.event, schema: compactSchema(choice.schema)};
        if (typeof choice.description === 'string') { entry.description = choice.description; }
        return entry;
      });
      return JSON.stringify(compacted).length &lt;= max_offers_bytes ? compacted : [];
    }
  </script>

  <!-- The memory seam: no memory, so the name is the one the session
       started with. -->
  <state id="recalling">
    <onentry>
      <log label="memory" expr="'absent'"/>
      <send event="bot.ability.identity.recalled" target="#_internal">
        <param name="name" expr="nameFact(typeof name === 'string' &amp;&amp; name.length &gt; 0 ? name : null)"/>
      </send>
    </onentry>
    <transition event="bot.ability.identity.recalled" event:schema="schemas/bot.ability.identity.recalled.json"
                cond="isObject(_event.data)" target="knowing">
      <assign location="name" expr="isObject(_event.data.name) ? _event.data.name.text : null"/>
      <log label="identity.name" expr="'recalled ' + JSON.stringify(name)"/>
    </transition>
  </state>

  <state id="knowing" initial="listening">
    <onentry>
      <assign location="offering" expr="true"/>
      <decision:choice location="offered" events="bot.ability.identity.adopt"/>
      <assign location="offering" expr="false"/>
      <if cond="compactOffers(offered).length &lt; offered.length">
        <log label="identity.offers.dropped" expr="'the offers are over ' + max_offers_bytes + ' bytes'"/>
      </if>
      <assign location="offered" expr="compactOffers(offered)"/>
      <log label="identity.offers" expr="offered.map(function (choice) { return choice.event; }).join(' ')"/>
      <send event="bot.ability.offers" target="#_parent">
        <param name="ability" expr="'identity'"/>
        <param name="choices" expr="offered"/>
      </send>
    </onentry>
    <!-- Offered for the whole time the ability is knowing: a bot can be
         given a name mid-sentence. -->
    <transition event="bot.ability.identity.adopt" event:schema="schemas/bot.ability.identity.adopt.json"
                cond="offering || validAdopt(_event.data)" target="adopting">
      <assign location="adopting_name" expr="_event.data.name"/>
    </transition>
    <transition event="bot.ability.identity.adopt">
      <log label="identity.rejected" expr="'bot.ability.identity.adopt does not satisfy schemas/bot.ability.identity.adopt.json'"/>
    </transition>

    <state id="listening">
      <!-- A nameless bot hears words and nothing follows from them. -->
      <transition event="bot.ability.communication.input" event:schema="schemas/bot.ability.communication.input.json"
                  cond="name !== null &amp;&amp; textOf(_event.data) !== null" target="recognizing">
        <assign location="heard" expr="textOf(_event.data)"/>
      </transition>
    </state>

    <!-- One recognition decision about one heard text. -->
    <state id="recognizing">
      <transition cond="hearsName(heard, name)" target="listening">
        <log label="identity.heard" expr="'addressed as ' + name"/>
        <send event="bot.ability.identity.addressed" target="#_parent">
          <param name="name" expr="name"/>
        </send>
      </transition>
      <transition target="listening">
        <log label="identity.heard" expr="'not addressed'"/>
      </transition>
    </state>
  </state>

  <!-- The memory seam for writing the name down: nothing is written. -->
  <state id="adopting">
    <onentry>
      <log label="memory" expr="'absent'"/>
      <send event="bot.ability.identity.adopted" target="#_internal">
        <param name="name" expr="nameFact(adopting_name)"/>
        <param name="persisted" expr="false"/>
      </send>
    </onentry>
    <transition event="bot.ability.identity.adopted" event:schema="schemas/bot.ability.identity.adopted.json"
                cond="isObject(_event.data) &amp;&amp; isObject(_event.data.name)" target="knowing">
      <assign location="name" expr="_event.data.name.text"/>
      <log label="identity.name" expr="'adopted ' + JSON.stringify(name) + ' (persisted: false)'"/>
    </transition>
  </state>
</scxml>
