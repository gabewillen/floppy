<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's vocal speech encoding ability:
  a reply's parts to speech through the speech service
  (services/speech, operation encode). Speaking
  (abilities/speaking/speaking.scx) invokes it once, as its long-lived
  child "vocal" (mosfet.py's Speaking holds its encoder), and sends it
  each utterance. Speaking cancels an utterance it stops hearing out
  (its stop, a failure or its encoding_timeout_ms bound) with
  bot.ability.processing.cancel {} (mosfet.py's processing cancel; it
  names no utterance, since vocal holds one at a time): applying then goes
  back to idle, which cancels the service request (SCXML 6.4), and nothing
  is answered; in idle it is dropped. Each
  service call takes a generated invoke id that its transitions match, as
  scxml.rs still delivers a cancelled call's late events.

    starting -> idle -bot.ability.vocal.speech.encoding.input-> applying -> idle

  Input: bot.ability.vocal.speech.encoding.input {parts} (the parts
  whole, decision D178). applying invokes the speech service with the
  <param>s operation "encode", provider (the invoker's, null for the
  OpenAI-compatible API), model and voice (the speech service requires
  both: the invoker names them), parts (the service says each pause as
  silence and applies no other cue, decision D178), output (where the
  service writes the audio: output_prefix, a path in the media directory
  the run grants it, which the invoker names, + the utterance's number,
  counted from 1, + "." + the media subtype) and media_type. The service streams its
  encoding (decision D203): each bot.ability.vocal.speech.encoding.chunk
  {audio, sequence, media_type, sample_rate_hz, channels, duration} it
  returns is sent on to the parent at once, as it arrives, so playout can
  start on the first chunk. Then it answers the parent with
  the service's bot.ability.vocal.speech.encoding.output {audio,
  media_type, sample_rate_hz, channels} (the audio as a reference, never
  bytes; a measured duration, when the service gives one, rides along), or
  bot.ability.failed {message} when the service fails, ends without an answer, or cannot
  run. An input that arrives while applying is logged and dropped: its
  invoker sends one per utterance.

  Drafts (decision D262): a reply can also arrive while it is still
  being written. bot.ability.speaking.draft {part, words, offset,
  expression?} in idle starts applying with no parts, so the speech
  service reads the reply from its events (a drafted encoding): once the
  service returns bot.ability.ready, each draft received so far, and
  each one after, is sent on to it (#_speech), and so is the reply of
  record, the bot.ability.vocal.speech.encoding.input that follows them.
  The service says each sentence as soon as it is written, and its chunks
  and answer come back as for any encoding.

  The service's events are not checked by scxml.rs (D41), so applying
  keeps only an answer of the right shape, one transition per event.

  Readiness: its start (starting, which goes on to idle) sends
  bot.ability.ready to the parent once (decision D242); it offers nothing.

  Bindings: the speech service package, with FLOPPY_SPEECH_BASE_URL and
  FLOPPY_SPEECH_API_KEY (no default backend, D31; without a key it asks a
  keyless backend with no key header, D127) and a media directory the run
  grants it (scx run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="vocal" initial="starting">
  <datamodel>
    <!-- The invoker's <param>s (provider null: the OpenAI-compatible API). -->
    <data id="provider" expr="null"/>
    <data id="model" expr="null"/>
    <data id="voice" expr="null"/>
    <data id="output_prefix" expr="'media/vocal-'"/>
    <data id="media_type" expr="'audio/pcm'"/>
    <!-- The utterance's number (the audio is written to output_prefix +
         operation + "." + the media subtype) and the speech service call's
         generated invoke id: a cancelled call's late events (still
         delivered, SCXML 6.4) are not this utterance's. -->
    <data id="operation" expr="0"/>
    <data id="speech" expr="null"/>
    <!-- The utterance in hand and the service's answer. -->
    <data id="parts" expr="null"/>
    <data id="encoded" expr="null"/>
    <data id="failure" expr="null"/>
    <!-- A drafted reply (D262): the drafts and the reply of record held
         until the service is ready, whether it is, and the draft being
         sent on (the <foreach> item). -->
    <data id="drafts" expr="[]"/>
    <data id="drafted_parts" expr="null"/>
    <data id="speech_ready" expr="false"/>
    <data id="draft" expr="null"/>
  </datamodel>
  <script src="vocal.js"/>

  <!-- Ready once, on start (decision D242): idle is entered again after
       each utterance. -->
  <state id="starting">
    <onentry>
      <send event="bot.ability.ready" target="#_parent"/>
    </onentry>
    <transition target="idle"/>
  </state>

  <state id="idle">
    <transition event="bot.ability.vocal.speech.encoding.input" event:schema="../schemas/bot.ability.vocal.speech.encoding.input.json"
                target="applying">
      <assign location="parts" expr="_event.data.parts"/>
      <assign location="drafts" expr="[]"/>
    </transition>
    <!-- A reply still being written: the service reads it as it comes. -->
    <transition event="bot.ability.speaking.draft" event:schema="../schemas/bot.ability.speaking.draft.json"
                target="applying">
      <assign location="parts" expr="null"/>
      <assign location="drafts" expr="[_event.data]"/>
    </transition>
  </state>

  <state id="applying">
    <onentry>
      <assign location="operation" expr="operation + 1"/>
      <assign location="encoded" expr="null"/>
      <assign location="failure" expr="null"/>
      <assign location="drafted_parts" expr="null"/>
      <assign location="speech_ready" expr="false"/>
    </onentry>
    <invoke idlocation="speech" type="https://github.com/stateforward/floppy/services/speech"
            env:apikey="FLOPPY_SPEECH_API_KEY" env:baseurl="FLOPPY_SPEECH_BASE_URL">
      <param name="operation" expr="'encode'"/>
      <param name="provider" expr="provider"/>
      <param name="model" expr="model"/>
      <param name="parts" expr="parts"/>
      <param name="voice" expr="voice"/>
      <param name="output" expr="outputPath()"/>
      <param name="media_type" expr="media_type"/>
    </invoke>

    <!-- Each chunk of the streamed encoding, sent on as it arrives. -->
    <transition event="bot.ability.vocal.speech.encoding.chunk" event:schema="../schemas/bot.ability.vocal.speech.encoding.chunk.json"
                cond="isCurrent(_event) &amp;&amp; isChunk(_event)">
      <send event="bot.ability.vocal.speech.encoding.chunk" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
    <transition event="bot.ability.vocal.speech.encoding.chunk" event:schema="../schemas/bot.ability.vocal.speech.encoding.chunk.json"
                cond="isCurrent(_event)">
      <log label="vocal.dropped" expr="_event.name"/>
    </transition>
    <!-- The speech service's answer, kept until it ends. -->
    <transition event="bot.ability.vocal.speech.encoding.output" event:schema="../schemas/bot.ability.vocal.speech.encoding.output.json"
                cond="isCurrent(_event)">
      <assign location="encoded" expr="encodedAnswer(_event)"/>
    </transition>
    <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json" cond="isCurrent(_event)">
      <assign location="failure" expr="failureAnswer(_event)"/>
    </transition>
    <transition event="done.invoke" cond="isCurrent(_event) &amp;&amp; hasEncoded()" target="idle">
      <send event="bot.ability.vocal.speech.encoding.output" target="#_parent">
        <content expr="encoded"/>
      </send>
    </transition>
    <transition event="done.invoke" cond="isCurrent(_event)" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="failureMessage()"/>
      </send>
    </transition>
    <transition event="error.*" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="speechRunFailure(_event)"/>
      </send>
    </transition>
    <!-- The utterance is cancelled (mosfet.py's processing cancel): leaving
         applying cancels the service call and its request (SCXML 6.4), and
         nothing is answered. -->
    <transition event="bot.ability.processing.cancel" event:schema="../schemas/bot.ability.processing.cancel.json"
                target="idle"/>
    <!-- A drafted encoding is ready for its events: what was held goes
         to it, in order. -->
    <transition event="bot.ability.ready" event:schema="../schemas/bot.ability.ready.json" cond="isCurrent(_event) &amp;&amp; isDrafted()">
      <foreach array="drafts" item="draft">
        <send event="bot.ability.speaking.draft" targetexpr="speechTarget()">
          <content expr="draft"/>
        </send>
      </foreach>
      <assign location="drafts" expr="[]"/>
      <if cond="drafted_parts !== null">
        <send event="bot.ability.vocal.speech.encoding.input" targetexpr="speechTarget()">
          <param name="parts" expr="drafted_parts"/>
        </send>
      </if>
      <assign location="speech_ready" expr="true"/>
    </transition>
    <transition event="bot.ability.speaking.draft" event:schema="../schemas/bot.ability.speaking.draft.json" cond="isDrafted()">
      <if cond="speech_ready">
        <send event="bot.ability.speaking.draft" targetexpr="speechTarget()">
          <content expr="_event.data"/>
        </send>
      <else/>
        <assign location="drafts[drafts.length]" expr="_event.data"/>
      </if>
    </transition>
    <transition event="bot.ability.speaking.draft" event:schema="../schemas/bot.ability.speaking.draft.json">
      <log label="vocal.dropped" expr="_event.name"/>
    </transition>
    <!-- The drafted reply of record. -->
    <transition event="bot.ability.vocal.speech.encoding.input" event:schema="../schemas/bot.ability.vocal.speech.encoding.input.json"
                cond="isDrafted()">
      <if cond="speech_ready">
        <send event="bot.ability.vocal.speech.encoding.input" targetexpr="speechTarget()">
          <param name="parts" expr="_event.data.parts"/>
        </send>
      <else/>
        <assign location="drafted_parts" expr="_event.data.parts"/>
      </if>
    </transition>
    <transition event="bot.ability.vocal.speech.encoding.input" event:schema="../schemas/bot.ability.vocal.speech.encoding.input.json">
      <log label="vocal.dropped" expr="_event.name"/>
    </transition>
  </state>
</scxml>
