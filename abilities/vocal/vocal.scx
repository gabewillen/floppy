<?xml version="1.0" encoding="UTF-8"?>
<!--
  floppy's vocal speech encoding ability:
  a reply's parts to speech through the speech service
  (services/speech, operation encode). Speaking
  (abilities/speaking/speaking.scx) invokes it as its child "vocal" from
  its encoding state, so leaving encoding (an answer, a failure or
  its encoding_timeout_ms bound) cancels it and the service request with it (SCXML
  6.4).

    starting -> idle -bot.ability.vocal.speech.encoding.input-> applying -> idle

  Input: bot.ability.vocal.speech.encoding.input {parts} (the parts
  whole, decision D178). applying invokes the speech service with the
  <param>s operation "encode", provider (the invoker's, null for the
  OpenAI-compatible API), model and voice (the speech service requires
  both: the invoker names them), parts (the service says each pause as
  silence and applies no other cue, decision D178), output (where the
  service writes the audio: a path in the media directory the run grants
  it, which the invoker names) and media_type. The service streams its
  encoding (decision D203): each bot.ability.vocal.speech.encoding.chunk
  {audio, sequence, media_type, sample_rate_hz, channels, duration} it
  returns is sent on to the parent at once, as it arrives, so playout can
  start on the first chunk. Then it answers the parent with
  the service's bot.ability.vocal.speech.encoding.output {audio,
  media_type, sample_rate_hz, channels} (the audio as a reference, never
  bytes; a measured duration, when the service gives one, rides along), or
  bot.ability.failed {message} when the service fails, ends without an answer, or cannot
  run. An input that arrives while applying is logged and dropped: its
  invoker sends one per invocation.

  The service's events are not checked by scxml.rs (D41), so applying
  keeps only an answer of the right shape, one transition per event.

  Readiness: its start (starting, which goes on to idle) sends
  bot.ability.ready to the parent once (decision D242); it offers nothing.

  Bindings: the speech service package, with FLOPPY_SPEECH_BASE_URL and
  FLOPPY_SPEECH_API_KEY (no default backend, D31; without a key it asks a
  keyless backend with no key header, D127) and a media directory the run
  grants it (scx run's dir option).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="vocal" initial="starting">
  <datamodel>
    <!-- The invoker's <param>s (provider null: the OpenAI-compatible API). -->
    <data id="provider" expr="null"/>
    <data id="model" expr="null"/>
    <data id="voice" expr="null"/>
    <data id="output" expr="null"/>
    <data id="media_type" expr="'audio/pcm'"/>
    <!-- The utterance in hand and the service's answer. -->
    <data id="parts" expr="null"/>
    <data id="encoded" expr="null"/>
    <data id="failure" expr="null"/>
  </datamodel>
  <script src="vocal.js"/>

  <!-- Ready once, on start (decision D242): idle is entered again after
       each utterance. -->
  <state id="starting">
    <onentry>
      <send event="bot.ability.ready" target="#_parent"/>
    </onentry>
    <transition target="idle"/>
  </state>

  <state id="idle">
    <transition event="bot.ability.vocal.speech.encoding.input" event:schema="../schemas/bot.ability.vocal.speech.encoding.input.json"
                target="applying">
      <assign location="parts" expr="_event.data.parts"/>
    </transition>
  </state>

  <state id="applying">
    <onentry>
      <assign location="encoded" expr="null"/>
      <assign location="failure" expr="null"/>
    </onentry>
    <invoke id="speech" type="https://github.com/stateforward/floppy/services/speech"
            env:apikey="FLOPPY_SPEECH_API_KEY" env:baseurl="FLOPPY_SPEECH_BASE_URL">
      <param name="operation" expr="'encode'"/>
      <param name="provider" expr="provider"/>
      <param name="model" expr="model"/>
      <param name="parts" expr="parts"/>
      <param name="voice" expr="voice"/>
      <param name="output" expr="output"/>
      <param name="media_type" expr="media_type"/>
    </invoke>

    <!-- Each chunk of the streamed encoding, sent on as it arrives. -->
    <transition event="bot.ability.vocal.speech.encoding.chunk" event:schema="../schemas/bot.ability.vocal.speech.encoding.chunk.json"
                cond="isChunk(_event)">
      <send event="bot.ability.vocal.speech.encoding.chunk" target="#_parent">
        <content expr="_event.data"/>
      </send>
    </transition>
    <transition event="bot.ability.vocal.speech.encoding.chunk" event:schema="../schemas/bot.ability.vocal.speech.encoding.chunk.json">
      <log label="vocal.dropped" expr="_event.name"/>
    </transition>
    <!-- The speech service's answer, kept until it ends. -->
    <transition event="bot.ability.vocal.speech.encoding.output" event:schema="../schemas/bot.ability.vocal.speech.encoding.output.json">
      <assign location="encoded" expr="encodedAnswer(_event)"/>
    </transition>
    <transition event="bot.ability.failed" event:schema="../schemas/bot.ability.failed.json">
      <assign location="failure" expr="failureAnswer(_event)"/>
    </transition>
    <transition event="done.invoke.speech" cond="hasEncoded()" target="idle">
      <send event="bot.ability.vocal.speech.encoding.output" target="#_parent">
        <content expr="encoded"/>
      </send>
    </transition>
    <transition event="done.invoke.speech" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="failureMessage()"/>
      </send>
    </transition>
    <transition event="error.*" target="idle">
      <send event="bot.ability.failed" target="#_parent">
        <param name="message" expr="speechRunFailure(_event)"/>
      </send>
    </transition>
    <transition event="bot.ability.vocal.speech.encoding.input" event:schema="../schemas/bot.ability.vocal.speech.encoding.input.json">
      <log label="vocal.dropped" expr="_event.name"/>
    </transition>
  </state>
</scxml>
