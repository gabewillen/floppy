<?xml version="1.0" encoding="UTF-8"?>
<!--
  The routines runner: the persistent routines Routines
  (abilities/routines/routines.scx) keeps running, as a chain of SCXML children.
  SCXML holds a fixed set of invokes per state, so one runner runs the
  first routine of its routines <param> and invokes itself for the rest;
  Routines invokes the first runner, and cancelling it (SCXML 6.4) stops
  every routine below it.

    running { routine_region { routine_on -> routine_off },
              rest_region { rest_deciding -> rest_on | rest_off } }

  Input: the <param> routines, the ACTIVE persistent rows Routines
  selected from behavior inventory, in inventory order: [{name, source}],
  at least one. Each routine is its bot_behavior row's source, run by
  <invoke><content expr> (no file, no srcexpr); like every invoked child it
  gets no schema files, so it carries no event:schema references
  (docs/plans/phase5-behaviors.mdscript.md, "Persistent Routine
  Contract").

  Ticks: each bot.behavior.tick the routine sends its parent (#_parent)
  goes up to this runner's parent, as does each one the rest of the chain
  passes up; a tick whose name is not the routine's is not forwarded
  (mosfet Routines._is_stale_tick). scxml.rs checks the tick against the
  transition's event:schema as it arrives.

  Stopping: a routine that ends, or cannot start (an error.* for it; a
  source that does not compile raises one with no invokeid), stays
  stopped until its source changes (mosfet: "it stays stopped until
  changed"), and the rest keep running. Each runner nests one level deeper
  (scxml.rs bounds the nested invoke depth at 32 below the root session),
  so a chain longer than that stops at the bound, logged as
  routines.failed.

  Bindings: none (no service, no I/O).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="routines_runner" initial="running">
  <datamodel>
    <data id="routines" expr="[]"/>
  </datamodel>
  <script src="routines_runner.js"/>

  <parallel id="running">
    <!-- The first routine. -->
    <state id="routine_region" initial="routine_on">
      <state id="routine_on">
        <invoke id="routine" type="scxml">
          <content expr="routineSource(0)"/>
        </invoke>
        <transition event="bot.behavior.tick" event:schema="schemas/bot.behavior.tick.json"
                    cond="isRunningTick(_event)">
          <send event="bot.behavior.tick" target="#_parent">
            <content expr="_event.data"/>
          </send>
        </transition>
        <transition event="done.invoke.routine" target="routine_off"/>
        <transition event="error.*" cond="isRoutineError(_event)"
                    target="routine_off">
          <log label="routines.failed" expr="routineFailure(0, _event)"/>
        </transition>
      </state>
      <final id="routine_off"/>
    </state>

    <!-- The rest of the chain. -->
    <state id="rest_region" initial="rest_deciding">
      <state id="rest_deciding">
        <transition cond="hasRest()" target="rest_on"/>
        <transition target="rest_off"/>
      </state>
      <state id="rest_on">
        <invoke id="rest" type="scxml" src="routines_runner.scx">
          <param name="routines" expr="restRoutines()"/>
        </invoke>
        <transition event="bot.behavior.tick" event:schema="schemas/bot.behavior.tick.json"
                    cond="isRest(_event)">
          <send event="bot.behavior.tick" target="#_parent">
            <content expr="_event.data"/>
          </send>
        </transition>
        <transition event="error.*" cond="isRest(_event)" target="rest_off">
          <log label="routines.failed" expr="routineFailure(1, _event)"/>
        </transition>
      </state>
      <final id="rest_off"/>
    </state>
  </parallel>
</scxml>
