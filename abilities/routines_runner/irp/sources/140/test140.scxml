<?xml version="1.0" encoding="UTF-8"?>
<!-- routines_runner-5: a routine that ends stays stopped while the next keeps ticking. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="routines_runner" type="scxml" src="../../../routines_runner.scx">
    <param name="routines" expr='[{"name": "Alpha", "source": "irp/behaviors/45ca4e53dac8f01a.scxml"}, {"name": "Beta", "source": "irp/behaviors/6197b9255bf000c6.scxml"}]'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.behavior.tick" cond='_event.data.name === "Alpha" &amp;&amp; _event.data.output[0].data.text === "once"' target="step1"/>
  </state>
  <state id="step1">
    <transition event="bot.behavior.tick" cond='_event.data.name === "Beta" &amp;&amp; _event.data.output[0].data.text === "every"' target="step2"/>
  </state>
  <state id="step2">
    <transition event="bot.behavior.tick" cond='_event.data.name === "Beta" &amp;&amp; _event.data.output[0].data.text === "every"' target="step3"/>
  </state>
  <state id="step3">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
