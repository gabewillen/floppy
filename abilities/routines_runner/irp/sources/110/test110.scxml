<?xml version="1.0" encoding="UTF-8"?>
<!-- routines_runner-2: the routine's tick reaches the parent with all its fields. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<state id="harness" initial="boot">
  <invoke id="routines_runner" type="scxml" src="../../../routines_runner.scx">
    <param name="routines" expr='[{"name": "Alpha", "source": "irp/behaviors/45ca4e53dac8f01a.scxml"}]'/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.behavior.tick" cond="_event.data.name === 'Alpha' &amp;&amp; _event.data.trigger === 'every' &amp;&amp; _event.data.scheduled_at === &quot;2026-10-05T08:00:00-04:00&quot; &amp;&amp; _event.data.fired_at === &quot;2026-10-05T08:00:00-04:00&quot; &amp;&amp; _event.data.output.length === 1 &amp;&amp; _event.data.output[0].event === 'bot.speaking.say' &amp;&amp; _event.data.output[0].target === 'speaker' &amp;&amp; _event.data.output[0].data.text === 'once'" target="step1"/>
  </state>
  <state id="step1">
    <onentry>
      <send event="harness.waited" delay="1s"/>
    </onentry>
    <transition event="harness.waited" target="step2"/>
  </state>
  <state id="step2">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
