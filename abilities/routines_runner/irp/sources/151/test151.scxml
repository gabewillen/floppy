<?xml version="1.0" encoding="UTF-8"?>
<!-- routines_runner-6: a broken routine deeper in the chain stops only itself. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="harness">
<datamodel>
  <data id="seen" expr="[]"/>
</datamodel>
<state id="harness" initial="boot">
  <invoke id="routines_runner" type="scxml" src="../../../routines_runner.scx">
    <param name="routines" expr="[{&quot;name&quot;: &quot;Alpha&quot;, &quot;source&quot;: &quot;&lt;scxml xmlns=\&quot;http://www.w3.org/2005/07/scxml\&quot; version=\&quot;1.0\&quot; datamodel=\&quot;ecmascript\&quot; initial=\&quot;s\&quot;&gt;&lt;state id=\&quot;s\&quot;&gt;&lt;onentry&gt;&lt;send event=\&quot;bot.behavior.tick\&quot; target=\&quot;#_parent\&quot;&gt;&lt;content expr=\&quot;({name: 'Alpha', trigger: 'every', scheduled_at: '2026-10-05T08:00:00-04:00', fired_at: '2026-10-05T08:00:00-04:00', output: [{event: 'bot.speaking.say', target: 'speaker', data: {text: 'once'}}]})\&quot;/&gt;&lt;/send&gt;&lt;/onentry&gt;&lt;transition target=\&quot;end\&quot;/&gt;&lt;/state&gt;&lt;final id=\&quot;end\&quot;/&gt;&lt;/scxml&gt;&quot;}, {&quot;name&quot;: &quot;Epsilon&quot;, &quot;source&quot;: &quot;&lt;scxml&quot;}, {&quot;name&quot;: &quot;Gamma&quot;, &quot;source&quot;: &quot;&lt;scxml xmlns=\&quot;http://www.w3.org/2005/07/scxml\&quot; version=\&quot;1.0\&quot; datamodel=\&quot;ecmascript\&quot; initial=\&quot;s\&quot;&gt;&lt;state id=\&quot;s\&quot;&gt;&lt;onentry&gt;&lt;send event=\&quot;bot.behavior.tick\&quot; target=\&quot;#_parent\&quot;&gt;&lt;content expr=\&quot;({name: 'Gamma', trigger: 'every', scheduled_at: '2026-10-05T08:00:00-04:00', fired_at: '2026-10-05T08:00:00-04:00', output: [{event: 'bot.speaking.say', target: 'speaker', data: {text: 'once'}}]})\&quot;/&gt;&lt;/send&gt;&lt;/onentry&gt;&lt;transition target=\&quot;end\&quot;/&gt;&lt;/state&gt;&lt;final id=\&quot;end\&quot;/&gt;&lt;/scxml&gt;&quot;}]"/>
  </invoke>
  <state id="boot">
    <onentry><send event="harness.go"/></onentry>
    <transition event="harness.go" target="step0"/>
  </state>
  <state id="step0">
    <transition event="bot.behavior.tick" target="step1"><assign location="seen" expr="seen.concat([_event.data.name])"/></transition>
  </state>
  <state id="step1">
    <transition event="bot.behavior.tick" target="step2"><assign location="seen" expr="seen.concat([_event.data.name])"/></transition>
  </state>
  <state id="step2">
    <onentry>
      <send event="harness.waited" delay="1s"/>
    </onentry>
    <transition event="harness.waited" target="step3"/>
  </state>
  <state id="step3">
    <onentry>
      <send event="harness.check"/>
    </onentry>
    <transition event="harness.check" cond="seen.sort().join(' ') === 'Alpha Gamma'" target="step4"/>
  </state>
  <state id="step4">
    <transition target="pass"/>
  </state>
  <transition event="*" target="fail"><log label="unexpected" expr="_event.name + ' ' + JSON.stringify(_event.data)"/></transition>
</state>
<final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
<final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
</scxml>
