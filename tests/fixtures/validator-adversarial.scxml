<scxml xmlns="http://www.w3.org/2005/07/scxml" initial="réady">
  <state id="1bad" initial="missing">
    <initial><transition event="boot" target="outside"/></initial>
    <state id="réady">
      <transition event="go,now" target="doné"/>
