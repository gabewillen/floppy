<?xml version="1.0" encoding="UTF-8"?>
<!-- Late data binding (SCXML 5.3): each state's <data> is bound when the
     state is first entered, so "bound_states" grows as the run enters
     "b", and "c" (never entered) stays unbound. Checkpoints: 0 after
     start ("a" bound), 1 after "go" ("b" bound too, its value computed
     from "x"), 2 at the only drain iteration, 3 at the end. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" binding="late" name="late-binding" initial="a">
  <state id="a">
    <datamodel>
      <data id="x" expr="1"/>
    </datamodel>
    <transition event="go" target="b"/>
  </state>
  <state id="b">
    <datamodel>
      <data id="y" expr="x + 1"/>
    </datamodel>
    <transition event="leave" target="c"/>
  </state>
  <state id="c">
    <datamodel>
      <data id="z" expr="'never bound'"/>
    </datamodel>
    <transition event="back" target="a"/>
  </state>
</scxml>
