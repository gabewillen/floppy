<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/2005/07/scxml"
           xmlns:s="http://www.w3.org/2005/07/scxml"
           elementFormDefault="qualified">
  <xs:element name="scxml">
    <xs:complexType>
      <xs:choice minOccurs="1" maxOccurs="unbounded">
        <xs:element ref="s:state"/>
        <xs:element ref="s:final"/>
        <xs:any namespace="##other" processContents="strict"/>
      </xs:choice>
      <xs:attribute name="initial" type="xs:NCName" use="required"/>
      <xs:attribute name="version" type="xs:decimal" fixed="1.0"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="state">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="s:transition" minOccurs="0" maxOccurs="unbounded"/>
        <xs:any namespace="##other" processContents="strict" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="final">
    <xs:complexType>
      <xs:attribute name="id" type="xs:NCName" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="transition">
    <xs:complexType>
      <xs:attribute name="event" type="xs:NMTOKEN"/>
      <xs:attribute name="target" type="xs:NCName" use="required"/>
      <xs:attribute name="cond" type="xs:string"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
