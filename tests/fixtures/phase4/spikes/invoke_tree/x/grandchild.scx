<!-- Spike (a), grandchild: the only document of the tree that invokes the
     generate service, with env: slots naming FLOPPY_API_KEY and
     FLOPPY_BASE_URL. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       version="1.0" datamodel="ecmascript" initial="generating">
  <datamodel>
    <data id="model" expr="null"/>
    <data id="prompt" expr="null"/>
  </datamodel>
  <state id="generating">
    <onexit><log label="grandchild.exit" expr="'generating'"/></onexit>
    <invoke id="gen" type="https://github.com/stateforward/floppy/services/generate"
            env:apikey="FLOPPY_API_KEY" env:baseurl="FLOPPY_BASE_URL">
      <param name="model" expr="model"/>
      <param name="prompt" expr="prompt"/>
      <param name="system" expr="'Answer in one short sentence.'"/>
    </invoke>
    <transition event="generate.result" target="done">
      <send event="spike.reply" target="#_parent">
        <param name="text" expr="_event.data.content"/>
      </send>
    </transition>
    <transition event="generate.failed" target="done">
      <send event="spike.failed" target="#_parent">
        <param name="code" expr="_event.data.code"/>
      </send>
    </transition>
  </state>
  <final id="done"/>
</scxml>
