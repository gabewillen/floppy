<!-- Spike (f): one entry arms a delay="0s" send and invokes a src that does
     not exist; the order of the invoke-start error and the timer is
     logged. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" initial="starting">
  <state id="starting">
    <onentry><send event="spike.tick" delay="0s"/></onentry>
    <invoke id="missing" type="scxml" src="missing.scx"/>
    <transition event="spike.tick">
      <log label="tick" expr="'0s'"/>
    </transition>
    <transition event="error.*">
      <log label="error" expr="_event.name + ' invokeid=' + String(_event.invokeid)"/>
    </transition>
    <transition event="spike.finish" target="done"/>
  </state>
  <final id="done"/>
</scxml>
