<!-- Spike (b), offerer: its two event:schema transitions are its choices;
     <decision:choice> writes them on entry and the choices goes to the parent as
     data. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:decision="https://github.com/stateforward/floppy/namespaces/decision"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" initial="offering">
  <datamodel>
    <data id="choices" expr="[]"/>
  </datamodel>
  <state id="offering">
    <onentry>
      <decision:choice location="choices"/>
      <log label="offerer.choices.bytes" expr="String(JSON.stringify(choices).length)"/>
      <send event="spike.choices" target="#_parent">
        <param name="choices" expr="choices"/>
      </send>
    </onentry>
    <transition event="error.*" target="done">
      <log label="offerer.error" expr="_event.name"/>
    </transition>
    <transition event="order.ship" event:schema='{"description":"Ship the order to the customer.","type":"object","properties":{"sku":{"type":"string"},"carrier":{"enum":["ups","fedex"]}},"required":["sku","carrier"],"additionalProperties":false}' target="done"/>
    <transition event="order.cancel" event:schema='{"description":"Cancel the order.","type":"object","properties":{"reason":{"enum":["customer","stock"]}},"required":["reason"],"additionalProperties":false}' target="done"/>
  </state>
  <final id="done"/>
</scxml>
