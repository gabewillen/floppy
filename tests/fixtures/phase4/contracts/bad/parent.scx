<!-- Contract fixture, broken on purpose: an inline event:schema, a send
     to the child that no child transition takes, and a bot.* name the original
     never declared. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" initial="invoking">
  <state id="invoking">
    <invoke id="child" type="scxml" src="child.scx"/>
    <transition event="contract.ready" event:schema='{"type":"object"}'>
      <send event="contract.unheard" target="#_child"/>
      <raise event="bot.ability.nonexistent"/>
    </transition>
    <transition event="done.invoke.child" target="done"/>
  </state>
  <final id="done"/>
</scxml>
