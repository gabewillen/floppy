<!-- Contract fixture, child: announces itself to its parent and takes a
     contract.ping described by its schema file. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" initial="waiting">
  <script src="child.js"/>
  <state id="waiting">
    <onentry><send event="contract.ready" target="#_parent"><content>{}</content></send></onentry>
    <transition event="contract.ping" event:schema="schemas/contract.ping.json" target="done"/>
  </state>
  <final id="done"/>
</scxml>
