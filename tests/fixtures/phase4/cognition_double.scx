<?xml version="1.0" encoding="UTF-8"?>
<!--
  A cognition double for the body tests (tests/tests/body.rs): the body's
  child "cognition" without a model. tests/tests/body.rs copies it to
  abilities/cognition.scx beside a copy of the body.

  Readiness: each entry into idle sends bot.ability.offers unless mode is
  'silent' (the test rewrites mode's expr): bot.ability.cognition.ignore
  with a schema carrying $schema, title, examples and a description (which
  the body compacts), or, when mode is 'huge', also a choice whose schema
  is over 32 KiB (the body fails such a turn). It stays near 36 KiB: from
  about 3050 values the offers event, with the raw message the SCXML
  processor renders, is over the 96 KiB event bound, so the double's offers
  send raises error.execution in the double and the body never becomes
  ready.

  Each turn's behavior is the name of the bot.input observation the turn
  carries (stimulus.data.observation.event), or, for a conversation
  product (stimulus.event bot.ability.conversation.output), the first word
  of its last message's text, whose observed data is then the number of messages, or,
  for bot.ability.identity.addressed, "addressed" with the name observed:

  * reply: answers the turn with one bot.ability.communication.respond
    selection naming no target (the communication offers it);
  * blank: selects bot.ability.communication.respond with blank text;
  * twice: selects bot.ability.communication.respond twice;
  * then_blank: selects bot.ability.communication.respond, then again with
    blank text (the second waits for the first);
  * unoffered: selects bot.ability.reasoning.input (offered by no ability
    the body invokes);
  * adopt: selects bot.ability.identity.adopt for the observation's data;
  * ignore: selects bot.ability.cognition.ignore for target cognition;
  * focus: selects bot.focus_device for the observation's data;
  * elsewhere: selects bot.ability.cognition.ignore for target speaking;
  * fail: answers bot.ability.failed;
  * stale: answers for another turn first, then for this one;
  * addressed: answers with one bot.ability.communication.respond
    selection "I am <name>";
  * reboot: asks the body for a reboot (bot.reboot);
  * hang: never answers, and acknowledges a cancel;
  * deaf: never answers and never acknowledges a cancel.

  It logs double.input per turn (turn, behavior, observation data),
  double.choices (the turn's choices as JSON), double.ignore when a routed
  bot.ability.cognition.ignore reaches it, and double.exit when it is
  cancelled.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="ecmascript" name="cognition_double" initial="alive">
  <datamodel>
    <data id="model" expr="'none'"/>
    <data id="mode" expr="'ready'"/>
    <data id="turn" expr="0"/>
    <data id="action" expr="null"/>
    <data id="observed" expr="null"/>
    <data id="stimulus" expr="null"/>
    <data id="ignore" expr="({event: 'bot.ability.cognition.ignore', description: 'Deliberately ignore this stimulus.', schema: {'$schema': 'https://json-schema.org/draft/2020-12/schema', title: 'bot.ability.cognition.ignore', description: 'Deliberately ignore this stimulus.', type: 'object', properties: {}, additionalProperties: false, examples: [{}]}})"/>
  </datamodel>
  <script>
    function product(stimulus) {
      return stimulus.event === 'bot.ability.conversation.output';
    }
    function addressed(stimulus) {
      return stimulus.event === 'bot.ability.identity.addressed';
    }
    function lastText(stimulus) {
      var messages = stimulus.data.messages;
      return messages[messages.length - 1].content.split(' ')[0];
    }
  </script>
  <state id="alive" initial="idle">
    <onexit>
      <log label="double.exit" expr="model"/>
    </onexit>
    <state id="idle">
      <onentry>
        <if cond="mode === 'ready'">
          <send event="bot.ability.offers" target="#_parent">
            <param name="ability" expr="'cognition'"/>
            <param name="choices" expr="[ignore]"/>
          </send>
        </if>
        <if cond="mode === 'huge'">
          <send event="bot.ability.offers" target="#_parent">
            <param name="ability" expr="'cognition'"/>
            <param name="choices" expr="[ignore, {event: 'bot.ability.cognition.input', schema: {type: 'object', properties: {pick: {type: 'string', 'enum': Array.from({length: 2800}, function (_, i) { return 'value-' + (1000 + i); })}}}}]"/>
          </send>
        </if>
      </onentry>
      <transition event="bot.ability.cognition.input" target="working">
        <assign location="turn" expr="_event.data.turn"/>
        <assign location="stimulus" expr="_event.data.stimulus"/>
        <assign location="action" expr="addressed(stimulus) ? 'addressed' : product(stimulus) ? lastText(stimulus) : stimulus.data.observation.event"/>
        <assign location="observed" expr="addressed(stimulus) ? stimulus.data.name : product(stimulus) ? stimulus.data.messages.length : stimulus.data.observation.data"/>
        <log label="double.input" expr="turn + ' ' + action + ' ' + JSON.stringify(observed)"/>
        <log label="double.choices" expr="JSON.stringify(_event.data.choices)"/>
      </transition>
      <transition event="bot.ability.cognition.ignore">
        <log label="double.ignore" expr="JSON.stringify(_event.data)"/>
      </transition>
      <transition event="bot.ability.cognition.cancel">
        <send event="bot.ability.cognition.cancelled" target="#_parent"><param name="turn" expr="_event.data.turn"/></send>
      </transition>
    </state>
    <state id="working">
      <onentry>
        <if cond="action === 'reply'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {text: 'reply ' + turn}}]"/>
          </send>
        </if>
        <if cond="action === 'blank'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {text: '  '}}]"/>
          </send>
        </if>
        <if cond="action === 'twice'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {text: 'first ' + turn}}, {event: 'bot.ability.communication.respond', data: {text: 'second ' + turn}}]"/>
          </send>
        </if>
        <if cond="action === 'then_blank'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {text: 'first ' + turn}}, {event: 'bot.ability.communication.respond', data: {text: '   '}}]"/>
          </send>
        </if>
        <if cond="action === 'unoffered'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.reasoning.input', data: {}}]"/>
          </send>
        </if>
        <if cond="action === 'adopt'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.identity.adopt', data: {name: observed}, reason: 'asked'}]"/>
          </send>
        </if>
        <if cond="action === 'addressed'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {text: 'I am ' + observed}}]"/>
          </send>
        </if>
        <if cond="action === 'ignore'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.cognition.ignore', data: {}, reason: 'nothing to do', target: 'cognition'}]"/>
          </send>
        </if>
        <if cond="action === 'elsewhere'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.cognition.ignore', data: {}, target: 'speaking'}]"/>
          </send>
        </if>
        <if cond="action === 'focus'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.focus_device', data: {device: observed}, reason: 'look'}]"/>
          </send>
        </if>
        <if cond="action === 'fail'">
          <send event="bot.ability.failed" target="#_parent">
            <param name="message" expr="'double failed'"/>
            <param name="turn" expr="turn"/>
            <param name="input" expr="({})"/>
          </send>
        </if>
        <if cond="action === 'stale'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn + 100"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {text: 'stale'}}]"/>
          </send>
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {text: 'fresh ' + turn}}]"/>
          </send>
        </if>
        <if cond="action === 'reboot'">
          <send event="bot.reboot" target="#_parent"><content>{"reason": "cognition_child_teardown_failed"}</content></send>
        </if>
      </onentry>
      <transition cond="['reply', 'blank', 'twice', 'then_blank', 'unoffered', 'adopt', 'addressed', 'ignore', 'elsewhere', 'focus', 'fail', 'stale'].indexOf(action) &gt;= 0" target="idle"/>
      <transition event="bot.ability.cognition.cancel" cond="action !== 'deaf'" target="idle">
        <send event="bot.ability.cognition.cancelled" target="#_parent"><param name="turn" expr="turn"/></send>
      </transition>
    </state>
  </state>
</scxml>
