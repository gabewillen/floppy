<?xml version="1.0" encoding="UTF-8"?>
<!--
  A cognition double for the body tests (tests/tests/body.rs): the body's
  child "cognition" without a model. tests/tests/body.rs copies it to
  abilities/cognition/cognition.scx beside a copy of the body.

  Readiness: its start sends bot.ability.ready unless mode is 'silent'
  (the test rewrites mode's expr). What it offers, the body reads from its
  live session (decision D242): its offerable <data> declares
  bot.ability.cognition.ignore, whose schema carries $schema, title,
  examples and a description (which the body compacts), or, when mode is
  'huge', also double.huge, whose schema (cognition_huge.json beside it,
  which tests/tests/body.rs copies) is over 32 KiB, so the body drops the
  double's whole offer.

  Each turn's behavior is the name of the bot.input observation the turn
  carries (stimulus.data.observation.event), or, for a conversation
  product (stimulus.event bot.ability.conversation.output), the first word
  of its last message's text, whose observed data is then the number of messages, or,
  for the listening's bot.ability.listening.speech.output, the first word
  of its content, with the content observed, or, for its environment.sound,
  "ignore" with the sound's kind observed, or, for seeing's
  bot.ability.seeing.sight, "ignore" with the sight's cause observed. A
  conversation product or heard speech whose turn's environment says the
  bot was named (self.identity.addressed, the identity's state the body
  read) is "addressed" instead, with the name observed:

  Like a stage of the real cognition, it sends each selection it makes to
  its target, the session id the turn's choices tag the first choice of
  its event with (#_scxml_ + target), before it answers the turn with them
  as its output; a selection whose event no choice offers names no target
  and is not sent (the body sends those to itself):

  * reply: answers the turn with one bot.ability.communication.respond
    selection of one part, {parts: [{words}]} (the communication offers it);
  * perceived (a bot.perceived stimulus, the percepts the body took
    together, whose observed data is each percept's observation data):
    answers as reply does;
  * blank: selects bot.ability.communication.respond whose one part's
    words are blank (the schema admits them; the communication refuses
    them);
  * twice: selects bot.ability.communication.respond twice;
  * then_blank: selects bot.ability.communication.respond, then again with
    blank words (the second waits for the first);
  * adopt: selects bot.ability.identity.adopt for the observation's data;
  * admit: selects bot.ability.communication.input (no choice offers it), the
    speech's words after the first from source "caller" (as the SpeechHeard
    seed admits heard speech);
  * ignore: selects bot.ability.cognition.ignore (the cognition's own offer,
    so the double sends it to itself);
  * focus: selects bot.focus_device for the observation's data;
  * act: selects the observation's data {event, data} (a focused device's
    action);
  * fail: answers bot.ability.failed;
  * stale: answers for another turn first, then for this one;
  * addressed: answers with one bot.ability.communication.respond
    selection "I am <name>";
  * reboot: asks the body for a reboot (bot.reboot);
  * hang: never answers, and acknowledges a cancel;
  * deaf: never answers and never acknowledges a cancel.

  It logs double.input per turn (turn, behavior, observation data),
  double.choices (the turn's choices as JSON), double.environment (the
  turn's environment as JSON), double.participants (the turn's
  participants as JSON), double.recent (the recent turns the body sent
  ahead of the turn, each [direction, speaker refs, text]), double.ignore when a
  bot.ability.cognition.ignore reaches it, and double.exit when it is
  cancelled.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="cognition_double" initial="alive">
  <datamodel>
    <data id="model" expr="'none'"/>
    <data id="mode" expr="'ready'"/>
    <data id="turn" expr="0"/>
    <data id="action" expr="null"/>
    <data id="observed" expr="null"/>
    <data id="named" expr="null"/>
    <data id="stimulus" expr="null"/>
    <data id="focus" expr="null"/>
    <!-- The turn's choices, its selections, and the one being sent. -->
    <data id="choices" expr="[]"/>
    <data id="out" expr="null"/>
    <data id="s" expr="null"/>
    <data id="offerable" expr="mode === 'huge' ? ({'bot.ability.cognition.ignore': {}, 'double.huge': {}}) : ({'bot.ability.cognition.ignore': {}})"/>
  </datamodel>
  <state id="alive" initial="idle">
    <onentry>
      <if cond="mode !== 'silent'">
        <send event="bot.ability.ready" target="#_parent"/>
      </if>
    </onentry>
    <onexit>
      <log label="double.exit" expr="model"/>
    </onexit>
    <!-- The short-term register's recent turns, which the body sends
         ahead of each turn. -->
    <transition event="bot.ability.memory.stm.recent_turns.output">
      <log label="double.recent" expr="JSON.stringify(_event.data.turns.map(function (t) { return [t.direction, t.speakers.map(function (s) { return s.ref; }), t.text]; }))"/>
    </transition>
    <state id="idle">
      <transition event="bot.ability.cognition.input" target="working">
        <assign location="turn" expr="_event.data.turn"/>
        <assign location="stimulus" expr="_event.data.stimulus"/>
        <assign location="focus" expr="_event.data.focus"/>
        <assign location="choices" expr="_event.data.choices"/>
        <assign location="named" expr="(stimulus.event === 'bot.ability.conversation.output' || stimulus.event === 'bot.ability.listening.speech.output') &amp;&amp; _event.data.environment.self.identity !== undefined &amp;&amp; _event.data.environment.self.identity.addressed === true ? _event.data.environment.self.identity.name : null"/>
        <assign location="action" expr="named !== null ? 'addressed' : stimulus.event === 'bot.perceived' ? 'perceived' : stimulus.event === 'bot.ability.listening.speech.output' ? stimulus.data.content.split(' ')[0] : stimulus.event === 'environment.sound' || stimulus.event === 'bot.ability.seeing.sight' ? 'ignore' : stimulus.event === 'bot.ability.conversation.output' ? stimulus.data.messages[stimulus.data.messages.length - 1].content.split(' ')[0] : stimulus.data.observation.event"/>
        <assign location="observed" expr="named !== null ? named : stimulus.event === 'bot.perceived' ? stimulus.data.percepts.map(function (p) { return p.stimulus.data.observation.data; }) : stimulus.event === 'bot.ability.listening.speech.output' ? stimulus.data.content : stimulus.event === 'environment.sound' ? stimulus.data.kind : stimulus.event === 'bot.ability.seeing.sight' ? stimulus.data.cause : stimulus.event === 'bot.ability.conversation.output' ? stimulus.data.messages.length : stimulus.data.observation.data"/>
        <log label="double.input" expr="turn + ' ' + action + ' ' + JSON.stringify(observed)"/>
        <log label="double.choices" expr="JSON.stringify(_event.data.choices)"/>
        <log label="double.environment" expr="JSON.stringify(_event.data.environment)"/>
        <log label="double.participants" expr="JSON.stringify(_event.data.participants)"/>
      </transition>
      <transition event="bot.ability.cognition.ignore" event:schema="../schemas/bot.ability.cognition.ignore.json">
        <log label="double.ignore" expr="JSON.stringify(_event.data)"/>
      </transition>
      <transition event="double.huge" event:schema="cognition_huge.json"/>
      <transition event="bot.ability.cognition.cancel">
        <send event="bot.ability.cognition.cancelled" target="#_parent"><param name="turn" expr="_event.data.turn"/></send>
      </transition>
    </state>
    <state id="working">
      <onentry>
        <if cond="action === 'reply' || action === 'perceived'">
          <assign location="out" expr="[{event: 'bot.ability.communication.respond', data: {parts: [{words: 'reply ' + turn}]}}]"/>
        </if>
        <if cond="action === 'blank'">
          <assign location="out" expr="[{event: 'bot.ability.communication.respond', data: {parts: [{words: '  '}]}}]"/>
        </if>
        <if cond="action === 'twice'">
          <assign location="out" expr="[{event: 'bot.ability.communication.respond', data: {parts: [{words: 'first ' + turn}]}}, {event: 'bot.ability.communication.respond', data: {parts: [{words: 'second ' + turn}]}}]"/>
        </if>
        <if cond="action === 'then_blank'">
          <assign location="out" expr="[{event: 'bot.ability.communication.respond', data: {parts: [{words: 'first ' + turn}]}}, {event: 'bot.ability.communication.respond', data: {parts: [{words: '   '}]}}]"/>
        </if>
        <if cond="action === 'adopt'">
          <assign location="out" expr="[{event: 'bot.ability.identity.adopt', data: {name: observed}, reason: 'asked'}]"/>
        </if>
        <if cond="action === 'addressed'">
          <assign location="out" expr="[{event: 'bot.ability.communication.respond', data: {parts: [{words: 'I am ' + observed}]}}]"/>
        </if>
        <if cond="action === 'admit'">
          <assign location="out" expr="[{event: 'bot.ability.communication.input', data: {source_ids: ['caller'], target_ids: [], content: observed.split(' ').slice(1).join(' '), content_type: 'text/plain', sample_rate_hz: stimulus.data.sample_rate_hz, channels: stimulus.data.channels}}]"/>
        </if>
        <if cond="action === 'ignore'">
          <assign location="out" expr="[{event: 'bot.ability.cognition.ignore', data: {}, reason: 'nothing to do'}]"/>
        </if>
        <if cond="action === 'focus'">
          <assign location="out" expr="[{event: 'bot.focus_device', data: {device: observed}, reason: 'look'}]"/>
        </if>
        <if cond="action === 'act'">
          <assign location="out" expr="[{event: observed.event, data: observed.data, reason: 'act'}]"/>
        </if>
        <if cond="action === 'fail'">
          <send event="bot.ability.failed" target="#_parent">
            <param name="message" expr="'double failed'"/>
            <param name="turn" expr="turn"/>
            <param name="input" expr="({})"/>
          </send>
        </if>
        <if cond="action === 'stale'">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn + 100"/>
            <param name="output" expr="[{event: 'bot.ability.communication.respond', data: {parts: [{words: 'stale'}]}}]"/>
          </send>
          <assign location="out" expr="[{event: 'bot.ability.communication.respond', data: {parts: [{words: 'fresh ' + turn}]}}]"/>
        </if>
        <if cond="out !== null">
          <assign location="out" expr="out.map(function (s) { var c = choices.filter(function (c) { return c.event === s.event; })[0]; return c === undefined ? s : Object.assign({}, s, {target: c.target}); })"/>
          <foreach array="out" item="s">
            <if cond="typeof s.target === 'string'">
              <send eventexpr="s.event" targetexpr="'#_scxml_' + s.target">
                <content expr="s.data"/>
              </send>
            </if>
          </foreach>
        </if>
      </onentry>
      <!-- Its own block, so a send above that fails (a device's schema
           refusing an action's data raises error.execution here, D41)
           still answers the turn. -->
      <onentry>
        <if cond="out !== null">
          <send event="bot.ability.cognition.output" target="#_parent">
            <param name="turn" expr="turn"/>
            <param name="output" expr="out"/>
          </send>
          <assign location="out" expr="null"/>
        </if>
        <if cond="action === 'reboot'">
          <send event="bot.reboot" target="#_parent"><content>{"reason": "cognition_child_teardown_failed"}</content></send>
        </if>
      </onentry>
      <transition cond="['reply', 'perceived', 'blank', 'twice', 'then_blank', 'adopt', 'admit', 'addressed', 'ignore', 'focus', 'act', 'fail', 'stale'].indexOf(action) &gt;= 0" target="idle"/>
      <transition event="bot.ability.cognition.cancel" cond="action !== 'deaf'" target="idle">
        <send event="bot.ability.cognition.cancelled" target="#_parent"><param name="turn" expr="turn"/></send>
      </transition>
    </state>
  </state>
</scxml>
