<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test harness of <memory:to_json> (tests/tests/communication.rs,
  the_remembered_input_is_one_memory_json_text): it logs the memory
  JSON of each external payload event's data as the conversation's input
  (payload), as the conversation remembers it.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:memory="https://github.com/stateforward/floppy/namespaces/memory"
       version="1.0" datamodel="ecmascript" name="payload" initial="taking">
  <datamodel>
    <data id="payload" expr="null"/>
  </datamodel>
  <state id="taking">
    <transition event="payload">
      <memory:to_json location="payload" message="_event.data"/>
      <log label="payload" expr="payload"/>
    </transition>
  </state>
</scxml>
