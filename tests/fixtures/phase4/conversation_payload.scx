<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test harness of abilities/conversation/conversation.js
  (tests/tests/communication.rs,
  the_remembered_input_is_mosfets_memory_json): copied beside the script,
  it loads it and logs memoryPayload() of each external payload event's
  data as the input (payload).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="payload" initial="taking">
  <datamodel>
    <data id="input" expr="null"/>
  </datamodel>
  <script src="conversation.js"/>
  <state id="taking">
    <transition event="payload">
      <assign location="input" expr="_event.data"/>
      <log label="payload" expr="memoryPayload()"/>
    </transition>
  </state>
</scxml>
