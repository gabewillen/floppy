<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test harness of abilities/conversation/conversation.scx (tests/tests/communication.rs,
  the_conversation_commits_each_message_into_its_history): it invokes the
  conversation as its child "conversation", forwards each external
  bot.ability.conversation.input and .append to it, and logs every
  bot.ability.conversation.output it answers, and the product of each
  bot.ability.cognition.input handoff (harness.output, its JSON), so
  the pinned trace holds each committed message field by field.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="harness" initial="run">
  <state id="run">
    <invoke id="conversation" type="scxml" src="conversation/conversation.scx"/>
    <transition event="bot.ability.conversation.output" cond="_event.invokeid === 'conversation'">
      <log label="harness.output" expr="JSON.stringify(_event.data)"/>
    </transition>
    <transition event="bot.ability.cognition.input" cond="_event.invokeid === 'conversation'">
      <log label="harness.output" expr="JSON.stringify(_event.data.stimulus.data)"/>
    </transition>
    <transition event="bot.ability.conversation.input bot.ability.conversation.append" cond="_event.invokeid === undefined">
      <send eventexpr="_event.name" target="#_conversation">
        <content expr="_event.data"/>
      </send>
    </transition>
  </state>
</scxml>
