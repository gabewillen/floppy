<?xml version="1.0" encoding="UTF-8"?>
<!--
  A firmware double for the body tests (tests/tests/body.rs): an owner's
  firmware (decision D160) that runs a timer. tests/tests/body.rs copies it
  beside a copy of the body and names it with the body's firmware_src.

  It offers its command, timer.set {minutes} (its schema timer.set.json
  beside it, which tests/tests/body.rs writes), in idle: the body reads it
  from its live session (decision D242). In idle, timer.set sets minutes,
  logs firmware.set with them, reports to the body (a
  bot.ability.cognition.input whose stimulus, timer.started, carries a
  bot.input observation "reply" with the minutes as its data, so the
  cognition double answers it as a reply) and goes to running; in running,
  timer.cancel goes back to idle. The body reads its state and minutes
  with <device:snapshot>.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="firmware_double" initial="idle">
  <datamodel>
    <data id="minutes" expr="0"/>
  </datamodel>
  <state id="idle">
    <transition event="timer.set" event:schema="timer.set.json" target="running">
      <assign location="minutes" expr="_event.data.minutes"/>
      <log label="firmware.set" expr="minutes"/>
      <send event="bot.ability.cognition.input" target="#_parent">
        <param name="stimulus" expr="({event: 'timer.started', data: {observation: {event: 'reply', data: 'timer ' + minutes}}})"/>
      </send>
    </transition>
  </state>
  <state id="running">
    <transition event="timer.cancel" target="idle"/>
  </state>
</scxml>
