{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lamp.on",
  "description": "Turn the lamp on, at a brightness from 1 to 100 (100 when none is given).",
  "properties": {
    "brightness": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "type": "object",
  "examples": [
    {},
    {"brightness": 40}
  ]
}
