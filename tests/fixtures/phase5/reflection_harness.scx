<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test harness of the Reflection ability (abilities/reflection/reflection.scx), laid
  out beside it in a scratch copy of abilities/ (tests/tests/reflection.rs).
  It seeds the database with the statements in seed (none by default),
  invokes the reflection as the cognition does (the <param>s memory and
  model), forwards each bot.ability.reflection.input from standard input
  to it, and after each answer logs it (harness.output or
  harness.failed) and then the inventory and the stored episodes
  (inventory, episodes), each as one JSON value, and logs each persona
  revision it sends up (harness.revise).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:event="https://github.com/stateforward/scxml.rs/namespaces/event"
       version="1.0" datamodel="ecmascript" name="reflection_harness" initial="seeding">
  <datamodel>
    <data id="database" expr="'/memory/floppy.sqlite'"/>
    <data id="seed" expr="[]"/>
    <!-- SQL both engines run; the logged values are assembled here. -->
    <data id="inspect_inventory">SELECT name, source, description, lifetime, status, status_reason, used_count, failed_count FROM bot_behavior ORDER BY name</data>
    <data id="inspect_triggers">SELECT behavior_name, "trigger" FROM bot_behavior_trigger ORDER BY behavior_name, "trigger"</data>
    <data id="inspect_episodes">SELECT context_ref, scope, kind, content FROM bot_memory WHERE query_tags = 'cognitive_episode' ORDER BY created_at, memory_id</data>
    <data id="inventory" expr="[]"/>
    <data id="triggers" expr="[]"/>
    <data id="episodes" expr="[]"/>
  </datamodel>

  <state id="seeding">
    <transition cond="seed.length === 0" target="running"/>
    <invoke id="seeder" type="scxml" src="memory/memory.scx">
      <param name="database" expr="database"/>
      <param name="statements" expr="seed"/>
    </invoke>
    <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json"
                cond="_event.invokeid === 'seeder'" target="running"/>
  </state>

  <state id="running" initial="waiting">
    <invoke id="reflection" type="scxml" src="reflection/reflection.scx">
      <param name="database" expr="database"/>
      <param name="model" expr="'fake-model'"/>
    </invoke>
    <transition event="bot.ability.reflection.input" event:schema="schemas/bot.ability.reflection.input.json">
      <send event="bot.ability.reflection.input" target="#_reflection">
        <content expr="_event.data"/>
      </send>
    </transition>
    <!-- A persona revision the reflection selected (decision D145). -->
    <transition event="bot.ability.persona.revise" event:schema="schemas/bot.ability.persona.revise.json">
      <log label="harness.revise" expr="JSON.stringify(_event.data)"/>
    </transition>
    <transition event="bot.ability.reflection.output" event:schema="schemas/bot.ability.reflection.output.json"
                target="inspecting">
      <log label="harness.output" expr="'answered'"/>
    </transition>
    <transition event="bot.ability.failed" event:schema="schemas/bot.ability.failed.json"
                cond="_event.invokeid === 'reflection'" target="inspecting">
      <log label="harness.failed" expr="_event.data.message"/>
    </transition>

    <state id="waiting"/>
    <state id="inspecting">
      <invoke id="inspector" type="scxml" src="memory/memory.scx">
        <param name="database" expr="database"/>
        <param name="statements" expr="[{sql: inspect_inventory}, {sql: inspect_triggers}, {sql: inspect_episodes}]"/>
      </invoke>
      <transition event="bot.ability.memory.output" event:schema="schemas/bot.ability.memory.output.json"
                  cond="_event.invokeid === 'inspector'" target="waiting">
        <assign location="triggers" expr="_event.data.results[1].rows"/>
        <assign location="inventory" expr="_event.data.results[0].rows.map(r =&gt; Object.fromEntries(r.columns.map((c, i) =&gt; [c, r.values[i]])))"/>
        <assign location="inventory" expr="inventory.map(b =&gt; Object.assign(b, {triggers: triggers.filter(t =&gt; t.values[0] === b.name).map(t =&gt; t.values[1])}))"/>
        <assign location="episodes" expr="_event.data.results[2].rows.map(r =&gt; Object.fromEntries(r.columns.map((c, i) =&gt; [c, r.values[i]])))"/>
        <assign location="episodes" expr="episodes.map(e =&gt; Object.assign(e, {content: JSON.parse(e.content)}))"/>
        <log label="inventory" expr="JSON.stringify(inventory)"/>
        <log label="episodes" expr="JSON.stringify(episodes)"/>
      </transition>
    </state>
  </state>
</scxml>
