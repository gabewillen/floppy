<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="a">
  <datamodel>
    <data id="x" expr="1"/>
    <data id="tries" expr="0"/>
  </datamodel>
  <state id="a">
    <transition event="go" cond="x = 2" target="f"/>
    <transition event="retry" cond="++tries &lt; 3" target="a"/>
    <transition event="both" cond="x = 3 and ready" target="f"/>
  </state>
  <final id="f"/>
</scxml>
