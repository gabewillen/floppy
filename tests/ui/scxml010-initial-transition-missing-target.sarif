{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"p\">\n  <state id=\"p\">\n    <initial>\n      <transition/>\n    </initial>\n    <state id=\"c\">\n      <transition event=\"go\" target=\"d\"/>\n    </state>\n    <final id=\"d\"/>\n  </state>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml010-initial-transition-missing-target.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml010-initial-transition-missing-target.scx"},"replacements":[{"deletedRegion":{"byteLength":0,"byteOffset":122,"endColumn":18,"endLine":4,"startColumn":18,"startLine":4},"insertedContent":{"text":" target=\"…\""}}]}],"description":{"text":"add the default `target`"},"properties":{"applicability":"has-placeholders"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml010-initial-transition-missing-target.scx"},"region":{"endColumn":18,"endLine":4,"startColumn":8,"startLine":4}}}],"message":{"markdown":"initial transition requires a `target`\n\n**Note:** default entry is unconditional: SCXML 3.6.2 says the initial transition \"MUST NOT contain 'cond' or 'event' attributes\" and must name a target\n\n**Help:** add a target state owned by the containing state\n\n**Spec:** SCXML 1.0 §3.6 <initial>","text":"initial transition requires a `target`"},"properties":{"byteSpan":{"end":122,"start":112},"category":"semantic"},"ruleId":"SCXML010"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"default entry is unconditional: SCXML 3.6.2 says the initial transition \"MUST NOT contain 'cond' or 'event' attributes\" and must name a target"},"help":{"text":"How to fix: remove `event`/`cond` from the initial transition and give it a `target`.\n\nSpecification: SCXML 1.0 §3.6 <initial>\n\nRun `scx --explain SCXML010` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#initial","id":"SCXML010","name":"SCXML010","properties":{"category":"semantic"},"shortDescription":{"text":"an `<initial>` transition has an event, a condition, or no target"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}