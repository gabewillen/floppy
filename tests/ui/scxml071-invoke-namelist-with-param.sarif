{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <datamodel>\n    <data id=\"x\" expr=\"1\"/>\n  </datamodel>\n  <state id=\"a\">\n    <invoke namelist=\"x\">\n      <param name=\"y\" expr=\"2\"/>\n      <content>\n        <scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\"><final id=\"c\"/></scxml>\n      </content>\n    </invoke>\n    <transition event=\"done.invoke\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml071-invoke-namelist-with-param.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml071-invoke-namelist-with-param.scx"},"replacements":[{"deletedRegion":{"byteLength":13,"byteOffset":182,"endColumn":25,"endLine":6,"startColumn":12,"startLine":6},"insertedContent":{"text":""}},{"deletedRegion":{"byteLength":0,"byteOffset":196,"endColumn":26,"endLine":6,"startColumn":26,"startLine":6},"insertedContent":{"text":"<param name=\"x\" location=\"x\"/>"}}]}],"description":{"text":"pass the namelist locations as `<param>` children"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml071-invoke-namelist-with-param.scx"},"region":{"endColumn":25,"endLine":6,"startColumn":13,"startLine":6}}}],"message":{"markdown":"an `<invoke>` with `<param>` children cannot also use `namelist`\n\n**Note:** `namelist` and `<param>` both pass data to the invoked service; SCXML allows only one of them on an `<invoke>`\n\n**Help:** pass each namelist location as a `<param>` with a `location`\n\n**Spec:** SCXML 1.0 §6.4 <invoke>","text":"an `<invoke>` with `<param>` children cannot also use `namelist`"},"properties":{"byteSpan":{"end":195,"start":183},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"param declared here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml071-invoke-namelist-with-param.scx"},"region":{"endColumn":13,"endLine":7,"startColumn":8,"startLine":7}}}],"ruleId":"SCXML071"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"SCXML 1.0 §6.4 says an `<invoke>`'s `namelist` \"Must not occur with the <param> element\": both pass data to the invoked service, and a conformant document uses one of them"},"help":{"text":"How to fix: pass each namelist location as a `<param>` whose `name` and `location` are that location, and remove `namelist`.\n\nSpecification: SCXML 1.0 §6.4 <invoke>\n\nRun `scx --explain SCXML071` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#invoke","id":"SCXML071","name":"SCXML071","properties":{"category":"semantic"},"shortDescription":{"text":"an `<invoke>` combines `namelist` with `<param>`"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}