{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <datamodel><data id=\"iid\"/></datamodel>\n  <state id=\"a\"><invoke id=\"i1\" idlocation=\"iid\" src=\"child.scxml\"/><transition event=\"done.invoke.i1\" target=\"f\"/></state><final id=\"f\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml016-invoke-id-and-idlocation.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-id-and-idlocation.scxml"},"replacements":[{"deletedRegion":{"byteLength":17,"byteOffset":170,"endColumn":49,"endLine":3,"startColumn":32,"startLine":3},"insertedContent":{"text":""}}]}],"description":{"text":"keep `id` and remove `idlocation`"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-id-and-idlocation.scxml"},"region":{"endColumn":32,"endLine":3,"startColumn":25,"startLine":3}}}],"message":{"markdown":"invoke ID cannot use both `id` and `idlocation`\n\n**Note:** `src`/`srcexpr`, `type`/`typeexpr`, `id`/`idlocation`, and an external source versus inline `<content>` are each mutually exclusive ways to say what to invoke and how to identify it\n\n**Help:** keep exactly one of `id` or `idlocation`\n\n**Spec:** SCXML 1.0 §6.4 <invoke>","text":"invoke ID cannot use both `id` and `idlocation`"},"properties":{"byteSpan":{"end":170,"start":163},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"conflicting attribute"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-id-and-idlocation.scxml"},"region":{"endColumn":49,"endLine":3,"startColumn":33,"startLine":3}}}],"ruleId":"SCXML016"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"`src`/`srcexpr`, `type`/`typeexpr`, `id`/`idlocation`, and an external source versus inline `<content>` are each mutually exclusive ways to say what to invoke and how to identify it"},"help":{"text":"How to fix: keep one source form and one type form.\n\nSpecification: SCXML 1.0 §6.4 <invoke>\n\nRun `scxml-cli --explain SCXML016` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#invoke","id":"SCXML016","name":"SCXML016","properties":{"category":"semantic"},"shortDescription":{"text":"an `<invoke>` has conflicting source or type forms"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}