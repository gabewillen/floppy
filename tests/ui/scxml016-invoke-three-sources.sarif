{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"a\" datamodel=\"ecmascript\">\n  <state id=\"a\">\n    <invoke type=\"scxml\" src=\"child.scxml\" srcexpr=\"'child.scxml'\"><content><scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\"><final id=\"f\"/></scxml></content></invoke>\n    <transition event=\"done.invoke\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml016-invoke-three-sources.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-three-sources.scx"},"region":{"endColumn":43,"endLine":3,"startColumn":26,"startLine":3}}}],"message":{"markdown":"invoke declares three sources: `src`, `srcexpr`, and inline `<content>`\n\n**Note:** `src`/`srcexpr`, `type`/`typeexpr`, `id`/`idlocation`, and an external source versus inline `<content>` are each mutually exclusive ways to say what to invoke and how to identify it\n\n**Help:** keep exactly one of `src`, `srcexpr`, or `<content>`\n\n**Spec:** SCXML 1.0 §6.4 <invoke>","text":"invoke declares three sources: `src`, `srcexpr`, and inline `<content>`"},"properties":{"byteSpan":{"end":156,"start":139},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"second source"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-three-sources.scx"},"region":{"endColumn":67,"endLine":3,"startColumn":44,"startLine":3}}},{"id":2,"message":{"text":"third source"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml016-invoke-three-sources.scx"},"region":{"endColumn":76,"endLine":3,"startColumn":69,"startLine":3}}}],"ruleId":"SCXML016"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"`src`/`srcexpr`, `type`/`typeexpr`, `id`/`idlocation`, and an external source versus inline `<content>` are each mutually exclusive ways to say what to invoke and how to identify it"},"help":{"text":"How to fix: keep one source form and one type form.\n\nSpecification: SCXML 1.0 §6.4 <invoke>\n\nRun `scx --explain SCXML016` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#invoke","id":"SCXML016","name":"SCXML016","properties":{"category":"semantic"},"shortDescription":{"text":"an `<invoke>` has conflicting source or type forms"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}