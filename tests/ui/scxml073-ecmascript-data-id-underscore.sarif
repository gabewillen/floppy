{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"s\">\n  <datamodel>\n    <data id=\"_\" expr=\"1\"/>\n    <data id=\"x\" expr=\"1\"/>\n  </datamodel>\n  <state id=\"s\">\n    <transition event=\"e\" cond=\"_ &gt; 0\" target=\"f\"/>\n  </state>\n  <final id=\"f\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml073-ecmascript-data-id-underscore.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml073-ecmascript-data-id-underscore.scxml"},"region":{"endColumn":16,"endLine":3,"startColumn":15,"startLine":3}}}],"message":{"markdown":"`<data id>` `_` begins with `_`\n\n**Note:** SCXML reserves names that begin with `_` for system variables such as `_event`, `_sessionid`, `_name`, and `_ioprocessors`, and a conformant document declares no data with such an id\n\n**Help:** rename the data without the leading `_`, and update every reference to it\n\n**Spec:** SCXML 1.0 §5.10 System Variables","text":"`<data id>` `_` begins with `_`"},"properties":{"byteSpan":{"end":126,"start":125},"category":"semantic"},"ruleId":"SCXML073"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"SCXML 1.0 §5.10: \"Variable names beginning with '_' are reserved for system use. A conformant SCXML document MUST NOT contain ids beginning with '_' in the <data> element.\" (under the null data model `<data>` itself is `SCXML037`)"},"help":{"text":"How to fix: rename the data without the leading `_`, and update every reference to it.\n\nSpecification: SCXML 1.0 §5.10 System Variables\n\nRun `scxml-cli --explain SCXML073` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#SystemVariables","id":"SCXML073","name":"SCXML073","properties":{"category":"semantic"},"shortDescription":{"text":"a `<data id>` begins with `_`"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}