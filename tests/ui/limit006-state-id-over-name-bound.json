{"version":"scxml.report/v3","kind":"validator","validator":{"source_name":"tests/ui/limit006-state-id-over-name-bound.scx","source_text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"start\">\n  <state id=\"start\">\n    <transition event=\"go\" target=\"\"/>\n  </state>\n  <final id=\"\"/>\n</scxml>\n","diagnostics":[{"severity":"error","code":"LIMIT006","category":"semantic","message":"state ID `sxxxxxxxxxxxxxxxxxxxxxxx…` is 1,025 bytes, more than the 1,024 a state name may have","primary":{"span":{"start":1187,"end":2212},"message":"1,025 bytes"},"secondary":[],"notes":["every build names the active states by their IDs (each step's configuration, snapshots, `In()`), and a name holds at most 1,024 bytes of UTF-8, so this state could never be reported once entered; SCXML 1.0 §3.14 sets no length, and this is the implementation's bound (spec errata L.6)"],"help":"shorten the ID to at most 1,024 bytes and update every reference to it","spec_references":["SCXML 1.0 §3.14 IDs"],"fixes":[]}],"counts":{"errors":1,"warnings":0,"notes":0,"total":1}}}