<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="null" initial="p">
  <parallel id="p">
    <state id="r1"><transition event="go" cond="In('r2')" target="done"/></state>
    <state id="r2"><transition event="go" cond="In(r3)" target="done"/></state>
  </parallel>
  <final id="done"/>
</scxml>
