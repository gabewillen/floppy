<?ui-args --service-package components/scxml-service-example/package/echo.service.json?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:env="https://github.com/stateforward/scxml.rs/namespaces/env"
       version="1.0" datamodel="ecmascript" initial="s0">
  <state id="s0">
    <invoke type="https://stateforward.org/scxml/services/echo" id="echo" env:tokn="API_TOKEN"/>
    <transition event="echo.fetched" target="done"/>
  </state>
  <final id="done"/>
</scxml>
