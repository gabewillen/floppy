{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\"\n       xmlns:event=\"https://github.com/stateforward/scxml.rs/namespaces/event\"\n       version=\"1.0\" datamodel=\"ecmascript\" initial=\"ordering\">\n  <state id=\"ordering\">\n    <invoke id=\"order\" src=\"invoked/valid-event011-child.scx\"/>\n    <transition event=\"order.ready\"\n                event:schema='{\"type\":\"object\",\"properties\":{\"count\":{\"type\":\"integer\"}},\"required\":[\"count\"]}'>\n      <send event=\"order.place\" target=\"#_order\"><content>{\"quantity\": 2}</content></send>\n    </transition>\n    <transition event=\"done.invoke.order\" target=\"done\"/>\n  </state>\n  <final id=\"done\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/valid-event011-compatible-invoked-event-data.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":0,"warnings":0},"producer":{"kind":"validator"}},"results":[],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}