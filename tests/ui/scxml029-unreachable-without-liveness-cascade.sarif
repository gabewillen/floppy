{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"a\">\n  <state id=\"a\"><transition event=\"go\" target=\"done\"/></state>\n  <state id=\"island\">\n    <state id=\"stuck\"/>\n  </state>\n  <final id=\"done\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml029-unreachable-without-liveness-cascade.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":1,"warnings":1},"producer":{"kind":"validator"}},"results":[{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml029-unreachable-without-liveness-cascade.scxml"},"region":{"endColumn":20,"endLine":3,"startColumn":14,"startLine":3}}}],"message":{"markdown":"state `island` can never become active\n\n**Note:** its descendant state is unreachable as well and is not reported separately\n\n**Note:** reachability assumes every event can arrive and every `cond` can be true; no reachable transition, `initial`, or history default enters this state or any of its descendants\n\n**Help:** target `island` from a transition of a reachable state, make it the initial state of the <scxml> root, or remove it\n\n**Spec:** SCXML 1.0 §3.11 Legal State Configurations and Specifications\n\n**Spec:** SCXML 1.0 §3.13 Selecting and Executing Transitions","text":"state `island` can never become active"},"properties":{"byteSpan":{"end":156,"start":150},"category":"lint"},"relatedLocations":[{"id":1,"message":{"text":"the <scxml> root enters `a` by default"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml029-unreachable-without-liveness-cascade.scxml"},"region":{"endColumn":72,"endLine":1,"startColumn":71,"startLine":1}}}],"ruleId":"SCXML029"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"no transition, `initial`, or history default reachable from the initial configuration enters the state or any descendant, even assuming every event arrives and every `cond` can be true; unreachable states are usually a mistyped target or a forgotten transition"},"help":{"text":"How to fix: target the state from a transition of a reachable state, make it the parent's initial state, or remove it.\n\nSpecification: SCXML 1.0 §3.11 Legal State Configurations and Specifications\n\nRun `scxml-cli --explain SCXML029` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#LegalStateConfigurations","id":"SCXML029","name":"SCXML029","properties":{"category":"lint"},"shortDescription":{"text":"a state can never become active"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}