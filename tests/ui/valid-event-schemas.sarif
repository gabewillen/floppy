{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\"\n       xmlns:event=\"https://github.com/stateforward/scxml.rs/namespaces/event\"\n       version=\"1.0\" datamodel=\"ecmascript\" initial=\"idle\">\n  <datamodel>\n    <data id=\"refundSchema\" expr=\"({type: 'object'})\"/>\n  </datamodel>\n  <state id=\"idle\">\n    <onentry>\n      <raise event=\"ready\" event:schema='{\"type\": \"null\"}'/>\n      <send event=\"tick\" delay=\"1s\" event:schema=\"event-schemas/order.json#/$defs/Item\"/>\n    </onentry>\n    <transition event=\"order\" target=\"done\" event:schema=\"event-schemas/order.json#/$defs/Order\"/>\n    <transition event=\"refund\" target=\"done\" event:schemaexpr=\"refundSchema\"/>\n    <transition event=\"ready\" event:schema=\"true\"/>\n    <transition event=\"tick\" event:schema=\"event-schemas/order.json\"/>\n  </state>\n  <final id=\"done\">\n    <donedata event:schema='{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}}}'>\n      <param name=\"id\" expr=\"'o-1'\"/>\n    </donedata>\n  </final>\n</scxml>\n"},"location":{"uri":"tests/ui/valid-event-schemas.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":0,"warnings":0},"producer":{"kind":"validator"}},"results":[],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}