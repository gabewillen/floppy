<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" initial="a">
  <datamodel>
    <data id="count" expr="0"/>
  </datamodel>
  <state id="a">
    <transition event="go" cond="count >= " target="b"/>
    <transition event="stop" target="b"/>
  </state>
  <final id="b"/>
</scxml>
