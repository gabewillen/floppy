{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <state id=\"a\" initial=\"a1\"><history id=\"h\"><transition target=\"a1\"/><transition target=\"a2\"/></history><state id=\"a1\"><transition event=\"go\" target=\"a2\"/></state><state id=\"a2\"><transition event=\"back\" target=\"f\"/></state></state><final id=\"f\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml019-history-two-transitions.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml019-history-two-transitions.scx"},"replacements":[{"deletedRegion":{"byteLength":25,"byteOffset":167,"endColumn":96,"endLine":2,"startColumn":71,"startLine":2},"insertedContent":{"text":""}}]}],"description":{"text":"keep only the first transition"},"properties":{"applicability":"maybe-incorrect"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml019-history-two-transitions.scx"},"region":{"endColumn":82,"endLine":2,"startColumn":72,"startLine":2}}}],"message":{"markdown":"history must contain exactly one transition, but has 2\n\n**Note:** the history transition defines the default configuration used before the parent state was ever exited\n\n**Help:** keep one `<transition>` in `<history>`; to enter several states at once, list them all in its `target` (for example `target=\"a b\"` across parallel regions)\n\n**Spec:** SCXML 1.0 §3.10 <history>","text":"history must contain exactly one transition, but has 2"},"properties":{"byteSpan":{"end":178,"start":168},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"the first transition is here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml019-history-two-transitions.scx"},"region":{"endColumn":57,"endLine":2,"startColumn":47,"startLine":2}}}],"ruleId":"SCXML019"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"the history transition defines the default configuration used before the parent state was ever exited"},"help":{"text":"How to fix: put exactly one target-only `<transition>` inside `<history>`.\n\nSpecification: SCXML 1.0 §3.10 <history>\n\nRun `scx --explain SCXML019` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#history","id":"SCXML019","name":"SCXML019","properties":{"category":"semantic"},"shortDescription":{"text":"a `<history>` does not contain exactly one `<transition>`"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}