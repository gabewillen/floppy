{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"p\">\n  <state id=\"p\" initial=\"c\">\n    <history id=\"h\">\n      <transition cond=\"true\" target=\"c\"/>\n    </history>\n    <state id=\"c\">\n      <transition event=\"go\" target=\"d\"/>\n    </state>\n    <final id=\"d\"/>\n  </state>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml020-history-conditional.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml020-history-conditional.scx"},"replacements":[{"deletedRegion":{"byteLength":12,"byteOffset":164,"endColumn":30,"endLine":4,"startColumn":18,"startLine":4},"insertedContent":{"text":""}}]}],"description":{"text":"remove `cond`"},"properties":{"applicability":"machine-applicable"}}],"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml020-history-conditional.scx"},"region":{"endColumn":30,"endLine":4,"startColumn":19,"startLine":4}}}],"message":{"markdown":"history transition must not have `cond`\n\n**Note:** the history default is unconditional: SCXML 3.10.2 says the history transition \"MUST NOT contain 'cond' or 'event' attributes\" and must name a target\n\n**Help:** remove `cond` from this transition\n\n**Spec:** SCXML 1.0 §3.10 <history>","text":"history transition must not have `cond`"},"properties":{"byteSpan":{"end":176,"start":165},"category":"semantic"},"ruleId":"SCXML020"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"the history default is unconditional: SCXML 3.10.2 says the history transition \"MUST NOT contain 'cond' or 'event' attributes\" and must name a target"},"help":{"text":"How to fix: remove `event`/`cond` from the history transition and give it a `target`.\n\nSpecification: SCXML 1.0 §3.10 <history>\n\nRun `scx --explain SCXML020` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#history","id":"SCXML020","name":"SCXML020","properties":{"category":"semantic"},"shortDescription":{"text":"a `<history>` transition has an event, a condition, or no target"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}