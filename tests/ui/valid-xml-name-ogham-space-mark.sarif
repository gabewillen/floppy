{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- U+1680 OGHAM SPACE MARK is Unicode white space but an XML NameStartChar: it is part of each name below, never a separator. -->\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"null\" initial=\"&#x1680;a\">\n  <state id=\"&#x1680;a\">\n    <transition event=\"go&#x1680;on &#x1680;\" target=\"b&#x1680;\"/>\n  </state>\n  <final id=\"b&#x1680;\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/valid-xml-name-ogham-space-mark.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":0,"warnings":0},"producer":{"kind":"validator"}},"results":[],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}