{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"p\">\n  <state id=\"p\" initial=\"c\">\n    <history id=\"h\" type=\"deep\">\n      <transition target=\"q\"/>\n    </history>\n    <state id=\"c\">\n      <transition event=\"go\" target=\"q\"/>\n    </state>\n  </state>\n  <final id=\"q\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml021-deep-history-outside-parent.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml021-deep-history-outside-parent.scx"},"region":{"endColumn":28,"endLine":4,"startColumn":27,"startLine":4}}}],"message":{"markdown":"deep history target `q` is not a descendant of the history's parent\n\n**Note:** shallow history records only the parent's immediate children, so its default must be one of them; deep history records descendants, so its default must lie inside the history's parent\n\n**Help:** target a state nested inside the state that contains this `<history>`\n\n**Spec:** SCXML 1.0 §3.10 <history>","text":"deep history target `q` is not a descendant of the history's parent"},"properties":{"byteSpan":{"end":163,"start":162},"category":"semantic"},"relatedLocations":[{"id":1,"message":{"text":"target declared here"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml021-deep-history-outside-parent.scx"},"region":{"endColumn":15,"endLine":10,"startColumn":14,"startLine":10}}}],"ruleId":"SCXML021"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"shallow history records only the parent's immediate children, so its default must be one of them; deep history records descendants, so its default must lie inside the history's parent"},"help":{"text":"How to fix: for shallow history target an immediate child of the history's parent (or declare `type=\"deep\"`); for deep history target a descendant of the parent.\n\nSpecification: SCXML 1.0 §3.10 <history>\n\nRun `scx --explain SCXML021` for examples."},"helpUri":"https://www.w3.org/TR/scxml/#history","id":"SCXML021","name":"SCXML021","properties":{"category":"semantic"},"shortDescription":{"text":"a history default targets a state outside what the history can restore"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}