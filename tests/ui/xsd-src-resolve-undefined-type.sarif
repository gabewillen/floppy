{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<?ui-args --schema urn:example:custom=tests/ui/schemas/undefined-type.xsd?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" xmlns:c=\"urn:example:custom\" initial=\"a\">\n  <final id=\"a\"><onentry><c:mark value=\"1\"/></onentry></final>\n</scxml>\n"},"location":{"uri":"tests/ui/xsd-src-resolve-undefined-type.scxml"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":1,"notes":0,"total":1,"warnings":0},"producer":{"kind":"validator"}},"results":[{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/xsd-src-resolve-undefined-type.scxml"},"region":{"endColumn":33,"endLine":3,"startColumn":27,"startLine":3}}}],"message":{"markdown":"Type '{urn:example:custom}missingType' not found\n\n**Note:** the schema registered for `urn:example:custom` rejects this under XML Schema constraint `src-resolve`\n\n**Help:** fix the schema registered for this namespace so every referenced type, element, and group is defined\n\n**Spec:** XML Schema 1.0 Part 1 §3 Schema Component Details (`src-resolve`)","text":"Type '{urn:example:custom}missingType' not found"},"properties":{"byteSpan":{"end":211,"start":205},"category":"schema"},"ruleId":"XSD-src-resolve"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"schema representation constraints (`src-*`) are checked lazily when an instance first uses the broken declaration, so the error surfaces at that element"},"help":{"text":"How to fix: fix the schema registered for this namespace so every referenced type, element, and group is defined.\n\nSpecification: XML Schema 1.0 Part 1 §3.15.3 Constraints on XML Representations of Schemas\n\nRun `scxml-cli --explain XSD-src-resolve` for examples."},"helpUri":"https://www.w3.org/TR/xmlschema-1/#src-resolve","id":"XSD-src-resolve","name":"XSD-src-resolve","properties":{"category":"schema"},"shortDescription":{"text":"the governing schema references a component it does not define"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}