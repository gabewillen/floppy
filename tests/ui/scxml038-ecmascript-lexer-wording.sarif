{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" initial=\"a\">\n  <datamodel><data id=\"x\" expr=\"1\"/><data id=\"y\" expr=\"2\"/></datamodel>\n  <state id=\"a\">\n    <onentry>\n      <log expr=\"# Retry loop\"/>\n      <log expr=\"x @ y\"/>\n      <log expr=\"Starting…\"/>\n      <log expr=\"😀 hi\"/>\n      <log expr=\"Error: failed\"/>\n      <log expr=\"it's done\"/>\n      <log expr=\"x.#secret\"/>\n      <log expr=\"// counts attempts\"/>\n      <log expr=\"`total\"/>\n      <script>\n        # Update the counter\n        x = x + 1;\n      </script>\n    </onentry>\n    <transition event=\"go\" target=\"b\"/>\n  </state>\n  <final id=\"b\"/>\n</scxml>\n"},"location":{"uri":"tests/ui/scxml038-ecmascript-lexer-wording.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":10,"warnings":10},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/scxml038-ecmascript-lexer-wording.scx"},"replacements":[{"deletedRegion":{"byteLength":12,"byteOffset":217,"endColumn":30,"endLine":5,"startColumn":18,"startLine":5},"insertedContent":{"text":"'# Retry loop'"}}]}],"description":{"text":"quote the text as a string literal"},"properties":{"applicability":"maybe-incorrect"}}],"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/scxml038-ecmascript-lexer-wording.scx"},"region":{"endColumn":19,"endLine":5,"startColumn":18,"startLine":5}}}],"message":{"markdown":"ecmascript syntax error in `expr`: `#` does not start a comment or a heading in an ECMAScript expression\n\n**Note:** an expression that cannot be parsed raises `error.execution` whenever it is evaluated\n\n**Help:** text in an expression must be a quoted string literal: write `'# Retry loop'`\n\n**Spec:** SC