{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"artifacts":[{"contents":{"text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"xpath\" initial=\"a\">\n  <datamodel><data id=\"name\" expr=\"'Ada'\"/></datamodel>\n  <final id=\"a\">\n    <onentry>\n      <log label=\"greeting\" expr=\"'Hello, ' + $name + '!'\"/>\n      <log label=\"sum\" expr=\"1 + 2\"/>\n      <log label=\"numeric\" expr=\"'1' + 2\"/>\n    </onentry>\n  </final>\n</scxml>\n"},"location":{"uri":"tests/ui/lint014-xpath-string-addition.scx"},"mimeType":"application/scxml+xml"}],"columnKind":"utf16CodeUnits","properties":{"diagnosticCounts":{"errors":0,"notes":0,"total":1,"warnings":1},"producer":{"kind":"validator"}},"results":[{"fixes":[{"artifactChanges":[{"artifactLocation":{"uri":"tests/ui/lint014-xpath-string-addition.scx"},"replacements":[{"deletedRegion":{"byteLength":23,"byteOffset":213,"endColumn":58,"endLine":5,"startColumn":35,"startLine":5},"insertedContent":{"text":"concat('Hello, ', $name, '!')"}}]}],"description":{"text":"join the strings with `concat()`"},"properties":{"applicability":"maybe-incorrect"}}],"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"tests/ui/lint014-xpath-string-addition.scx"},"region":{"endColumn":46,"endLine":5,"startColumn":45,"startLine":5}}}],"message":{"markdown":"`+` adds numbers in XPath, so adding the string 'Hello, ' yields `NaN`\n\n**Note:** XPath converts both operands of `+` to numbers; a string that is not a number converts to `NaN`, and `NaN` plus anything is `NaN`\n\n**Help:** join strings with `concat()`: `concat('Hello, ', $name, '!')`\n\n**Spec:** SCXML CR 2014 §C.3 The XPath Data Model\n\n**Spec:** XPath 1.0 §3.5 Numbers","text":"`+` adds numbers in XPath, so adding the string 'Hello, ' yields `NaN`"},"properties":{"byteSpan":{"end":224,"start":223},"category":"lint"},"relatedLocations":[{"id":1,"message":{"text":"this sum is `NaN`"},"physicalLocation":{"artifactLocation":{"uri":"tests/ui/lint014-xpath-string-addition.scx"},"region":{"endColumn":58,"endLine":5,"startColumn":35,"startLine":5}}}],"ruleId":"LINT014"}],"tool":{"driver":{"informationUri":"https://www.w3.org/TR/scxml/","name":"scxml-validator","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"XPath converts both operands of `+` to numbers, so a string that is not numeric becomes `NaN` and the sum is `NaN`; `+` does not concatenate strings as it does in ECMAScript"},"help":{"text":"How to fix: join strings with `concat()`, for example `concat('Hello, ', $name)`.\n\nSpecification: XPath 1.0 §3.5 Numbers\n\nRun `scx --explain LINT014` for examples."},"helpUri":"https://www.w3.org/TR/1999/REC-xpath-19991116/#numbers","id":"LINT014","name":"LINT014","properties":{"category":"lint"},"shortDescription":{"text":"an XPath expression adds a string with `+`"}}],"semanticVersion":"0.2.0"}}}],"version":"2.1.0"}