{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Result": {
      "description": "The model's reply: text without a requested schema, or the JSON value that satisfies the requested schema.",
      "oneOf": [
        {
          "type": "object",
          "properties": {"text": {"type": "string"}},
          "required": ["text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"json": true},
          "required": ["json"],
          "additionalProperties": false
        }
      ]
    },
    "Failed": {
      "description": "The generation failed; code names why (closed).",
      "type": "object",
      "properties": {
        "code": {"enum": ["unconfigured", "refused", "transport", "status", "malformed", "truncated", "filtered", "refusal", "not-json", "schema-mismatch"]}
      },
      "required": ["code"],
      "additionalProperties": false
    }
  }
}
