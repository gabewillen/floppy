{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot.ability.hearing.voice.identification.output",
  "description": "Voice embeddings identified from segmented voice audio.",
  "properties": {
    "embeddings": {
      "description": "Voice embeddings identified for the input voice segments, in input order.",
      "examples": [
        [
          {
            "confidence": 0.91,
            "embedding": [
              0.12,
              -0.08,
              0.31
            ],
            "model": "voice-embedding-v1"
          }
        ]
      ],
      "items": {
        "description": "Provider-neutral embedding value returned for an identified voice segment.",
        "examples": [
          {
            "confidence": 0.91,
            "embedding": [
              0.12,
              -0.08,
              0.31
            ],
            "model": "voice-embedding-v1"
          }
        ],
        "properties": {
          "embedding": {
            "description": "Provider-neutral numeric voice embedding produced by the classifier. Providers decide how to index and compare the vector; it is not a human-readable speaker label.",
            "examples": [
              [
                0.12,
                -0.08,
                0.31
              ]
            ],
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "title": "Embedding",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional embedding model identifier that produced this voice embedding.",
            "examples": [
              "voice-embedding-v1"
            ],
            "title": "Model"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional provider confidence that the voice embedding represents this speaker, normalized from 0.0 to 1.0.",
            "examples": [
              0.91
            ],
            "title": "Confidence"
          }
        },
        "required": [
          "embedding"
        ],
        "title": "VoiceEmbedding",
        "type": "object"
      },
      "minItems": 1,
      "title": "Embeddings",
      "type": "array"
    }
  },
  "required": [
    "embeddings"
  ],
  "type": "object",
  "examples": [
    {
      "embeddings": [
        {
          "confidence": 0.91,
          "embedding": [
            0.12,
            -0.08,
            0.31
          ],
          "model": "voice-embedding-v1"
        }
      ]
    }
  ]
}
