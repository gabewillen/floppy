# Every variable floppy's bots read, by name only. Copy this file to .env and
# write each value after the name (NAME=VALUE), or leave a name bare to take
# it from the calling shell (a bare name the shell does not set is skipped).
# Pass the file to scx run with --env-file .env, and never commit .env.
# README.md, "Defaults", says which document reads each variable.

# The generate service's model endpoint: an OpenAI-compatible base URL (for
# example a vLLM server's /v1) and its key. Both are required; there is no
# default backend (decision D31). Read by the builder and by the floppy
# bot's reasoning.
FLOPPY_BASE_URL
FLOPPY_API_KEY

# The decision service (TypeSafe), read by the builder's triage and the
# floppy bot's intuition. The floppy bot needs the key (without it every turn
# fails); the builder triages with its fallback. Without a base URL the
# service uses its declared origin, https://api.typesafe.ai.
TYPESAFE_BASE_URL
TYPESAFE_API_KEY

# The speech service's speech endpoint: an OpenAI-compatible audio API
# (/audio/transcriptions and /audio/speech) and its key, for the floppy
# bot's speech decoding (listening) and speech encoding (speaking). No
# default backend.
FLOPPY_SPEECH_BASE_URL
FLOPPY_SPEECH_API_KEY

# The speech service's voice endpoint: LocalAI's voice APIs (/vad,
# /audio/diarization, /voice/embed) and its key, for the floppy bot's voice
# detection, diarization and voice identification (listening). No default
# backend.
FLOPPY_VOICE_BASE_URL
FLOPPY_VOICE_API_KEY
